---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us — FreeFontFinderAI | Support & Inquiries"
  description="Have feedback, questions, or feature suggestions for FreeFontFinderAI? Reach out to our team. We'd love to hear from you."
  canonicalUrl="https://freefontfinderai.com/contact"
>
  <article class="py-12 sm:py-20 px-4 sm:px-6 max-w-[1000px] mx-auto transition-colors">
    <!-- Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-white/[0.03] border border-[#e2e4e8] dark:border-[#23252a] font-mono text-[11px] text-[#475569] dark:text-[#8a8f98] mb-4 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#ff4d00] dark:bg-[#e4f222]"></span>
        <span>GET IN TOUCH WITH THE TEAM</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.022em]">
        Contact Us
      </h1>
      <p class="mt-3 text-[15px] sm:text-[16px] text-[#475569] dark:text-[#8a8f98] leading-relaxed max-w-2xl">
        We're dedicated to building the most helpful and private typography tools on the web. Have feedback, found a bug, or want to suggest a new feature? We'd love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left 2 Cols: Contact Form -->
      <div class="lg:col-span-2">
        <div class="rounded-[16px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] mb-1.5">
            Send a Message
          </h2>
          <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] mb-6">
            Fill out the form below and our development team will respond within 24 to 48 hours.
          </p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98] mb-1.5">
                  Your Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Alex Morgan"
                  class="w-full px-3.5 py-2.5 rounded-[8px] border border-[#e2e4e8] dark:border-[#282b32] bg-[#f8f9fa] dark:bg-[#141518] text-[#08090a] dark:text-[#ffffff] text-[13px] focus:outline-none focus:border-[#ff4d00] dark:focus:border-[#e4f222] transition-colors"
                />
              </div>

              <div>
                <label for="contact-email" class="block font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98] mb-1.5">
                  Email Address <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="alex@example.com"
                  class="w-full px-3.5 py-2.5 rounded-[8px] border border-[#e2e4e8] dark:border-[#282b32] bg-[#f8f9fa] dark:bg-[#141518] text-[#08090a] dark:text-[#ffffff] text-[13px] focus:outline-none focus:border-[#ff4d00] dark:focus:border-[#e4f222] transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="contact-subject" class="block font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98] mb-1.5">
                Topic / Subject <span class="text-red-500">*</span>
              </label>
              <select
                id="contact-subject"
                name="subject"
                required
                class="w-full px-3.5 py-2.5 rounded-[8px] border border-[#e2e4e8] dark:border-[#282b32] bg-[#f8f9fa] dark:bg-[#141518] text-[#08090a] dark:text-[#ffffff] text-[13px] focus:outline-none focus:border-[#ff4d00] dark:focus:border-[#e4f222] transition-colors"
              >
                <option value="General Inquiry">General Inquiry</option>
                <option value="Font Matching Feedback">Font Matching Feedback</option>
                <option value="Bug Report">Bug Report</option>
                <option value="Feature Suggestion">Feature Suggestion</option>
                <option value="Partnership / Other">Partnership / Other</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98] mb-1.5">
                Message <span class="text-red-500">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="How can we help? Please share details about your inquiry or feedback..."
                class="w-full px-3.5 py-2.5 rounded-[8px] border border-[#e2e4e8] dark:border-[#282b32] bg-[#f8f9fa] dark:bg-[#141518] text-[#08090a] dark:text-[#ffffff] text-[13px] focus:outline-none focus:border-[#ff4d00] dark:focus:border-[#e4f222] transition-colors resize-y"
              ></textarea>
            </div>

            <button
              type="submit"
              id="contact-submit-btn"
              class="btn-acid-lime inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-[8px] text-[13px] font-[550] shadow-sm transition-all cursor-pointer w-full sm:w-auto"
            >
              <span>Send Message</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>

          <!-- Success Alert -->
          <div id="contact-success" class="hidden mt-4 p-4 rounded-[8px] bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-[13px]">
            <div class="flex items-center gap-2 font-[510]">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Thank you! Your message has been received.</span>
            </div>
            <p class="mt-1 text-[12px] opacity-90">
              We appreciate your feedback and will get back to you shortly at the email address provided.
            </p>
          </div>
        </div>
      </div>

      <!-- Right 1 Col: Quick Contact Info & Direct Links -->
      <div class="space-y-6">
        
        <!-- Direct Email Card -->
        <div class="rounded-[16px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 shadow-sm">
          <div class="w-9 h-9 rounded-[8px] bg-[#f1f3f6] dark:bg-[#161718] border border-[#e2e4e8] dark:border-[#282b32] flex items-center justify-center text-[#ff4d00] dark:text-[#e4f222] mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-[510] text-[15px] text-[#08090a] dark:text-[#ffffff]">
            Direct Email Support
          </h3>
          <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] mt-1 mb-3 leading-relaxed">
            Prefer direct email? Send us notes, attachments, or sample font images anytime.
          </p>
          <a
            href="mailto:support@freefontfinderai.com"
            class="text-[13px] font-mono text-[#ff4d00] dark:text-[#e4f222] hover:underline break-all"
          >
            support@freefontfinderai.com
          </a>
        </div>

        <!-- Open Source & Issue Tracker Card -->
        <div class="rounded-[16px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 shadow-sm">
          <div class="w-9 h-9 rounded-[8px] bg-[#f1f3f6] dark:bg-[#161718] border border-[#e2e4e8] dark:border-[#282b32] flex items-center justify-center text-[#ff4d00] dark:text-[#e4f222] mb-3">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </div>
          <h3 class="font-[510] text-[15px] text-[#08090a] dark:text-[#ffffff]">
            GitHub Repository
          </h3>
          <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] mt-1 mb-3 leading-relaxed">
            Report bugs, submit feature suggestions, or explore the source repository.
          </p>
          <a
            href="https://github.com/prabhatsingh985/Font-Finder"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[13px] font-mono text-[#ff4d00] dark:text-[#e4f222] hover:underline inline-flex items-center gap-1"
          >
            <span>github.com/prabhatsingh985/Font-Finder</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>

        <!-- Quick Help Card -->
        <div class="rounded-[16px] border border-[#e2e4e8] dark:border-[#23252a] bg-[#f8f9fa] dark:bg-[#141518] p-5 shadow-sm">
          <h4 class="font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98] mb-2">
            Looking for answers right now?
          </h4>
          <p class="text-[12px] text-[#475569] dark:text-[#8a8f98] leading-relaxed mb-3">
            Check out our comprehensive FAQ covering cursive fonts, image formatting, and Google Fonts deployment.
          </p>
          <a href="/#faq" class="text-[12px] font-mono text-[#ff4d00] dark:text-[#e4f222] hover:underline inline-flex items-center gap-1 font-medium">
            <span>View FAQ Section &rarr;</span>
          </a>
        </div>

      </div>

    </div>
  </article>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('contact-success');
    const submitBtn = document.getElementById('contact-submit-btn');

    if (form && successMsg && submitBtn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = 'Sending...';
        submitBtn.disabled = true;

        setTimeout(() => {
          form.reset();
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
          successMsg.classList.remove('hidden');
          successMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 600);
      });
    }
  </script>
</BaseLayout>
