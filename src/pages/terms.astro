---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service — Font Finder"
  description="Read the terms of service governing the use of the Font Finder website and typography tools."
>
  <article class="py-12 sm:py-20 px-4 sm:px-6 max-w-[1000px] mx-auto">
    <div class="mb-12">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98]">01 / LEGAL BLUEPRINT</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-[510] text-[#ffffff] tracking-[-0.022em]">
        Terms of Service
      </h1>
      <p class="mt-3 text-[15px] sm:text-[16px] text-[#8a8f98] leading-relaxed">
        Last revised: March 2026.
      </p>
    </div>

    <div class="space-y-6 text-[14px] leading-relaxed text-[#8a8f98]">
      
      <section class="rounded-[12px] border border-[#23252a] bg-[#0f1011] p-6 sm:p-8 shadow-sm">
        <div class="border-l-2 border-[#e4f222] pl-3 mb-3">
          <h2 class="text-[16px] sm:text-[17px] font-[510] text-[#ffffff] tracking-[-0.012em]">
            1. Agreement to Terms
          </h2>
        </div>
        <p class="text-[#d0d6e0]">
          By using Font Finder, you agree to these Terms of Service. The service is provided free of charge for identifying typography and accessing open-source font resources.
        </p>
      </section>

      <section class="rounded-[12px] border border-[#23252a] bg-[#0f1011] p-6 sm:p-8 shadow-sm">
        <div class="border-l-2 border-[#e4f222] pl-3 mb-3">
          <h2 class="text-[16px] sm:text-[17px] font-[510] text-[#ffffff] tracking-[-0.012em]">
            2. Font Licensing
          </h2>
        </div>
        <p class="text-[#d0d6e0]">
          Fonts verified and linked through this platform are subject to their respective open-source licenses, primarily the SIL Open Font License (OFL). Users are responsible for complying with the terms of each respective font.
        </p>
      </section>

    </div>
  </article>
</BaseLayout>
