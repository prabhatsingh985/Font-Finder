---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service — Font Finder"
  description="Read the terms of service governing the use of the Font Finder website and typography tools."
>
  <article class="py-12 sm:py-20 px-4 sm:px-6 max-w-[1000px] mx-auto">
    <div class="mb-12">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">01 / LEGAL BLUEPRINT</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] tracking-tight">
        Terms of Service
      </h1>
      <p class="mt-3 text-base text-[#727272] leading-relaxed">
        Last revised: March 2026.
      </p>
    </div>

    <div class="space-y-8 text-sm leading-relaxed text-[#727272]">
      
      <section class="rounded-2xl border border-[#e5e7eb] bg-[#f9f9f9] p-8 shadow-[0_0_0_6px_rgb(249,249,249)]">
        <div class="border-l-2 border-[#ff4d00] pl-3 mb-3">
          <h2 class="text-base font-semibold text-[#262626]">
            1. Agreement to Terms
          </h2>
        </div>
        <p>
          By using Font Finder, you agree to these Terms of Service. The service is provided free of charge for identifying typography and accessing open-source font resources.
        </p>
      </section>

      <section class="rounded-2xl border border-[#e5e7eb] bg-[#f9f9f9] p-8 shadow-[0_0_0_6px_rgb(249,249,249)]">
        <div class="border-l-2 border-[#ff4d00] pl-3 mb-3">
          <h2 class="text-base font-semibold text-[#262626]">
            2. Font Licensing
          </h2>
        </div>
        <p>
          Fonts verified and linked through this platform are subject to their respective open-source licenses, primarily the SIL Open Font License (OFL). Users are responsible for complying with the terms of each respective font.
        </p>
      </section>

    </div>
  </article>
</BaseLayout>
