---
import { NON_DEFAULT_LOCALES } from '../../i18n/languages';
import ContactView from '../../components/pages/ContactView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<ContactView lang={lang} />
