---
import { NON_DEFAULT_LOCALES } from '../../../i18n/languages';
import ScreenshotFontFinderView from '../../../components/pages/ScreenshotFontFinderView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<ScreenshotFontFinderView lang={lang} />
