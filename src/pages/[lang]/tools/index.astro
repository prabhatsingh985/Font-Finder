---
import { NON_DEFAULT_LOCALES } from '../../../i18n/languages';
import ToolsIndexView from '../../../components/pages/ToolsIndexView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<ToolsIndexView lang={lang} />
