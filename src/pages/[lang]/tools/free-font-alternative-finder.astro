---
import { NON_DEFAULT_LOCALES } from '../../../i18n/languages';
import CommercialAlternativeView from '../../../components/pages/CommercialAlternativeView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<CommercialAlternativeView lang={lang} />
