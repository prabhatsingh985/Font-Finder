---
import { NON_DEFAULT_LOCALES } from '../../../i18n/languages';
import HandwritingFontFinderView from '../../../components/pages/HandwritingFontFinderView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<HandwritingFontFinderView lang={lang} />
