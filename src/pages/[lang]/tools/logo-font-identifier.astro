---
import { NON_DEFAULT_LOCALES } from '../../../i18n/languages';
import LogoFontFinderView from '../../../components/pages/LogoFontFinderView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<LogoFontFinderView lang={lang} />
