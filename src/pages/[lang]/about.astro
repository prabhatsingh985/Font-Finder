---
import { NON_DEFAULT_LOCALES } from '../../i18n/languages';
import AboutView from '../../components/pages/AboutView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<AboutView lang={lang} />
