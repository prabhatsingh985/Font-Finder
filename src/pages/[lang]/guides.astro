---
import { NON_DEFAULT_LOCALES } from '../../i18n/languages';
import GuidesView from '../../components/pages/GuidesView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<GuidesView lang={lang} />
