---
import { NON_DEFAULT_LOCALES } from '../../i18n/languages';
import HowItWorksView from '../../components/pages/HowItWorksView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---
<HowItWorksView lang={lang} />
