---
import BaseLayout from '../layouts/BaseLayout.astro';
import FontFinderApp from '../components/FontFinderApp.astro';
import FontCard from '../components/FontCard.astro';
import { VERIFIED_GOOGLE_FONTS } from '../services/googleFonts/data';

const featuredFonts = VERIFIED_GOOGLE_FONTS.slice(0, 6);
---

<BaseLayout
  title="Font Finder — Developer-First Image Font Identifier & Google Fonts Verification"
  description="Identify any font from screenshots with optical precision. Technical letterform analysis verified against authentic Google Fonts with production CSS blueprints."
>
  <!-- Hero Section with Linear Atmospheric Depth & Floor Wash -->
  <section class="relative pt-12 pb-16 sm:pt-16 sm:pb-20 px-4 sm:px-6 bg-grid-pattern-subtle hero-gradient-floor border-b border-[#23252a] overflow-hidden">
    <div class="max-w-[1200px] mx-auto text-center relative z-10">
      
      <!-- Linear Precision Status Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.03] border border-[#23252a] font-mono text-[11px] text-[#8a8f98] mb-5 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></span>
        <span class="font-normal text-[#d0d6e0]">Google Fonts Optical Matcher</span>
        <span class="text-[#62666d]">&bull;</span>
        <span class="text-[#8a8f98]">1,935 In-Browser Signatures</span>
      </div>

      <!-- Linear Display Headline (64px / 510 / tight tracking -0.022em) -->
      <h1 class="text-4xl sm:text-6xl lg:text-[64px] font-[510] tracking-[-0.022em] text-[#ffffff] leading-[1.05] max-w-4xl mx-auto">
        Identify fonts in <br class="hidden sm:inline" />
        <span class="inline-flex items-center justify-center min-w-[220px] sm:min-w-[340px] text-[#ff4d00] dark:text-[#e4f222] transition-all duration-300 select-none" id="morphing-font-word" style="font-family: 'Playfair Display', serif; font-style: italic; color: var(--color-acid-lime);">
          Playfair Display
        </span>
      </h1>

      <p class="mt-4 text-[15px] sm:text-[16px] text-[#8a8f98] max-w-lg mx-auto leading-relaxed font-normal">
        Drop any screenshot to isolate letterforms, calculate optical contours, and get verified open-source Google Fonts.
      </p>

      <!-- Live CSS snippet tag (Berkeley / JetBrains Mono) -->
      <div class="mt-3.5 flex items-center justify-center">
        <span class="px-3 py-1 rounded-[6px] bg-[#0f1011] border border-[#23252a] font-mono text-[11px] text-[#8a8f98] transition-all shadow-sm" id="morphing-font-css">
          font-family: 'Playfair Display', serif;
        </span>
      </div>
    </div>

    <!-- Core Font Finder Tool (Product UI as Hero Showcase) -->
    <div class="mt-8 sm:mt-11 relative z-10">
      <FontFinderApp />
    </div>
  </section>

  <!-- Live Font Cycler Script -->
  <script is:inline>
    (function () {
      const fonts = [
        { name: 'Playfair Display', style: "font-family: 'Playfair Display', serif; font-style: italic; color: var(--color-acid-lime);", css: "font-family: 'Playfair Display', serif;" },
        { name: 'JetBrains Mono', style: "font-family: 'JetBrains Mono', monospace; font-weight: 500; color: var(--color-acid-lime);", css: "font-family: 'JetBrains Mono', monospace;" },
        { name: 'Bebas Neue', style: "font-family: 'Bebas Neue', sans-serif; letter-spacing: 2px; color: var(--color-acid-lime);", css: "font-family: 'Bebas Neue', cursive;" },
        { name: 'Syne', style: "font-family: 'Syne', sans-serif; font-weight: 700; color: var(--color-acid-lime);", css: "font-family: 'Syne', sans-serif;" },
        { name: 'Cinzel', style: "font-family: 'Cinzel', serif; font-weight: 600; color: var(--color-acid-lime);", css: "font-family: 'Cinzel', serif;" },
        { name: 'Inter', style: "font-family: 'Inter', sans-serif; font-weight: 600; color: var(--color-acid-lime);", css: "font-family: 'Inter', sans-serif;" }
      ];

      let idx = 0;
      const wordEl = document.getElementById('morphing-font-word');
      const cssEl = document.getElementById('morphing-font-css');

      if (wordEl && cssEl) {
        setInterval(() => {
          idx = (idx + 1) % fonts.length;
          const f = fonts[idx];
          
          wordEl.style.opacity = '0';
          wordEl.style.transform = 'translateY(4px)';
          
          setTimeout(() => {
            wordEl.textContent = f.name;
            wordEl.setAttribute('style', f.style);
            cssEl.textContent = f.css;
            
            wordEl.style.opacity = '1';
            wordEl.style.transform = 'translateY(0)';
            wordEl.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          }, 150);
        }, 2500);
      }
    })();
  </script>

  <!-- Official Verified Developer Ecosystem Strip -->
  <section class="ecosystem-strip py-8 sm:py-10 px-4 sm:px-6 relative overflow-hidden transition-colors">
    <!-- Subtle atmospheric ambient floor glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_0%,rgba(228,242,34,0.035),transparent_70%)] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-[1200px] mx-auto relative z-10">
      <!-- Section Header with Live Status & Standards Assurance -->
      <div class="ecosystem-divider flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-[#1b1c20]">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10b981] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10b981]"></span>
          </span>
          <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-[#ffffff] font-medium flex items-center gap-1.5">
            VERIFIED STANDARDS & OFFICIAL ECOSYSTEM
          </span>
          <span class="hidden md:inline-block text-[#383b42]">•</span>
          <span class="hidden md:inline-block text-[11px] text-[#8a8f98] font-normal">
            Zero telemetry in-memory OCR &bull; 100% Client-side execution
          </span>
        </div>

        <div class="flex items-center gap-2 text-[11px] font-mono text-[#8a8f98]">
          <span class="ecosystem-pill inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[5px] text-[#a0a6b2]">
            <svg class="w-3 h-3 text-[#10b981]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
            <span>OFL 1.1 Compliant</span>
          </span>
          <span class="text-[#383b42]">•</span>
          <span class="text-[#d0d6e0]">W3C WOFF2</span>
        </div>
      </div>

      <!-- 5 Official Ecosystem Specification Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-3.5">
        
        <!-- Card 1: Google Fonts Official Specimen API -->
        <a 
          href="https://fonts.google.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="ecosystem-card group flex flex-col justify-between p-3.5 sm:p-4 rounded-[10px]"
        >
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="ecosystem-icon-box w-8 h-8 rounded-[6px] flex items-center justify-center">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z" />
              </svg>
            </div>
            <span class="ecosystem-pill font-mono text-[9px] uppercase px-1.5 py-0.5 rounded transition-colors">
              Official Repo
            </span>
          </div>
          <div>
            <div class="ecosystem-title flex items-center gap-1.5 font-[510] text-[13px] sm:text-[14px] text-[#ffffff] tracking-[-0.01em] transition-colors">
              <span>Google Fonts</span>
              <svg class="w-3 h-3 text-[#8a8f98] opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
            <p class="ecosystem-sub font-mono text-[10px] text-[#8a8f98] mt-1 leading-snug">
              3,200+ Verified Open Fonts
            </p>
          </div>
        </a>

        <!-- Card 2: SIL Open Font License -->
        <a 
          href="https://scripts.sil.org/OFL" 
          target="_blank" 
          rel="noopener noreferrer"
          class="ecosystem-card group flex flex-col justify-between p-3.5 sm:p-4 rounded-[10px]"
        >
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="ecosystem-icon-box w-8 h-8 rounded-[6px] flex items-center justify-center">
              <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18C8 3 4 5 4 9v6c0 4 8 6 8 6s8-2 8-6V9c0-4-4-6-8-6z" />
              </svg>
            </div>
            <span class="ecosystem-pill font-mono text-[9px] uppercase px-1.5 py-0.5 rounded transition-colors">
              License
            </span>
          </div>
          <div>
            <div class="ecosystem-title flex items-center gap-1.5 font-[510] text-[13px] sm:text-[14px] text-[#ffffff] tracking-[-0.01em] transition-colors">
              <span>SIL OFL 1.1</span>
              <svg class="w-3 h-3 text-[#8a8f98] opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
            <p class="ecosystem-sub font-mono text-[10px] text-[#8a8f98] mt-1 leading-snug">
              100% Free Commercial Use
            </p>
          </div>
        </a>

        <!-- Card 3: W3C Web Fonts Standard -->
        <a 
          href="https://www.w3.org/TR/WOFF2/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="ecosystem-card group flex flex-col justify-between p-3.5 sm:p-4 rounded-[10px]"
        >
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="ecosystem-icon-box w-8 h-8 rounded-[6px] flex items-center justify-center">
              <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7V4h16v3M9 20h6M12 4v16" />
              </svg>
            </div>
            <span class="ecosystem-pill font-mono text-[9px] uppercase px-1.5 py-0.5 rounded transition-colors">
              W3C Spec
            </span>
          </div>
          <div>
            <div class="ecosystem-title flex items-center gap-1.5 font-[510] text-[13px] sm:text-[14px] text-[#ffffff] tracking-[-0.01em] transition-colors">
              <span>W3C Web Fonts</span>
              <svg class="w-3 h-3 text-[#8a8f98] opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
            <p class="ecosystem-sub font-mono text-[10px] text-[#8a8f98] mt-1 leading-snug">
              WOFF2 &bull; Variable OpenType
            </p>
          </div>
        </a>

        <!-- Card 4: HTML5 Canvas & WebGL Acceleration -->
        <div class="ecosystem-card group flex flex-col justify-between p-3.5 sm:p-4 rounded-[10px]">
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="ecosystem-icon-box w-8 h-8 rounded-[6px] flex items-center justify-center">
              <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m16-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <span class="ecosystem-pill font-mono text-[9px] uppercase px-1.5 py-0.5 rounded transition-colors">
              GPU Engine
            </span>
          </div>
          <div>
            <div class="ecosystem-title flex items-center gap-1.5 font-[510] text-[13px] sm:text-[14px] text-[#ffffff] tracking-[-0.01em] transition-colors">
              <span>HTML5 Canvas & WebGL</span>
            </div>
            <p class="ecosystem-sub font-mono text-[10px] text-[#8a8f98] mt-1 leading-snug">
              Subpixel Canvas Rasterizer
            </p>
          </div>
        </div>

        <!-- Card 5: Zero Telemetry Client In-Memory OCR -->
        <div class="ecosystem-card group flex flex-col justify-between p-3.5 sm:p-4 rounded-[10px]">
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="ecosystem-icon-box w-8 h-8 rounded-[6px] flex items-center justify-center">
              <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <span class="font-mono text-[9px] uppercase px-1.5 py-0.5 rounded bg-[#10b981]/10 border border-[#10b981]/25 text-[#10b981]">
              100% Private
            </span>
          </div>
          <div>
            <div class="ecosystem-title flex items-center gap-1.5 font-[510] text-[13px] sm:text-[14px] text-[#ffffff] tracking-[-0.01em] transition-colors">
              <span>In-Memory OCR</span>
            </div>
            <p class="ecosystem-sub font-mono text-[10px] text-[#8a8f98] mt-1 leading-snug">
              Zero Server Uploads / Telemetry
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section: Three-step Workflow (Creative Interactive Recognition Pipeline) -->
  <section class="py-20 sm:py-28 max-w-[1200px] mx-auto px-4 sm:px-6 relative">
    
    <!-- Section Header with Linear Engineering Aesthetics -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="pipeline-tag inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-white/[0.03] border border-[#23252a]">
          <span class="w-2 h-2 rounded-full bg-[#e4f222] shadow-[0_0_8px_#e4f222] animate-pulse"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-[#d0d6e0] font-semibold">RECOGNITION ARCHITECTURE</span>
        </div>
        <h2 class="pipeline-heading text-3xl sm:text-4xl font-[510] tracking-[-0.025em] text-[#ffffff] leading-tight">
          Three-step recognition pipeline
        </h2>
        <p class="pipeline-subheading text-[14px] text-[#8a8f98] mt-2 font-normal max-w-xl">
          From unconstrained bitmap pixels to verified, production-ready open-source CSS typography.
        </p>
      </div>

      <!-- Live Speed & Privacy Assurance Badge -->
      <div class="pipeline-assurance-badge hidden lg:flex items-center gap-3 font-mono text-[11px] text-[#8a8f98] p-2.5 rounded-[8px] bg-[#0c0d10] border border-[#202329]">
        <div class="flex items-center gap-1.5 text-[#10b981]">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="font-semibold">&lt; 150ms Local Inference</span>
        </div>
        <span class="text-[#2b2e35]">|</span>
        <div class="flex items-center gap-1.5 text-[#d0d6e0]">
          <svg class="w-3.5 h-3.5 text-[#e4f222]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Zero Server Uploads</span>
        </div>
      </div>
    </div>

    <!-- 3 High-Tech Interactive Step Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 relative">

      <!-- Connecting line indicator across steps for desktop -->
      <div class="pipeline-connecting-line hidden md:block absolute top-[42px] left-[15%] right-[15%] h-[1px] bg-gradient-to-r from-transparent via-white/[0.08] to-transparent pointer-events-none z-0" aria-hidden="true"></div>

      <!-- STEP 1 CARD -->
      <div class="pipeline-step-card group p-6 sm:p-7 flex flex-col justify-between z-10">
        <!-- Hover Gradient Spotlight Accent -->
        <div class="absolute -top-20 -right-20 w-44 h-44 rounded-full bg-[radial-gradient(circle,rgba(228,242,34,0.12),transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none blur-2xl"></div>

        <!-- Giant Creative Number Watermark -->
        <div class="step-watermark absolute top-2 right-4 font-mono font-black text-6xl sm:text-7xl text-white/[0.025] select-none pointer-events-none tracking-tighter">
          01
        </div>

        <div>
          <!-- Creative Step Header Pill with Pulsing Status -->
          <div class="flex items-center justify-between gap-2 mb-5">
            <div class="step-badge-pill inline-flex items-center gap-2 px-3 py-1 rounded-full font-mono text-[10px] font-semibold tracking-wider bg-[#14161a] border border-[#26282e] text-[#a0a6b2] shrink-0">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#e4f222] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#e4f222]"></span>
              </span>
              <span>PHASE 01 // INGESTION</span>
            </div>
            <span class="step-phase-tag font-mono text-[10px] text-[#62666d] group-hover:text-[#e4f222] transition-colors whitespace-nowrap text-right">RAW INPUT</span>
          </div>

          <!-- Step Title & Description -->
          <h3 class="step-title font-[510] text-[18px] sm:text-[19px] text-[#ffffff] tracking-[-0.015em] group-hover:text-[#e4f222] transition-colors">
            Upload or Paste
          </h3>
          <p class="step-desc text-[13px] text-[#8a8f98] mt-2 leading-relaxed">
            Drop an image or paste instantly from clipboard with <kbd class="font-mono text-[10px] bg-[#161718] border border-[#23252a] px-1.5 py-0.5 rounded text-[#d0d6e0] shadow-sm">⌘V</kbd>. Interactive crop isolate glyph contours.
          </p>

          <!-- Creative Interactive Visual Demo: Optical Crop Viewfinder -->
          <div class="pipeline-preview-box crop-preview-box mt-6 p-4 rounded-[10px] bg-[#121316] border border-[#1e2025] group-hover:border-[#333742] transition-all relative overflow-hidden">
            <!-- Viewfinder Corner Brackets that expand on hover -->
            <span class="crop-bracket absolute top-2 left-2 w-2.5 h-2.5 border-t-2 border-l-2 border-[#e4f222] transition-all duration-300 group-hover:w-4 group-hover:h-4"></span>
            <span class="crop-bracket absolute top-2 right-2 w-2.5 h-2.5 border-t-2 border-r-2 border-[#e4f222] transition-all duration-300 group-hover:w-4 group-hover:h-4"></span>
            <span class="crop-bracket absolute bottom-2 left-2 w-2.5 h-2.5 border-b-2 border-l-2 border-[#e4f222] transition-all duration-300 group-hover:w-4 group-hover:h-4"></span>
            <span class="crop-bracket absolute bottom-2 right-2 w-2.5 h-2.5 border-b-2 border-r-2 border-[#e4f222] transition-all duration-300 group-hover:w-4 group-hover:h-4"></span>

            <div class="flex items-center justify-between">
              <!-- Glyph Preview with Dashed Precision Crop Box -->
              <div class="crop-glyph-box relative px-4 py-2 border border-dashed border-[#e4f222]/50 rounded-[4px] bg-[#16181d] group-hover:border-[#e4f222] group-hover:shadow-[0_0_12px_rgba(228,242,34,0.15)] transition-all">
                <span class="crop-glyph-text font-serif text-2xl text-[#ffffff] tracking-wider select-none font-bold">Aa</span>
                <span class="crop-badge-tag absolute -top-2 -left-1 font-mono text-[8px] bg-[#0c0d10] px-1 text-[#e4f222] font-semibold">CROP</span>
              </div>

              <!-- Shortcut Pill -->
              <div class="flex flex-col items-end gap-1">
                <span class="crop-detect-pill inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[6px] font-mono text-[10px] bg-[#181a1e] border border-[#2a2c32] text-[#d0d6e0] group-hover:border-[#e4f222]/40 transition-colors shadow-sm">
                  <svg class="crop-detect-icon w-3 h-3 text-[#e4f222]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  <span>Auto-Detect</span>
                </span>
                <span class="crop-detect-sub font-mono text-[9px] text-[#62666d]">PNG • JPG • WebP</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step Bottom Status Bar -->
