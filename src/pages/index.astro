---
import BaseLayout from '../layouts/BaseLayout.astro';
import FontFinderApp from '../components/FontFinderApp.astro';
import FontCard from '../components/FontCard.astro';
import { VERIFIED_GOOGLE_FONTS } from '../services/googleFonts/data';

const featuredFonts = VERIFIED_GOOGLE_FONTS.slice(0, 6);
---

<BaseLayout
  title="Font Finder — Free Image Font Identifier & Verified Google Fonts"
  description="Identify any font from an image in seconds. Measured through optical letterform analysis, verified against Google Fonts, with ready-to-use CSS snippets."
>
  <!-- Hero Section -->
  <section class="relative pt-16 pb-12 sm:pt-24 sm:pb-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Trust Eyebrow -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-muted border border-border text-xs font-medium text-muted-foreground mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse-subtle"></span>
        <span>100% Optical Typography Matching &bull; Verified Google Fonts</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-foreground leading-[1.1]">
        Upload an image. <br class="hidden sm:inline" />
        <span class="text-muted-foreground font-semibold">Find the font.</span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        Identify fonts from screenshots, logos, and print. Inspect optical letterform measurements, get guaranteed Google Fonts matches, and copy production-ready CSS.
      </p>
    </div>

    <!-- Font Finder Interactive App -->
    <div class="mt-10 sm:mt-12">
      <FontFinderApp />
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-16 sm:py-20 border-t border-border bg-muted/20 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Process</h2>
        <p class="text-2xl sm:text-3xl font-bold text-foreground mt-2">How Font Identification Works</p>
        <p class="text-sm text-muted-foreground mt-2">
          No vague guesses or hallucinated names. Every result is computed through optical typography geometry.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="rounded-xl border border-border bg-card p-6 shadow-subtle flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-lg bg-foreground text-background flex items-center justify-center font-bold text-sm mb-4">
              01
            </div>
            <h3 class="text-base font-semibold text-foreground">Upload or Paste</h3>
            <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
              Drag in a screenshot, paste from clipboard (<kbd class="px-1 py-0.5 rounded bg-muted border border-border text-[10px] font-mono">⌘V</kbd>), or try our sample specimens. Tight crops around horizontal text yield the highest precision.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-border text-[11px] text-muted-foreground">
            Adaptive contrast thresholding
          </div>
        </div>

        <!-- Step 2 -->
        <div class="rounded-xl border border-border bg-card p-6 shadow-subtle flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-lg bg-foreground text-background flex items-center justify-center font-bold text-sm mb-4">
              02
            </div>
            <h3 class="text-base font-semibold text-foreground">Measure Letterforms</h3>
            <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
              Our optical engine analyzes glyph contours, measuring terminal serif flares, vertical stem width, horizontal hairline contrast, aspect ratios, and x-height.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-border text-[11px] text-muted-foreground">
            Zero cloud uploads &bull; Pure browser canvas
          </div>
        </div>

        <!-- Step 3 -->
        <div class="rounded-xl border border-border bg-card p-6 shadow-subtle flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-lg bg-foreground text-background flex items-center justify-center font-bold text-sm mb-4">
              03
            </div>
            <h3 class="text-base font-semibold text-foreground">Verified Match & CSS</h3>
            <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
              Candidates are ranked against the verified open-source Google Fonts catalog. Preview the font with your own text and copy ready-to-use CSS snippets instantly.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-border text-[11px] text-muted-foreground">
            One-click CSS @import & font-family
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Differentiators Section -->
  <section class="py-16 sm:py-20 border-t border-border px-4 sm:px-6">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
            Engineered for Precision
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-foreground mt-2 tracking-tight">
            Built to be trusted, not just quick.
          </h2>
          <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
            Most font detectors present arbitrary percentages or make up font names that do not exist or cost hundreds of dollars to license. Font Finder prioritizes open, accessible typography you can actually use today.
          </p>

          <div class="mt-6 space-y-3.5">
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-foreground">No Hallucinations</h4>
                <p class="text-xs text-muted-foreground">Every detected typeface corresponds to an authentic, documented font family.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-foreground">Google Fonts Verification</h4>
                <p class="text-xs text-muted-foreground">Only fonts verified in the official Google Fonts registry receive the verified badge.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-foreground">Free Commercial Alternatives</h4>
                <p class="text-xs text-muted-foreground">Identifies commercial classics like Helvetica, Futura, and Gotham and pairs them with 100% free open-source equivalents.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-foreground">Complete Privacy</h4>
                <p class="text-xs text-muted-foreground">No image files are saved to disks or external servers. Analysis runs in volatile memory.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Visual Typography Card -->
        <div class="rounded-2xl border border-border bg-card p-6 sm:p-8 shadow-elevated">
          <div class="flex items-center justify-between pb-4 border-b border-border text-xs">
            <span class="font-mono text-muted-foreground">TYPOGRAPHIC ANATOMY</span>
            <span class="px-2 py-0.5 rounded bg-muted text-foreground font-mono">100% OPTICAL</span>
          </div>

          <div class="mt-6 space-y-4">
            <div class="p-3.5 rounded-lg bg-muted/40 border border-border/80">
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-foreground">Terminal Serifs</span>
                <span class="text-muted-foreground font-mono">Flared vs Hairline vs None</span>
              </div>
              <p class="text-xs text-muted-foreground">Distinguishes bracketed classical serifs (Playfair Display) from monoline grotesques (Inter).</p>
            </div>

            <div class="p-3.5 rounded-lg bg-muted/40 border border-border/80">
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-foreground">Geometric Proportions</span>
                <span class="text-muted-foreground font-mono">Aspect Ratio Index</span>
              </div>
              <p class="text-xs text-muted-foreground">Calculates width-to-height distribution to separate circular designs (Montserrat) from condensed headlines (Oswald).</p>
            </div>

            <div class="p-3.5 rounded-lg bg-muted/40 border border-border/80">
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-foreground">Stroke Contrast</span>
                <span class="text-muted-foreground font-mono">Stem / Hairline Ratio</span>
              </div>
              <p class="text-xs text-muted-foreground">Detects high stroke modulation in modern display serifs vs consistent stroke weight in technical monospace.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Verified Fonts Showcase -->
  <section class="py-16 sm:py-20 border-t border-border bg-muted/20 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Verified Typefaces</h2>
          <p class="text-2xl sm:text-3xl font-bold text-foreground mt-1">Browse Popular Fonts</p>
        </div>
        <a
          href="/fonts"
          class="text-xs font-semibold text-foreground hover:underline inline-flex items-center gap-1"
        >
          View all verified fonts &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredFonts.map((font) => <FontCard font={font} />)}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 sm:py-20 border-t border-border px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">FAQ</h2>
        <p class="text-2xl sm:text-3xl font-bold text-foreground mt-1">Frequently Asked Questions</p>
      </div>

      <div class="divide-y divide-border border-y border-border">
        <!-- Q1 -->
        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-foreground list-none">
            <span>Is Font Finder completely free to use?</span>
            <span class="transition-transform group-open:rotate-180 text-muted-foreground">&darr;</span>
          </summary>
          <p class="mt-2.5 text-xs text-muted-foreground leading-relaxed">
            Yes, Font Finder is 100% free with unlimited scans, no credit card required, and no account signup. All matching runs in-browser or volatile memory, and all recommended font families are licensed under the SIL Open Font License (OFL) for free commercial and personal use.
          </p>
        </details>

        <!-- Q2 -->
        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-foreground list-none">
            <span>Do you store my uploaded images or screenshots?</span>
            <span class="transition-transform group-open:rotate-180 text-muted-foreground">&darr;</span>
          </summary>
          <p class="mt-2.5 text-xs text-muted-foreground leading-relaxed">
            No. Your privacy is paramount. Uploaded images are rendered directly onto an in-memory HTML5 canvas element for optical trait measurement and discarded. No images are saved to any permanent disk, database, or third party.
          </p>
        </details>

        <!-- Q3 -->
        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-foreground list-none">
            <span>How does Google Fonts verification work?</span>
            <span class="transition-transform group-open:rotate-180 text-muted-foreground">&darr;</span>
          </summary>
          <p class="mt-2.5 text-xs text-muted-foreground leading-relaxed">
            Only fonts that match an authentic entry in our verified Google Fonts registry receive the "Google Fonts Verified" checkmark. We provide the official family name, available styles, designer credit, direct Google Fonts link, and tested CSS snippets.
          </p>
        </details>

        <!-- Q4 -->
        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-foreground list-none">
            <span>Can I identify commercial fonts like Helvetica or Futura?</span>
            <span class="transition-transform group-open:rotate-180 text-muted-foreground">&darr;</span>
          </summary>
          <p class="mt-2.5 text-xs text-muted-foreground leading-relaxed">
            Yes! If your image contains a commercial font like Helvetica, Futura, Gotham, or Didot, the tool identifies the typography characteristics and provides the closest 100% free open-source Google Font alternative (e.g. Inter for Helvetica, Montserrat for Futura, EB Garamond for Adobe Garamond).
          </p>
        </details>

        <!-- Q5 -->
        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-foreground list-none">
            <span>How can I get the best identification accuracy?</span>
            <span class="transition-transform group-open:rotate-180 text-muted-foreground">&darr;</span>
          </summary>
          <p class="mt-2.5 text-xs text-muted-foreground leading-relaxed">
            Crop tightly around 1-3 words of horizontal, undistorted text. Ensure adequate contrast between letters and background. Lowercase letters provide richer typographic fingerprints (x-height and apertures) than all-caps headings.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 sm:py-20 border-t border-border bg-foreground text-background px-4 sm:px-6 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
        Ready to identify your font?
      </h2>
      <p class="mt-3 text-sm text-background/80">
        Drop a screenshot into the finder and get your verified Google Fonts CSS snippet in seconds.
      </p>
      <div class="mt-6">
        <a
          href="#finder"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-background text-foreground font-semibold text-sm hover:opacity-95 transition-opacity shadow-sm"
        >
          Jump to Font Finder
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
