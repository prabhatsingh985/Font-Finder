---
import BaseLayout from '../layouts/BaseLayout.astro';
import FontFinderApp from '../components/FontFinderApp.astro';
import FontCard from '../components/FontCard.astro';
import { VERIFIED_GOOGLE_FONTS } from '../services/googleFonts/data';

const featuredFonts = VERIFIED_GOOGLE_FONTS.slice(0, 6);
---

<BaseLayout
  title="Font Finder — Developer-First Image Font Identifier & Google Fonts Verification"
  description="Identify any font from screenshots with optical precision. Technical letterform analysis verified against authentic Google Fonts with production CSS blueprints."
>
  <!-- Hero Section with Linear Atmospheric Depth & Floor Wash -->
  <section class="relative pt-12 pb-16 sm:pt-16 sm:pb-20 px-4 sm:px-6 bg-grid-pattern-subtle hero-gradient-floor border-b border-[#23252a] overflow-hidden">
    <div class="max-w-[1200px] mx-auto text-center relative z-10">
      
      <!-- Linear Precision Status Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.03] border border-[#23252a] font-mono text-[11px] text-[#8a8f98] mb-5 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></span>
        <span class="font-normal text-[#d0d6e0]">Google Fonts Optical Matcher</span>
        <span class="text-[#62666d]">&bull;</span>
        <span class="text-[#8a8f98]">1,935 In-Browser Signatures</span>
      </div>

      <!-- Linear Display Headline (64px / 510 / tight tracking -0.022em) -->
      <h1 class="text-4xl sm:text-6xl lg:text-[64px] font-[510] tracking-[-0.022em] text-[#ffffff] leading-[1.05] max-w-4xl mx-auto">
        Identify fonts in <br class="hidden sm:inline" />
        <span class="inline-flex items-center justify-center min-w-[220px] sm:min-w-[340px] text-[#e4f222] transition-all duration-300 select-none" id="morphing-font-word" style="font-family: 'Playfair Display', serif; font-style: italic; color: #e4f222;">
          Playfair Display
        </span>
      </h1>

      <p class="mt-4 text-[15px] sm:text-[16px] text-[#8a8f98] max-w-lg mx-auto leading-relaxed font-normal">
        Drop any screenshot to isolate letterforms, calculate optical contours, and get verified open-source Google Fonts.
      </p>

      <!-- Live CSS snippet tag (Berkeley / JetBrains Mono) -->
      <div class="mt-3.5 flex items-center justify-center">
        <span class="px-3 py-1 rounded-[6px] bg-[#0f1011] border border-[#23252a] font-mono text-[11px] text-[#8a8f98] transition-all shadow-sm" id="morphing-font-css">
          font-family: 'Playfair Display', serif;
        </span>
      </div>
    </div>

    <!-- Core Font Finder Tool (Product UI as Hero Showcase) -->
    <div class="mt-8 sm:mt-11 relative z-10">
      <FontFinderApp />
    </div>
  </section>

  <!-- Live Font Cycler Script -->
  <script is:inline>
    (function () {
      const fonts = [
        { name: 'Playfair Display', style: "font-family: 'Playfair Display', serif; font-style: italic; color: #e4f222;", css: "font-family: 'Playfair Display', serif;" },
        { name: 'JetBrains Mono', style: "font-family: 'JetBrains Mono', monospace; font-weight: 500; color: #e4f222;", css: "font-family: 'JetBrains Mono', monospace;" },
        { name: 'Bebas Neue', style: "font-family: 'Bebas Neue', sans-serif; letter-spacing: 2px; color: #e4f222;", css: "font-family: 'Bebas Neue', cursive;" },
        { name: 'Syne', style: "font-family: 'Syne', sans-serif; font-weight: 700; color: #e4f222;", css: "font-family: 'Syne', sans-serif;" },
        { name: 'Cinzel', style: "font-family: 'Cinzel', serif; font-weight: 600; color: #e4f222;", css: "font-family: 'Cinzel', serif;" },
        { name: 'Inter', style: "font-family: 'Inter', sans-serif; font-weight: 600; color: #e4f222;", css: "font-family: 'Inter', sans-serif;" }
      ];

      let idx = 0;
      const wordEl = document.getElementById('morphing-font-word');
      const cssEl = document.getElementById('morphing-font-css');

      if (wordEl && cssEl) {
        setInterval(() => {
          idx = (idx + 1) % fonts.length;
          const f = fonts[idx];
          
          wordEl.style.opacity = '0';
          wordEl.style.transform = 'translateY(4px)';
          
          setTimeout(() => {
            wordEl.textContent = f.name;
            wordEl.setAttribute('style', f.style);
            cssEl.textContent = f.css;
            
            wordEl.style.opacity = '1';
            wordEl.style.transform = 'translateY(0)';
            wordEl.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          }, 150);
        }, 2500);
      }
    })();
  </script>

  <!-- Linear Logo Bar: Developer Ecosystem Strip -->
  <section class="border-b border-[#23252a] py-7 px-4 sm:px-6 bg-[#08090a]">
    <div class="max-w-[1200px] mx-auto flex flex-wrap items-center justify-center gap-8 sm:gap-14 text-[#8a8f98] font-mono text-[12px]">
      <span class="text-[#62666d] uppercase tracking-wider text-[10px]">VERIFIED ECOSYSTEM:</span>
      <span class="hover:text-[#d0d6e0] transition-colors">Google Fonts</span>
      <span class="hover:text-[#d0d6e0] transition-colors">SIL Open Font License</span>
      <span class="hover:text-[#d0d6e0] transition-colors">W3C Web Fonts</span>
      <span class="hover:text-[#d0d6e0] transition-colors">HTML5 Canvas WebGL</span>
      <span class="hover:text-[#d0d6e0] transition-colors">Client In-Memory OCR</span>
    </div>
  </section>

  <!-- Section: Three-step Workflow (Section gap: 96px) -->
  <section class="py-20 sm:py-24 max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98]">HOW IT WORKS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-[510] tracking-[-0.022em] text-[#ffffff]">
        Three-step recognition pipeline
      </h2>
      <p class="text-[13px] sm:text-[14px] text-[#8a8f98] mt-1 font-normal">From bitmap image to production-ready open-source typography.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
      <!-- Step 1 -->
      <div class="rounded-[12px] border border-[#23252a] bg-[#0f1011] p-6 text-left flex flex-col justify-between hover:border-[#383b3f] transition-colors shadow-sm">
        <div>
          <span class="font-mono text-[11px] text-[#d0d6e0] bg-white/[0.05] px-2 py-0.5 rounded-[4px] border border-[#23252a]">Step 01</span>
          <h3 class="font-[510] text-[15px] sm:text-[16px] text-[#ffffff] mt-3 tracking-[-0.011em]">Upload or Paste</h3>
          <p class="text-[13px] text-[#8a8f98] mt-2 leading-relaxed">
            Drop an image or paste with <kbd class="font-mono text-[10px] bg-[#161718] border border-[#23252a] px-1.5 py-0.5 rounded text-[#d0d6e0]">⌘V</kbd>. Crop around the wordmark to isolate glyph contours.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="rounded-[12px] border border-[#23252a] bg-[#0f1011] p-6 text-left flex flex-col justify-between hover:border-[#383b3f] transition-colors shadow-sm">
        <div>
          <span class="font-mono text-[11px] text-[#d0d6e0] bg-white/[0.05] px-2 py-0.5 rounded-[4px] border border-[#23252a]">Step 02</span>
          <h3 class="font-[510] text-[15px] sm:text-[16px] text-[#ffffff] mt-3 tracking-[-0.011em]">Optical Scan</h3>
          <p class="text-[13px] text-[#8a8f98] mt-2 leading-relaxed">
            Extracts contrast, stroke weights, and 16×16 glyph fingerprints locally in memory. Zero server uploads.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="rounded-[12px] border border-[#23252a] bg-[#0f1011] p-6 text-left flex flex-col justify-between hover:border-[#383b3f] transition-colors shadow-sm">
        <div>
          <span class="font-mono text-[11px] text-[#d0d6e0] bg-white/[0.05] px-2 py-0.5 rounded-[4px] border border-[#23252a]">Step 03</span>
          <h3 class="font-[510] text-[15px] sm:text-[16px] text-[#ffffff] mt-3 tracking-[-0.011em]">Export Code</h3>
          <p class="text-[13px] text-[#8a8f98] mt-2 leading-relaxed">
            Get verified Google Fonts alternatives with tested <code class="font-mono text-[11px] text-[#d0d6e0]">@import</code> and <code class="font-mono text-[11px] text-[#d0d6e0]">font-family</code> CSS rules.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Engine Specifications -->
  <section class="py-20 sm:py-24 border-t border-[#23252a] bg-[#08090a]">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <div class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></div>
            <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98]">ENGINE SPECIFICATIONS</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-[510] tracking-[-0.022em] text-[#ffffff]">
            Open-source matches. <br />
            <span class="text-[#e4f222]">Production ready.</span>
          </h2>
          <p class="text-[13px] sm:text-[14px] text-[#8a8f98] mt-2.5 leading-relaxed font-normal">
            Avoid commercial license traps. Font Finder maps bitmap letterforms to authentic, free-to-use Google Fonts alternatives.
          </p>

          <div class="mt-6 space-y-2.5 font-mono text-[12px]">
            <div class="p-3.5 rounded-[6px] bg-[#0f1011] border border-[#23252a] flex items-center justify-between">
              <span class="text-[#8a8f98]">Licensing Model</span>
              <span class="text-[#ffffff] font-normal">100% Free SIL Open Font License</span>
            </div>
            <div class="p-3.5 rounded-[6px] bg-[#0f1011] border border-[#23252a] flex items-center justify-between">
              <span class="text-[#8a8f98]">Processing Architecture</span>
              <span class="text-[#ffffff] font-normal">100% Client-Side WebGL / Canvas</span>
            </div>
            <div class="p-3.5 rounded-[6px] bg-[#0f1011] border border-[#23252a] flex items-center justify-between">
              <span class="text-[#8a8f98]">CDN Integration</span>
              <span class="text-[#ffffff] font-normal">Direct Google Fonts Embeds</span>
            </div>
          </div>
        </div>

        <!-- Clean Linear Code Window: 12px radius, graphite hairline border, Berkeley/JetBrains Mono -->
        <div class="rounded-[12px] border border-[#23252a] bg-[#0f1011] overflow-hidden shadow-sm">
          <div class="h-9 px-3.5 bg-[#161718] border-b border-[#23252a] flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
              <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
              <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
              <span class="font-mono text-[11px] text-[#8a8f98] ml-2">specimenPayload.json</span>
            </div>
            <span class="font-mono text-[10px] text-[#62666d]">JSON Output</span>
          </div>
          <pre class="p-4 font-mono text-[12px] text-[#d0d6e0] overflow-x-auto leading-relaxed"><code>&#123;
  <span class="text-[#8a8f98]">"matched_font"</span>: <span class="text-[#ffffff]">"Inter"</span>,
  <span class="text-[#8a8f98]">"category"</span>: <span class="text-[#ffffff]">"sans-serif"</span>,
  <span class="text-[#8a8f98]">"confidence"</span>: <span class="text-[#e4f222]">"94%"</span>,
  <span class="text-[#8a8f98]">"isGoogleFontsVerified"</span>: <span class="text-[#27a644]">true</span>,
  <span class="text-[#8a8f98]">"license"</span>: <span class="text-[#ffffff]">"SIL Open Font License"</span>,
  <span class="text-[#8a8f98]">"css"</span>: &#123;
    <span class="text-[#8a8f98]">"import"</span>: <span class="text-[#ffffff]">"@import url('https://fonts.googleapis.com/...');"</span>,
    <span class="text-[#8a8f98]">"fontFamily"</span>: <span class="text-[#ffffff]">"font-family: 'Inter', sans-serif;"</span>
  &#125;
&#125;</code></pre>
        </div>
      </div>

    </div>
  </section>

  <!-- Section: Popular Typefaces Catalog -->
  <section class="py-20 sm:py-24 max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <div class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98]">VERIFIED REPOSITORY</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-[510] tracking-[-0.022em] text-[#ffffff]">
          Popular open-source typefaces
        </h2>
        <p class="text-[13px] text-[#8a8f98] mt-1 font-normal">Ready to browse, test, and copy for your projects.</p>
      </div>
      <a
        href="/fonts"
        class="font-normal text-[13px] text-[#d0d6e0] hover:text-[#ffffff] inline-flex items-center gap-1 transition-colors"
      >
        <span>View all verified fonts</span> &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredFonts.map((font) => <FontCard font={font} />)}
    </div>
  </section>

  <!-- Section: Frequently Asked Questions -->
  <section class="py-20 sm:py-24 border-t border-[#23252a] bg-[#08090a]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-2 mb-2 justify-center">
        <div class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98]">FAQ</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-[510] tracking-[-0.022em] text-[#ffffff] text-center mb-8">
        Frequently Asked Questions
      </h2>

      <div class="divide-y divide-[#23252a] border-y border-[#23252a] bg-[#0f1011] rounded-[12px] px-5 sm:px-6">
        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-[14px] font-[510] text-[#ffffff] list-none">
            <span>Is Font Finder completely free?</span>
            <span class="text-[12px] font-mono text-[#8a8f98] transition-transform group-open:rotate-180">&darr;</span>
          </summary>
          <p class="mt-2 text-[13px] text-[#8a8f98] leading-relaxed">
            Yes, 100% free with unlimited scans. No credit card, subscription, or account required. All fonts found are free for personal and commercial use under the SIL Open Font License.
          </p>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-[14px] font-[510] text-[#ffffff] list-none">
            <span>Are my uploaded images or screenshots saved?</span>
            <span class="text-[12px] font-mono text-[#8a8f98] transition-transform group-open:rotate-180">&darr;</span>
          </summary>
          <p class="mt-2 text-[13px] text-[#8a8f98] leading-relaxed">
            No. Uploaded images are processed entirely inside your browser's memory using HTML5 canvas. No files ever leave your device or get saved to any server.
          </p>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-[14px] font-[510] text-[#ffffff] list-none">
            <span>How does Google Fonts verification work?</span>
            <span class="text-[12px] font-mono text-[#8a8f98] transition-transform group-open:rotate-180">&darr;</span>
          </summary>
          <p class="mt-2 text-[13px] text-[#8a8f98] leading-relaxed">
            Every match is verified against authentic Google Fonts database entries. You get the official font family name, direct Google Fonts page URL, and tested CSS embed codes.
          </p>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between cursor-pointer text-[14px] font-[510] text-[#ffffff] list-none">
            <span>Can I identify commercial fonts like Helvetica or Futura?</span>
            <span class="text-[12px] font-mono text-[#8a8f98] transition-transform group-open:rotate-180">&darr;</span>
          </summary>
          <p class="mt-2 text-[13px] text-[#8a8f98] leading-relaxed">
            Yes. If an image uses a paid commercial font, Font Finder matches its letterform traits to the closest 100% free Google Fonts alternative (e.g. Inter for Helvetica, Montserrat for Futura).
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA: Linear Precision Action Block -->
  <section class="py-20 sm:py-24 max-w-[1200px] mx-auto px-4 sm:px-6 text-center">
    <div class="rounded-[12px] border border-[#23252a] bg-[#0f1011] p-8 sm:p-12 shadow-sm">
      <h2 class="text-xl sm:text-2xl font-[510] tracking-[-0.022em] text-[#ffffff]">
        Ready to identify a font?
      </h2>
      <p class="mt-2 text-[13px] sm:text-[14px] text-[#8a8f98] max-w-md mx-auto">
        Drop an image above or test with sample fonts to get instant CSS blueprints.
      </p>
      <div class="mt-6">
        <a
          href="#finder"
          class="btn-acid-lime"
        >
          Identify Font Now &uarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
