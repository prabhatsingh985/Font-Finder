---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontCard from '../../components/FontCard.astro';
import { VERIFIED_GOOGLE_FONTS } from '../../services/googleFonts/data';

const categories = ['all', 'sans-serif', 'serif', 'display', 'monospace', 'handwriting'];
const initialFonts = VERIFIED_GOOGLE_FONTS.slice(0, 9);
---

<BaseLayout
  title="Browse Verified Google Fonts — Developer-First Typography Directory"
  description="Explore our complete directory of verified Google Fonts. Filter by category, test with custom specimen text, and copy ready-to-use CSS declarations."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Header -->
    <div class="max-w-2xl">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98]">TYPEFACE DIRECTORY</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-[510] text-[#ffffff] tracking-[-0.022em]">
        Verified Google Fonts
      </h1>
      <p class="mt-2.5 text-[14px] text-[#8a8f98] leading-relaxed">
        Browse open-source typefaces with tested CSS declarations, available weights, and commercial alternatives. All fonts are free under SIL Open Font License.
      </p>
    </div>

    <!-- Search & Filter Controls -->
    <div class="mt-8 p-3.5 sm:p-4 rounded-[12px] border border-[#23252a] bg-[#0f1011] shadow-sm flex flex-col md:flex-row gap-4 items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full md:w-80">
        <input
          id="font-search"
          type="text"
          placeholder="Search fonts by family or designer..."
          class="w-full pl-9 pr-4 py-2 rounded-[6px] border border-[#23252a] bg-[#161718] text-xs font-mono text-[#ffffff] focus:outline-none focus:border-[#d0d6e0] placeholder:text-[#62666d]"
        />
        <svg class="w-4 h-4 text-[#8a8f98] absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Category Filter Tabs (Pills) -->
      <div class="flex flex-wrap gap-1.5 w-full md:w-auto" id="category-tabs">
        {categories.map((cat) => (
          <button
            type="button"
            data-cat={cat}
            class={`cat-tab px-3 py-1.5 rounded-[6px] font-mono text-[12px] transition-colors cursor-pointer capitalize ${
              cat === 'all'
                ? 'bg-[#ffffff] text-[#08090a] font-[510]'
                : 'bg-[#161718] text-[#8a8f98] border border-[#23252a] hover:text-[#ffffff] hover:bg-[#23252a]'
            }`}
          >
            {cat.replace('-', ' ')}
          </button>
        ))}
      </div>
    </div>

    <!-- Specimen Adjuster Bar -->
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 font-mono text-[12px] text-[#8a8f98] px-1">
      <div class="flex items-center gap-2">
        <span>Specimen text:</span>
        <input
          id="global-specimen-text"
          type="text"
          value="Almost before we knew it, we had left the ground."
          class="px-3 py-1 rounded-[6px] border border-[#23252a] bg-[#161718] text-[#ffffff] text-[12px] w-64 sm:w-96 focus:outline-none focus:border-[#d0d6e0]"
        />
      </div>
      <span id="font-count-label" class="text-[11px]">Showing {initialFonts.length} verified fonts</span>
    </div>

    <!-- Fonts Grid -->
    <div id="fonts-grid" class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {initialFonts.map((font) => (
        <div class="font-item" data-family={font.family.toLowerCase()} data-designer={font.designer.toLowerCase()} data-cat={font.category}>
          <FontCard font={font} />
        </div>
      ))}
    </div>

    <!-- Show More Controls -->
    <div class="mt-12 text-center">
      <button
        id="btn-show-more"
        type="button"
        class="btn-ghost-linear font-mono text-[12px] px-7 py-3 rounded-[6px] inline-flex items-center gap-2"
      >
        <span>Show More Fonts (+9)</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <p id="all-loaded-note" class="hidden text-xs text-[#8a8f98] font-mono mt-4">
        &check; All available fonts displayed
      </p>
    </div>

    <div id="no-results" class="hidden py-16 text-center text-[#8a8f98] font-mono text-xs">
      No verified fonts match your search query. Try "Inter", "Roboto", or "Sans".
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('font-search');
    const tabs = document.querySelectorAll('.cat-tab');
    const grid = document.getElementById('fonts-grid');
    const noResults = document.getElementById('no-results');
    const countLabel = document.getElementById('font-count-label');
    const globalSpecimenInput = document.getElementById('global-specimen-text');
    const btnShowMore = document.getElementById('btn-show-more');
    const allLoadedNote = document.getElementById('all-loaded-note');

    let allFontsCatalog = [];
    let filteredFonts = [];
    let visibleCount = 9;
    const PAGE_SIZE = 9;

    let activeCategory = 'all';
    let searchQuery = '';

    // Fetch complete catalog of 1,946 Google Fonts
    fetch('/data/google-fonts-catalog.json')
      .then((res) => res.json())
      .then((data) => {
        if (Array.isArray(data) && data.length > 0) {
          allFontsCatalog = data;
          applyFilterAndRender();
        }
      })
      .catch((err) => {
        console.warn('Could not load full catalog, using static set', err);
      });

    function getFilteredList() {
      if (!allFontsCatalog || allFontsCatalog.length === 0) return [];
      return allFontsCatalog.filter((font) => {
        const family = (font.family || '').toLowerCase();
        const designers = Array.isArray(font.designers) ? font.designers.join(' ').toLowerCase() : (font.designer || '').toLowerCase();
        const cat = font.category || '';

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesSearch = !searchQuery || family.includes(searchQuery) || designers.includes(searchQuery);

        return matchesCat && matchesSearch;
      });
    }

    function createCardElement(font) {
      const div = document.createElement('div');
      div.className = 'font-item group rounded-[12px] border border-[#23252a] bg-[#0f1011] p-6 transition-all hover:bg-[#161718] hover:border-[#383b3f] shadow-sm flex flex-col justify-between';
      div.setAttribute('data-family', (font.family || '').toLowerCase());
      const designers = Array.isArray(font.designers) ? font.designers.join(', ') : (font.designer || 'Google Fonts');
      div.setAttribute('data-designer', designers.toLowerCase());
      div.setAttribute('data-cat', font.category || 'sans-serif');

      const encodedFamily = encodeURIComponent(font.family).replace(/%20/g, '+');
      const fontId = font.id || font.family.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const inspectUrl = `/fonts/${fontId}`;
      const weightsCount = Array.isArray(font.weights) ? font.weights.length : (Array.isArray(font.variants) ? font.variants.length : 1);
      const activeSpecimen = globalSpecimenInput ? globalSpecimenInput.value : 'Almost before we knew it, we had left the ground.';

      div.innerHTML = `
        <div>
          <div class="flex items-start justify-between gap-2 mb-3">
            <div>
              <h3 class="font-[510] text-[16px] text-[#ffffff] tracking-[-0.012em] transition-colors">
                <a href="${inspectUrl}">${font.family}</a>
              </h3>
              <p class="text-[12px] text-[#8a8f98] mt-0.5 font-normal">
                ${designers} &bull; <span class="capitalize">${font.category || 'sans-serif'}</span>
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-mono px-2 py-0.5 rounded-[4px] bg-white/[0.04] text-[#8a8f98] border border-[#23252a] shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-[#27a644]"></span>
              <span>Verified</span>
            </span>
          </div>

          <div class="my-4 p-3.5 rounded-[6px] bg-[#161718] border border-[#23252a] overflow-hidden">
            <p
              class="specimen-text text-xl text-[#ffffff] truncate select-all"
              style="font-family: '${font.family}', ${font.category || 'sans-serif'};"
            >
              ${activeSpecimen}
            </p>
          </div>

          <p class="text-[13px] text-[#8a8f98] line-clamp-2 leading-relaxed">
            ${font.description || `${font.family} is a verified open-source Google Font family available for free personal and commercial projects.`}
          </p>
        </div>

        <div class="mt-5 pt-4 border-t border-[#23252a] flex items-center justify-between font-mono text-[12px]">
          <span class="text-[#62666d]">
            ${weightsCount} style${weightsCount > 1 ? 's' : ''} ${font.variable ? '• Variable' : ''}
          </span>
          <a
            href="${inspectUrl}"
            class="font-normal text-[#d0d6e0] hover:text-[#ffffff] transition-colors inline-flex items-center gap-1"
          >
            Inspect &rarr;
          </a>
        </div>
      `;
      return div;
    }

    function preloadVisibleFonts(fontsToLoad) {
      if (!fontsToLoad || fontsToLoad.length === 0) return;
      const families = fontsToLoad.map(f => encodeURIComponent(f.family).replace(/%20/g, '+'));
      const linkId = 'dynamic-catalog-fonts';
      let link = document.getElementById(linkId);
      if (!link) {
        link = document.createElement('link');
        link.id = linkId;
        link.rel = 'stylesheet';
        document.head.appendChild(link);
      }
      link.href = `https://fonts.googleapis.com/css2?family=${families.join('&family=')}&display=swap`;
    }

    function applyFilterAndRender() {
      filteredFonts = getFilteredList();
      grid.innerHTML = '';

      if (filteredFonts.length === 0) {
        noResults.classList.remove('hidden');
        btnShowMore.classList.add('hidden');
        allLoadedNote.classList.add('hidden');
        countLabel.textContent = `Showing 0 fonts`;
        return;
      }

      noResults.classList.add('hidden');
      const batch = filteredFonts.slice(0, visibleCount);
      preloadVisibleFonts(batch);

      batch.forEach((font) => {
        grid.appendChild(createCardElement(font));
      });

      countLabel.textContent = `Showing ${batch.length} of ${filteredFonts.length.toLocaleString()} fonts`;

      if (batch.length >= filteredFonts.length) {
        btnShowMore.classList.add('hidden');
        allLoadedNote.classList.remove('hidden');
      } else {
        btnShowMore.classList.remove('hidden');
        allLoadedNote.classList.add('hidden');
      }
    }

    // Category Tabs click
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('bg-[#ffffff]', 'text-[#08090a]', 'font-[510]');
          t.classList.add('bg-[#161718]', 'text-[#8a8f98]', 'border', 'border-[#23252a]');
        });
        tab.classList.remove('bg-[#161718]', 'text-[#8a8f98]', 'border', 'border-[#23252a]');
        tab.classList.add('bg-[#ffffff]', 'text-[#08090a]', 'font-[510]');

        activeCategory = tab.getAttribute('data-cat') || 'all';
        visibleCount = PAGE_SIZE;
        applyFilterAndRender();
      });
    });

    // Real-time search with debounce
    let debounceTimer;
    searchInput.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        searchQuery = (e.target.value || '').trim().toLowerCase();
        visibleCount = PAGE_SIZE;
        applyFilterAndRender();
      }, 250);
    });

    // Global specimen preview live update
    if (globalSpecimenInput) {
      globalSpecimenInput.addEventListener('input', (e) => {
        const text = e.target.value || 'Almost before we knew it, we had left the ground.';
        document.querySelectorAll('.specimen-text').forEach((el) => {
          el.textContent = text;
        });
      });
    }

    // Show more fonts button
    btnShowMore.addEventListener('click', () => {
      visibleCount += PAGE_SIZE;
      applyFilterAndRender();
    });
  })();
</script>
