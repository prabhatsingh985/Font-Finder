---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontCard from '../../components/FontCard.astro';
import { VERIFIED_GOOGLE_FONTS } from '../../services/googleFonts/data';

const categories = ['all', 'sans-serif', 'serif', 'display', 'monospace', 'handwriting'];
---

<BaseLayout
  title="Browse Verified Google Fonts — Developer-First Typography Directory"
  description="Explore our curated directory of verified Google Fonts. Filter by category, test with custom specimen text, and copy ready-to-use CSS declarations."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Header -->
    <div class="max-w-2xl">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">01 / DIRECTORY</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] tracking-tight">
        Verified Google Fonts
      </h1>
      <p class="mt-3 text-sm text-[#727272] leading-relaxed">
        Browse open-source typefaces with tested CSS declarations, available weights, and commercial alternatives. All fonts are free under SIL Open Font License.
      </p>
    </div>

    <!-- Search & Filter Controls (Firecrawl Pill container) -->
    <div class="mt-8 p-4 rounded-2xl border border-[#e5e7eb] bg-white shadow-[0_0_0_6px_rgb(249,249,249)] flex flex-col md:flex-row gap-4 items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full md:w-80">
        <input
          id="font-search"
          type="text"
          placeholder="Search fonts by family or designer..."
          class="w-full pl-9 pr-4 py-2 rounded-full border border-[#e5e7eb] bg-[#f9f9f9] text-xs font-mono text-[#262626] focus:outline-none focus:border-[#ff4d00] placeholder:text-[#c7c7c7]"
        />
        <svg class="w-4 h-4 text-[#727272] absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Category Filter Tabs (Pills) -->
      <div class="flex flex-wrap gap-1.5 w-full md:w-auto" id="category-tabs">
        {categories.map((cat) => (
          <button
            type="button"
            data-cat={cat}
            class={`cat-tab px-3 py-1.5 rounded-full font-mono text-xs transition-colors cursor-pointer capitalize ${
              cat === 'all'
                ? 'bg-[#262626] text-white font-medium'
                : 'bg-[#f9f9f9] text-[#727272] border border-[#e5e7eb] hover:text-[#262626] hover:bg-[#e5e7eb]'
            }`}
          >
            {cat.replace('-', ' ')}
          </button>
        ))}
      </div>
    </div>

    <!-- Specimen Adjuster Bar -->
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 font-mono text-xs text-[#727272] px-1">
      <div class="flex items-center gap-2">
        <span>Specimen text:</span>
        <input
          id="global-specimen-text"
          type="text"
          value="Almost before we knew it, we had left the ground."
          class="px-3 py-1 rounded-full border border-[#e5e7eb] bg-white text-[#262626] text-xs w-64 sm:w-96 focus:outline-none focus:border-[#ff4d00]"
        />
      </div>
      <span id="font-count-label" class="text-[11px]">Showing {VERIFIED_GOOGLE_FONTS.length} verified fonts</span>
    </div>

    <!-- Fonts Grid -->
    <div id="fonts-grid" class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {VERIFIED_GOOGLE_FONTS.map((font) => (
        <div class="font-item" data-family={font.family.toLowerCase()} data-designer={font.designer.toLowerCase()} data-cat={font.category}>
          <FontCard font={font} />
        </div>
      ))}
    </div>

    <div id="no-results" class="hidden py-16 text-center text-[#727272] font-mono text-xs">
      No verified fonts match your search query. Try "Inter", "Roboto", or "Sans".
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('font-search');
    const tabs = document.querySelectorAll('.cat-tab');
    const fontItems = document.querySelectorAll('.font-item');
    const noResults = document.getElementById('no-results');
    const countLabel = document.getElementById('font-count-label');
    const globalSpecimenInput = document.getElementById('global-specimen-text');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterFonts() {
      let visibleCount = 0;
      fontItems.forEach((item) => {
        const family = item.getAttribute('data-family') || '';
        const designer = item.getAttribute('data-designer') || '';
        const cat = item.getAttribute('data-cat') || '';

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesSearch = !searchQuery || family.includes(searchQuery) || designer.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      countLabel.textContent = `Showing ${visibleCount} verified fonts`;
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      filterFonts();
    });

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('bg-[#262626]', 'text-white', 'font-medium');
          t.classList.add('bg-[#f9f9f9]', 'text-[#727272]', 'border', 'border-[#e5e7eb]');
        });
        tab.classList.remove('bg-[#f9f9f9]', 'text-[#727272]', 'border', 'border-[#e5e7eb]');
        tab.classList.add('bg-[#262626]', 'text-white', 'font-medium');

        activeCategory = tab.getAttribute('data-cat') || 'all';
        filterFonts();
      });
    });

    globalSpecimenInput.addEventListener('input', (e) => {
      const val = e.target.value || 'Almost before we knew it, we had left the ground.';
      document.querySelectorAll('.font-item p.truncate').forEach((p) => {
        p.textContent = val;
      });
    });
  })();
</script>
