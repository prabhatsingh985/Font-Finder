---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontCard from '../../components/FontCard.astro';
import { VERIFIED_GOOGLE_FONTS } from '../../services/googleFonts/data';

const categories = ['all', 'sans-serif', 'serif', 'display', 'monospace', 'handwriting'];
---

<BaseLayout
  title="Browse Verified Google Fonts — Free Open Source Typography Library"
  description="Explore our curated directory of verified Google Fonts. Search by category, test with custom specimen text, and copy ready-to-use CSS declarations."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-muted border border-border text-xs font-medium text-muted-foreground mb-4">
        <span>Verified Registry &bull; SIL Open Font License</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight">
        Verified Google Fonts
      </h1>
      <p class="mt-3 text-sm sm:text-base text-muted-foreground leading-relaxed">
        Browse open-source typefaces with tested CSS declarations, weights, and commercial alternatives. All fonts are free for personal and commercial design projects.
      </p>
    </div>

    <!-- Search & Filter Controls -->
    <div class="mt-8 p-4 rounded-xl border border-border bg-card shadow-subtle flex flex-col md:flex-row gap-4 items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full md:w-80">
        <input
          id="font-search"
          type="text"
          placeholder="Search fonts by name, designer..."
          class="w-full pl-9 pr-4 py-2 rounded-lg border border-border bg-background text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-foreground placeholder:text-muted-foreground"
        />
        <svg class="w-4 h-4 text-muted-foreground absolute left-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-1.5 w-full md:w-auto" id="category-tabs">
        {categories.map((cat) => (
          <button
            type="button"
            data-cat={cat}
            class={`cat-tab px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer capitalize ${
              cat === 'all'
                ? 'bg-foreground text-background font-semibold'
                : 'bg-muted/60 text-muted-foreground hover:text-foreground hover:bg-muted'
            }`}
          >
            {cat.replace('-', ' ')}
          </button>
        ))}
      </div>
    </div>

    <!-- Global Preview Text Adjuster -->
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-muted-foreground px-1">
      <div class="flex items-center gap-2">
        <span>Preview specimen:</span>
        <input
          id="global-specimen-text"
          type="text"
          value="Almost before we knew it, we had left the ground."
          class="px-2.5 py-1 rounded border border-border bg-background text-foreground text-xs w-64 sm:w-96 focus:outline-none focus:ring-1 focus:ring-foreground"
        />
      </div>
      <span id="font-count-label" class="font-mono text-[11px]">Showing {VERIFIED_GOOGLE_FONTS.length} verified fonts</span>
    </div>

    <!-- Fonts Grid -->
    <div id="fonts-grid" class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {VERIFIED_GOOGLE_FONTS.map((font) => (
        <div class="font-item" data-family={font.family.toLowerCase()} data-designer={font.designer.toLowerCase()} data-cat={font.category}>
          <FontCard font={font} />
        </div>
      ))}
    </div>

    <div id="no-results" class="hidden py-16 text-center text-muted-foreground text-sm">
      No verified fonts match your search query. Try searching for "Inter", "Sans", or "Serif".
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('font-search');
    const tabs = document.querySelectorAll('.cat-tab');
    const fontItems = document.querySelectorAll('.font-item');
    const noResults = document.getElementById('no-results');
    const countLabel = document.getElementById('font-count-label');
    const globalSpecimenInput = document.getElementById('global-specimen-text');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterFonts() {
      let visibleCount = 0;
      fontItems.forEach((item) => {
        const family = item.getAttribute('data-family') || '';
        const designer = item.getAttribute('data-designer') || '';
        const cat = item.getAttribute('data-cat') || '';

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesSearch = !searchQuery || family.includes(searchQuery) || designer.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      countLabel.textContent = `Showing ${visibleCount} verified fonts`;
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      filterFonts();
    });

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('bg-foreground', 'text-background', 'font-semibold');
          t.classList.add('bg-muted/60', 'text-muted-foreground');
        });
        tab.classList.remove('bg-muted/60', 'text-muted-foreground');
        tab.classList.add('bg-foreground', 'text-background', 'font-semibold');

        activeCategory = tab.getAttribute('data-cat') || 'all';
        filterFonts();
      });
    });

    // Sync global specimen text across all specimen cards
    globalSpecimenInput.addEventListener('input', (e) => {
      const val = e.target.value || 'Almost before we knew it, we had left the ground.';
      document.querySelectorAll('.font-item p.truncate').forEach((p) => {
        p.textContent = val;
      });
    });
  })();
</script>
