---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllFontsMap, getAllStaticFontPaths } from '../../services/googleFonts/fontCatalog';
import type { FontFamily } from '../../types/font';

export async function getStaticPaths() {
  return getAllStaticFontPaths();
}

interface Props {
  font: FontFamily;
}

const { font } = Astro.props;
const encodedFamily = encodeURIComponent(font.family).replace(/%20/g, '+');

// Alias slugs ("abhaya-libre", "abhaya libre") render the same page, so every
// variant canonicalizes to the primary id that the sitemap lists.
const canonicalPath = `/fonts/${font.id.toLowerCase()}`;

// Related fonts: alphabetical neighbours within the same category. Deterministic,
// and spreads internal links across the whole catalog instead of every page
// pointing at the same first three families.
const RELATED_COUNT = 6;
const sameCategory = [...getAllFontsMap().values()]
  .filter((f) => f.category === font.category)
  .sort((a, b) => a.family.localeCompare(b.family));
const selfIndex = sameCategory.findIndex((f) => f.id.toLowerCase() === font.id.toLowerCase());
const similarFonts: FontFamily[] = [];
for (let offset = 1; similarFonts.length < RELATED_COUNT && offset < sameCategory.length; offset++) {
  for (const idx of [selfIndex + offset, selfIndex - offset]) {
    const candidate = sameCategory[(idx + sameCategory.length) % sameCategory.length];
    if (similarFonts.length < RELATED_COUNT && candidate && !similarFonts.includes(candidate) && candidate !== sameCategory[selfIndex]) {
      similarFonts.push(candidate);
    }
  }
}

const finderTools = [
  { href: '/', label: 'Find a font from an image' },
  { href: '/tools/screenshot-font-finder', label: 'Screenshot font finder' },
  { href: '/tools/logo-font-finder', label: 'Logo font finder' },
  { href: '/tools/free-font-alternative-finder', label: 'Free font alternative finder' }
];
---

<BaseLayout
  title={`${font.family} — Free Google Font Specimen, Weights & CSS Blueprint`}
  description={`Download and use ${font.family} by ${font.designer}. Free Google Font with ${font.variants.length} styles, copy-ready CSS declarations, and recommended font pairings.`}
  canonicalUrl={canonicalPath}
  hreflang={false}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Fonts', item: '/fonts' },
    { name: font.family, item: canonicalPath }
  ]}
>
  <link
    rel="stylesheet"
    href={`https://fonts.googleapis.com/css2?family=${encodedFamily}:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,700&display=swap`}
  />

  <article class="py-12 sm:py-20 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Breadcrumb in Berkeley/JetBrains Mono -->
    <nav class="flex items-center gap-2 font-mono text-[12px] text-[#64748b] dark:text-[#8a8f98] mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Home</a>
      <span class="text-[#cbd5e1] dark:text-[#62666d]">/</span>
      <a href="/fonts" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Fonts</a>
      <span class="text-[#cbd5e1] dark:text-[#62666d]">/</span>
      <span class="text-[#08090a] dark:text-[#ffffff] font-normal">{font.family}</span>
    </nav>

    <!-- Header Section -->
    <div class="flex flex-wrap items-start justify-between gap-6 pb-8 border-b border-[#e2e4e8] dark:border-[#23252a]">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl sm:text-5xl font-[510] tracking-[-0.022em] text-[#08090a] dark:text-[#ffffff]">
            {font.family}
          </h1>
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] px-2.5 py-0.5 rounded-[4px] bg-[#f1f3f6] dark:bg-white/[0.04] text-[#475569] dark:text-[#8a8f98] border border-[#e2e4e8] dark:border-[#23252a]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a] dark:bg-[#27a644]"></span>
            <span>Google Fonts Verified</span>
          </span>
        </div>
        <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] mt-2 font-normal">
          Designed by <span class="text-[#08090a] dark:text-[#ffffff] font-normal">{font.designer}</span> &bull; <span class="capitalize">{font.category}</span> &bull; SIL Open Font License (OFL)
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={font.googleFontsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-acid-lime"
        >
          <span>Open on Google Fonts</span>
          <svg class="w-3.5 h-3.5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Description & Typographic Traits -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00] dark:bg-[#e4f222]"></div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98]">TYPEFACE OVERVIEW</span>
        </div>
        <p class="text-[15px] text-[#334155] dark:text-[#d0d6e0] leading-relaxed">
          {font.description}
        </p>

        {font.commercialAlternativesFor && font.commercialAlternativesFor.length > 0 && (
          <div class="mt-5 p-4 rounded-[8px] bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] font-mono text-[12px] text-[#475569] dark:text-[#8a8f98]">
            <span class="font-[510] text-[#08090a] dark:text-[#ffffff]">Commercial Stand-In:</span> Often chosen as an open-source alternative to {font.commercialAlternativesFor.join(', ')}.
          </div>
        )}
      </div>

      <!-- Quick Metrics Panel -->
      <div class="p-6 rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] shadow-sm space-y-3 font-mono text-[12px]">
        <h3 class="font-[510] text-[#08090a] dark:text-[#ffffff] uppercase tracking-wider text-[11px] pb-2 border-b border-[#e2e4e8] dark:border-[#23252a]">
          OPTICAL CHARACTERISTICS
        </h3>
        <div class="flex justify-between py-1.5 border-b border-[#e2e4e8] dark:border-[#23252a]">
          <span class="text-[#64748b] dark:text-[#8a8f98]">Category</span>
          <span class="text-[#08090a] dark:text-[#ffffff] capitalize">{font.category}</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-[#e2e4e8] dark:border-[#23252a]">
          <span class="text-[#64748b] dark:text-[#8a8f98]">Serifs</span>
          <span class="text-[#08090a] dark:text-[#ffffff] capitalize">{font.typographicMetrics?.serif || 'None'}</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-[#e2e4e8] dark:border-[#23252a]">
          <span class="text-[#64748b] dark:text-[#8a8f98]">Contrast</span>
          <span class="text-[#08090a] dark:text-[#ffffff] capitalize">{font.typographicMetrics?.contrast || 'Low'}</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-[#e2e4e8] dark:border-[#23252a]">
          <span class="text-[#64748b] dark:text-[#8a8f98]">Proportions</span>
          <span class="text-[#08090a] dark:text-[#ffffff] capitalize">{font.typographicMetrics?.proportions || 'Regular'}</span>
        </div>
        <div class="flex justify-between py-1.5">
          <span class="text-[#64748b] dark:text-[#8a8f98]">Variable Font</span>
          <span class="text-[#08090a] dark:text-[#ffffff]">{font.variable ? 'Yes' : 'Static'}</span>
        </div>
      </div>
    </div>

    <!-- Interactive Specimen Playground -->
    <div class="mt-12 rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-8 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[#e2e4e8] dark:border-[#23252a]">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98]">
          INTERACTIVE SPECIMEN TESTER
        </span>
        <div class="flex items-center gap-2">
          <span class="font-mono text-[11px] text-[#64748b] dark:text-[#8a8f98]">Size:</span>
          <input
            id="page-size-slider"
            type="range"
            min="16"
            max="80"
            value="36"
            class="w-28 sm:w-36 accent-[#ff4d00] dark:accent-[#e4f222] cursor-pointer"
          />
          <span id="page-size-label" class="font-mono text-[11px] text-[#08090a] dark:text-[#ffffff] w-10">36px</span>
        </div>
      </div>

      <div class="mt-6">
        <textarea
          id="page-specimen-text"
          rows="2"
          class="w-full bg-transparent border-0 text-[#08090a] dark:text-[#ffffff] focus:ring-0 focus:outline-none resize-none leading-tight transition-all"
          style={`font-family: '${font.family}', ${font.category}; font-size: 36px;`}
        >All their equipment and instruments are alive.</textarea>
      </div>
    </div>

    <!-- Styles & Weights Showcase -->
    <div class="mt-12">
      <h2 class="text-xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] mb-4">
        Styles & Weights ({font.variants.length})
      </h2>
      <div class="divide-y divide-[#e2e4e8] dark:divide-[#23252a] border-y border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] rounded-[12px] shadow-sm px-6">
        {font.variants.map((variant) => (
          <div class="py-5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-3">
            <span class="font-mono text-[12px] text-[#64748b] dark:text-[#8a8f98] w-36 shrink-0">
              {variant.weight} {variant.style === 'italic' ? 'Italic' : 'Regular'}
            </span>
            <p
              class="text-xl sm:text-2xl text-[#08090a] dark:text-[#ffffff] truncate select-all flex-1"
              style={`font-family: '${font.family}', ${font.category}; font-weight: ${variant.weight}; font-style: ${variant.style};`}
            >
              Pack my box with five dozen liquor jugs.
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Production CSS Blueprint -->
    <div class="mt-12">
      <h2 class="text-xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] mb-4">
        Production CSS Blueprint
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- @import Code Window -->
        <div class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-[#f8f9fa] dark:bg-[#08090a] shadow-sm overflow-hidden">
          <div class="h-10 px-3.5 bg-white dark:bg-[#161718] border-b border-[#e2e4e8] dark:border-[#23252a] flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <div class="w-2 h-2 rounded-full bg-[#cbd5e1] dark:bg-[#23252a]"></div>
              <div class="w-2 h-2 rounded-full bg-[#cbd5e1] dark:bg-[#23252a]"></div>
              <div class="w-2 h-2 rounded-full bg-[#cbd5e1] dark:bg-[#23252a]"></div>
              <span class="font-mono text-[11px] text-[#64748b] dark:text-[#8a8f98] ml-2">google-fonts.css</span>
            </div>
            <button
              type="button"
              class="copy-btn font-mono text-[11px] px-2.5 py-1 rounded-[4px] bg-[#f1f3f6] dark:bg-white/[0.05] border border-[#e2e4e8] dark:border-[#23252a] hover:bg-[#e2e4e8] dark:hover:bg-white/[0.1] text-[#475569] dark:text-[#d0d6e0] hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors cursor-pointer"
              data-text={font.importUrl}
            >
              Copy
            </button>
          </div>
          <pre class="p-4 font-mono text-[12px] text-[#334155] dark:text-[#d0d6e0] overflow-x-auto leading-relaxed"><code>{font.importUrl}</code></pre>
        </div>

        <!-- font-family Code Window -->
        <div class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-[#f8f9fa] dark:bg-[#08090a] shadow-sm overflow-hidden">
          <div class="h-10 px-3.5 bg-white dark:bg-[#161718] border-b border-[#e2e4e8] dark:border-[#23252a] flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <div class="w-2 h-2 rounded-full bg-[#cbd5e1] dark:bg-[#23252a]"></div>
              <div class="w-2 h-2 rounded-full bg-[#cbd5e1] dark:bg-[#23252a]"></div>
              <div class="w-2 h-2 rounded-full bg-[#cbd5e1] dark:bg-[#23252a]"></div>
              <span class="font-mono text-[11px] text-[#64748b] dark:text-[#8a8f98] ml-2">style.css</span>
            </div>
            <button
              type="button"
              class="copy-btn font-mono text-[11px] px-2.5 py-1 rounded-[4px] bg-[#f1f3f6] dark:bg-white/[0.05] border border-[#e2e4e8] dark:border-[#23252a] hover:bg-[#e2e4e8] dark:hover:bg-white/[0.1] text-[#475569] dark:text-[#d0d6e0] hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors cursor-pointer"
              data-text={font.fontFamilyCss}
            >
              Copy
            </button>
          </div>
          <pre class="p-4 font-mono text-[12px] text-[#334155] dark:text-[#d0d6e0] overflow-x-auto leading-relaxed"><code>{font.fontFamilyCss}</code></pre>
        </div>
      </div>
    </div>

    <!-- Similar Fonts -->
    {similarFonts.length > 0 && (
      <div class="mt-16 pt-12 border-t border-[#e2e4e8] dark:border-[#23252a]">
        <h2 class="text-xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.022em] mb-6">
          Similar Verified Typefaces
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {similarFonts.map((sim) => (
            <a
              href={`/fonts/${sim.id.toLowerCase()}`}
              class="group p-5 rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] hover:bg-[#f8f9fa] dark:hover:bg-[#161718] hover:border-[#cbd5e1] dark:hover:border-[#383b3f] shadow-sm transition-all block"
            >
              <h3 class="font-[510] text-[#08090a] dark:text-[#ffffff] text-sm group-hover:text-[#ff4d00] dark:group-hover:text-[#e4f222] transition-colors">{sim.family}</h3>
              <p class="text-[12px] text-[#475569] dark:text-[#8a8f98] mt-1 line-clamp-2">{sim.description}</p>
              <div class="mt-4 flex items-center justify-between font-mono text-[11px] text-[#64748b] dark:text-[#8a8f98]">
                <span class="capitalize">{sim.category}</span>
                <span class="text-[#334155] dark:text-[#d0d6e0] group-hover:text-[#08090a] dark:group-hover:text-[#ffffff]">View Specimen &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Finder tools -->
    <nav class="mt-12 pt-8 border-t border-[#e2e4e8] dark:border-[#23252a]" aria-label="Font finder tools">
      <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] mb-3">
        Saw a typeface like {font.family} in an image? Identify it for free, right in your browser:
      </p>
      <ul class="flex flex-wrap gap-2 font-mono text-[12px]">
        {finderTools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="inline-block px-3 py-1.5 rounded-[6px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] text-[#334155] dark:text-[#d0d6e0] hover:text-[#08090a] dark:hover:text-[#ffffff] hover:border-[#cbd5e1] dark:hover:border-[#383b3f] transition-colors"
            >
              {tool.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>

  <!-- Schema.org JSON-LD for Generative AI & Rich Snippets -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": font.family,
    "headline": `${font.family} — Free Google Font Specimen, Weights & CSS Blueprint`,
    "description": font.description,
    "author": {
      "@type": "Person",
      "name": font.designer
    },
    "genre": font.category,
    "license": "https://scripts.sil.org/OFL",
    "isAccessibleForFree": true,
    "url": `https://profontfinder.com${canonicalPath}`,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Google Fonts",
      "url": "https://fonts.google.com"
    }
  })} />
</BaseLayout>

<script is:inline>
  (function () {
    const slider = document.getElementById('page-size-slider');
    const label = document.getElementById('page-size-label');
    const textarea = document.getElementById('page-specimen-text');

    if (slider && label && textarea) {
      slider.addEventListener('input', (e) => {
        const val = e.target.value;
        label.textContent = `${val}px`;
        textarea.style.fontSize = `${val}px`;
      });
    }

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-text') || '';
        try {
          await navigator.clipboard.writeText(text);
          const original = btn.innerHTML;
          btn.innerHTML = `<span class="text-[#27a644] font-normal">✓ Copied!</span>`;
          setTimeout(() => {
            btn.innerHTML = original;
          }, 2000);
        } catch (err) {
          console.error(err);
        }
      });
    });
  })();
</script>
