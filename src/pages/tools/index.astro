---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  {
    id: 'commercial-alternative',
    title: 'Find a free alternative to a paid font',
    description: 'Upload an image of a commercial typeface and get the closest free font you can legally use.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    badge: 'Popular',
    href: '/tools/commercial-alternative'
  },
  {
    id: 'url-font-finder',
    title: 'Detect fonts from any website link',
    description: 'Enter any URL to extract loaded web fonts, stylesheet @font-face declarations, and typography stacks.',
    icon: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
    badge: 'URL / Web',
    href: '/tools/url-font-finder'
  },
  {
    id: 'logo-font-finder',
    title: 'Identify the font in a logo',
    description: 'Upload a logo and find out what typeface it uses — plus free fonts that look the same.',
    icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
    badge: 'Branding',
    href: '/tools/logo-font-finder'
  },
  {
    id: 'screenshot-font-finder',
    title: 'Find the font in a screenshot',
    description: 'Screenshots are the easiest case — clean, sharp, undistorted letters are exactly what the matcher wants.',
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
    badge: 'Instant ⌘V',
    href: '/tools/screenshot-font-finder'
  },
  {
    id: 'pdf-font-finder',
    title: 'Detect the fonts in a PDF',
    description: 'Screenshot a page and identify the typeface visually — or read the embedded font names straight from the file.',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    badge: 'Documents',
    href: '/tools/pdf-font-finder'
  },
  {
    id: 'handwriting-font-finder',
    title: 'Find a handwriting or script font',
    description: 'Script fonts are the hardest to identify. Here is how to get a usable answer anyway.',
    icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z',
    badge: 'Cursive AI',
    href: '/tools/handwriting-font-finder'
  },
  {
    id: 'font-pairing',
    title: 'Find a font pairing',
    description: 'Identify one font, then get the companions that work alongside it.',
    icon: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
    badge: 'Design System',
    href: '/tools/font-pairing'
  }
];
---

<BaseLayout
  title="Font Tools — Free Typography Identification Utilities"
  description="Specialized typography utilities for finding free commercial alternatives, extracting logo fonts, pairing typefaces, and detecting document fonts."
>
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-grid-pattern-subtle border-b border-[#e5e7eb] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto">
      <!-- Header -->
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
          <span class="font-mono text-xs uppercase tracking-wider text-[#6b7280] dark:text-[#9ca3af]">TOOL SUITE</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-medium text-[#111827] dark:text-[#f3f4f6] tracking-tight">
          Font tools
        </h1>
        <p class="mt-3 text-sm sm:text-base text-[#6b7280] dark:text-[#9ca3af] leading-relaxed">
          Purpose-built typography utilities tuned for specific tasks. All free, all unlimited, running privately in your browser.
        </p>
      </div>

      <!-- 2-Column Tools Grid -->
      <div class="mt-8 sm:mt-10 grid grid-cols-1 md:grid-cols-2 gap-5">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group block p-6 sm:p-7 rounded-xl border border-[#e5e7eb] dark:border-[#222533] bg-white dark:bg-[#11131b] transition-all hover:bg-white dark:hover:bg-[#151824] hover:border-[#ff4d00]/40 dark:hover:border-[#ff4d00]/50 hover:shadow-xs relative"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2.5 mb-2.5">
                  <span class="inline-flex items-center text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-[#f3f4f6] dark:bg-[#1f2330] text-[#4b5563] dark:text-[#cbd5e1] border border-[#e5e7eb] dark:border-[#2e3446]">
                    {tool.badge}
                  </span>
                </div>
                <h2 class="text-xl sm:text-2xl font-bold text-[#111827] dark:text-[#f3f4f6] tracking-tight group-hover:text-[#ff4d00] dark:group-hover:text-[#ff4d00] transition-colors">
                  {tool.title}
                </h2>
                <p class="mt-2.5 text-sm text-[#6b7280] dark:text-[#9ca3af] leading-relaxed">
                  {tool.description}
                </p>
              </div>

              <!-- Icon Container -->
              <div class="w-11 h-11 rounded-xl bg-[#f9fafb] dark:bg-[#101217] border border-[#e5e7eb] dark:border-[#242834] flex items-center justify-center text-[#4b5563] dark:text-[#cbd5e1] group-hover:text-[#ff4d00] dark:group-hover:text-[#ff4d00] group-hover:border-[#ff4d00]/30 group-hover:bg-[#ff4d00]/5 transition-all shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={tool.icon} />
                </svg>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-[#f3f4f6] dark:border-[#242834] flex items-center justify-between text-xs font-mono text-[#6b7280] dark:text-[#9ca3af]">
              <span>100% In-Browser &bull; SIL Open License</span>
              <span class="font-medium text-[#111827] dark:text-[#f3f4f6] group-hover:text-[#ff4d00] dark:group-hover:text-[#ff4d00] inline-flex items-center gap-1 transition-colors">
                Open Tool &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Bottom Help Banner -->
      <div class="mt-14 p-8 rounded-2xl border border-[#e5e7eb] dark:border-[#242834] bg-[#f9fafb] dark:bg-[#15171e] text-center max-w-3xl mx-auto shadow-xs">
        <h3 class="text-lg font-bold text-[#111827] dark:text-[#f3f4f6]">Looking for the general font scanner?</h3>
        <p class="text-sm text-[#6b7280] dark:text-[#9ca3af] mt-1.5 max-w-lg mx-auto">
          Drop any screenshot directly into our core optical engine to match against all 1,946 Google Fonts in seconds.
        </p>
        <div class="mt-5">
          <a
            href="/#finder"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#ff4d00] text-white hover:opacity-95 text-xs font-semibold transition-all shadow-sm hover:shadow-[0_0_0_6px_#fcddcc] dark:hover:shadow-[0_0_0_6px_rgba(255,77,0,0.25)]"
          >
            <span>Identify Font Now</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
