---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
---

<BaseLayout
  title="Find the Font in a Screenshot — 1-Click Clipboard Paste & Optical Matcher"
  description="Screenshots are the easiest case — clean, sharp, undistorted letters are exactly what the matcher wants. Paste directly with ⌘V or drop an image."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Breadcrumb & Tag -->
    <div class="flex items-center gap-2 mb-3">
      <a href="/tools" class="text-xs font-mono text-[#727272] hover:text-[#ff4d00] transition-colors">Tools</a>
      <span class="text-xs text-[#d1d5db]">/</span>
      <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Screenshot Font Identifier</span>
    </div>

    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] tracking-tight">
        Find the font in a screenshot
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-[#727272] leading-relaxed">
        Screenshots provide clean, pixel-perfect, undistorted letterforms. Press <kbd class="font-mono text-xs bg-white border border-[#e5e7eb] px-1.5 py-0.5 rounded shadow-2xs text-[#111827]">⌘V</kbd> / <kbd class="font-mono text-xs bg-white border border-[#e5e7eb] px-1.5 py-0.5 rounded shadow-2xs text-[#111827]">Ctrl+V</kbd> to paste straight from your clipboard and identify any UI or web font.
      </p>
    </div>

    <!-- Core Scanner Tool -->
    <div class="mt-10">
      <FontFinderApp />
    </div>

    <!-- Screenshot Feature Guide -->
    <div class="mt-16 pt-12 border-t border-[#e5e7eb]">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">WHY SCREENSHOTS WORK BEST</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#111827] tracking-tight mb-3">
        Engineered for website & UI screenshot analysis
      </h2>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            ⌘V
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Direct Clipboard Paste</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Take a snippet using macOS Cmd+Shift+4 or Windows Snipping Tool (Win+Shift+S) and simply paste directly on this webpage.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            4K
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">HiDPI / Retina Crispness</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Our multi-resolution $128 \times 128$ contour engine exploits the high subpixel density of modern Retina displays for flawless stem analysis.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            0%
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Zero Perspective Distortion</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Unlike photos taken with a phone camera, screenshots have perfectly parallel stems and flat baselines, yielding over 95% top-match accuracy.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
