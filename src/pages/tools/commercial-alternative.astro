---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';

const commercialTwins = [
  { paid: 'Helvetica / Helvetica Neue', free: 'Inter', category: 'Sans-Serif', similarity: '98%', reason: 'Tall x-height, neutral neo-grotesque apertures, clean geometric neutrality.' },
  { paid: 'Futura / Avenir', free: 'Poppins', category: 'Geometric Sans', similarity: '96%', reason: 'Pure circular bowls in o/b/d/p, sharp geometric apex on A/M, flat terminals.' },
  { paid: 'Bodoni / Didot', free: 'Playfair Display', category: 'High-Contrast Serif', similarity: '95%', reason: 'Extreme thick-thin stroke modulation, hairline serifs, luxury editorial aesthetic.' },
  { paid: 'Proxima Nova / Gotham', free: 'Montserrat', category: 'Geometric Sans', similarity: '94%', reason: 'Urban modernist proportions, wide tracking, sturdy architectural capital letters.' },
  { paid: 'DIN / Alternate Gothic', free: 'Oswald', category: 'Condensed Display', similarity: '95%', reason: 'Compressed vertical geometry, narrow tracking, impactful industrial headlines.' },
  { paid: 'Gill Sans / Johnston', free: 'Cabin', category: 'Humanist Sans', similarity: '93%', reason: 'Humanist warmth, organic proportions, British editorial letterforms.' },
  { paid: 'Baskerville', free: 'Libre Baskerville', category: 'Transitional Serif', similarity: '97%', reason: 'Refined transitional serifs, open counterforms, high book legibility.' },
  { paid: 'ITC Garamond', free: 'Cormorant Garamond', category: 'Old-Style Serif', similarity: '96%', reason: 'Historical French Renaissance strokes, expressive calligraphic curves, sharp terminals.' }
];
---

<BaseLayout
  title="Find Free Alternatives to Paid Fonts — Open-Source Font Matcher"
  description="Upload an image of any commercial or paid typeface and get the closest free Google Font you can legally use in personal and commercial projects."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Breadcrumb & Tag -->
    <div class="flex items-center gap-2 mb-3">
      <a href="/tools" class="text-xs font-mono text-[#727272] hover:text-[#ff4d00] transition-colors">Tools</a>
      <span class="text-xs text-[#d1d5db]">/</span>
      <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Commercial Font Alternatives</span>
    </div>

    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] tracking-tight">
        Find a free alternative to a paid font
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-[#727272] leading-relaxed">
        Upload a screenshot of any proprietary commercial typeface (e.g. Helvetica, Futura, Proxima Nova, Didot) to discover the closest open-source Google Font counterpart with ready-to-use CSS.
      </p>
    </div>

    <!-- Core Scanner Tool -->
    <div class="mt-10">
      <FontFinderApp />
    </div>

    <!-- Commercial Font Replacement Matrix -->
    <div class="mt-16 pt-12 border-t border-[#e5e7eb]">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">QUICK-REFERENCE CHEATSHEET</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#111827] tracking-tight mb-3">
        Popular commercial fonts & their free Google Font twins
      </h2>
      <p class="text-sm text-[#6b7280] mb-8 max-w-2xl">
        All recommended alternatives are 100% free for commercial use under the SIL Open Font License, with full webfont CDN availability.
      </p>

      <div class="overflow-x-auto rounded-2xl border border-[#e5e7eb] bg-white shadow-xs">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-[#f9fafb] border-b border-[#e5e7eb] text-xs font-mono uppercase text-[#6b7280]">
            <tr>
              <th class="py-3.5 px-4 sm:px-6">Commercial Font (Paid)</th>
              <th class="py-3.5 px-4 sm:px-6">Free Google Font Twin</th>
              <th class="py-3.5 px-4 sm:px-6 hidden md:table-cell">Style Category</th>
              <th class="py-3.5 px-4 sm:px-6 hidden sm:table-cell">Visual Match</th>
              <th class="py-3.5 px-4 sm:px-6">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#f3f4f6]">
            {commercialTwins.map((item) => (
              <tr class="hover:bg-[#f9fafb]/80 transition-colors">
                <td class="py-4 px-4 sm:px-6 font-semibold text-[#111827]">
                  {item.paid}
                </td>
                <td class="py-4 px-4 sm:px-6">
                  <span class="font-bold text-[#ff4d00]">{item.free}</span>
                  <div class="text-[11px] text-[#6b7280] mt-0.5 md:hidden">{item.category}</div>
                </td>
                <td class="py-4 px-4 sm:px-6 text-[#6b7280] hidden md:table-cell">
                  {item.category}
                </td>
                <td class="py-4 px-4 sm:px-6 font-mono text-xs text-[#059669] font-medium hidden sm:table-cell">
                  {item.similarity}
                </td>
                <td class="py-4 px-4 sm:px-6">
                  <a
                    href={`https://fonts.google.com/specimen/${item.free.replace(/\s+/g, '+')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs font-medium text-[#262626] hover:text-[#ff4d00] transition-colors"
                  >
                    <span>Get Font</span>
                    <span>&rarr;</span>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
