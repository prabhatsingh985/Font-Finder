---

<BaseLayout
  title="Find Free Alternatives to Paid Fonts — Commercial Font Matcher"
  description="Instantly look up the closest free, open-source Google Font twin for any commercial paid font. Includes similarity scores, metrics, live specimen previews, and copyable CSS."
>
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-[#08090a] bg-grid-pattern-subtle border-b border-[#23252a] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto text-center">
      
      <!-- Breadcrumb & Badge -->
      <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-[#161718] border border-[#23252a]">
        <div class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></div>
        <a href="/tools" class="text-xs font-mono text-[#8a8f98] hover:text-[#e4f222] transition-colors">Tools</a>
        <span class="text-xs text-[#383b3f]">/</span>
        <span class="text-xs font-mono text-[#ffffff] uppercase tracking-wider">Commercial Font Twins</span>
      </div>

      <!-- Hero Header -->
      <h1 class="text-3xl sm:text-5xl font-medium text-[#ffffff] tracking-tight max-w-2xl mx-auto">
        Find a free alternative to a paid font
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#8a8f98] max-w-xl mx-auto">
        Avoid costly commercial foundry licenses. Search 50+ proprietary typefaces or upload an image to get verified 100% free Google Font twins with production CSS.
      </p>

      <!-- Mode Switcher Tabs -->
      <div class="mt-8 inline-flex p-1 rounded-full bg-[#161718] border border-[#23252a]">
        <button
          id="tab-search"
          type="button"
          class="px-5 py-1.5 rounded-full text-xs font-mono transition-all font-medium bg-[#ffffff] text-[#08090a] shadow-xs cursor-pointer"
        >
          Instant Font Search
        </button>
        <button
          id="tab-image"
          type="button"
          class="px-5 py-1.5 rounded-full text-xs font-mono transition-all text-[#8a8f98] hover:text-[#ffffff] cursor-pointer"
        >
          Upload Sample Image
        </button>
      </div>

      <!-- Mode 1: Search Font Name (Default) -->
      <div id="section-search" class="mt-8 sm:mt-12 w-full max-w-[1020px] mx-auto text-left">
        
        <!-- Search Bar with Instant Suggestions -->
        <div class="relative">
          <input
            id="commercial-input"
            type="text"
            placeholder="Type any commercial font (e.g. Helvetica, Futura, Gotham, Didot, DIN, Avenir, Circular...)"
            class="w-full pl-12 pr-4 py-4 rounded-[12px] border border-[#23252a] bg-[#0f1011] text-sm text-[#ffffff] shadow-xs focus:outline-none focus:border-[#e4f222] placeholder:text-[#62666d] transition-all font-mono"
            autocomplete="off"
          />
          <svg class="w-5 h-5 text-[#8a8f98] absolute left-4 top-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Category Filters & Popular Preset Chips -->
        <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-[11px] font-mono text-[#8a8f98] mr-1">Popular:</span>
            {['Helvetica', 'Futura', 'Gotham', 'Didot', 'DIN', 'Avenir', 'Circular', 'Garamond'].map((name) => (
              <button
                type="button"
                data-preset={name}
                class="preset-chip text-xs font-mono px-3 py-1 rounded-full border border-[#23252a] bg-[#161718] text-[#8a8f98] hover:border-[#e4f222] hover:text-[#ffffff] transition-all cursor-pointer shadow-xs"
              >
                {name}
              </button>
            ))}
          </div>

          <!-- Category Filter Pills -->
          <div id="cat-filter-container" class="flex flex-wrap items-center gap-1">
            <button type="button" data-cat="all" class="cat-pill active text-[11px] font-mono px-2.5 py-1 rounded-[4px] bg-[#ffffff] text-[#08090a] font-medium shadow-xs cursor-pointer">All</button>
            <button type="button" data-cat="Neo-Grotesque Sans" class="cat-pill text-[11px] font-mono px-2.5 py-1 rounded-[4px] bg-[#161718] text-[#8a8f98] border border-[#23252a] hover:border-[#e4f222] hover:text-[#ffffff] transition-all cursor-pointer">Grotesk</button>
            <button type="button" data-cat="Geometric Sans" class="cat-pill text-[11px] font-mono px-2.5 py-1 rounded-[4px] bg-[#161718] text-[#8a8f98] border border-[#23252a] hover:border-[#e4f222] hover:text-[#ffffff] transition-all cursor-pointer">Geometric</button>
            <button type="button" data-cat="Serif" class="cat-pill text-[11px] font-mono px-2.5 py-1 rounded-[4px] bg-[#161718] text-[#8a8f98] border border-[#23252a] hover:border-[#e4f222] hover:text-[#ffffff] transition-all cursor-pointer">Serif</button>
            <button type="button" data-cat="Display / Slab" class="cat-pill text-[11px] font-mono px-2.5 py-1 rounded-[4px] bg-[#161718] text-[#8a8f98] border border-[#23252a] hover:border-[#e4f222] hover:text-[#ffffff] transition-all cursor-pointer">Display</button>
          </div>
        </div>

        <!-- Main Showcase Card -->
        <div id="match-card" class="mt-8 p-6 sm:p-8 rounded-[12px] border border-[#23252a] bg-[#0f1011] shadow-xs space-y-6">
          
          <!-- Card Header: Commercial Font Identity vs Top Match % -->
          <div class="flex flex-wrap items-start justify-between gap-4 pb-6 border-b border-[#23252a]">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs uppercase tracking-wider text-[#8a8f98]">COMMERCIAL PROPRIETARY TYPEFACE</span>
                <span id="result-foundry" class="text-[11px] font-mono px-2 py-0.5 rounded-[4px] bg-[#161718] text-[#d0d6e0] border border-[#23252a]">
                  Linotype / Monotype
                </span>
              </div>
              <h2 id="result-paid" class="text-3xl sm:text-4xl font-bold tracking-tight text-[#ffffff] mt-2">
                Helvetica
              </h2>
              <p id="result-cat-desc" class="text-xs text-[#8a8f98] mt-1 font-mono">
                Category: Neo-Grotesque Sans &bull; Commercial License Required
              </p>
            </div>

            <div class="text-right shrink-0">
              <span class="font-mono text-xs text-[#8a8f98]">OPTICAL SIMILARITY</span>
              <div id="result-similarity" class="font-mono text-2xl sm:text-3xl font-bold text-[#27a644]">98%</div>
              <div class="text-[11px] font-mono text-[#8a8f98] uppercase">SIL Open License</div>
            </div>
          </div>

          <!-- Ranked Twin Selection Tabs (#1 Closest, #2 Secondary, #3 Alternative) -->
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="font-mono text-xs uppercase tracking-wider text-[#8a8f98] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></span>
                <span>RANKED FREE GOOGLE FONT TWINS</span>
              </span>
              <span class="text-xs text-[#8a8f98] font-mono">Click to preview twin</span>
            </div>
            
            <div id="twins-rank-buttons" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <!-- Dynamically populated rank tabs -->
            </div>
          </div>

          <!-- Active Twin Detailed Specimen & Rationale Box -->
          <div class="p-6 rounded-[8px] bg-[#161718] border border-[#23252a] space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <span class="text-xs font-mono text-[#8a8f98]">Currently Previewing Free Twin:</span>
                <div class="flex items-center gap-2 mt-0.5">
                  <h3 id="result-free-name" class="text-2xl font-bold text-[#ffffff] tracking-tight">Inter</h3>
                  <span id="result-free-designer" class="text-xs text-[#8a8f98] font-mono">by Rasmus Andersson</span>
                </div>
              </div>

              <!-- Specimen Controls -->
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono text-[#8a8f98]">Size:</span>
                  <input id="specimen-size" type="range" min="16" max="64" value="32" class="w-24 sm:w-28 accent-[#e4f222] cursor-pointer" />
                  <span id="specimen-size-label" class="font-mono text-xs text-[#ffffff] w-7">32px</span>
                </div>
              </div>
            </div>

            <p id="result-reason" class="text-xs sm:text-sm text-[#d0d6e0] leading-relaxed">
              Tall x-height, neutral apertures, clean geometric balance, perfected for UI screens.
            </p>

            <!-- Live Editable Specimen Text Field -->
            <div class="pt-2">
              <span class="font-mono text-[10px] text-[#8a8f98] uppercase block mb-1">Interactive Specimen (Type anything to test):</span>
              <input
                id="specimen-input"
                type="text"
                value="Sphinx of black quartz, judge my vow. 0123456789"
                class="w-full bg-[#08090a] border border-[#23252a] rounded-[6px] px-4 py-3 text-[#ffffff] focus:outline-none focus:border-[#e4f222] transition-all leading-snug break-words"
                style="font-size: 32px; font-family: 'Inter', sans-serif;"
                spellcheck="false"
              />
            </div>
          </div>

          <!-- Typographic Geometry Metrics -->
          <div>
            <span class="font-mono text-xs uppercase tracking-wider text-[#8a8f98] block mb-3">
              TYPOGRAPHIC METRICS COMPARISON
            </span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div class="p-3 rounded-[6px] border border-[#23252a] bg-[#161718]">
                <span class="text-[11px] font-mono text-[#8a8f98] block">x-Height Ratio</span>
                <span id="metric-xheight" class="font-mono font-semibold text-xs sm:text-sm text-[#ffffff]">High (0.72)</span>
              </div>
              <div class="p-3 rounded-[6px] border border-[#23252a] bg-[#161718]">
                <span class="text-[11px] font-mono text-[#8a8f98] block">Stroke Contrast</span>
                <span id="metric-contrast" class="font-mono font-semibold text-xs sm:text-sm text-[#ffffff]">Low / Monoline</span>
              </div>
              <div class="p-3 rounded-[6px] border border-[#23252a] bg-[#161718]">
                <span class="text-[11px] font-mono text-[#8a8f98] block">Terminals</span>
                <span id="metric-terminals" class="font-mono font-semibold text-xs sm:text-sm text-[#ffffff]">Strictly Horizontal</span>
              </div>
              <div class="p-3 rounded-[6px] border border-[#23252a] bg-[#161718]">
                <span class="text-[11px] font-mono text-[#8a8f98] block">Apertures</span>
                <span id="metric-apertures" class="font-mono font-semibold text-xs sm:text-sm text-[#ffffff]">Neutral / Semi-closed</span>
              </div>
            </div>
          </div>

          <!-- Production CSS Blueprint Window -->
          <div class="rounded-[8px] border border-[#23252a] bg-[#08090a] overflow-hidden">
            <div class="h-10 px-4 bg-[#161718] border-b border-[#23252a] flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <span class="font-mono text-xs text-[#8a8f98] ml-2">production-twin.css</span>
              </div>
              <button
                id="btn-copy-blueprint"
                type="button"
                class="btn-ghost-linear font-mono text-xs px-3 py-1 rounded-[6px] cursor-pointer"
              >
                Copy CSS
              </button>
            </div>
            <pre id="code-blueprint" class="p-4 font-mono text-xs text-[#d0d6e0] overflow-x-auto leading-relaxed"><code>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
font-family: 'Inter', sans-serif;</code></pre>
          </div>

          <!-- Action Links -->
          <div class="pt-4 border-t border-[#23252a] flex flex-wrap items-center justify-between gap-3">
            <a
              id="link-google-font"
              href="https://fonts.google.com/specimen/Inter"
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs font-medium text-[#e4f222] hover:underline inline-flex items-center gap-1.5"
            >
              <span>Inspect on Google Fonts Repository</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            
            <a
              id="link-specimen-internal"
              href="/fonts/inter"
              class="font-mono text-xs text-[#8a8f98] hover:text-[#ffffff] transition-colors"
            >
              View Full Font Family Specimen &rarr;
            </a>
          </div>

        </div>
      </div>

      <!-- Mode 2: Upload Font Image -->
      <div id="section-image" class="hidden mt-8 sm:mt-12 w-full max-w-[1020px] mx-auto text-left">
        <div class="mb-6 p-4 rounded-[8px] border border-[#23252a] bg-[#161718] text-xs font-mono text-[#d0d6e0] flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#e4f222]"></span>
          <span>Upload an image sample of a commercial font. Our in-browser optical engine matches letterforms and checks 50+ commercial stand-in equivalents automatically.</span>
        </div>
        <FontFinderApp />
      </div>

    </div>
  </section>

  <script id="commercial-db" type="application/json" is:inline set:html={dbJson}></script>
  <script is:inline>
    (function () {
      const dbEl = document.getElementById('commercial-db');
      let database = [];
      try {
        database = JSON.parse(dbEl?.textContent || '[]');
      } catch (e) {
        console.error('Failed to parse commercial font database', e);
      }

      const input = document.getElementById('commercial-input');
      const tabSearch = document.getElementById('tab-search');
      const tabImage = document.getElementById('tab-image');
      const secSearch = document.getElementById('section-search');
      const secImage = document.getElementById('section-image');

      const resultPaid = document.getElementById('result-paid');
      const resultFoundry = document.getElementById('result-foundry');
      const resultSimilarity = document.getElementById('result-similarity');
      const resultCatDesc = document.getElementById('result-cat-desc');
      const resultFreeName = document.getElementById('result-free-name');
      const resultFreeDesigner = document.getElementById('result-free-designer');
      const resultReason = document.getElementById('result-reason');
      const specimenInput = document.getElementById('specimen-input');
      const specimenSize = document.getElementById('specimen-size');
      const specimenSizeLabel = document.getElementById('specimen-size-label');

      const metricXheight = document.getElementById('metric-xheight');
      const metricContrast = document.getElementById('metric-contrast');
      const metricTerminals = document.getElementById('metric-terminals');
      const metricApertures = document.getElementById('metric-apertures');

      const codeBlueprint = document.getElementById('code-blueprint');
      const btnCopyBlueprint = document.getElementById('btn-copy-blueprint');
      const linkGoogleFont = document.getElementById('link-google-font');
      const linkSpecimenInternal = document.getElementById('link-specimen-internal');
      const twinsRankButtons = document.getElementById('twins-rank-buttons');

      let currentItem = database[0] || null;
      let currentActiveTwinIndex = 0;

      // Tab Switcher
      tabSearch?.addEventListener('click', () => {
        tabSearch.className = 'px-5 py-1.5 rounded-full text-xs font-mono transition-all font-medium bg-[#ffffff] text-[#08090a] shadow-xs cursor-pointer';
        tabImage.className = 'px-5 py-1.5 rounded-full text-xs font-mono transition-all text-[#8a8f98] hover:text-[#ffffff] cursor-pointer';
        secSearch?.classList.remove('hidden');
        secImage?.classList.add('hidden');
      });

      tabImage?.addEventListener('click', () => {
        tabImage.className = 'px-5 py-1.5 rounded-full text-xs font-mono transition-all font-medium bg-[#ffffff] text-[#08090a] shadow-xs cursor-pointer';
        tabSearch.className = 'px-5 py-1.5 rounded-full text-xs font-mono transition-all text-[#8a8f98] hover:text-[#ffffff] cursor-pointer';
        secImage?.classList.remove('hidden');
        secSearch?.classList.add('hidden');
      });

      function loadGoogleFontSpecimen(fontName) {
        const id = `gfont-${fontName.replace(/\s+/g, '-').toLowerCase()}`;
        if (!document.getElementById(id)) {
          const link = document.createElement('link');
          link.id = id;
          link.rel = 'stylesheet';
          link.href = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(fontName).replace(/%20/g, '+')}:wght@400;500;600;700&display=swap`;
          document.head.appendChild(link);
        }
      }

      function renderItem(item, selectedTwinIndex = 0) {
        if (!item) return;
        currentItem = item;
        currentActiveTwinIndex = selectedTwinIndex;
        const activeTwin = item.twins[selectedTwinIndex] || item.twins[0];

        loadGoogleFontSpecimen(activeTwin.name);

        if (resultPaid) resultPaid.textContent = item.paid;
        if (resultFoundry) resultFoundry.textContent = item.foundry;
        if (resultCatDesc) resultCatDesc.textContent = `Category: ${item.category} • Commercial License Required`;
        if (resultSimilarity) resultSimilarity.textContent = activeTwin.similarity;

        if (resultFreeName) resultFreeName.textContent = activeTwin.name;
        if (resultFreeDesigner) resultFreeDesigner.textContent = `by ${activeTwin.designer}`;
        if (resultReason) resultReason.textContent = activeTwin.reason;

        if (specimenInput) {
          specimenInput.style.fontFamily = `'${activeTwin.name}', sans-serif`;
        }

        if (metricXheight) metricXheight.textContent = item.metrics?.xHeight || 'High (0.71)';
        if (metricContrast) metricContrast.textContent = item.metrics?.contrast || 'Low';
        if (metricTerminals) metricTerminals.textContent = item.metrics?.terminals || 'Horizontal';
        if (metricApertures) metricApertures.textContent = item.metrics?.apertures || 'Balanced';

        // CSS Blueprint
        const encName = encodeURIComponent(activeTwin.name).replace(/%20/g, '+');
        const cssSnippet = `@import url('https://fonts.googleapis.com/css2?family=${encName}:wght@400;500;600;700&display=swap');\nfont-family: '${activeTwin.name}', sans-serif;`;
        if (codeBlueprint) codeBlueprint.innerHTML = `<code>${cssSnippet}</code>`;

        if (linkGoogleFont) linkGoogleFont.href = `https://fonts.google.com/specimen/${encName}`;
        if (linkSpecimenInternal) {
          const slug = activeTwin.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          linkSpecimenInternal.href = `/fonts/${slug}`;
        }

        // Render Twin Selection Tabs
        if (twinsRankButtons) {
          twinsRankButtons.innerHTML = '';
          item.twins.forEach((twin, idx) => {
            const isSelected = (idx === selectedTwinIndex);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `p-3 rounded-[8px] border text-left transition-all cursor-pointer ${
              isSelected
                ? 'border-[#e4f222] bg-[#161718] ring-1 ring-[#e4f222]'
                : 'border-[#23252a] bg-[#0f1011] hover:border-[#383b3f]'
            }`;
            btn.innerHTML = `
              <div class="flex items-center justify-between text-xs font-mono mb-1">
                <span class="${isSelected ? 'text-[#e4f222] font-semibold' : 'text-[#8a8f98]'}">#${idx + 1} Twin</span>
                <span class="font-bold ${isSelected ? 'text-[#27a644]' : 'text-[#8a8f98]'}">${twin.similarity}</span>
              </div>
              <div class="font-bold text-sm sm:text-base ${isSelected ? 'text-[#ffffff]' : 'text-[#d0d6e0]'}">${twin.name}</div>
              <div class="text-[11px] ${isSelected ? 'text-[#8a8f98]' : 'text-[#62666d]'} line-clamp-1 mt-0.5">${twin.weight}</div>
            `;
            btn.addEventListener('click', () => {
              renderItem(item, idx);
            });
            twinsRankButtons.appendChild(btn);
          });
        }
      }

      function searchDatabase(query) {
        const q = query.trim().toLowerCase();
        if (!q) {
          renderItem(database[0], 0);
          return;
        }

        const match = database.find(item => 
          item.paid.toLowerCase().includes(q) ||
          item.aliases.some(a => a.includes(q)) ||
          item.twins.some(t => t.name.toLowerCase().includes(q))
        );

        if (match) {
          renderItem(match, 0);
        } else {
          // Dynamic fallback for unlisted fonts
          renderItem({
            paid: query,
            aliases: [query.toLowerCase()],
            foundry: 'Commercial Typeface',
            category: 'Universal Sans',
            twins: [
              { name: 'Inter', similarity: '92%', reason: 'Universal high-contrast digital workhorse matching general commercial grotesque proportions.', weight: '100-900', designer: 'Rasmus Andersson' },
              { name: 'Roboto', similarity: '90%', reason: 'Clean dual geometric curves engineered for seamless cross-platform reading.', weight: '100-900', designer: 'Christian Robertson' },
              { name: 'Open Sans', similarity: '88%', reason: 'Open apertures and friendly neutral rhythm for web and mobile.', weight: '300-800', designer: 'Steve Matteson' }
            ],
            metrics: { xHeight: 'High (0.71)', contrast: 'Low', terminals: 'Horizontal Cuts', apertures: 'Neutral' },
            css: "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap');\nfont-family: 'Inter', sans-serif;"
          }, 0);
        }
      }

      input?.addEventListener('input', (e) => {
        searchDatabase(e.target.value);
      });

      document.querySelectorAll('.preset-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-preset');
          if (input) input.value = val;
          searchDatabase(val);
        });
      });

      // Category filter pills
      document.querySelectorAll('.cat-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.cat-pill').forEach(p => {
            p.className = 'cat-pill text-[11px] font-mono px-2.5 py-1 rounded-[4px] bg-[#161718] text-[#8a8f98] border border-[#23252a] hover:border-[#e4f222] hover:text-[#ffffff] transition-all cursor-pointer';
          });
          pill.className = 'cat-pill active text-[11px] font-mono px-2.5 py-1 rounded-[4px] bg-[#ffffff] text-[#08090a] font-medium shadow-xs cursor-pointer';

          const cat = pill.getAttribute('data-cat');
          if (cat === 'all') {
            renderItem(database[0], 0);
          } else {
            const found = database.find(d => d.category.toLowerCase().includes(cat.toLowerCase()));
            if (found) renderItem(found, 0);
          }
        });
      });

      // Specimen Size Slider
      specimenSize?.addEventListener('input', (e) => {
        const val = e.target.value;
        if (specimenSizeLabel) specimenSizeLabel.textContent = `${val}px`;
        if (specimenInput) specimenInput.style.fontSize = `${val}px`;
      });

      // Copy Blueprint Button
      btnCopyBlueprint?.addEventListener('click', async () => {
        const text = codeBlueprint?.textContent || '';
        let copied = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            copied = true;
          }
        } catch (e) {}

        if (!copied) {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          } catch (e) {}
        }

        const orig = btnCopyBlueprint.innerHTML;
        btnCopyBlueprint.innerHTML = `<span class="text-[#27a644] font-semibold">✓ Copied!</span>`;
        setTimeout(() => {
          btnCopyBlueprint.innerHTML = orig;
        }, 2000);
      });

      // Initial render
      renderItem(database[0], 0);
    })();
  </script>
</BaseLayout>
