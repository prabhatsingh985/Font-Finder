---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';

// Comprehensive Industry Typographic Equivalence Database (50+ Commercial Standards)
const commercialDatabase = [
  {
