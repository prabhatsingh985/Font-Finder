---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
---

<BaseLayout
  title="Find a Handwriting or Script Font — Visual Script Typeface Identifier"
  description="Script fonts are the hardest to identify. Upload handwritten text or calligraphic lettering to identify the closest free cursive and script Google fonts."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Breadcrumb & Tag -->
    <div class="flex items-center gap-2 mb-3">
      <a href="/tools" class="text-xs font-mono text-[#727272] hover:text-[#ff4d00] transition-colors">Tools</a>
      <span class="text-xs text-[#d1d5db]">/</span>
      <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Script Font Identifier</span>
    </div>

    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] tracking-tight">
        Find a handwriting or script font
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-[#727272] leading-relaxed">
        Script and cursive fonts are historically the hardest to identify due to connected letters and flourishes. Here is how to isolate strokes and get an instant, usable match.
      </p>
    </div>

    <!-- Core Scanner Tool -->
    <div class="mt-10">
      <FontFinderApp />
    </div>

    <!-- Handwriting & Script Best Practices -->
    <div class="mt-16 pt-12 border-t border-[#e5e7eb]">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">CURSIVE & SCRIPT MATCHING</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#111827] tracking-tight mb-3">
        Mastering script font recognition
      </h2>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            01
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Isolate Individual Words</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Crop tightly around one or two clear words rather than whole sentences. Script ligatures match best when glyph slant and baselines are level.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            02
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Enter Character Hints</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Because script letters connect, OCR can sometimes misread joints. Typing the exact word in the text box activates character-guided stroke analysis.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            03
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Browse Handwriting Category</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Filter our catalog under the "Handwriting" tag to compare against famous calligraphy options like Pacifico, Dancing Script, Caveat, and Great Vibes.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
