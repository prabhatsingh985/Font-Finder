---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';

const pdfSamples = [
  { id: 'pdfdoc', label: 'Report Heading (Serif)', sampleKey: 'pdfdoc' },
  { id: 'playfair', label: 'Book Page (Playfair)', sampleKey: 'playfair' },
  { id: 'inter', label: 'Modern Body Text (Inter)', sampleKey: 'inter' }
];
---

<BaseLayout
  title="Detect the Fonts in a PDF — Document Typeface Identifier"
  description="Screenshot a page or upload a document to detect the embedded typeface and find free open-source alternatives."
>
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-grid-pattern-subtle border-b border-[#e5e7eb] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto text-center">
      <!-- Breadcrumb & Tag -->
      <div class="inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-[#f9fafb] dark:bg-[#15171e] border border-[#e5e7eb] dark:border-[#242834]">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <a href="/tools" class="text-xs font-mono text-[#727272] dark:text-[#9ca3af] hover:text-[#ff4d00] transition-colors">Tools</a>
        <span class="text-xs text-[#d1d5db] dark:text-[#4b5563]">/</span>
        <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">PDF Font Detector</span>
      </div>

      <!-- Centered Minimalist Hero -->
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] dark:text-[#f3f4f6] tracking-tight max-w-2xl mx-auto">
        Detect fonts in a PDF
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#727272] dark:text-[#9ca3af] max-w-lg mx-auto">
        Screenshot any PDF document page or paragraph to inspect its typography and get free Google Font equivalents.
      </p>

      <!-- Specific PDF Scanner Tool -->
      <div class="mt-8 sm:mt-12 w-full max-w-[1000px] mx-auto text-left">
        <FontFinderApp
          dropzoneTitle="Drop PDF page screenshot or document capture"
          dropzoneSubtitle="Crisp zoom (200%) yields highest recognition accuracy &bull; 100% private"
          buttonText="Select Document Image"
          samplesTitle="Test Document Presets:"
          samples={pdfSamples}
        />
      </div>
    </div>
  </section>
</BaseLayout>
