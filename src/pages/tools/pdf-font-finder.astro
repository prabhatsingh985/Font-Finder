---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
---

<BaseLayout
  title="Detect the Fonts in a PDF — Extract & Identify Typefaces from Documents"
  description="Screenshot a page and identify the typeface visually — or read the embedded font names straight from your PDF document with free open-source alternatives."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Breadcrumb & Tag -->
    <div class="flex items-center gap-2 mb-3">
      <a href="/tools" class="text-xs font-mono text-[#727272] hover:text-[#ff4d00] transition-colors">Tools</a>
      <span class="text-xs text-[#d1d5db]">/</span>
      <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">PDF Font Detector</span>
    </div>

    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] tracking-tight">
        Detect the fonts in a PDF
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-[#727272] leading-relaxed">
        Screenshot a page and identify the typeface visually — or find the closest free open-source alternatives for any font embedded in your PDF documents.
      </p>
    </div>

    <!-- Core Scanner Tool -->
    <div class="mt-10">
      <FontFinderApp />
    </div>

    <!-- PDF Font Detection Guidance -->
    <div class="mt-16 pt-12 border-t border-[#e5e7eb]">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">DOCUMENT TYPOGRAPHY GUIDE</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#111827] tracking-tight mb-3">
        How to get 100% accuracy from PDF text
      </h2>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            01
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Zoom in 200–300%</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Before taking a screenshot of the PDF, zoom into the target paragraph so letter contours and terminals are crisp and free of anti-aliasing blur.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            02
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Select Characteristic Letters</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Look for distinctive letters such as lowercase "g" (single vs double-storey), "a", uppercase "Q" tails, and "R" legs for fastest recognition.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            03
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Check Document Properties</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            If the PDF has selectable text, open Acrobat or Preview Properties &gt; Fonts to see the original font name, then search our 1,946 font catalog for legal alternatives.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
