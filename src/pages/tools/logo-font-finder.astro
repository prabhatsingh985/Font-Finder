      { name: 'Work Sans', similarity: '95%', reason: 'Warm humanist grotesque with generous counters, sturdy stems, and organic rhythm.', weight: '700' },
      { name: 'Source Sans 3', similarity: '93%', reason: 'Clean open apertures and balanced proportions.', weight: '700' },
      { name: 'Open Sans', similarity: '91%', reason: 'Friendly neutral reading rhythm.', weight: '700' }
    ],
    sampleText: 'STARBUCKS',
    notes: 'Starbucks uses Freight Sans Black alongside their custom internal typeface Sodo Sans for packaging and signage.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@700;800&display=swap');\nfont-family: 'Work Sans', sans-serif;\nfont-weight: 800;\nletter-spacing: 0.1em;"
