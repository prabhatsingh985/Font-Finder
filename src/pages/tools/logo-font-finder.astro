---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
---

<BaseLayout
  title="Identify the Font in a Logo — Free Logo Typeface Identifier"
  description="Upload a brand logo or wordmark image to find what typeface it uses, plus open-source free fonts that share the same visual style."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Breadcrumb & Tag -->
    <div class="flex items-center gap-2 mb-3">
      <a href="/tools" class="text-xs font-mono text-[#727272] hover:text-[#ff4d00] transition-colors">Tools</a>
      <span class="text-xs text-[#d1d5db]">/</span>
      <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Logo Font Finder</span>
    </div>

    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] tracking-tight">
        Identify the font in a logo
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-[#727272] leading-relaxed">
        Upload a brand logo or wordmark screenshot to find out what typeface it uses — plus free open-source fonts that share the exact same aesthetic and proportions.
      </p>
    </div>

    <!-- Core Scanner Tool -->
    <div class="mt-10">
      <FontFinderApp />
    </div>

    <!-- Logo Font Identification Pro Tips -->
    <div class="mt-16 pt-12 border-t border-[#e5e7eb]">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">BEST PRACTICES FOR LOGOS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#111827] tracking-tight mb-3">
        Tips for high-accuracy logo font detection
      </h2>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            01
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Crop Out the Emblem</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Separate graphical icons, emblems, or mascots from the lettering so the optical scanner can focus purely on letter glyph contours.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            02
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Type Known Wordmark</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Enter the exact brand name in the text input box. This activates Mode A character-aware matching for maximum recognition precision.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-white">
          <div class="w-8 h-8 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] font-bold font-mono text-xs flex items-center justify-center mb-3">
            03
          </div>
          <h3 class="font-bold text-[#111827] text-base mb-1.5">Look for Twin Matches</h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Many famous logos (Supreme, Jeep, Target, Panasonic) use customized commercial fonts. Our engine provides the best legal free stand-in.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
