    twins: [
      { name: 'Archivo', similarity: '96%', reason: 'Muscular geometric grotesque with tight negative space, perfect for replicating the FedEx optical arrow.', weight: '700' },
      { name: 'Montserrat', similarity: '93%', reason: 'Sturdy uppercase geometric stems with architectural clarity.', weight: '800' },
