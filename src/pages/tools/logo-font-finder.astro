const brandDbJson = JSON.stringify(brandLogos);
---

<BaseLayout
  title="Identify the Font in a Logo — Brand Typeface & Free Alternative Identifier"
  description="Discover what font any famous brand or logo uses. Search our 30+ brand typography database or upload any logo image for automated in-browser letterform matching."
>
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-grid-pattern-subtle border-b border-[#e5e7eb] dark:border-[#242834] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto text-center">
      
      <!-- Breadcrumb & Badge -->
      <div class="inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-[#f9fafb] dark:bg-[#15171e] border border-[#e5e7eb] dark:border-[#242834]">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <a href="/tools" class="text-xs font-mono text-[#727272] dark:text-[#9ca3af] hover:text-[#ff4d00] transition-colors">Tools</a>
        <span class="text-xs text-[#d1d5db] dark:text-[#4b5563]">/</span>
        <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Logo Font Finder</span>
      </div>

      <!-- Hero Header -->
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] dark:text-[#f3f4f6] tracking-tight max-w-2xl mx-auto">
        Identify the font in a logo
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#727272] dark:text-[#9ca3af] max-w-xl mx-auto">
        Find the exact typeface behind iconic brand logos &mdash; plus free legal Google Font equivalents with ready-to-use CSS.
      </p>

      <!-- Mode Switcher Tabs -->
      <div class="mt-8 inline-flex p-1 rounded-full bg-[#f3f4f6] dark:bg-[#15171e] border border-[#e5e7eb] dark:border-[#242834]">
        <button
          id="tab-brand-dir"
          type="button"
          class="px-5 py-1.5 rounded-full text-xs font-mono transition-all font-medium bg-white dark:bg-[#242834] text-[#262626] dark:text-white shadow-xs cursor-pointer"
        >
          Brand Logo Directory
        </button>
        <button
          id="tab-logo-upload"
          type="button"
          class="px-5 py-1.5 rounded-full text-xs font-mono transition-all text-[#727272] dark:text-[#9ca3af] hover:text-[#262626] dark:hover:text-white cursor-pointer"
        >
          Upload Any Logo Image
        </button>
      </div>

      <!-- Mode 1: Brand Logo Directory (Default) -->
      <div id="section-brand-dir" class="mt-8 sm:mt-12 w-full max-w-[1020px] mx-auto text-left">
        
        <!-- Search Box -->
        <div class="relative">
          <input
            id="brand-input"
            type="text"
            placeholder="Search brand logo (e.g. Nike, Supreme, Spotify, Netflix, Google, Tesla...)"
            class="w-full pl-12 pr-4 py-4 rounded-2xl border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] text-sm text-[#262626] dark:text-[#f3f4f6] shadow-[0_0_0_6px_rgb(249,249,249)] dark:shadow-[0_0_0_6px_rgba(21,23,30,0.9)] focus:outline-none focus:border-[#ff4d00] placeholder:text-[#9ca3af] dark:placeholder:text-[#6b7280] transition-all font-mono"
            autocomplete="off"
          />
          <svg class="w-5 h-5 text-[#727272] dark:text-[#9ca3af] absolute left-4 top-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Quick Brand Chips -->
        <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-[11px] font-mono text-[#727272] dark:text-[#9ca3af] mr-1">Brands:</span>
            {['Nike', 'Supreme', 'Spotify', 'Netflix', 'Google', 'Apple', 'Tesla', 'Airbnb'].map((brandName) => (
              <button
                type="button"
                data-brand={brandName}
                class="brand-chip text-xs font-mono px-3 py-1 rounded-full border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] text-[#4b5563] dark:text-[#cbd5e1] hover:border-[#ff4d00] hover:text-[#ff4d00] transition-all cursor-pointer shadow-2xs"
              >
                {brandName}
              </button>
            ))}
          </div>

          <!-- Industry Filter Pills -->
          <div id="industry-filter-container" class="flex flex-wrap items-center gap-1">
            <button type="button" data-ind="all" class="ind-pill active text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-[#262626] dark:bg-white text-white dark:text-[#111827] font-semibold cursor-pointer">All</button>
            <button type="button" data-ind="Tech" class="ind-pill text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-[#f3f4f6] dark:bg-[#15171e] text-[#4b5563] dark:text-[#cbd5e1] border border-[#e5e7eb] dark:border-[#242834] cursor-pointer">Tech</button>
            <button type="button" data-ind="Apparel" class="ind-pill text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-[#f3f4f6] dark:bg-[#15171e] text-[#4b5563] dark:text-[#cbd5e1] border border-[#e5e7eb] dark:border-[#242834] cursor-pointer">Apparel</button>
            <button type="button" data-ind="Media" class="ind-pill text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-[#f3f4f6] dark:bg-[#15171e] text-[#4b5563] dark:text-[#cbd5e1] border border-[#e5e7eb] dark:border-[#242834] cursor-pointer">Media</button>
            <button type="button" data-ind="Food" class="ind-pill text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-[#f3f4f6] dark:bg-[#15171e] text-[#4b5563] dark:text-[#cbd5e1] border border-[#e5e7eb] dark:border-[#242834] cursor-pointer">Food</button>
          </div>
        </div>

        <!-- Main Brand Showcase Card -->
        <div id="brand-card" class="mt-8 p-6 sm:p-8 rounded-2xl border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] shadow-[0_0_0_6px_rgb(249,249,249)] dark:shadow-[0_0_0_6px_rgba(21,23,30,0.9)] space-y-6">
          
          <!-- Brand Identity Header -->
          <div class="flex flex-wrap items-start justify-between gap-4 pb-6 border-b border-[#e5e7eb] dark:border-[#242834]">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs uppercase tracking-wider text-[#727272] dark:text-[#9ca3af]">OFFICIAL BRAND LOGO TYPEFACE</span>
                <span id="logo-industry" class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-[#f3f4f6] dark:bg-[#101217] text-[#4b5563] dark:text-[#cbd5e1] border border-[#e5e7eb] dark:border-[#242834]">
                  Apparel & Sports
                </span>
              </div>
              <h2 id="logo-brand-name" class="text-3xl sm:text-4xl font-bold tracking-tight text-[#111827] dark:text-[#f3f4f6] mt-2">
                Nike
              </h2>
              <p id="logo-official-font" class="text-xs text-[#727272] dark:text-[#9ca3af] mt-1 font-mono">
                Official Typeface: Futura Bold Extra Condensed (Oblique) &bull; Bauer / Monotype
              </p>
            </div>

            <div class="text-right shrink-0">
              <span class="font-mono text-xs text-[#727272] dark:text-[#9ca3af]">CLOSEST FREE TWIN</span>
              <div id="logo-similarity" class="font-mono text-2xl sm:text-3xl font-bold text-[#059669] dark:text-[#34d399]">97%</div>
              <div class="text-[11px] font-mono text-[#727272] dark:text-[#9ca3af] uppercase">SIL Open License</div>
            </div>
          </div>

          <!-- Ranked Free Stand-in Twins Tabs -->
          <div>
            <span class="font-mono text-xs uppercase tracking-wider text-[#727272] dark:text-[#9ca3af] block mb-3">
              RANKED FREE GOOGLE FONT STAND-INS
            </span>
            <div id="logo-twins-container" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- Specimen Preview Box -->
          <div class="p-6 rounded-xl bg-[#f8f9fa] dark:bg-[#101217] border border-[#f0f0f0] dark:border-[#242834] space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <span class="text-xs font-mono text-[#727272] dark:text-[#9ca3af]">Previewing Stand-in Font:</span>
                <div class="flex items-center gap-2 mt-0.5">
                  <h3 id="logo-free-font-name" class="text-2xl font-bold text-[#ff4d00] tracking-tight">Oswald</h3>
                  <span class="text-xs text-[#727272] dark:text-[#9ca3af] font-mono">(Google Font)</span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono text-[#727272] dark:text-[#9ca3af]">Size:</span>
                <input id="logo-specimen-size" type="range" min="18" max="72" value="38" class="w-24 sm:w-28 accent-[#ff4d00] cursor-pointer" />
                <span id="logo-specimen-size-label" class="font-mono text-xs text-[#262626] dark:text-[#f3f4f6] w-7">38px</span>
              </div>
            </div>

            <p id="logo-reason" class="text-xs sm:text-sm text-[#4b5563] dark:text-[#cbd5e1] leading-relaxed">
              Sturdy condensed vertical stems, athletic uppercase energy, near-identical proportion to Futura Condensed.
            </p>

            <div class="pt-2">
              <span class="font-mono text-[10px] text-[#727272] dark:text-[#9ca3af] uppercase block mb-1">Interactive Brand Specimen:</span>
              <input
                id="logo-specimen-input"
                type="text"
                value="JUST DO IT"
                class="w-full bg-white dark:bg-[#15171e] border border-[#e5e7eb] dark:border-[#242834] rounded-xl px-4 py-3 text-[#111827] dark:text-[#f3f4f6] focus:outline-none focus:border-[#ff4d00] transition-all leading-snug break-words"
                style="font-size: 38px; font-family: 'Oswald', sans-serif;"
                spellcheck="false"
              />
            </div>

            <p id="logo-notes" class="text-xs text-[#727272] dark:text-[#9ca3af] font-mono pt-2 border-t border-[#e5e7eb] dark:border-[#242834]">
              The iconic Nike tagline and wordmark uses a customized heavyweight italic cut of Futura Condensed.
            </p>
          </div>

          <!-- CSS Window -->
          <div class="rounded-xl border border-[#e5e7eb] dark:border-[#242834] bg-[#f9f9f9] dark:bg-[#101217] overflow-hidden">
            <div class="h-10 px-4 bg-[#f9f9f9] dark:bg-[#101217] border-b border-[#e5e7eb] dark:border-[#242834] flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb] dark:bg-[#242834]"></div>
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb] dark:bg-[#242834]"></div>
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb] dark:bg-[#242834]"></div>
                <span class="font-mono text-xs text-[#727272] dark:text-[#9ca3af] ml-2">logo-font-blueprint.css</span>
              </div>
              <button
                id="btn-copy-logo-css"
                type="button"
                class="font-mono text-xs px-3 py-1 rounded-full bg-white dark:bg-[#15171e] border border-[#e5e7eb] dark:border-[#242834] hover:bg-[#f9f9f9] dark:hover:bg-[#242834] text-[#262626] dark:text-[#f3f4f6] transition-colors cursor-pointer"
              >
                Copy CSS
              </button>
            </div>
            <pre id="code-logo-css" class="p-4 font-mono text-xs text-[#262626] dark:text-[#f3f4f6] overflow-x-auto leading-relaxed"><code>@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap');
font-family: 'Oswald', sans-serif;
font-weight: 700;
font-style: italic;</code></pre>
          </div>

          <!-- Action Links -->
          <div class="pt-4 border-t border-[#e5e7eb] dark:border-[#242834] flex flex-wrap items-center justify-between gap-3">
            <a
              id="link-logo-gf"
              href="https://fonts.google.com/specimen/Oswald"
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs font-semibold text-[#ff4d00] hover:underline inline-flex items-center gap-1.5"
            >
              <span>Inspect on Google Fonts Repository</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            
            <a
              id="link-logo-specimen"
              href="/fonts/oswald"
              class="font-mono text-xs text-[#727272] dark:text-[#9ca3af] hover:text-[#262626] dark:hover:text-[#f3f4f6] transition-colors"
            >
              View Full Typography Specimen &rarr;
            </a>
          </div>

        </div>
      </div>

      <!-- Mode 2: Upload Logo Image -->
      <div id="section-logo-upload" class="hidden mt-8 sm:mt-12 w-full max-w-[1020px] mx-auto text-left">
        <div class="mb-6 p-4 rounded-xl border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] text-xs font-mono text-[#727272] dark:text-[#9ca3af] flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#ff4d00]"></span>
          <span>Logo pre-processor active: Transparent alphas are normalized, colored backgrounds are auto-inverted, and non-letter emblem icons are segmented automatically.</span>
        </div>
        <FontFinderApp
          dropzoneTitle="Drop brand logo or wordmark image here"
          dropzoneSubtitle="Optimized for vector marks, transparent PNGs, and colored brand assets &bull; 100% in-browser"
          buttonText="Select Brand Logo File"
          samplesTitle="Test Real Logos:"
          samples={[
            { id: 'supreme', label: 'Supreme (Futura)', sampleKey: 'supreme' },
            { id: 'nike', label: 'Nike (Condensed)', sampleKey: 'nike' },
            { id: 'spotify', label: 'Spotify (Circular)', sampleKey: 'spotify' },
            { id: 'netflix', label: 'Netflix (Bebas)', sampleKey: 'netflix' }
          ]}
        />
      </div>

    </div>
  </section>

  <script id="brand-db" type="application/json" is:inline set:html={brandDbJson}></script>
  <script is:inline>
    (function () {
      const dbEl = document.getElementById('brand-db');
      let brands = [];
      try {
        brands = JSON.parse(dbEl?.textContent || '[]');
      } catch (e) {
        console.error('Failed to parse brand logo database', e);
      }

      const input = document.getElementById('brand-input');
      const tabBrandDir = document.getElementById('tab-brand-dir');
      const tabLogoUpload = document.getElementById('tab-logo-upload');
      const secBrandDir = document.getElementById('section-brand-dir');
      const secLogoUpload = document.getElementById('section-logo-upload');

      const logoBrandName = document.getElementById('logo-brand-name');
      const logoIndustry = document.getElementById('logo-industry');
      const logoOfficialFont = document.getElementById('logo-official-font');
      const logoSimilarity = document.getElementById('logo-similarity');
      const logoFreeFontName = document.getElementById('logo-free-font-name');
      const logoReason = document.getElementById('logo-reason');
      const logoNotes = document.getElementById('logo-notes');
      const logoSpecimenInput = document.getElementById('logo-specimen-input');
      const logoSpecimenSize = document.getElementById('logo-specimen-size');
      const logoSpecimenSizeLabel = document.getElementById('logo-specimen-size-label');
      const logoTwinsContainer = document.getElementById('logo-twins-container');
      const codeLogoCss = document.getElementById('code-logo-css');
      const btnCopyLogoCss = document.getElementById('btn-copy-logo-css');
      const linkLogoGf = document.getElementById('link-logo-gf');
      const linkLogoSpecimen = document.getElementById('link-logo-specimen');

      let currentBrand = brands[0] || null;
      let currentTwinIdx = 0;

      // Tab switcher
      tabBrandDir?.addEventListener('click', () => {
        tabBrandDir.className = 'px-5 py-1.5 rounded-full text-xs font-mono transition-all font-medium bg-white dark:bg-[#242834] text-[#262626] dark:text-white shadow-xs cursor-pointer';
        tabLogoUpload.className = 'px-5 py-1.5 rounded-full text-xs font-mono transition-all text-[#727272] dark:text-[#9ca3af] hover:text-[#262626] dark:hover:text-white cursor-pointer';
        secBrandDir?.classList.remove('hidden');
        secLogoUpload?.classList.add('hidden');
      });

      tabLogoUpload?.addEventListener('click', () => {
        tabLogoUpload.className = 'px-5 py-1.5 rounded-full text-xs font-mono transition-all font-medium bg-white dark:bg-[#242834] text-[#262626] dark:text-white shadow-xs cursor-pointer';
        tabBrandDir.className = 'px-5 py-1.5 rounded-full text-xs font-mono transition-all text-[#727272] dark:text-[#9ca3af] hover:text-[#262626] dark:hover:text-white cursor-pointer';
        secLogoUpload?.classList.remove('hidden');
        secBrandDir?.classList.add('hidden');
      });

      function loadGoogleFontSpecimen(fontName) {
        const id = `gfont-logo-${fontName.replace(/\s+/g, '-').toLowerCase()}`;
        if (!document.getElementById(id)) {
          const link = document.createElement('link');
          link.id = id;
          link.rel = 'stylesheet';
          link.href = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(fontName).replace(/%20/g, '+')}:wght@400;600;700;800;900&display=swap`;
          document.head.appendChild(link);
        }
      }

      function renderBrand(brand, twinIndex = 0) {
        if (!brand) return;
        currentBrand = brand;
        currentTwinIdx = twinIndex;
        const activeTwin = brand.twins[twinIndex] || brand.twins[0];

        loadGoogleFontSpecimen(activeTwin.name);

        if (logoBrandName) logoBrandName.textContent = brand.brand;
        if (logoIndustry) logoIndustry.textContent = brand.industry;
        if (logoOfficialFont) logoOfficialFont.textContent = `Official Typeface: ${brand.officialFont} • ${brand.foundry}`;
        if (logoSimilarity) logoSimilarity.textContent = activeTwin.similarity;
        if (logoFreeFontName) logoFreeFontName.textContent = activeTwin.name;
        if (logoReason) logoReason.textContent = activeTwin.reason;
        if (logoNotes) logoNotes.textContent = brand.notes;

        if (logoSpecimenInput) {
          logoSpecimenInput.value = brand.sampleText || brand.brand;
          logoSpecimenInput.style.fontFamily = `'${activeTwin.name}', sans-serif`;
          logoSpecimenInput.style.fontWeight = activeTwin.weight || '700';
        }

        const encName = encodeURIComponent(activeTwin.name).replace(/%20/g, '+');
        const cssSnippet = brand.css || `@import url('https://fonts.googleapis.com/css2?family=${encName}:wght@700&display=swap');\nfont-family: '${activeTwin.name}', sans-serif;\nfont-weight: 700;`;
        if (codeLogoCss) codeLogoCss.innerHTML = `<code>${cssSnippet}</code>`;

        if (linkLogoGf) linkLogoGf.href = `https://fonts.google.com/specimen/${encName}`;
        if (linkLogoSpecimen) {
          const slug = activeTwin.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          linkLogoSpecimen.href = `/fonts/${slug}`;
        }

        // Render Twins Buttons
        if (logoTwinsContainer) {
          logoTwinsContainer.innerHTML = '';
          brand.twins.forEach((twin, idx) => {
            const isSelected = (idx === twinIndex);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `p-3 rounded-xl border text-left transition-all cursor-pointer ${
              isSelected
                ? 'border-[#ff4d00] bg-[#ff4d00]/5 dark:bg-[#ff4d00]/10 ring-1 ring-[#ff4d00]'
                : 'border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#101217] hover:border-[#d1d5db] dark:hover:border-[#333846]'
            }`;
            btn.innerHTML = `
              <div class="flex items-center justify-between text-xs font-mono mb-1">
                <span class="${isSelected ? 'text-[#ff4d00] font-bold' : 'text-[#727272] dark:text-[#9ca3af]'}">#${idx + 1} Twin</span>
                <span class="font-bold ${isSelected ? 'text-[#059669] dark:text-[#34d399]' : 'text-[#727272] dark:text-[#9ca3af]'}">${twin.similarity}</span>
              </div>
              <div class="font-bold text-sm sm:text-base text-[#111827] dark:text-[#f3f4f6]">${twin.name}</div>
              <div class="text-[11px] text-[#727272] dark:text-[#9ca3af] mt-0.5">Weight: ${twin.weight}</div>
            `;
            btn.addEventListener('click', () => {
              renderBrand(brand, idx);
            });
            logoTwinsContainer.appendChild(btn);
          });
        }
      }

      function searchBrand(query) {
        const q = query.trim().toLowerCase();
        if (!q) {
          renderBrand(brands[0], 0);
          return;
        }

        const found = brands.find(b =>
          b.brand.toLowerCase().includes(q) ||
          b.officialFont.toLowerCase().includes(q) ||
          b.twins.some(t => t.name.toLowerCase().includes(q))
        );

        if (found) {
          renderBrand(found, 0);
        } else {
          renderBrand({
            brand: query,
            industry: 'Custom Brand',
            officialFont: 'Custom Identity Typeface',
            foundry: 'Brand Commission',
            category: 'Brand Display',
            twins: [
              { name: 'Plus Jakarta Sans', similarity: '94%', reason: 'Versatile contemporary branding workhorse with clean geometric proportions.', weight: '700' },
              { name: 'Inter', similarity: '92%', reason: 'Neutral utilitarian letterforms with high legibility across digital and print touchpoints.', weight: '700' },
              { name: 'Oswald', similarity: '90%', reason: 'High-contrast condensed display font suitable for bold wordmarks.', weight: '700' }
            ],
            sampleText: query.toUpperCase(),
            notes: 'Unlisted brand logo. Displaying closest universal geometric branding typefaces.',
            css: "@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700&display=swap');\nfont-family: 'Plus Jakarta Sans', sans-serif;\nfont-weight: 700;"
          }, 0);
        }
      }

      input?.addEventListener('input', (e) => {
        searchBrand(e.target.value);
      });

      document.querySelectorAll('.brand-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          const bName = btn.getAttribute('data-brand');
          if (input) input.value = bName;
          searchBrand(bName);
        });
      });

      // Industry pills
      document.querySelectorAll('.ind-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.ind-pill').forEach(p => {
            p.classList.remove('bg-[#262626]', 'dark:bg-white', 'text-white', 'dark:text-[#111827]', 'font-semibold');
            p.classList.add('bg-[#f3f4f6]', 'dark:bg-[#15171e]', 'text-[#4b5563]', 'dark:text-[#cbd5e1]', 'border', 'border-[#e5e7eb]', 'dark:border-[#242834]');
          });
          pill.classList.remove('bg-[#f3f4f6]', 'dark:bg-[#15171e]', 'text-[#4b5563]', 'dark:text-[#cbd5e1]', 'border', 'border-[#e5e7eb]', 'dark:border-[#242834]');
          pill.classList.add('bg-[#262626]', 'dark:bg-white', 'text-white', 'dark:text-[#111827]', 'font-semibold');

          const ind = pill.getAttribute('data-ind');
          if (ind === 'all') {
            renderBrand(brands[0], 0);
          } else {
            const match = brands.find(b => b.industry.toLowerCase().includes(ind.toLowerCase()));
            if (match) renderBrand(match, 0);
          }
        });
      });

      logoSpecimenSize?.addEventListener('input', (e) => {
        const val = e.target.value;
        if (logoSpecimenSizeLabel) logoSpecimenSizeLabel.textContent = `${val}px`;
        if (logoSpecimenInput) logoSpecimenInput.style.fontSize = `${val}px`;
      });

      btnCopyLogoCss?.addEventListener('click', async () => {
        const text = codeLogoCss?.textContent || '';
        let copied = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            copied = true;
          }
        } catch (e) {}

        if (!copied) {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          } catch (e) {}
        }

        const orig = btnCopyLogoCss.innerHTML;
        btnCopyLogoCss.innerHTML = `<span class="text-[#059669] dark:text-[#34d399] font-semibold">✓ Copied!</span>`;
        setTimeout(() => {
          btnCopyLogoCss.innerHTML = orig;
        }, 2000);
      });

      // Initial render
      renderBrand(brands[0], 0);
    })();
  </script>
</BaseLayout>
