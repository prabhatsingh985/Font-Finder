---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';

const logoSamples = [
  { id: 'supreme', label: 'Supreme (Futura)', sampleKey: 'supreme' },
  { id: 'nike', label: 'Nike (Condensed)', sampleKey: 'nike' },
  { id: 'spotify', label: 'Spotify (Circular)', sampleKey: 'spotify' },
  { id: 'netflix', label: 'Netflix (Bebas)', sampleKey: 'netflix' }
];
---

<BaseLayout
  title="Identify the Font in a Logo — Free Logo Typeface Identifier"
  description="Upload a brand logo or wordmark image to find what typeface it uses, plus open-source free fonts that share the same visual style."
>
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-grid-pattern-subtle border-b border-[#e5e7eb] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto text-center">
      <!-- Breadcrumb & Tag -->
      <div class="inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-[#f9fafb] dark:bg-[#15171e] border border-[#e5e7eb] dark:border-[#242834]">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <a href="/tools" class="text-xs font-mono text-[#727272] dark:text-[#9ca3af] hover:text-[#ff4d00] transition-colors">Tools</a>
        <span class="text-xs text-[#d1d5db] dark:text-[#4b5563]">/</span>
        <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Logo Font Finder</span>
      </div>

      <!-- Centered Minimalist Hero -->
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] dark:text-[#f3f4f6] tracking-tight max-w-2xl mx-auto">
        Identify the font in a logo
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#727272] dark:text-[#9ca3af] max-w-lg mx-auto">
        Upload a brand logo or wordmark screenshot to find out what typeface it uses &mdash; plus free legal stand-ins.
      </p>

      <!-- Specific Logo Scanner Tool -->
      <div class="mt-8 sm:mt-12 w-full max-w-[1000px] mx-auto text-left">
        <FontFinderApp
          dropzoneTitle="Drop brand logo or paste with ⌘V"
          dropzoneSubtitle="Supports PNG, SVG, JPG, WebP &bull; Transparent backgrounds supported"
          buttonText="Select Logo File"
          samplesTitle="Test Famous Logos:"
          samples={logoSamples}
          accept="image/png, image/jpeg, image/jpg, image/webp, image/svg+xml"
        />
      </div>
    </div>
  </section>
</BaseLayout>
