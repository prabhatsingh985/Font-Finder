      { name: 'DM Sans', similarity: '95%', reason: 'Geometric grotesque with compact vertical proportion and generous counterforms.', weight: '700' },
      { name: 'Nunito Sans', similarity: '92%', reason: 'Slightly rounded humanist geometric cadence.', weight: '700' }
    ],
    sampleText: 'airbnb',
    notes: 'Commissioned by Airbnb from Dalton Maag to create a brand voice that translates seamlessly from print to mobile apps.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\nfont-family: 'Plus Jakarta Sans', sans-serif;\nfont-weight: 700;"
  },
  {
    brand: 'Adidas',
    industry: 'Apparel & Sports',
    officialFont: 'ITC Avant Garde Gothic Bold',
    foundry: 'ITC / Monotype',
    category: 'Geometric Sans',
    twins: [
      { name: 'Montserrat', similarity: '95%', reason: 'Pure circular geometric lowercase a and d with crisp vertical stem alignment.', weight: '700' },
      { name: 'Poppins', similarity: '94%', reason: 'Sharp geometric apex with strict circular loop proportions.', weight: '700' },
      { name: 'Jost', similarity: '93%', reason: 'Clean Bauhaus geometric letterforms.', weight: '700' }
    ],
    sampleText: 'adidas',
    notes: 'The lowercase Adidas wordmark relies on Avant Garde’s pure circular bowl forms and strict geometric harmony.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&display=swap');\nfont-family: 'Montserrat', sans-serif;\nfont-weight: 700;"
  },
  {
    brand: 'Coca-Cola',
    industry: 'Food & Beverage',
