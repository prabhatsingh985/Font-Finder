      { name: 'Lobster', similarity: '92%', reason: 'Bold flowing cursive script with connected high-contrast baseline loops.', weight: '400' },
      { name: 'Pacifico', similarity: '90%', reason: 'Warm retro American brush script with continuous flowing rhythm.', weight: '400' },
      { name: 'Great Vibes', similarity: '88%', reason: 'Elegant calligraphic script with sweeping ascender and descender loops.', weight: '400' }
    ],
    sampleText: 'Coca-Cola',
