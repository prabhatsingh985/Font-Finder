const pairingsJson = JSON.stringify(pairings);
---

<BaseLayout
  title="Font Pairing Generator — Typography Design System Studio"
  description="Generate designer-tested Google Font headline and body pairings. Test combinations live in an interactive design canvas with layout switchers and 1-click CSS exports."
>
  <!-- Preconnect and batch-load Google Fonts for initial top pairings -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Source+Sans+3:wght@400;500;600&family=Montserrat:wght@500;600;700&family=Lora:ital,wght@0,400;0,500;1,400&family=Plus+Jakarta+Sans:wght@500;600;700&family=Outfit:wght@400;500;600&family=Syne:wght@600;700;800&family=DM+Sans:wght@400;500;700&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400&family=Oswald:wght@500;600;700&family=Merriweather:wght@300;400;700&family=IBM+Plex+Serif:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;600;700&display=swap"
  />

  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-grid-pattern-subtle border-b border-[#e5e7eb] dark:border-[#242834] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto">
      
      <!-- Top Breadcrumb & Badge -->
      <div class="flex items-center justify-center gap-2 mb-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f9fafb] dark:bg-[#15171e] border border-[#e5e7eb] dark:border-[#242834]">
          <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
          <a href="/tools" class="text-xs font-mono text-[#727272] dark:text-[#9ca3af] hover:text-[#ff4d00] transition-colors">Tools</a>
          <span class="text-xs text-[#d1d5db] dark:text-[#4b5563]">/</span>
          <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Design System Studio</span>
        </div>
      </div>

      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] dark:text-[#f3f4f6] tracking-tight">
          Find a font pairing
        </h1>
        <p class="mt-3.5 text-sm sm:text-base text-[#727272] dark:text-[#9ca3af] leading-relaxed max-w-xl mx-auto">
          Typography harmony is an exact science. Test 31 designer-curated Google Font combinations across Editorial, SaaS Hero, and Product layouts with live CSS exports.
        </p>
      </div>

      <!-- ========================================================================= -->
      <!-- SECTION 1: INTERACTIVE DESIGN SYSTEM STUDIO (LIVE CANVAS) -->
      <!-- ========================================================================= -->
      <div id="studio" class="mt-10 rounded-2xl border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] shadow-xs overflow-hidden">
        
        <!-- Studio Toolbar: Header Pair Status & Layout Switcher -->
        <div class="p-4 sm:p-5 border-b border-[#e5e7eb] dark:border-[#242834] bg-[#f9fafb] dark:bg-[#101217] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
          
          <!-- Active Pair Display -->
          <div class="flex items-center gap-3">
            <div class="w-2.5 h-2.5 rounded-full bg-[#ff4d00] animate-pulse"></div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-bold text-[#262626] dark:text-[#f3f4f6]" id="active-heading-name">Space Grotesk</span>
                <span class="text-xs font-mono text-[#ff4d00]">&plus;</span>
                <span class="text-xs font-mono font-bold text-[#262626] dark:text-[#f3f4f6]" id="active-body-name">Inter</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#ff4d00]/10 text-[#ff4d00] border border-[#ff4d00]/20 ml-2" id="active-vibe-badge">SaaS & Tech</span>
              </div>
              <p class="text-[11px] font-mono text-[#727272] dark:text-[#9ca3af] mt-0.5" id="active-rule-text">
                Neo-brutalist tech headline balanced by ultra-clean neutral UI workhorse.
              </p>
            </div>
          </div>

          <!-- Studio Action Buttons -->
          <div class="flex flex-wrap items-center gap-2 self-stretch sm:self-auto justify-end">
            <!-- Shuffle / Surprise Me Button -->
            <button
              type="button"
              id="btn-shuffle-pair"
              class="px-3.5 py-1.5 rounded-xl border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] hover:border-[#ff4d00] hover:text-[#ff4d00] text-[#262626] dark:text-[#f3f4f6] text-xs font-mono transition-all cursor-pointer inline-flex items-center gap-1.5 shadow-xs"
              title="Pick a random pairing"
            >
              <span>🎲</span>
              <span>Surprise Me</span>
            </button>

            <!-- Invert Roles (Swap Heading & Body) -->
            <button
              type="button"
              id="btn-swap-fonts"
              class="px-3.5 py-1.5 rounded-xl border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] hover:border-[#ff4d00] hover:text-[#ff4d00] text-[#262626] dark:text-[#f3f4f6] text-xs font-mono transition-all cursor-pointer inline-flex items-center gap-1.5 shadow-xs"
              title="Swap Heading and Body fonts"
            >
              <span>⇄</span>
              <span>Invert Roles</span>
            </button>

            <!-- Layout View Switchers -->
            <div class="inline-flex p-0.5 rounded-xl bg-[#e5e7eb]/70 dark:bg-[#242834] border border-[#d1d5db] dark:border-[#2e3446]">
              <button
                type="button"
                id="layout-btn-editorial"
                class="layout-view-btn px-2.5 py-1 rounded-lg text-xs font-mono transition-all bg-white dark:bg-[#15171e] text-[#262626] dark:text-[#f3f4f6] shadow-xs cursor-pointer"
                data-layout="editorial"
              >
                Editorial
              </button>
              <button
                type="button"
                id="layout-btn-saas"
                class="layout-view-btn px-2.5 py-1 rounded-lg text-xs font-mono transition-all text-[#727272] dark:text-[#9ca3af] hover:text-[#262626] dark:hover:text-[#f3f4f6] cursor-pointer"
                data-layout="saas"
              >
                SaaS Hero
              </button>
              <button
                type="button"
                id="layout-btn-product"
                class="layout-view-btn px-2.5 py-1 rounded-lg text-xs font-mono transition-all text-[#727272] dark:text-[#9ca3af] hover:text-[#262626] dark:hover:text-[#f3f4f6] cursor-pointer"
                data-layout="product"
              >
                Product Card
              </button>
            </div>
          </div>
        </div>

        <!-- Studio Hierarchy & Sliders Control Panel -->
        <div class="px-5 py-3 border-b border-[#f3f4f6] dark:border-[#242834] bg-white dark:bg-[#15171e] flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-[#727272] dark:text-[#9ca3af]">
          <div class="flex flex-wrap items-center gap-6">
            <!-- Heading Size Slider -->
            <div class="flex items-center gap-2">
              <span>H1 Size:</span>
              <input
                id="slider-heading-size"
                type="range"
                min="24"
                max="60"
                value="38"
                class="w-24 accent-[#ff4d00] cursor-pointer"
              />
              <span id="label-heading-size" class="w-8 text-[#262626] dark:text-[#f3f4f6] font-medium">38px</span>
            </div>

            <!-- Body Size Slider -->
            <div class="flex items-center gap-2">
              <span>Body Size:</span>
              <input
                id="slider-body-size"
                type="range"
                min="13"
                max="20"
                value="15"
                class="w-20 accent-[#ff4d00] cursor-pointer"
              />
              <span id="label-body-size" class="w-8 text-[#262626] dark:text-[#f3f4f6] font-medium">15px</span>
            </div>

            <!-- Heading Weight -->
            <div class="flex items-center gap-2">
              <span>H1 Weight:</span>
              <select
                id="select-heading-weight"
                class="px-2 py-1 rounded-lg border border-[#e5e7eb] dark:border-[#242834] bg-[#f9fafb] dark:bg-[#101217] text-xs text-[#262626] dark:text-[#f3f4f6] outline-none"
              >
                <option value="400">Regular (400)</option>
                <option value="600">SemiBold (600)</option>
                <option value="700" selected>Bold (700)</option>
                <option value="800">Black (800)</option>
              </select>
            </div>
          </div>

          <div class="text-[11px] text-[#9ca3af] dark:text-[#6b7280]">
            💡 All text below is <span class="text-[#ff4d00]">editable</span> — click to test your own copy
          </div>
        </div>

        <!-- ========================================================================= -->
        <!-- LIVE CANVAS CONTENT AREA (3 Switchable Layouts) -->
        <!-- ========================================================================= -->
        <div class="p-6 sm:p-10 min-h-[380px] bg-white dark:bg-[#15171e] transition-colors">
          
          <!-- LAYOUT 1: EDITORIAL ARTICLE LAYOUT -->
          <div id="canvas-editorial" class="canvas-layout max-w-3xl mx-auto">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-[10px] font-mono uppercase tracking-widest px-2 py-0.5 rounded-sm bg-[#f3f4f6] dark:bg-[#1f2330] text-[#727272] dark:text-[#9ca3af] border border-[#e5e7eb] dark:border-[#2e3446]">
                Typography Monograph
              </span>
              <span class="text-xs font-mono text-[#9ca3af]">&bull; Volume IV</span>
            </div>

            <h1
              id="live-heading-editorial"
              class="font-bold text-[#111827] dark:text-[#f3f4f6] tracking-tight outline-none transition-all leading-[1.15]"
              contenteditable="true"
              spellcheck="false"
              style="font-family: 'Space Grotesk', sans-serif; font-size: 38px; font-weight: 700;"
            >
              Architecture in digital spaces and the mathematical harmony of screens
            </h1>

            <div class="mt-4 pb-4 border-b border-[#f3f4f6] dark:border-[#242834] flex items-center gap-3 text-xs font-mono text-[#727272] dark:text-[#9ca3af]">
              <span>By Elena Rostova</span>
              <span>&bull;</span>
              <span>6 min read</span>
              <span>&bull;</span>
              <span>Published in Architectural Review</span>
            </div>

            <h2
              id="live-subhead-editorial"
              class="mt-6 font-semibold text-[#262626] dark:text-[#e5e7eb] tracking-tight outline-none transition-all text-xl"
              contenteditable="true"
              spellcheck="false"
              style="font-family: 'Space Grotesk', sans-serif;"
            >
              Structuring contrast, optical baseline balance, and typographic pacing
            </h2>

            <p
              id="live-body-editorial-1"
              class="mt-4 text-[#4b5563] dark:text-[#cbd5e1] leading-relaxed outline-none transition-all"
              contenteditable="true"
              spellcheck="false"
              style="font-family: 'Inter', sans-serif; font-size: 15px;"
            >
              Good typography does not call attention to itself; it creates an invisible visual architecture that guides the reader effortlessly through complex hierarchies. When pairing two distinct typefaces, tension and harmony must balance with mathematical rhythm: the heading provides distinctive character and editorial voice, while the body typeface delivers effortless micro-legibility across screens.
            </p>

            <blockquote
              id="live-quote-editorial"
              class="my-6 pl-4 border-l-2 border-[#ff4d00] italic text-[#262626] dark:text-[#f3f4f6] outline-none text-base transition-all"
              contenteditable="true"
              spellcheck="false"
              style="font-family: 'Space Grotesk', serif;"
            >
