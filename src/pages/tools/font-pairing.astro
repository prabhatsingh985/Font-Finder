      const btnSwap = document.getElementById('btn-swap-fonts');

      // Sliders & Weight Select
      const sliderHeadingSize = document.getElementById('slider-heading-size');
      const sliderBodySize = document.getElementById('slider-body-size');
      const labelHeadingSize = document.getElementById('label-heading-size');
      const labelBodySize = document.getElementById('label-body-size');
      const selectHeadingWeight = document.getElementById('select-heading-weight');

      // Layout Views
      const layoutButtons = document.querySelectorAll('.layout-view-btn');
      const canvasEditorial = document.getElementById('canvas-editorial');
      const canvasSaas = document.getElementById('canvas-saas');
      const canvasProduct = document.getElementById('canvas-product');

      // Export Type Buttons
      const exportButtons = document.querySelectorAll('.btn-export-type');

      // Live Elements in Canvas
      const headingElements = [
        document.getElementById('live-heading-editorial'),
        document.getElementById('live-subhead-editorial'),
        document.getElementById('live-heading-saas'),
        document.getElementById('live-heading-product')
      ];

      const bodyElements = [
        document.getElementById('live-body-editorial-1'),
        document.getElementById('live-body-editorial-2'),
        document.getElementById('live-quote-editorial'),
        document.getElementById('live-body-saas'),
        document.getElementById('live-body-product')
      ];

      // Directory Search & Filter Elements
      const searchInput = document.getElementById('pairing-search');
      const vibeButtons = document.querySelectorAll('.vibe-btn');
      const cards = document.querySelectorAll('.pair-card');
      const pairCount = document.getElementById('pair-count');
      const noResults = document.getElementById('no-pairings');

      // State
      let currentPairIndex = 0;
      let activeHeading = pairingsData[0]?.heading || 'Space Grotesk';
      let activeHeadingCat = pairingsData[0]?.headingCat || 'sans-serif';
      let activeBody = pairingsData[0]?.body || 'Inter';
      let activeBodyCat = pairingsData[0]?.bodyCat || 'sans-serif';
      let activeVibe = pairingsData[0]?.vibe || 'SaaS & Tech';
      let activeRule = pairingsData[0]?.contrastRule || '';
      let activeExportType = 'css';

      let directoryFilterVibe = 'All';
      let directorySearchQuery = '';

      // Load Google Font Dynamically into Head
      function ensureFontLoaded(fontName) {
        const id = `gfont-${fontName.replace(/\s+/g, '-').toLowerCase()}`;
        if (!document.getElementById(id)) {
          const link = document.createElement('link');
          link.id = id;
          link.rel = 'stylesheet';
          link.href = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(fontName).replace(/%20/g, '+')}:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap`;
          document.head.appendChild(link);
        }
      }

      // Generate Production Export Code Snippet
      function generateCodeSnippet(h, hCat, b, bCat, type) {
        const encodedH = encodeURIComponent(h).replace(/%20/g, '+');
        const encodedB = encodeURIComponent(b).replace(/%20/g, '+');

        if (type === 'import') {
          return `@import url('https://fonts.googleapis.com/css2?family=${encodedH}:wght@600;700&family=${encodedB}:wght@400;500;600&display=swap');`;
        } else if (type === 'tailwind') {
          return `// tailwind.config.js\nmodule.exports = {\n  theme: {\n    extend: {\n      fontFamily: {\n        heading: ["'${h}'", "${hCat.toLowerCase()}"],\n        body: ["'${b}'", "${bCat.toLowerCase()}"]\n      }\n    }\n  }\n};`;
        } else {
          return `/* Design System CSS Variables */\n:root {\n  --font-heading: '${h}', ${hCat.toLowerCase()};\n  --font-body: '${b}', ${bCat.toLowerCase()};\n}\n\nh1, h2, h3, h4 {\n  font-family: var(--font-heading);\n}\n\nbody, p, input, button {\n  font-family: var(--font-body);\n}`;
        }
      }

      // Update Studio Elements
      function applyPairToStudio(pair) {
        activeHeading = pair.heading;
        activeHeadingCat = pair.headingCat;
        activeBody = pair.body;
        activeBodyCat = pair.bodyCat;
        activeVibe = pair.vibe;
        activeRule = pair.contrastRule;

        ensureFontLoaded(activeHeading);
        ensureFontLoaded(activeBody);

        if (activeHeadingName) activeHeadingName.textContent = activeHeading;
        if (activeBodyName) activeBodyName.textContent = activeBody;
        if (activeVibeBadge) activeVibeBadge.textContent = activeVibe;
        if (activeRuleText) activeRuleText.textContent = activeRule;

        // Apply to Headings
        headingElements.forEach((el) => {
          if (el) el.style.fontFamily = `'${activeHeading}', ${activeHeadingCat.toLowerCase()}`;
        });

        // Apply to Body
        bodyElements.forEach((el) => {
          if (el) el.style.fontFamily = `'${activeBody}', ${activeBodyCat.toLowerCase()}`;
        });

        // Update Code Block
        if (activeCodeDisplay) {
          activeCodeDisplay.textContent = generateCodeSnippet(activeHeading, activeHeadingCat, activeBody, activeBodyCat, activeExportType);
        }
      }

      // Initialize Studio with first pair
      if (pairingsData.length > 0) {
        applyPairToStudio(pairingsData[0]);
      }

      // Swap Heading and Body
      btnSwap?.addEventListener('click', () => {
        const tempH = activeHeading;
        const tempHCat = activeHeadingCat;
        activeHeading = activeBody;
        activeHeadingCat = activeBodyCat;
        activeBody = tempH;
        activeBodyCat = tempHCat;

        applyPairToStudio({
          heading: activeHeading,
          headingCat: activeHeadingCat,
          body: activeBody,
          bodyCat: activeBodyCat,
          vibe: activeVibe,
          contrastRule: `Inverted Role: ${activeHeading} for titles, ${activeBody} for body.`
        });
      });

      // Shuffle / Surprise Me
      btnShuffle?.addEventListener('click', () => {
        let nextIndex;
        do {
          nextIndex = Math.floor(Math.random() * pairingsData.length);
        } while (nextIndex === currentPairIndex && pairingsData.length > 1);

        currentPairIndex = nextIndex;
        applyPairToStudio(pairingsData[currentPairIndex]);
      });

      // Sliders & Weight
      sliderHeadingSize?.addEventListener('input', (e) => {
        const val = e.target.value;
        if (labelHeadingSize) labelHeadingSize.textContent = `${val}px`;
        const h1 = document.getElementById('live-heading-editorial');
        const hSaas = document.getElementById('live-heading-saas');
        if (h1) h1.style.fontSize = `${val}px`;
        if (hSaas) hSaas.style.fontSize = `${Math.min(val * 1.1, 56)}px`;
      });

      sliderBodySize?.addEventListener('input', (e) => {
        const val = e.target.value;
        if (labelBodySize) labelBodySize.textContent = `${val}px`;
        bodyElements.forEach((el) => {
          if (el && el.id !== 'live-quote-editorial') {
            el.style.fontSize = `${val}px`;
          }
        });
      });

      selectHeadingWeight?.addEventListener('change', (e) => {
        const val = e.target.value;
        headingElements.forEach((el) => {
          if (el) el.style.fontWeight = val;
        });
      });

      // Layout Switcher
      layoutButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          layoutButtons.forEach((b) => {
            b.className = 'layout-view-btn px-2.5 py-1 rounded-lg text-xs font-mono transition-all text-[#727272] dark:text-[#9ca3af] hover:text-[#262626] dark:hover:text-[#f3f4f6] cursor-pointer';
          });
          btn.className = 'layout-view-btn px-2.5 py-1 rounded-lg text-xs font-mono transition-all bg-white dark:bg-[#15171e] text-[#262626] dark:text-[#f3f4f6] shadow-xs cursor-pointer';

          const layout = btn.getAttribute('data-layout');
          if (layout === 'editorial') {
            canvasEditorial?.classList.remove('hidden');
            canvasSaas?.classList.add('hidden');
            canvasProduct?.classList.add('hidden');
          } else if (layout === 'saas') {
            canvasSaas?.classList.remove('hidden');
            canvasEditorial?.classList.add('hidden');
            canvasProduct?.classList.add('hidden');
          } else if (layout === 'product') {
            canvasProduct?.classList.remove('hidden');
            canvasEditorial?.classList.add('hidden');
            canvasSaas?.classList.add('hidden');
          }
        });
      });

      // Export Type Buttons
      exportButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          exportButtons.forEach((b) => {
            b.className = 'btn-export-type px-2.5 py-1 rounded text-[11px] font-mono text-[#727272] dark:text-[#9ca3af] cursor-pointer';
          });
          btn.className = 'btn-export-type px-2.5 py-1 rounded text-[11px] font-mono bg-white dark:bg-[#15171e] text-[#262626] dark:text-[#f3f4f6] shadow-xs cursor-pointer';

          activeExportType = btn.getAttribute('data-type') || 'css';
          if (activeCodeDisplay) {
            activeCodeDisplay.textContent = generateCodeSnippet(activeHeading, activeHeadingCat, activeBody, activeBodyCat, activeExportType);
          }
        });
      });

      // Copy Active Code
      btnCopyActiveCode?.addEventListener('click', () => {
        const text = activeCodeDisplay?.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          const original = btnCopyActiveCode.innerHTML;
          btnCopyActiveCode.innerHTML = '<span>✓ Copied!</span>';
          setTimeout(() => {
            btnCopyActiveCode.innerHTML = original;
          }, 1800);
        });
      });

      // Load Pairing from Directory Card into Studio
      document.querySelectorAll('.btn-load-studio').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const pair = pairingsData.find((p) => p.id === id);
          if (pair) {
            applyPairToStudio(pair);
            document.getElementById('studio')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // Copy Card CSS button
      document.querySelectorAll('.btn-copy-card-css').forEach((btn) => {
        btn.addEventListener('click', () => {
          const css = btn.getAttribute('data-css') || '';
          navigator.clipboard.writeText(css).then(() => {
            const original = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('bg-[#ff4d00]');
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove('bg-[#ff4d00]');
            }, 1800);
          });
        });
      });

      // Directory Search and Vibe Filter Logic
      function filterDirectory() {
        let visible = 0;
        cards.forEach((card) => {
          const heading = (card.getAttribute('data-heading') || '').toLowerCase();
          const body = (card.getAttribute('data-body') || '').toLowerCase();
          const vibe = card.getAttribute('data-vibe') || '';

          const matchesVibe = directoryFilterVibe === 'All' || vibe === directoryFilterVibe;
          const matchesSearch = !directorySearchQuery || heading.includes(directorySearchQuery) || body.includes(directorySearchQuery) || vibe.toLowerCase().includes(directorySearchQuery);

          if (matchesVibe && matchesSearch) {
            card.classList.remove('hidden');
            visible++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (pairCount) pairCount.textContent = String(visible);
        if (noResults) {
          if (visible === 0) noResults.classList.remove('hidden');
          else noResults.classList.add('hidden');
        }
      }

      searchInput?.addEventListener('input', (e) => {
        directorySearchQuery = e.target.value.trim().toLowerCase();
        filterDirectory();
      });

      vibeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          vibeButtons.forEach((b) => {
            b.className = 'vibe-btn text-xs font-mono px-3.5 py-1.5 rounded-full border transition-all cursor-pointer bg-white dark:bg-[#15171e] border-[#e5e7eb] dark:border-[#242834] text-[#4b5563] dark:text-[#cbd5e1] hover:border-[#ff4d00] hover:text-[#ff4d00]';
          });
          btn.className = 'vibe-btn text-xs font-mono px-3.5 py-1.5 rounded-full border transition-all cursor-pointer bg-[#262626] dark:bg-[#242834] text-white border-transparent';
          directoryFilterVibe = btn.getAttribute('data-vibe') || 'All';
          filterDirectory();
        });
      });
    })();
  </script>
</BaseLayout>
