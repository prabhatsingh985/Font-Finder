---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pairings = [
  {
    id: 'pair-1',
    heading: 'Playfair Display',
    headingCat: 'Serif',
    body: 'Source Sans 3',
    bodyCat: 'Sans-Serif',
    vibe: 'Editorial & Elegant',
    description: 'High-contrast luxury serif headlines paired with clean, ultra-legible humanist body text.'
  },
  {
    id: 'pair-2',
    heading: 'Space Grotesk',
    headingCat: 'Sans-Serif',
    body: 'Inter',
    bodyCat: 'Sans-Serif',
    vibe: 'SaaS & Tech',
    description: 'Distinctive neo-brutalist tech headline font balanced by the neutrality of Inter.'
  },
  {
    id: 'pair-3',
    heading: 'Montserrat',
    headingCat: 'Sans-Serif',
    body: 'Lora',
    bodyCat: 'Serif',
    vibe: 'Modern Minimalist',
    description: 'Geometric architectural capitals grounded by warm, calligraphic literary serif body copy.'
  },
  {
    id: 'pair-4',
    heading: 'Cinzel',
    headingCat: 'Serif',
    body: 'Fauna One',
    bodyCat: 'Serif',
    vibe: 'Luxury & Fashion',
    description: 'Classical Roman inscriptional title font accompanied by a gentle transitional text serif.'
  },
  {
    id: 'pair-5',
    heading: 'Oswald',
    headingCat: 'Sans-Serif',
    body: 'Merriweather',
    bodyCat: 'Serif',
    vibe: 'Creative & Bold',
    description: 'Impactful condensed display headline combined with robust, readable editorial serif.'
  },
  {
    id: 'pair-6',
    heading: 'Syne',
    headingCat: 'Display',
    body: 'DM Sans',
    bodyCat: 'Sans-Serif',
    vibe: 'Creative & Bold',
    description: 'Explosive contemporary art-direction display font paired with balanced geometric sans.'
  }
];

const pairingsJson = JSON.stringify(pairings);
---

<BaseLayout
  title="Font Pairing Generator — Free Typography Combination Matcher"
  description="Select a primary font or aesthetic vibe to generate proven Google Font headline and body pairings with instant CSS."
>
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-grid-pattern-subtle border-b border-[#e5e7eb] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto text-center">
      <!-- Breadcrumb & Tag -->
      <div class="inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-[#f9fafb] dark:bg-[#15171e] border border-[#e5e7eb] dark:border-[#242834]">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <a href="/tools" class="text-xs font-mono text-[#727272] dark:text-[#9ca3af] hover:text-[#ff4d00] transition-colors">Tools</a>
        <span class="text-xs text-[#d1d5db] dark:text-[#4b5563]">/</span>
        <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Font Pairing Generator</span>
      </div>

      <!-- Centered Minimalist Hero -->
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] dark:text-[#f3f4f6] tracking-tight max-w-2xl mx-auto">
        Find a font pairing
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#727272] dark:text-[#9ca3af] max-w-lg mx-auto">
        Select a primary font or style to generate designer-tested headline & body combinations with live CSS.
      </p>

      <!-- Specific Input: Primary Font & Vibe Picker -->
      <div class="mt-8 sm:mt-12 w-full max-w-[1000px] mx-auto text-left">
        <!-- Search / Primary Font Input -->
        <div class="relative">
          <input
            id="pairing-search"
            type="text"
            placeholder="Filter by font name (e.g. Playfair, Inter, Montserrat, Space Grotesk)..."
            class="w-full pl-11 pr-4 py-3.5 rounded-2xl border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] text-sm text-[#262626] dark:text-[#f3f4f6] shadow-[0_0_0_6px_rgb(249,249,249)] dark:shadow-[0_0_0_6px_rgba(21,23,30,0.9)] focus:outline-none focus:border-[#ff4d00] placeholder:text-[#9ca3af] dark:placeholder:text-[#6b7280] transition-all"
          />
          <svg class="w-5 h-5 text-[#727272] dark:text-[#9ca3af] absolute left-4 top-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Vibe Filter Chips -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2" id="vibe-filters">
          {['All', 'SaaS & Tech', 'Editorial & Elegant', 'Modern Minimalist', 'Luxury & Fashion', 'Creative & Bold'].map((vibe, idx) => (
            <button
              type="button"
              data-vibe={vibe}
              class={`vibe-btn text-xs font-mono px-3 py-1 rounded-full border transition-all cursor-pointer ${
                idx === 0
                  ? 'bg-[#262626] dark:bg-[#242834] text-white border-transparent'
                  : 'bg-white dark:bg-[#15171e] border-[#e5e7eb] dark:border-[#242834] text-[#4b5563] dark:text-[#cbd5e1] hover:border-[#ff4d00] hover:text-[#ff4d00]'
              }`}
            >
              {vibe}
            </button>
          ))}
        </div>
      </div>

      <!-- Live Specimen Live Customizer -->
      <div class="mt-8 w-full max-w-[1000px] mx-auto flex items-center justify-between text-xs font-mono text-[#727272] dark:text-[#9ca3af] px-1">
        <span>Editable specimen text:</span>
        <span id="pair-count" class="text-[11px] text-[#ff4d00]">Showing 6 pairings</span>
      </div>

      <!-- Pairs List -->
      <div id="pairings-container" class="mt-4 space-y-6 w-full max-w-[1000px] mx-auto text-left">
      {pairings.map((p) => {
        const encodedHeading = encodeURIComponent(p.heading).replace(/%20/g, '+');
        const encodedBody = encodeURIComponent(p.body).replace(/%20/g, '+');
        return (
          <div
            class="pair-card p-6 rounded-2xl border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#15171e] shadow-xs hover:border-[#ff4d00]/40 transition-all"
            data-heading={p.heading.toLowerCase()}
            data-body={p.body.toLowerCase()}
            data-vibe={p.vibe}
          >
            <!-- Google Fonts embed -->
            <link
              rel="stylesheet"
              href={`https://fonts.googleapis.com/css2?family=${encodedHeading}:wght@600;700&family=${encodedBody}:wght@400;500&display=swap`}
            />

            <!-- Top bar -->
            <div class="flex items-center justify-between gap-3 pb-4 border-b border-[#f3f4f6] dark:border-[#242834]">
              <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-[#f3f4f6] dark:bg-[#1f2330] text-[#4b5563] dark:text-[#cbd5e1] border border-[#e5e7eb] dark:border-[#2e3446]">
                {p.vibe}
              </span>
              <div class="flex items-center gap-2 text-xs font-mono text-[#727272] dark:text-[#9ca3af]">
                <span>{p.heading}</span>
                <span class="text-[#ff4d00]">&plus;</span>
                <span>{p.body}</span>
              </div>
            </div>

            <!-- Live Typography Preview -->
            <div class="my-5">
              <h2
                class="text-2xl sm:text-3xl font-bold text-[#262626] dark:text-[#f3f4f6] tracking-tight outline-none"
                contenteditable="true"
                spellcheck="false"
                style={`font-family: '${p.heading}', serif;`}
              >
                Architecture in digital spaces
              </h2>
              <p
                class="mt-3 text-sm text-[#4b5563] dark:text-[#cbd5e1] leading-relaxed outline-none"
                contenteditable="true"
                spellcheck="false"
                style={`font-family: '${p.body}', sans-serif;`}
              >
                Good typography establishes visual hierarchy and guides the reader effortlessly. Click anywhere in this text to test your own copy.
              </p>
            </div>

            <!-- Actions & CSS declaration -->
            <div class="pt-4 border-t border-[#f3f4f6] dark:border-[#242834] flex flex-wrap items-center justify-between gap-3">
              <button
                type="button"
                data-css={`/* Heading */\nfont-family: '${p.heading}', ${p.headingCat.toLowerCase()};\n\n/* Body */\nfont-family: '${p.body}', ${p.bodyCat.toLowerCase()};`}
                class="btn-copy-pair px-4 py-1.5 rounded-full bg-[#262626] dark:bg-[#242834] text-white text-xs font-mono font-medium hover:bg-[#ff4d00] transition-colors cursor-pointer"
              >
                Copy Pair CSS
              </button>

              <div class="flex items-center gap-3 text-xs font-mono">
                <a
                  href={`https://fonts.google.com/specimen/${p.heading.replace(/\s+/g, '+')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#727272] dark:text-[#9ca3af] hover:text-[#ff4d00] transition-colors"
                >
                  {p.heading} &rarr;
                </a>
                <a
                  href={`https://fonts.google.com/specimen/${p.body.replace(/\s+/g, '+')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#727272] dark:text-[#9ca3af] hover:text-[#ff4d00] transition-colors"
                >
                  {p.body} &rarr;
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div id="no-pairings" class="hidden py-12 text-center text-xs font-mono text-[#727272] dark:text-[#9ca3af]">
      No pairings matched your search. Try "Playfair", "Inter", or select "All".
    </div>
    </div>
  </section>

  <script id="pairings-data" type="application/json" is:inline set:html={pairingsJson}></script>
  <script is:inline>
    (function () {
      const searchInput = document.getElementById('pairing-search');
      const vibeButtons = document.querySelectorAll('.vibe-btn');
      const cards = document.querySelectorAll('.pair-card');
      const pairCount = document.getElementById('pair-count');
      const noResults = document.getElementById('no-pairings');

      let activeVibe = 'All';
      let searchQuery = '';

      function filterCards() {
        let visible = 0;
        cards.forEach((card) => {
          const heading = card.getAttribute('data-heading') || '';
          const body = card.getAttribute('data-body') || '';
          const vibe = card.getAttribute('data-vibe') || '';

          const matchesVibe = activeVibe === 'All' || vibe === activeVibe;
          const matchesSearch = !searchQuery || heading.includes(searchQuery) || body.includes(searchQuery);

          if (matchesVibe && matchesSearch) {
            card.classList.remove('hidden');
            visible++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (pairCount) pairCount.textContent = `Showing ${visible} pairings`;
        if (noResults) {
          if (visible === 0) noResults.classList.remove('hidden');
          else noResults.classList.add('hidden');
        }
      }

      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        filterCards();
      });

      vibeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          vibeButtons.forEach((b) => {
            b.className = 'vibe-btn text-xs font-mono px-3 py-1 rounded-full border transition-all cursor-pointer bg-white dark:bg-[#15171e] border-[#e5e7eb] dark:border-[#242834] text-[#4b5563] dark:text-[#cbd5e1] hover:border-[#ff4d00] hover:text-[#ff4d00]';
          });
          btn.className = 'vibe-btn text-xs font-mono px-3 py-1 rounded-full border transition-all cursor-pointer bg-[#262626] dark:bg-[#242834] text-white border-transparent';
          activeVibe = btn.getAttribute('data-vibe') || 'All';
          filterCards();
        });
      });

      document.querySelectorAll('.btn-copy-pair').forEach((btn) => {
        btn.addEventListener('click', () => {
          const css = btn.getAttribute('data-css') || '';
          navigator.clipboard.writeText(css).then(() => {
            const original = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('bg-[#ff4d00]');
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove('bg-[#ff4d00]');
            }, 1800);
          });
        });
      });
    })();
  </script>
</BaseLayout>
