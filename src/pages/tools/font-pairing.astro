---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';

const pairings = [
  {
    header: 'Playfair Display',
    headerCat: 'Serif',
    body: 'Source Sans Pro',
    bodyCat: 'Sans-Serif',
    vibe: 'Editorial & Elegant'
  },
  {
    header: 'Montserrat',
    headerCat: 'Sans-Serif',
    body: 'Lora',
    bodyCat: 'Serif',
    vibe: 'Modern Classic'
  },
  {
    header: 'Space Grotesk',
    headerCat: 'Sans-Serif',
    body: 'Inter',
    bodyCat: 'Sans-Serif',
    vibe: 'Tech & SaaS'
  },
  {
    header: 'Cinzel',
    headerCat: 'Serif',
    body: 'Fauna One',
    bodyCat: 'Serif',
    vibe: 'Luxury & Cinematic'
  }
];
---

<BaseLayout
  title="Find a Font Pairing — Typography Companion Generator & Matcher"
  description="Identify one font, then get the harmonizing companions that work alongside it for headlines, body copy, and UI accents."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-[1200px] mx-auto">
    <!-- Breadcrumb & Tag -->
    <div class="flex items-center gap-2 mb-3">
      <a href="/tools" class="text-xs font-mono text-[#727272] hover:text-[#ff4d00] transition-colors">Tools</a>
      <span class="text-xs text-[#d1d5db]">/</span>
      <span class="text-xs font-mono text-[#ff4d00] uppercase tracking-wider">Font Pairing Matcher</span>
    </div>

    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl font-medium text-[#262626] tracking-tight">
        Find a font pairing
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-[#727272] leading-relaxed">
        Identify your primary typeface first, then generate proven typographic combinations for headlines, body text, and UI components.
      </p>
    </div>

    <!-- Core Scanner Tool -->
    <div class="mt-10">
      <FontFinderApp />
    </div>

    <!-- Popular Font Pairings Cheat Sheet -->
    <div class="mt-16 pt-12 border-t border-[#e5e7eb]">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">CURATED COMBINATIONS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#111827] tracking-tight mb-3">
        Tested Google Font pairings
      </h2>
      <p class="text-sm text-[#6b7280] max-w-xl mb-8">
        Use these battle-tested typeface pairings that follow strict rules of contrast, hierarchy, and proportional x-height harmony.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {pairings.map((p) => (
          <div class="p-5 rounded-2xl border border-[#e5e7eb] bg-white hover:border-[#ff4d00]/30 transition-colors">
            <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-[#f3f4f6] text-[#4b5563]">
              {p.vibe}
            </span>
            <div class="mt-4">
              <div class="text-xs text-[#9ca3af] font-mono">HEADING</div>
              <div class="font-bold text-[#111827] text-base mt-0.5">{p.header}</div>
              <span class="text-[11px] text-[#6b7280]">{p.headerCat}</span>
            </div>
            <div class="mt-3 pt-3 border-t border-[#f3f4f6]">
              <div class="text-xs text-[#9ca3af] font-mono">BODY</div>
              <div class="font-medium text-[#374151] text-sm mt-0.5">{p.body}</div>
              <span class="text-[11px] text-[#6b7280]">{p.bodyCat}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Pairing Rules -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-[#f9fafb]">
        <h3 class="font-bold text-[#111827] text-sm mb-1.5">1. Contrast is King</h3>
        <p class="text-xs text-[#6b7280] leading-relaxed">
          Pair a strong Serif headline with a neutral Sans-Serif body, or a distinctive Display header with an ultra-legible geometric workhorse.
        </p>
      </div>
      <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-[#f9fafb]">
        <h3 class="font-bold text-[#111827] text-sm mb-1.5">2. Match the x-Height</h3>
        <p class="text-xs text-[#6b7280] leading-relaxed">
          When switching between fonts across identical line-height layouts, ensure both fonts share similar lowercase x-height proportions.
        </p>
      </div>
      <div class="p-6 rounded-2xl border border-[#e5e7eb] bg-[#f9fafb]">
        <h3 class="font-bold text-[#111827] text-sm mb-1.5">3. Limit to Two Families</h3>
        <p class="text-xs text-[#6b7280] leading-relaxed">
          Stick to 2 typeface families maximum. Create variety through weights (e.g. 400, 600, 800) and italic styles instead of adding third fonts.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
