---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import NeonCursorTrail from '../components/NeonCursorTrail.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const { title, description, canonicalUrl, ogImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <!-- Prevent dark mode flash -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        const userPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && userPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground transition-colors duration-200">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-foreground text-background font-medium rounded-md shadow-lg"
    >
      Skip to content
    </a>

    <Navbar />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <NeonCursorTrail />
    <Footer />
  </body>
</html>
