---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getViewTranslations } from '../../i18n/viewTranslations';
import type { SupportedLocale } from '../../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentLocale = lang as SupportedLocale;
const t = useTranslations(lang);
const lT = t.logoFontFinder;
const vT = getViewTranslations(lang).logo;
const toolsHref = getLocalizedPath('/tools', currentLocale);
const p = (path: string) => getLocalizedPath(path, currentLocale);

// Famous Brand Logos Typography Database
const brandLogos = [
  {
    id: 'nike',
    brand: 'Nike',
    industry: 'Apparel & Sports',
    industrySlug: 'apparel',
    officialFont: 'Futura Bold Extra Condensed (Oblique)',
    foundry: 'Bauer / Monotype',
    sampleText: 'JUST DO IT',
    notes: 'The iconic Nike wordmark and "Just Do It" campaign use a customized, tightly kerned heavyweight italic cut of Futura Condensed.',
    freeName: 'Oswald',
    freeDesigner: 'Vernon Adams',
    freeSlug: 'oswald',
    similarity: '97%',
    reason: 'Athletic uppercase vertical rhythm, punchy condensed monoline stems, and near-identical letter proportions.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap');\nfont-family: 'Oswald', sans-serif;\nfont-weight: 700;\nfont-style: italic;",
    googleFontUrl: 'https://fonts.google.com/specimen/Oswald'
  },
  {
    id: 'supreme',
    brand: 'Supreme',
    industry: 'Fashion & Streetwear',
    industrySlug: 'fashion',
