---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import type { SupportedLocale } from '../../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentLocale = lang as SupportedLocale;
const t = useTranslations(lang);
const hT = t.handwritingFontFinder;
---

<BaseLayout
  title={hT.meta.title}
  description={hT.meta.description}
  lang={lang}
>
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-[#08090a] bg-grid-pattern-subtle border-b border-[#23252a] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto text-center">
      

      <!-- Hero Header -->
      <h1 class="text-3xl sm:text-5xl font-medium text-[#ffffff] tracking-tight max-w-2xl mx-auto" style="letter-spacing: -0.022em;">
        {hT.title}
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#8a8f98] max-w-xl mx-auto leading-relaxed">
        {hT.subtitle}
      </p>

      <!-- Scan Handwriting Image UI -->
      <div class="mt-8 sm:mt-12 w-full max-w-[1020px] mx-auto text-left">
        <FontFinderApp
          lang={lang}
          dropzoneTitle={hT.dropzoneTitle}
          dropzoneSubtitle={hT.dropzoneSubtitle}
          buttonText={hT.buttonText}
        />
      </div>

    </div>
  </section>
</BaseLayout>
