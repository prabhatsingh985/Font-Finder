---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getViewTranslations } from '../../i18n/viewTranslations';
import type { SupportedLocale } from '../../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentLocale = lang as SupportedLocale;
const t = useTranslations(lang);
const cT = t.commercialAlternative;
const vT = getViewTranslations(lang).commercial;
const toolsHref = getLocalizedPath('/tools', currentLocale);
const p = (path: string) => getLocalizedPath(path, currentLocale);

// Curated High-Intent Commercial to Free Google Font Equivalents Database
const commercialDatabase = [
  {
    id: 'helvetica',
    paid: 'Helvetica Neue',
    foundry: 'Linotype / Monotype',
    price: '$35 / weight',
    category: 'Neo-Grotesque',
    categorySlug: 'neo-grotesque',
    description: 'The quintessential Swiss Neo-Grotesque typeface designed by Max Miedinger with Eduard Hoffmann. Renowned for neutral tone, horizontal terminals, and dense texture.',
    freeName: 'Inter',
    freeDesigner: 'Rasmus Andersson',
    freeSlug: 'inter',
    similarity: '98%',
    reason: 'Identical tall x-height, monoline stroke rhythm, and strictly horizontal terminal cuts, optimized for ultra-crisp screen legibility.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\nfont-family: 'Inter', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Inter'
  },
  {
    id: 'futura',
    paid: 'Futura',
    foundry: 'Bauer / Monotype',
    price: '$45 / weight',
    category: 'Geometric Sans',
    categorySlug: 'geometric',
    description: 'Designed by Paul Renner in 1927. The iconic classic geometric sans-serif based on strict Bauhaus geometry: circles, triangles, and squares.',
    freeName: 'Jost',
    freeDesigner: 'indestructible type*',
    freeSlug: 'jost',
    similarity: '96%',
    reason: 'Faithful open-source tribute to 1920s German constructivism with matching sharp pointed apexes on A/M/N and pure circular O.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;600;700;800&display=swap');\nfont-family: 'Jost', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Jost'
  },
  {
    id: 'gotham',
    paid: 'Gotham',
    foundry: 'Hoefler & Co.',
    price: '$199 / family',
    category: 'Geometric Sans',
    categorySlug: 'geometric',
    description: 'Inspired by mid-century architectural lettering in New York City. Wide uppercase stance, generous open counters, and high modern authority.',
    freeName: 'Montserrat',
    freeDesigner: 'Julieta Ulanovsky',
    freeSlug: 'montserrat',
    similarity: '96%',
    reason: 'Broad uppercase proportions, architectural geometric baseline balance, and clean circular loops inspired by urban signage.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');\nfont-family: 'Montserrat', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Montserrat'
  },
  {
    id: 'proxima-nova',
    paid: 'Proxima Nova',
    foundry: 'Mark Simonson Studio',
    price: '$29 / weight',
    category: 'Geometric Sans',
    categorySlug: 'geometric',
    description: 'Bridges the gap between geometric and humanist proportion. Widely regarded as the modern web classic used by Spotify, BuzzFeed, and Wired.',
    freeName: 'Montserrat',
    freeDesigner: 'Julieta Ulanovsky',
    freeSlug: 'montserrat',
    similarity: '95%',
    reason: 'Near-identical hybrid geometric-grotesque proportions, crisp terminal angles, and open contemporary digital rhythm.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap');\nfont-family: 'Montserrat', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Montserrat'
  },
  {
    id: 'avenir',
    paid: 'Avenir',
    foundry: 'Linotype / Monotype',
    price: '$35 / weight',
    category: 'Geometric Sans',
    categorySlug: 'geometric',
    description: 'Designed by Adrian Frutiger as an organic, humanist answer to rigid geometric typefaces, with softened vertical terminals and balanced circles.',
    freeName: 'Nunito Sans',
    freeDesigner: 'Vernon Adams',
    freeSlug: 'nunito-sans',
    similarity: '95%',
    reason: 'Organic warmth blended with geometric precision, featuring matching round counters and comfortable text cadence.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&display=swap');\nfont-family: 'Nunito Sans', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Nunito+Sans'
  },
  {
    id: 'circular',
    paid: 'Circular Std',
    foundry: 'Lineto',
    price: 'CHF 180 / family',
    category: 'Neo-Grotesque',
    categorySlug: 'neo-grotesque',
    description: 'Designed by Laurent Benner. The signature typographic voice of tech giants including Spotify and Airbnb, combining warmth with Swiss structure.',
    freeName: 'Plus Jakarta Sans',
    freeDesigner: 'Tokotype',
    freeSlug: 'plus-jakarta-sans',
    similarity: '97%',
    reason: 'Warm circular counters, friendly geometric grotesque stems, and matching lowercase t curvature engineered for modern digital interfaces.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\nfont-family: 'Plus Jakarta Sans', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Plus+Jakarta+Sans'
  },
  {
    id: 'neue-haas-grotesk',
    paid: 'Neue Haas Grotesk',
    foundry: 'Linotype',
    price: '$35 / weight',
    category: 'Neo-Grotesque',
    categorySlug: 'neo-grotesque',
    description: 'The authentic digital restoration of Helvetica by Christian Schwartz, returning to the original metal type proportions and delicate optical weights.',
    freeName: 'Inter',
    freeDesigner: 'Rasmus Andersson',
    freeSlug: 'inter',
    similarity: '98%',
    reason: 'Strict horizontal terminal cuts, neutral closed apertures, and flawless high-density visual texture in body and display copy.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\nfont-family: 'Inter', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Inter'
  },
  {
    id: 'didot',
    paid: 'Didot',
    foundry: 'Linotype / Monotype',
    price: '$49 / weight',
    category: 'Serif',
    categorySlug: 'serif',
    description: 'The defining French neoclassical Didone typeface. Dramatic razor-thin horizontal serifs and extreme vertical stroke contrast used across luxury fashion.',
    freeName: 'Playfair Display',
    freeDesigner: 'Claus Eggers Sørensen',
    freeSlug: 'playfair-display',
    similarity: '97%',
    reason: 'Dramatic thick-to-thin vertical stroke contrast, delicate hairline serifs, and high-fashion editorial sophistication.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap');\nfont-family: 'Playfair Display', serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Playfair+Display'
  },
  {
    id: 'din',
    paid: 'DIN / FF DIN',
    foundry: 'FontFont / Monotype',
    price: '$65 / weight',
    category: 'Display & Slab',
    categorySlug: 'display',
    description: 'The German industrial standard (Deutsches Institut für Normung) engineered for traffic signage, technical blueprints, and brutalist engineering layouts.',
    freeName: 'Barlow Condensed',
    freeDesigner: 'Jeremy Tribby',
    freeSlug: 'barlow-condensed',
    similarity: '96%',
    reason: 'Slightly rounded industrial signage grotesk inspired by California highway transit, capturing DIN’s narrow vertical rhythm.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700&display=swap');\nfont-family: 'Barlow Condensed', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Barlow+Condensed'
  },
  {
    id: 'garamond',
    paid: 'Adobe Garamond',
    foundry: 'Adobe / Monotype',
    price: '$39 / weight',
    category: 'Serif',
    categorySlug: 'serif',
    description: 'The quintessential 16th-century Renaissance serif designed by Claude Garamont. Renowned for timeless literary warmth and organic calligraphic grace.',
    freeName: 'EB Garamond',
    freeDesigner: 'Georg Duffner',
    freeSlug: 'eb-garamond',
    similarity: '98%',
    reason: 'Exacting open-source scholarly revival of the classical 1592 Egenolff-Berner specimen with natural calligraphic modulation.',
    css: "@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400&display=swap');\nfont-family: 'EB Garamond', serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/EB+Garamond'
  },
  {
    id: 'baskerville',
    paid: 'Baskerville Pro',
    foundry: 'Monotype',
    price: '$35 / weight',
    category: 'Serif',
    categorySlug: 'serif',
    description: 'The landmark 18th-century English Transitional serif created by John Baskerville, featuring high stroke contrast and sharply bracketed serifs.',
    freeName: 'Libre Baskerville',
    freeDesigner: 'Impallari Type',
    freeSlug: 'libre-baskerville',
    similarity: '98%',
    reason: 'Optimized digital transitional revival with wider counters, taller x-height, and open bracketed serifs built for effortless screen reading.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');\nfont-family: 'Libre Baskerville', serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Libre+Baskerville'
  },
  {
    id: 'gill-sans',
    paid: 'Gill Sans',
    foundry: 'Monotype',
    price: '$35 / weight',
    category: 'Humanist Sans',
    categorySlug: 'humanist',
    description: 'Eric Gill’s 1928 British modernist classic, blending classical Roman capital proportions with warm humanist lowercase curves.',
    freeName: 'Cabin',
    freeDesigner: 'Pablo Impallari',
    freeSlug: 'cabin',
    similarity: '95%',
    reason: 'Humanist sans with subtle organic curves, modern proportions, and open British cadence with clean horizontal cuts.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400;0,600;0,700;1,400&display=swap');\nfont-family: 'Cabin', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Cabin'
  },
  {
    id: 'frutiger',
    paid: 'Frutiger',
    foundry: 'Linotype / Monotype',
    price: '$35 / weight',
    category: 'Humanist Sans',
    categorySlug: 'humanist',
    description: 'Commissioned for Charles de Gaulle Airport, Frutiger is the world gold-standard for effortless navigational signage and interface legibility.',
    freeName: 'Open Sans',
    freeDesigner: 'Steve Matteson',
    freeSlug: 'open-sans',
    similarity: '96%',
    reason: 'Engineered by Steve Matteson specifically for effortless signage and digital interface clarity with wide apertures and warm rhythm.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap');\nfont-family: 'Open Sans', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Open+Sans'
  },
  {
    id: 'trajan',
    paid: 'Trajan Pro',
    foundry: 'Adobe Originals',
    price: '$45 / weight',
    category: 'Display & Slab',
    categorySlug: 'display',
    description: 'Carol Twombly’s iconic adaptation of the classical Roman monumental inscriptions carved into the base of Trajan’s Column in Rome.',
    freeName: 'Cinzel',
    freeDesigner: 'Natanael Gama',
    freeSlug: 'cinzel',
    similarity: '98%',
    reason: 'Classical Roman monumental letterforms with chisel-cut serifs and commanding cinematic dignity.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&display=swap');\nfont-family: 'Cinzel', serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Cinzel'
  },
  {
    id: 'brandon-grotesque',
    paid: 'Brandon Grotesque',
    foundry: 'HVD Fonts',
    price: '$40 / weight',
    category: 'Geometric Sans',
    categorySlug: 'geometric',
    description: 'Hannes von Döhren’s geometric sans with subtly rounded corners, evoking warm, elegant 1920s European café culture and modern boutique branding.',
    freeName: 'Poppins',
    freeDesigner: 'Indian Type Foundry',
    freeSlug: 'poppins',
    similarity: '95%',
    reason: 'Geometric circular letterforms with smooth rounded transitions, clean monoline stems, and high display warmth.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');\nfont-family: 'Poppins', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Poppins'
  },
  {
    id: 'akzidenz-grotesk',
    paid: 'Akzidenz-Grotesk',
    foundry: 'Berthold',
    price: '$49 / weight',
    category: 'Neo-Grotesque',
    categorySlug: 'neo-grotesque',
    description: 'The historic 1898 German realist grotesk that laid the groundwork for Swiss modernism and Helvetica decades later.',
    freeName: 'Hanken Grotesk',
    freeDesigner: 'Hanken Design Co.',
    freeSlug: 'hanken-grotesk',
    similarity: '96%',
    reason: 'Muscular stems, tight historical grotesque apertures, and utilitarian raw European balance.',
    css: "@import url('https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&display=swap');\nfont-family: 'Hanken Grotesk', sans-serif;",
    googleFontUrl: 'https://fonts.google.com/specimen/Hanken+Grotesk'
  }
];

const faqs = [
  {
    q: 'Are Google Font alternatives 100% legal for commercial use?',
    a: 'Yes. Every Google Font recommended on ProFontFinder is released under the SIL Open Font License (OFL) or Apache 2.0. This allows unlimited commercial use across websites, software, mobile apps, videos, and branding without purchasing a license or paying royalties.'
  },
  {
    q: 'What is the closest free Google Font to Helvetica?',
    a: 'Inter (by Rasmus Andersson) is the closest free digital alternative to Helvetica and Helvetica Neue. It shares Helvetica’s strictly horizontal terminals, tall x-height, and neutral Swiss rhythm while offering optimized screen hinting.'
  },
  {
    q: 'What is the best free alternative to Gotham?',
    a: 'Montserrat (by Julieta Ulanovsky) is the most popular open-source substitute for Gotham. Its uppercase letters share Gotham’s wide architectural stance, circular O, and mid-century geometric dignity.'
  },
  {
    q: 'How does ProFontFinder calculate optical similarity?',
    a: 'Our client-side matching engine analyzes glyph aspect ratios, x-height proportions, stroke contrast, terminal angles, and 16×16 vector matrix signatures to calculate exact geometric similarity scores.'
  }
];
---

<BaseLayout
  title={cT.meta.title}
  description={cT.meta.description}
  lang={lang}
>
  <!-- Schema.org JSON-LD FAQPage Schema for Search Engine Rich Snippets -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": vT.faqs.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  })} />

  <!-- Hero Section -->
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-20 px-4 sm:px-6 bg-[#08090a] bg-grid-pattern-subtle border-b border-[#23252a]">
    <div class="max-w-[1200px] mx-auto text-center">
      
      <!-- Breadcrumb & Badge -->
      <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-[#161718] border border-[#23252a]">
        <div class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></div>
        <a href={toolsHref} class="text-xs font-mono text-[#8a8f98] hover:text-[#e4f222] transition-colors">{t.common.nav.tools}</a>
        <span class="text-xs text-[#383b3f]">/</span>
        <span class="text-xs font-mono text-[#ffffff] uppercase tracking-wider">{cT.breadcrumb}</span>
      </div>

      <!-- Hero Header -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[510] text-[#ffffff] tracking-tight max-w-3xl mx-auto leading-tight">
        {cT.title}
      </h1>
      <p class="mt-4 text-sm sm:text-base text-[#8a8f98] max-w-xl mx-auto leading-relaxed">
        {cT.subtitle}
      </p>

      <!-- Upload Sample Image UI -->
      <div class="mt-8 sm:mt-12 w-full max-w-[1020px] mx-auto text-left">
        <FontFinderApp
          lang={lang}
          dropzoneTitle={cT.dropzoneTitle}
          dropzoneSubtitle={cT.dropzoneSubtitle}
          buttonText={cT.buttonText}
        />
      </div>

    </div>
  </section>

  <!-- DIRECTORY SECTION (CRUCIAL CRAWLABLE CONTENT FOR GOOGLEBOT) -->
  <section id="directory" class="py-16 sm:py-24 max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-[#e2e4e8] dark:border-[#23252a]">
      <div>
        <div class="inline-flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
          <span class="font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98] font-semibold">
            {vT.directoryBadge}
          </span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-tight">
          {vT.directoryTitle}
        </h2>
        <p class="mt-2 text-sm text-[#475569] dark:text-[#8a8f98] max-w-xl">
          {vT.directorySubtitle}
        </p>
      </div>

      <!-- Live Search & Filter Counter -->
      <div class="w-full md:w-72">
        <div class="relative">
          <input
            type="text"
            id="font-search-input"
            placeholder={vT.searchPlaceholder}
            class="w-full px-3.5 py-2 pl-9 rounded-[8px] bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] text-xs text-[#08090a] dark:text-[#ffffff] focus:outline-none focus:border-[#ff4d00] dark:focus:border-[#e4f222]"
          />
          <svg class="w-4 h-4 absolute left-3 top-2.5 text-[#64748b] dark:text-[#8a8f98]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center gap-2 mb-8" id="category-pills">
      <button type="button" data-filter="all" class="cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-[#08090a] text-white dark:bg-white dark:text-[#08090a]">
        {vT.filterAll} ({commercialDatabase.length})
      </button>
      <button type="button" data-filter="geometric" class="cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] text-[#475569] dark:text-[#8a8f98] hover:border-[#cbd5e1] dark:hover:border-[#383b44]">
        {vT.filterGeometric}
      </button>
      <button type="button" data-filter="neo-grotesque" class="cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] text-[#475569] dark:text-[#8a8f98] hover:border-[#cbd5e1] dark:hover:border-[#383b44]">
        {vT.filterNeoGrotesque}
      </button>
      <button type="button" data-filter="serif" class="cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] text-[#475569] dark:text-[#8a8f98] hover:border-[#cbd5e1] dark:hover:border-[#383b44]">
        {vT.filterSerif}
      </button>
      <button type="button" data-filter="humanist" class="cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] text-[#475569] dark:text-[#8a8f98] hover:border-[#cbd5e1] dark:hover:border-[#383b44]">
        {vT.filterHumanist}
      </button>
      <button type="button" data-filter="display" class="cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] text-[#475569] dark:text-[#8a8f98] hover:border-[#cbd5e1] dark:hover:border-[#383b44]">
        {vT.filterDisplay}
      </button>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="font-cards-container">
      {commercialDatabase.map((item) => (
        <article
          class="font-twin-card flex flex-col justify-between rounded-2xl border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 shadow-sm hover:border-[#cbd5e1] dark:hover:border-[#383b44] transition-all space-y-5"
          data-name={item.paid.toLowerCase()}
          data-free={item.freeName.toLowerCase()}
          data-category={item.categorySlug}
        >
          <div class="space-y-4">
            <!-- Paid Header -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-[#e2e4e8] dark:border-[#23252a]">
              <div>
                <h3 class="font-[510] text-xl text-[#08090a] dark:text-[#ffffff]">
                  {item.paid}
                </h3>
                <span class="text-xs font-mono text-[#64748b] dark:text-[#8a8f98]">
                  {item.foundry} • {item.category}
                </span>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-[#ef4444]/10 border border-[#ef4444]/30 text-[#ef4444] text-[11px] font-mono font-semibold shrink-0">
                {item.price}
              </span>
            </div>

            <p class="text-xs text-[#475569] dark:text-[#8a8f98] leading-relaxed">
              {item.description}
            </p>

            <!-- Free Stand-In Highlight Box -->
            <div class="p-4 sm:p-5 rounded-xl bg-[#f8f9fa] dark:bg-[#14161a] border border-[#e2e4e8] dark:border-[#26282e] space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-mono uppercase tracking-wider text-[#ff4d00] dark:text-[#e4f222] font-semibold">
                  {vT.recommendedStandIn}
                </span>
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded-full bg-[#16a34a]/15 text-[#16a34a] dark:text-[#10b981] text-[10px] font-mono font-semibold">
                    {vT.freeOfl}
                  </span>
                  <span class="font-mono text-xs font-bold text-[#16a34a] dark:text-[#10b981]">
                    {item.similarity} {vT.match}
                  </span>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h4 class="text-lg font-[510] text-[#08090a] dark:text-[#ffffff]">
                    {item.freeName}
                  </h4>
                  <span class="text-xs font-mono text-[#64748b] dark:text-[#8a8f98]">
                    {vT.by} {item.freeDesigner}
                  </span>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <a
                    href={item.googleFontUrl}
                    target="_blank"
                    rel="noopener"
                    class="px-3 py-1.5 rounded-full bg-[#08090a] text-white dark:bg-[#ffffff] dark:text-[#08090a] text-xs font-semibold hover:opacity-90 transition-opacity"
                  >
                    {vT.getFreeFont}
                  </a>
                  <a
                    href={`/fonts/${item.freeSlug}`}
                    class="px-3 py-1.5 rounded-full bg-white dark:bg-[#1c1e24] border border-[#e2e4e8] dark:border-[#2a2d36] text-xs font-medium text-[#08090a] dark:text-[#ffffff] hover:border-[#cbd5e1] dark:hover:border-[#383b44] transition-colors"
                  >
                    {vT.specimen}
                  </a>
                </div>
              </div>

              <p class="text-[11.5px] text-[#475569] dark:text-[#8a8f98] leading-relaxed pt-1">
                {item.reason}
              </p>
            </div>
          </div>

          <!-- Bottom Code Snippet Blueprint -->
          <div class="pt-3 border-t border-[#f1f3f6] dark:border-[#1a1b1e] flex items-center justify-between text-xs font-mono">
            <span class="text-[#64748b] dark:text-[#8a8f98] truncate max-w-[240px]">
              {item.css.split('\n')[1]}
            </span>
            <button
              type="button"
              data-css={item.css}
              data-copied={vT.copied}
              class="btn-copy-css text-[#ff4d00] dark:text-[#e4f222] hover:underline font-semibold cursor-pointer shrink-0 ml-2"
            >
              {vT.copyCss}
            </button>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-results-box" class="hidden py-16 text-center text-[#64748b] dark:text-[#8a8f98]">
      <p class="text-sm font-mono">{vT.noResults}</p>
    </div>
  </section>

  <!-- TYPOGRAPHY GUIDE & FAQ (CRAWLABLE SCHEMA RICH CONTENT) -->
  <section class="py-16 sm:py-20 border-t border-[#e2e4e8] dark:border-[#23252a] bg-[#f8f9fa] dark:bg-[#0c0d10] transition-colors">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 space-y-12">
      <div class="text-center">
        <span class="font-mono text-xs uppercase tracking-widest text-[#ff4d00] dark:text-[#e4f222] font-semibold block mb-2">{vT.faqBadge}</span>
        <h2 class="text-2xl sm:text-3xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-tight">
          {vT.faqTitle}
        </h2>
        <p class="mt-2 text-sm text-[#475569] dark:text-[#8a8f98]">
          {vT.faqSubtitle}
        </p>
      </div>

      <div class="space-y-4">
        {vT.faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] shadow-sm space-y-2">
            <h3 class="text-base sm:text-lg font-[510] text-[#08090a] dark:text-[#ffffff]">
              {faq.q}
            </h3>
            <p class="text-xs sm:text-sm text-[#475569] dark:text-[#8a8f98] leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side Interactive Filter Script -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById('font-search-input');
      const cards = document.querySelectorAll('.font-twin-card');
      const filterBtns = document.querySelectorAll('.cat-filter-btn');
      const noResults = document.getElementById('no-results-box');
      let currentFilter = 'all';

      function filterCards() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach((card) => {
          const name = card.getAttribute('data-name') || '';
          const free = card.getAttribute('data-free') || '';
          const cat = card.getAttribute('data-category') || '';

          const matchesQuery = !query || name.includes(query) || free.includes(query);
          const matchesCategory = currentFilter === 'all' || cat === currentFilter;

          if (matchesQuery && matchesCategory) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      searchInput?.addEventListener('input', filterCards);

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.className = 'cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] text-[#475569] dark:text-[#8a8f98] hover:border-[#cbd5e1] dark:hover:border-[#383b44]';
          });
          btn.className = 'cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-[#08090a] text-white dark:bg-white dark:text-[#08090a] shadow-sm';
          currentFilter = btn.getAttribute('data-filter') || 'all';
          filterCards();
        });
      });

      // Copy CSS Handlers
      document.querySelectorAll('.btn-copy-css').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const css = btn.getAttribute('data-css') || '';
          try {
            await navigator.clipboard.writeText(css);
            const original = btn.textContent;
            const copiedText = btn.getAttribute('data-copied') || 'Copied!';
            btn.textContent = copiedText;
            setTimeout(() => {
              btn.textContent = original;
            }, 2000);
          } catch (e) {}
        });
      });
    })();
  </script>
</BaseLayout>
