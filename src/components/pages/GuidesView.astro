---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getViewTranslations } from '../../i18n/viewTranslations';
import { getBlogArticles } from '../../data/blogArticles';
import type { SupportedLocale } from '../../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentLocale = lang as SupportedLocale;
const t = useTranslations(lang);
const gT = t.guides;
const allVT = getViewTranslations(lang);
const vT = allVT.guidesFeatured;
const bT = allVT.blog;
const articles = getBlogArticles(lang);

const p = (path: string) => getLocalizedPath(path, currentLocale);
---

<BaseLayout
  title={gT.meta.title}
  description={gT.meta.description}
  lang={lang}
>
  <main class="py-12 sm:py-20 px-4 sm:px-6 max-w-[1100px] mx-auto transition-colors">
    <!-- Header -->
    <div class="mb-12 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 mb-3">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00] dark:bg-[#e4f222]"></div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98] font-medium">{gT.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.025em] leading-tight">
        {gT.title}
      </h1>
      <p class="mt-3 text-[15px] sm:text-[16px] text-[#475569] dark:text-[#8a8f98] leading-relaxed max-w-2xl font-normal">
        {gT.subtitle}
      </p>
    </div>

    <!-- CORNERSTONE RESEARCH ARTICLES ROW (HIGH INTENT SEARCH FUNNEL) -->
    <div class="mb-14 p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] shadow-sm">
      <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-[#f1f3f6] dark:border-[#1a1b1e]">
        <div>
          <span class="font-mono text-[10px] uppercase tracking-wider text-[#ff4d00] dark:text-[#e4f222] font-semibold block mb-1">
            {vT.badge}
          </span>
          <h2 class="text-xl sm:text-2xl font-[510] text-[#08090a] dark:text-[#ffffff]">
            {vT.title}
          </h2>
        </div>
        <a href={p('/blog')} class="text-xs font-mono text-[#ff4d00] dark:text-[#e4f222] hover:underline font-semibold shrink-0">
          {vT.viewAll}
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {articles.map((article) => (
          <a
            href={p(`/blog/${article.slug}`)}
            class="p-4 rounded-xl border border-[#e2e4e8] dark:border-[#202227] bg-[#f8f9fa] dark:bg-[#14161a] hover:border-[#ff4d00] dark:hover:border-[#e4f222] transition-all flex flex-col justify-between group"
          >
            <div>
              <span class="text-[10px] font-mono text-[#64748b] dark:text-[#8a8f98] block mb-1.5">
                {article.category}
              </span>
              <h3 class="text-xs sm:text-sm font-semibold text-[#08090a] dark:text-[#ffffff] leading-snug group-hover:text-[#ff4d00] dark:group-hover:text-[#e4f222] transition-colors">
                {article.title}
              </h3>
            </div>
            <div class="mt-4 pt-3 border-t border-[#e2e4e8]/60 dark:border-[#23252a] flex items-center justify-between text-[10px] font-mono text-[#64748b] dark:text-[#8a8f98]">
              <span>{article.readTime}</span>
              <span class="text-[#ff4d00] dark:text-[#e4f222] font-semibold">{bT.readArticle}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {gT.items.map((item, idx) => (
        <article class="flex flex-col justify-between rounded-[14px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-7 shadow-sm hover:border-[#cbd5e1] dark:hover:border-[#383b44] transition-all group">
          <div>
            <!-- Top Badges -->
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="font-mono text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-[#f1f3f6] dark:bg-[#161718] border border-[#e2e4e8] dark:border-[#23252a] text-[#475569] dark:text-[#8a8f98]">
                {item.category}
              </span>
              <span class="font-mono text-[11px] text-[#64748b] dark:text-[#62666d]">
                {item.readTime} {gT.readTimeSuffix}
              </span>
            </div>

            <!-- Title -->
            <h2 class="text-[17px] sm:text-[18px] font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] leading-snug group-hover:text-[#ff4d00] dark:group-hover:text-[#e4f222] transition-colors">
              {item.title}
            </h2>

            <!-- Description -->
            <p class="mt-2.5 text-[13.5px] text-[#475569] dark:text-[#8a8f98] leading-relaxed">
              {item.desc}
            </p>

            <!-- Step by Step Key Points -->
            <div class="mt-4 pt-4 border-t border-[#f1f3f6] dark:border-[#1a1b1e]">
              <ul class="space-y-2">
                {item.steps.map((step, sIdx) => (
                  <li class="flex items-start gap-2.5 text-[12.5px] text-[#334155] dark:text-[#d0d6e0] leading-snug">
                    <span class="font-mono text-[10px] font-semibold text-[#ff4d00] dark:text-[#e4f222] mt-0.5 w-4 shrink-0">
                      0{sIdx + 1}
                    </span>
                    <span>{step}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom Action Link -->
          <div class="mt-6 pt-4 border-t border-[#f1f3f6] dark:border-[#1a1b1e] flex items-center justify-between">
            <a
              href={p(item.toolLink)}
              class="inline-flex items-center gap-1.5 text-[13px] font-[510] text-[#08090a] dark:text-[#ffffff] hover:text-[#ff4d00] dark:hover:text-[#e4f222] transition-colors"
            >
              <span>{item.toolName}</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- FAQ Section -->
    <section class="rounded-[14px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-9 mb-14 shadow-sm">
      <!-- Schema.org JSON-LD FAQPage Schema for Search Engine Rich Snippets -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": gT.faqs.map(item => ({
          "@type": "Question",
          "name": item.q,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.a
          }
        }))
      })} />

      <div class="mb-6">
        <h2 class="text-xl sm:text-2xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em]">
          {gT.faqTitle}
        </h2>
      </div>

      <div class="divide-y divide-[#e2e4e8] dark:divide-[#23252a]">
        {gT.faqs.map((faq) => (
          <details class="py-4 group">
            <summary class="flex items-center justify-between cursor-pointer font-[510] text-[15px] text-[#08090a] dark:text-[#ffffff] list-none select-none">
              <span>{faq.q}</span>
              <svg class="w-4 h-4 text-[#64748b] dark:text-[#8a8f98] transition-transform group-open:rotate-180 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-2.5 text-[14px] text-[#475569] dark:text-[#8a8f98] leading-relaxed">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Bottom Action Banner -->
    <div class="rounded-[14px] border border-[#e2e4e8] dark:border-[#23252a] bg-[#f8f9fa] dark:bg-[#0c0d0e] p-8 text-center sm:flex sm:items-center sm:justify-between sm:text-left">
      <div>
        <h3 class="text-lg font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em]">
          {t.common.buttons.identifyNow}
        </h3>
        <p class="mt-1 text-[13.5px] text-[#475569] dark:text-[#8a8f98]">
          {t.common.brandTagline}
        </p>
      </div>
      <div class="mt-4 sm:mt-0 shrink-0">
        <a
          href={p('/#finder')}
          class="inline-flex items-center justify-center px-5 py-2.5 text-[13.5px] font-[510] rounded-full bg-[#08090a] dark:bg-[#ffffff] text-white dark:text-[#08090a] hover:bg-[#23252a] dark:hover:bg-[#e5e5e6] transition-colors shadow-sm"
        >
          {t.common.nav.identifyFont}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
