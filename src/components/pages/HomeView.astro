---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../FontFinderApp.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import type { SupportedLocale } from '../../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentLocale = lang as SupportedLocale;
const t = useTranslations(lang);
const hT = t.home;
const p = (path: string) => getLocalizedPath(path, currentLocale);
const finderAnchor = `${p('/') === '/' ? '' : p('/')}/#finder`;
---

<BaseLayout
  title={hT.meta.title}
  description={hT.meta.description}
  lang={lang}
>
  <!-- Hero Section with Linear Atmospheric Depth & Floor Wash -->
  <section class="relative pt-12 pb-16 sm:pt-16 sm:pb-20 px-4 sm:px-6 bg-grid-pattern-subtle hero-gradient-floor border-b border-[#e2e4e8] dark:border-[#23252a] bg-[#f8f9fa] dark:bg-[#08090a] transition-colors overflow-hidden">
    <!-- Soft radial vignette so grid fades gracefully at section edges -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_45%,rgba(248,249,250,0.85)_100%)] dark:bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(8,9,10,0.85)_100%)] select-none z-0" aria-hidden="true"></div>

    <div class="max-w-[1200px] mx-auto text-center relative z-10">
      <!-- Linear Display Headline (64px / 510 / tight tracking -0.022em) -->
      <h1 class="text-4xl sm:text-6xl lg:text-[64px] font-[510] tracking-[-0.022em] text-[#08090a] dark:text-[#ffffff] leading-[1.05] max-w-4xl mx-auto">
        {hT.hero.headlinePrefix} <br class="hidden sm:inline" />
        <span class="inline-flex items-center justify-center min-w-[220px] sm:min-w-[340px] text-[#ff4d00] dark:text-[#e4f222] transition-all duration-300 select-none" id="morphing-font-word" style="font-family: 'Playfair Display', serif; font-style: italic; color: var(--color-acid-lime);">
          Playfair Display
        </span>
      </h1>

      <p class="mt-4 text-[15px] sm:text-[16px] text-[#475569] dark:text-[#8a8f98] max-w-lg mx-auto leading-relaxed font-normal">
        {hT.hero.subtitle}
      </p>

      <!-- Live CSS snippet tag (Berkeley / JetBrains Mono) -->
      <div class="mt-3.5 flex items-center justify-center">
        <span class="px-3 py-1 rounded-[6px] bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] font-mono text-[11px] text-[#475569] dark:text-[#8a8f98] transition-all shadow-sm" id="morphing-font-css">
          font-family: 'Playfair Display', serif;
        </span>
      </div>
    </div>

    <!-- Core Font Finder Tool (Product UI as Hero Showcase) -->
    <div class="mt-8 sm:mt-11 relative z-10">
      <FontFinderApp
        lang={lang}
        dropzoneTitle={hT.dropzone.title}
        dropzoneSubtitle={hT.dropzone.subtitle}
        buttonText={hT.dropzone.buttonText}
      />
    </div>
  </section>

  <!-- Live Font Cycler Script -->
  <script is:inline>
    (function () {
      const fonts = [
        { name: 'Playfair Display', style: "font-family: 'Playfair Display', serif; font-style: italic; color: var(--color-acid-lime);", css: "font-family: 'Playfair Display', serif;" },
        { name: 'JetBrains Mono', style: "font-family: 'JetBrains Mono', monospace; font-weight: 500; color: var(--color-acid-lime);", css: "font-family: 'JetBrains Mono', monospace;" },
        { name: 'Bebas Neue', style: "font-family: 'Bebas Neue', sans-serif; letter-spacing: 2px; color: var(--color-acid-lime);", css: "font-family: 'Bebas Neue', cursive;" },
        { name: 'Syne', style: "font-family: 'Syne', sans-serif; font-weight: 700; color: var(--color-acid-lime);", css: "font-family: 'Syne', sans-serif;" },
        { name: 'Cinzel', style: "font-family: 'Cinzel', serif; font-weight: 600; color: var(--color-acid-lime);", css: "font-family: 'Cinzel', serif;" },
        { name: 'Inter', style: "font-family: 'Inter', sans-serif; font-weight: 600; color: var(--color-acid-lime);", css: "font-family: 'Inter', sans-serif;" }
      ];

      let idx = 0;
      const wordEl = document.getElementById('morphing-font-word');
      const cssEl = document.getElementById('morphing-font-css');

      if (wordEl && cssEl) {
        setInterval(() => {
          idx = (idx + 1) % fonts.length;
          const f = fonts[idx];
          
          wordEl.style.opacity = '0';
          wordEl.style.transform = 'translateY(4px)';
          
          setTimeout(() => {
            wordEl.textContent = f.name;
            wordEl.setAttribute('style', f.style);
            cssEl.textContent = f.css;
            
            wordEl.style.opacity = '1';
            wordEl.style.transform = 'translateY(0)';
            wordEl.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          }, 150);
        }, 2500);
      }
    })();
  </script>

  <!-- Section: Three-step Workflow (Creative Interactive Recognition Pipeline) -->
  <section class="py-20 sm:py-28 max-w-[1200px] mx-auto px-4 sm:px-6 relative">
    
    <!-- Section Header with Linear Engineering Aesthetics -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="pipeline-tag inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-white dark:bg-white/[0.03] border border-[#e2e4e8] dark:border-[#23252a] shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#ff4d00] dark:bg-[#e4f222] shadow-[0_0_8px_#ff4d00] dark:shadow-[0_0_8px_#e4f222] animate-pulse"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-[#334155] dark:text-[#d0d6e0] font-semibold">{hT.pipeline.badge}</span>
        </div>
        <h2 class="pipeline-heading text-3xl sm:text-4xl font-[510] tracking-[-0.025em] text-[#08090a] dark:text-[#ffffff] leading-tight">
          {hT.pipeline.heading}
        </h2>
        <p class="pipeline-subheading text-[14px] text-[#475569] dark:text-[#8a8f98] mt-2 font-normal max-w-xl">
          {hT.pipeline.subheading}
        </p>
      </div>

      <!-- Live Speed & Privacy Assurance Badge -->
      <div class="pipeline-assurance-badge hidden lg:flex items-center gap-3 font-mono text-[11px] text-[#475569] dark:text-[#8a8f98] p-2.5 rounded-[8px] bg-white dark:bg-[#0c0d10] border border-[#e2e4e8] dark:border-[#202329] shadow-sm">
        <div class="flex items-center gap-1.5 text-[#16a34a] dark:text-[#10b981]">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="font-semibold">{hT.pipeline.localInference}</span>
        </div>
        <span class="text-[#e2e4e8] dark:text-[#2b2e35]">|</span>
        <div class="flex items-center gap-1.5 text-[#334155] dark:text-[#d0d6e0]">
          <svg class="w-3.5 h-3.5 text-[#ff4d00] dark:text-[#e4f222]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>{hT.pipeline.zeroUploads}</span>
        </div>
      </div>
    </div>

    <!-- 3 High-Tech Interactive Step Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 relative">

      <!-- Connecting line indicator across steps for desktop -->
      <div class="pipeline-connecting-line hidden md:block absolute top-[42px] left-[15%] right-[15%] h-[1px] bg-gradient-to-r from-transparent via-white/[0.08] to-transparent pointer-events-none z-0" aria-hidden="true"></div>

      <!-- STEP 1 CARD -->
      <div class="pipeline-step-card group p-6 sm:p-7 flex flex-col justify-between z-10">
        <!-- Hover Gradient Spotlight Accent -->
        <div class="absolute -top-20 -right-20 w-44 h-44 rounded-full bg-[radial-gradient(circle,rgba(228,242,34,0.12),transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none blur-2xl"></div>

        <!-- Giant Creative Number Watermark -->
        <div class="step-watermark absolute top-2 right-4 font-mono font-black text-6xl sm:text-7xl text-white/[0.025] select-none pointer-events-none tracking-tighter">
          01
        </div>

        <div>
          <!-- Creative Step Header Pill with Pulsing Status -->
          <div class="flex items-center justify-between gap-2 mb-5">
            <div class="step-badge-pill inline-flex items-center gap-2 px-3 py-1 rounded-full font-mono text-[10px] font-semibold tracking-wider bg-[#14161a] border border-[#26282e] text-[#a0a6b2] shrink-0">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#e4f222] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#e4f222]"></span>
              </span>
              <span>{hT.pipeline.step1.phase}</span>
            </div>
            <span class="step-phase-tag font-mono text-[10px] text-[#62666d] group-hover:text-[#e4f222] transition-colors whitespace-nowrap text-right">{hT.pipeline.step1.tag}</span>
          </div>

          <!-- Step Title & Description -->
          <h3 class="step-title font-[510] text-[18px] sm:text-[19px] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] group-hover:text-[#ff4d00] dark:group-hover:text-[#e4f222] transition-colors">
            {hT.pipeline.step1.title}
          </h3>
          <p class="step-desc text-[13px] text-[#475569] dark:text-[#8a8f98] mt-2 leading-relaxed">
            {hT.pipeline.step1.desc} <kbd class="font-mono text-[10px] bg-[#f1f3f6] dark:bg-[#161718] border border-[#cbd5e1] dark:border-[#23252a] px-1.5 py-0.5 rounded text-[#0f172a] dark:text-[#d0d6e0] shadow-sm">⌘V</kbd>. {hT.pipeline.step1.descSuffix}
          </p>

          <!-- Creative Interactive Visual Demo: Optical Crop Viewfinder -->
          <div class="pipeline-preview-box crop-preview-box mt-6 p-4 rounded-[10px] bg-[#121316] border border-[#1e2025] group-hover:border-[#333742] transition-all relative overflow-hidden">
            <!-- Viewfinder Corner Brackets that expand on hover -->
            <span class="crop-bracket absolute top-2 left-2 w-2.5 h-2.5 border-t-2 border-l-2 border-[#e4f222] transition-all duration-300 group-hover:w-4 group-hover:h-4"></span>
            <span class="crop-bracket absolute top-2 right-2 w-2.5 h-2.5 border-t-2 border-r-2 border-[#e4f222] transition-all duration-300 group-hover:w-4 group-hover:h-4"></span>
            <span class="crop-bracket absolute bottom-2 left-2 w-2.5 h-2.5 border-b-2 border-l-2 border-[#e4f222] transition-all duration-300 group-hover:w-4 group-hover:h-4"></span>
            <span class="crop-bracket absolute bottom-2 right-2 w-2.5 h-2.5 border-b-2 border-r-2 border-[#e4f222] transition-all duration-300 group-hover:w-4 group-hover:h-4"></span>

            <div class="flex items-center justify-between">
              <!-- Glyph Preview with Dashed Precision Crop Box -->
              <div class="crop-glyph-box relative px-4 py-2 border border-dashed border-[#e4f222]/50 rounded-[4px] bg-[#16181d] group-hover:border-[#e4f222] group-hover:shadow-[0_0_12px_rgba(228,242,34,0.15)] transition-all">
                <span class="crop-glyph-text font-serif text-2xl text-[#08090a] dark:text-[#ffffff] tracking-wider select-none font-bold">Aa</span>
                <span class="crop-badge-tag absolute -top-2 -left-1 font-mono text-[8px] bg-[#0c0d10] px-1 text-[#e4f222] font-semibold">{hT.pipeline.step1.crop}</span>
              </div>

              <!-- Shortcut Pill -->
              <div class="flex flex-col items-end gap-1">
                <span class="crop-detect-pill inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[6px] font-mono text-[10px] bg-[#181a1e] border border-[#2a2c32] text-[#d0d6e0] group-hover:border-[#e4f222]/40 transition-colors shadow-sm">
                  <svg class="crop-detect-icon w-3 h-3 text-[#e4f222]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  <span>{hT.pipeline.step1.autoDetect}</span>
                </span>
                <span class="crop-detect-sub font-mono text-[9px] text-[#62666d]">PNG • JPG • WebP</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step Bottom Status Bar -->
        <div class="step-card-footer mt-6 pt-3.5 border-t border-white/[0.06] flex items-center justify-between text-[11px] font-mono text-[#8a8f98]">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
            <span>{hT.pipeline.step1.footerTraffic}</span>
          </span>
          <span class="text-[#62666d]">{hT.pipeline.step1.step}</span>
        </div>
      </div>

      <!-- STEP 2 CARD -->
      <div class="pipeline-step-card group p-6 sm:p-7 flex flex-col justify-between z-10">
        <!-- Hover Gradient Spotlight Accent -->
        <div class="absolute -top-20 -right-20 w-44 h-44 rounded-full bg-[radial-gradient(circle,rgba(228,242,34,0.12),transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none blur-2xl"></div>

        <!-- Giant Creative Number Watermark -->
        <div class="step-watermark absolute top-2 right-4 font-mono font-black text-6xl sm:text-7xl text-white/[0.025] select-none pointer-events-none tracking-tighter">
          02
        </div>

        <div>
          <!-- Creative Step Header Pill with Pulsing Status -->
          <div class="flex items-center justify-between gap-2 mb-5">
            <div class="step-badge-pill inline-flex items-center gap-2 px-3 py-1 rounded-full font-mono text-[10px] font-semibold tracking-wider bg-[#14161a] border border-[#26282e] text-[#a0a6b2] shrink-0">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#e4f222] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#e4f222]"></span>
              </span>
              <span>{hT.pipeline.step2.phase}</span>
            </div>
            <span class="step-phase-tag font-mono text-[10px] text-[#62666d] group-hover:text-[#e4f222] transition-colors whitespace-nowrap text-right">{hT.pipeline.step2.tag}</span>
          </div>

          <!-- Step Title & Description -->
          <h3 class="step-title font-[510] text-[18px] sm:text-[19px] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] group-hover:text-[#ff4d00] dark:group-hover:text-[#e4f222] transition-colors">
            {hT.pipeline.step2.title}
          </h3>
          <p class="step-desc text-[13px] text-[#475569] dark:text-[#8a8f98] mt-2 leading-relaxed">
            {hT.pipeline.step2.desc}
          </p>

          <!-- Creative Interactive Visual Demo: 16×16 Matrix + Sweeping Laser Scan -->
          <div class="pipeline-preview-box matrix-preview-box mt-6 p-4 rounded-[10px] bg-[#121316] border border-[#1e2025] group-hover:border-[#333742] transition-all relative overflow-hidden">
            <!-- Animated Sweeping Laser Scanline Beam on Hover -->
            <div class="scan-laser absolute inset-y-0 -left-6 w-8 bg-gradient-to-r from-transparent via-[#e4f222]/80 to-transparent opacity-0 pointer-events-none shadow-[0_0_16px_#e4f222]"></div>

            <div class="flex items-center justify-between">
              <!-- Matrix Dot Grid Simulation -->
              <div class="matrix-grid-box grid grid-cols-4 gap-1.5 p-1.5 rounded bg-[#16181d] border border-white/[0.05]">
                <div class="matrix-dot matrix-dot-1 w-2.5 h-2.5 rounded-sm bg-[#e4f222] shadow-[0_0_6px_rgba(228,242,34,0.6)]"></div>
                <div class="matrix-dot matrix-dot-2 w-2.5 h-2.5 rounded-sm bg-[#e4f222]/60"></div>
                <div class="matrix-dot matrix-dot-3 w-2.5 h-2.5 rounded-sm bg-[#e4f222]/20"></div>
                <div class="matrix-dot matrix-dot-4 w-2.5 h-2.5 rounded-sm bg-[#e4f222] shadow-[0_0_6px_rgba(228,242,34,0.6)]"></div>
                <div class="matrix-dot matrix-dot-5 w-2.5 h-2.5 rounded-sm bg-[#e4f222]/80"></div>
                <div class="matrix-dot matrix-dot-6 w-2.5 h-2.5 rounded-sm bg-[#e4f222]"></div>
                <div class="matrix-dot matrix-dot-7 w-2.5 h-2.5 rounded-sm bg-[#e4f222]/40"></div>
                <div class="matrix-dot matrix-dot-8 w-2.5 h-2.5 rounded-sm bg-[#e4f222]/70"></div>
              </div>

              <!-- Optical Metric Telemetry -->
              <div class="matrix-telemetry flex flex-col items-end font-mono text-[10px] space-y-1 text-[#475569] dark:text-[#8a8f98]">
                <div><span class="matrix-val text-[#ff4d00] dark:text-[#e4f222] font-semibold">{hT.pipeline.step2.matrix}</span></div>
                <div><span class="apertures-val text-[#08090a] dark:text-[#ffffff]">{hT.pipeline.step2.apertures}</span></div>
                <div><span class="nodes-val text-[#16a34a] dark:text-[#10b981]">{hT.pipeline.step2.vectorNodes}</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Step Bottom Status Bar -->
        <div class="step-card-footer mt-6 pt-3.5 border-t border-white/[0.06] flex items-center justify-between text-[11px] font-mono text-[#8a8f98]">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
            <span>{hT.pipeline.step2.footerClient}</span>
          </span>
          <span class="text-[#62666d]">{hT.pipeline.step2.step}</span>
        </div>
      </div>

      <!-- STEP 3 CARD -->
      <div class="pipeline-step-card group p-6 sm:p-7 flex flex-col justify-between z-10">
        <!-- Hover Gradient Spotlight Accent -->
        <div class="absolute -top-20 -right-20 w-44 h-44 rounded-full bg-[radial-gradient(circle,rgba(228,242,34,0.12),transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none blur-2xl"></div>

        <!-- Giant Creative Number Watermark -->
        <div class="step-watermark absolute top-2 right-4 font-mono font-black text-6xl sm:text-7xl text-white/[0.025] select-none pointer-events-none tracking-tighter">
          03
        </div>

        <div>
          <!-- Creative Step Header Pill with Pulsing Status -->
          <div class="flex items-center justify-between gap-2 mb-5">
            <div class="step-badge-pill inline-flex items-center gap-2 px-3 py-1 rounded-full font-mono text-[10px] font-semibold tracking-wider bg-[#14161a] border border-[#26282e] text-[#a0a6b2] shrink-0">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#e4f222] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#e4f222]"></span>
              </span>
              <span>{hT.pipeline.step3.phase}</span>
            </div>
            <span class="step-phase-tag font-mono text-[10px] text-[#62666d] group-hover:text-[#e4f222] transition-colors whitespace-nowrap text-right">{hT.pipeline.step3.tag}</span>
          </div>

          <!-- Step Title & Description -->
          <h3 class="step-title font-[510] text-[18px] sm:text-[19px] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] group-hover:text-[#ff4d00] dark:group-hover:text-[#e4f222] transition-colors">
            {hT.pipeline.step3.title}
          </h3>
          <p class="step-desc text-[13px] text-[#475569] dark:text-[#8a8f98] mt-2 leading-relaxed">
            {hT.pipeline.step3.desc} <code class="font-mono text-[11px] text-[#0f172a] dark:text-[#d0d6e0]">@import</code> and <code class="font-mono text-[11px] text-[#0f172a] dark:text-[#d0d6e0]">font-family</code> {hT.pipeline.step3.descSuffix}
          </p>

          <!-- Creative Interactive Visual Demo: Live Code Blueprint with Ready Badge -->
          <div class="pipeline-preview-box code-preview-box mt-6 p-3.5 rounded-[10px] bg-[#121316] border border-[#1e2025] group-hover:border-[#333742] transition-all relative overflow-hidden font-mono text-[11px]">
            <!-- Terminal Header with Traffic Dots and Slide-in Copy Pill -->
            <div class="code-terminal-header flex items-center justify-between pb-2 mb-2 border-b border-white/[0.06]">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-[#ef4444]/80"></div>
                <div class="w-2 h-2 rounded-full bg-[#eab308]/80"></div>
                <div class="w-2 h-2 rounded-full bg-[#22c55e]/80"></div>
                <span class="code-terminal-title text-[10px] text-[#62666d] ml-1.5">font.css</span>
              </div>
              <div class="code-ready-badge flex items-center gap-1 text-[9px] text-[#ff4d00] dark:text-[#e4f222] font-semibold opacity-80 group-hover:opacity-100 transition-opacity">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{hT.pipeline.step3.readyToEmbed}</span>
              </div>
            </div>

            <!-- Code lines -->
            <div class="code-lines space-y-1 text-[10px] leading-relaxed">
              <div><span class="code-keyword text-[#ff4d00] dark:text-[#e4f222]">@import</span> <span class="code-url text-[#0284c7] dark:text-[#d0d6e0]">url('https://fonts...');</span></div>
              <div><span class="code-prop text-[#64748b] dark:text-[#8a8f98]">font-family:</span> <span class="code-val text-[#08090a] dark:text-[#ffffff] font-medium">'Inter', sans-serif;</span></div>
            </div>
          </div>
        </div>

        <!-- Step Bottom Status Bar -->
        <div class="step-card-footer mt-6 pt-3.5 border-t border-white/[0.06] flex items-center justify-between text-[11px] font-mono text-[#8a8f98]">
