      <div class="absolute bottom-3 right-3 font-mono text-[11px] text-[#383b42] cta-corner-tick group-hover:text-[#e4f222] transition-colors select-none">+</div>

      <!-- Corner Blueprint Coordinate Tags -->
      <div class="hidden sm:block absolute top-3.5 left-8 font-mono text-[9px] uppercase tracking-wider text-[#555a61] select-none">
        {hT.cta.gridSpecimen}
      </div>
      <div class="hidden sm:block absolute top-3.5 right-8 font-mono text-[9px] uppercase tracking-wider text-[#555a61] select-none">
        {hT.cta.ocrLatency}
      </div>

      <!-- Ambient Spotlight Radial Glow on Hover -->
      <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 cta-spotlight" aria-hidden="true"></div>

      <!-- Subtle Typographic Contour Watermarks in Background -->
      <div class="pointer-events-none absolute -left-6 top-1/2 -translate-y-1/2 font-serif text-[140px] sm:text-[180px] font-bold text-white/[0.015] cta-watermark group-hover:text-white/[0.035] group-hover:translate-x-2 transition-all duration-700 select-none hidden lg:block" aria-hidden="true">
        Aa
      </div>
      <div class="pointer-events-none absolute -right-4 top-1/2 -translate-y-1/2 font-mono text-[120px] sm:text-[160px] font-semibold text-white/[0.015] cta-watermark group-hover:text-white/[0.035] group-hover:-translate-x-2 transition-all duration-700 select-none hidden lg:block" aria-hidden="true">
        &amp;
      </div>

      <!-- Content Container -->
      <div class="relative z-10 max-w-2xl mx-auto">
        <!-- Linear Precision Status Tag -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-[#141518] border border-[#e2e4e8] dark:border-[#23252a] text-[11px] font-mono text-[#475569] dark:text-[#8a8f98] mb-5 cta-badge group-hover:border-[#cbd5e1] dark:group-hover:border-[#383b42] transition-colors shadow-sm">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ff4d00] dark:bg-[#e4f222] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#ff4d00] dark:bg-[#e4f222]"></span>
          </span>
          <span class="text-[#08090a] dark:text-[#d0d6e0] cta-badge-text font-normal">{hT.cta.engineReady}</span>
          <span class="text-[#94a3b8] dark:text-[#555a61]">&bull;</span>
          <span class="text-[#64748b] dark:text-[#8a8f98]">{hT.cta.signatures}</span>
        </div>

        <!-- Headline -->
        <h2 class="text-2xl sm:text-3xl lg:text-[32px] font-[510] tracking-[-0.025em] text-[#08090a] dark:text-[#ffffff] cta-title leading-tight">
          {hT.cta.title}
        </h2>

        <!-- Subtitle -->
        <p class="mt-3 text-[13px] sm:text-[14px] text-[#475569] dark:text-[#8a8f98] cta-desc max-w-md mx-auto leading-relaxed font-normal">
          {hT.cta.desc}
        </p>

        <!-- Action Button Group -->
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <a
            href={finderAnchor}
            class="btn-acid-lime group/btn relative inline-flex items-center gap-2 px-5 py-2.5 rounded-[8px] text-[13px] font-[550] shadow-sm hover:shadow-[0_0_20px_rgba(228,242,34,0.3)] transition-all cursor-pointer"
          >
            <span>{hT.cta.btnIdentify}</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/btn:-translate-y-0.5 group-hover/btn:translate-x-0.5" viewBox="0 0 16 16" fill="none">
              <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <a
            href={p('/tools')}
            class="cta-secondary-btn inline-flex items-center gap-1.5 px-4 py-2.5 rounded-[8px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#141518] hover:bg-[#f8f9fa] dark:hover:bg-[#1a1b1f] hover:border-[#cbd5e1] dark:hover:border-[#383b42] text-[#334155] dark:text-[#c9ced6] text-[13px] font-[450] transition-all cursor-pointer group/sec shadow-sm"
          >
            <span>{hT.cta.btnTools}</span>
            <span class="text-[#64748b] group-hover/sec:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>

        <!-- Subtle Quality Signals Strip -->
        <div class="mt-8 pt-6 border-t border-[#e2e4e8] dark:border-[#1d1f23] grid grid-cols-1 sm:grid-cols-3 gap-3.5 max-w-md mx-auto text-left sm:text-center">
          <div class="flex items-center sm:justify-center gap-2 text-[12px] text-[#475569] dark:text-[#8a8f98] group-hover:text-[#08090a] dark:group-hover:text-[#a6abb5] transition-colors">
            <svg class="w-3.5 h-3.5 text-[#ff4d00] dark:text-[#e4f222] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="font-mono text-[11px]">{hT.cta.badgeInBrowser}</span>
          </div>
          <div class="flex items-center sm:justify-center gap-2 text-[12px] text-[#475569] dark:text-[#8a8f98] group-hover:text-[#08090a] dark:group-hover:text-[#a6abb5] transition-colors">
            <svg class="w-3.5 h-3.5 text-[#ff4d00] dark:text-[#e4f222] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span class="font-mono text-[11px]">{hT.cta.badgeZeroLatency}</span>
          </div>
          <div class="flex items-center sm:justify-center gap-2 text-[12px] text-[#475569] dark:text-[#8a8f98] group-hover:text-[#08090a] dark:group-hover:text-[#a6abb5] transition-colors">
            <svg class="w-3.5 h-3.5 text-[#ff4d00] dark:text-[#e4f222] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="font-mono text-[11px]">{hT.cta.badgeTestedCss}</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
