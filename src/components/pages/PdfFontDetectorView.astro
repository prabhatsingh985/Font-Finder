---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getViewTranslations } from '../../i18n/viewTranslations';
import type { SupportedLocale } from '../../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentLocale = lang as SupportedLocale;
const t = useTranslations(lang);
const vT = getViewTranslations(lang).pdf;
const p = (path: string) => getLocalizedPath(path, currentLocale);
---

<BaseLayout
  title={`${vT.heroTitle} ${vT.heroHighlight} — ProFontFinder`}
  description={vT.heroSubtitle}
  lang={lang}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": vT.faqs.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  })} />

  <!-- Hero Section -->
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-20 px-4 sm:px-6 bg-[#08090a] bg-grid-pattern-subtle border-b border-[#23252a]">
    <div class="max-w-[1200px] mx-auto text-center">
      
      <!-- Hero Header -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[510] text-[#ffffff] tracking-tight max-w-3xl mx-auto leading-tight">
        {vT.heroTitle} {vT.heroHighlight}
      </h1>
      <p class="mt-4 text-sm sm:text-base text-[#8a8f98] max-w-xl mx-auto leading-relaxed">
        {vT.heroSubtitle}
      </p>

      <!-- Upload Sample Image UI -->
      <div class="mt-8 sm:mt-12 w-full max-w-[1020px] mx-auto text-left">
        <FontFinderApp
          lang={lang}
          dropzoneTitle={vT.dropzoneTitle}
          dropzoneSubtitle={vT.dropzoneSubtitle}
          buttonText={vT.buttonText}
          accept="image/png, image/jpeg, image/jpg, image/webp, application/pdf, .pdf"
        />
      </div>

    </div>
  </section>

  <!-- HOW TO IDENTIFY FONTS IN PDF GUIDE -->
  <section class="py-16 sm:py-24 max-w-[1000px] mx-auto px-4 sm:px-6 space-y-16">
    <div class="text-center max-w-2xl mx-auto">
      <span class="font-mono text-xs uppercase tracking-widest text-[#ff4d00] dark:text-[#e4f222] font-semibold block mb-2">{vT.faqBadge}</span>
      <h2 class="text-2xl sm:text-4xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-tight">
        {vT.heroTitle} {vT.heroHighlight}
      </h2>
      <p class="mt-3 text-sm text-[#475569] dark:text-[#8a8f98] leading-relaxed">
        {vT.faqSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] shadow-sm space-y-3">
        <div class="font-mono text-xs font-bold text-[#ff4d00] dark:text-[#e4f222]">01</div>
        <h3 class="text-lg font-[510] text-[#08090a] dark:text-[#ffffff]">{vT.feature1Title}</h3>
        <p class="text-xs text-[#475569] dark:text-[#8a8f98] leading-relaxed">
          {vT.feature1Desc}
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] shadow-sm space-y-3">
        <div class="font-mono text-xs font-bold text-[#ff4d00] dark:text-[#e4f222]">02</div>
        <h3 class="text-lg font-[510] text-[#08090a] dark:text-[#ffffff]">{vT.feature2Title}</h3>
        <p class="text-xs text-[#475569] dark:text-[#8a8f98] leading-relaxed">
          {vT.feature2Desc}
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] shadow-sm space-y-3">
        <div class="font-mono text-xs font-bold text-[#ff4d00] dark:text-[#e4f222]">03</div>
        <h3 class="text-lg font-[510] text-[#08090a] dark:text-[#ffffff]">{vT.feature3Title}</h3>
        <p class="text-xs text-[#475569] dark:text-[#8a8f98] leading-relaxed">
          {vT.feature3Desc}
        </p>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="pt-8 border-t border-[#e2e4e8] dark:border-[#23252a] space-y-6">
      <h3 class="text-xl font-[510] text-[#08090a] dark:text-[#ffffff] text-center">{vT.faqTitle}</h3>
      <div class="space-y-4">
        {vT.faqs.map((faq) => (
          <div class="p-5 rounded-xl bg-white dark:bg-[#0f1011] border border-[#e2e4e8] dark:border-[#23252a] space-y-1.5">
            <h4 class="text-sm font-semibold text-[#08090a] dark:text-[#ffffff]">{faq.q}</h4>
            <p class="text-xs text-[#475569] dark:text-[#8a8f98] leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
