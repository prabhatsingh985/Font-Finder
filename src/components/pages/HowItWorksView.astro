---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const t = useTranslations(lang);
const hT = t.howItWorks;
---

<BaseLayout
  title={hT.meta.title}
  description={hT.meta.description}
  lang={lang}
>
  <article class="py-12 sm:py-20 px-4 sm:px-6 max-w-[1000px] mx-auto transition-colors">
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00] dark:bg-[#e4f222]"></div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#64748b] dark:text-[#8a8f98]">{hT.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.022em]">
        {hT.title}
      </h1>
      <p class="mt-3 text-[15px] sm:text-[16px] text-[#475569] dark:text-[#8a8f98] leading-relaxed font-normal">
        {hT.subtitle}
      </p>
    </div>

    <div class="space-y-6 text-[14px] leading-relaxed text-[#475569] dark:text-[#8a8f98]">
      
      <!-- Overview Section -->
      <section class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="font-mono text-[11px] font-normal text-[#ff4d00] dark:text-[#e4f222]">00</span>
          <h2 class="text-[15px] sm:text-[16px] font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.011em]">
            {hT.overviewTitle}
          </h2>
        </div>
        <p class="mt-2 text-[#334155] dark:text-[#d0d6e0]">
          {hT.overviewDesc}
        </p>
      </section>

      <!-- Phase 1 -->
      <section class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="font-mono text-[11px] font-normal text-[#ff4d00] dark:text-[#e4f222]">01</span>
          <h2 class="text-[15px] sm:text-[16px] font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.011em]">
            {hT.phase1.title}
          </h2>
        </div>
        <p class="mt-2 text-[#334155] dark:text-[#d0d6e0]">
          {hT.phase1.desc}
        </p>
        <ul class="space-y-1.5 list-disc pl-5 mt-3 text-[#334155] dark:text-[#d0d6e0]">
          {hT.phase1.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <!-- Phase 2 -->
      <section class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="font-mono text-[11px] font-normal text-[#ff4d00] dark:text-[#e4f222]">02</span>
          <h2 class="text-[15px] sm:text-[16px] font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.011em]">
            {hT.phase2.title}
          </h2>
        </div>
        <p class="mt-2 text-[#334155] dark:text-[#d0d6e0]">
          {hT.phase2.desc}
        </p>
        <ul class="space-y-1.5 list-disc pl-5 mt-3 text-[#334155] dark:text-[#d0d6e0]">
          {hT.phase2.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <!-- Phase 3 -->
      <section class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="font-mono text-[11px] font-normal text-[#ff4d00] dark:text-[#e4f222]">03</span>
          <h2 class="text-[15px] sm:text-[16px] font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.011em]">
            {hT.phase3.title}
          </h2>
        </div>
        <p class="mt-2 text-[#334155] dark:text-[#d0d6e0]">
          {hT.phase3.desc}
        </p>
        <ul class="space-y-1.5 list-disc pl-5 mt-3 text-[#334155] dark:text-[#d0d6e0]">
          {hT.phase3.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <!-- Phase 4 -->
      <section class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="font-mono text-[11px] font-normal text-[#ff4d00] dark:text-[#e4f222]">04</span>
          <h2 class="text-[15px] sm:text-[16px] font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.011em]">
            {hT.phase4.title}
          </h2>
        </div>
        <p class="mt-2 text-[#334155] dark:text-[#d0d6e0]">
          {hT.phase4.desc}
        </p>
        <ul class="space-y-1.5 list-disc pl-5 mt-3 text-[#334155] dark:text-[#d0d6e0]">
          {hT.phase4.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <!-- Canvas & Privacy Callouts -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 shadow-sm">
          <h3 class="font-[510] text-[15px] text-[#08090a] dark:text-[#ffffff] mb-2">{hT.canvasTitle}</h3>
          <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] leading-relaxed">{hT.canvasDesc}</p>
        </div>
        <div class="rounded-[12px] border border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#0f1011] p-6 shadow-sm">
          <h3 class="font-[510] text-[15px] text-[#08090a] dark:text-[#ffffff] mb-2">{hT.privacyTitle}</h3>
          <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] leading-relaxed">{hT.privacyDesc}</p>
        </div>
      </div>

    </div>
  </article>
</BaseLayout>
