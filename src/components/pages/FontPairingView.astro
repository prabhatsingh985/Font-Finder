---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontFinderApp from '../../components/FontFinderApp.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLocale } from '../../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentLocale = lang as SupportedLocale;
const t = useTranslations(lang);
const fP = t.fontPairing;
---

<BaseLayout
  title={fP.meta.title}
  description={fP.meta.description}
  lang={lang}
>
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 bg-[#08090a] bg-grid-pattern-subtle border-b border-[#23252a] min-h-[calc(100vh-140px)]">
    <div class="max-w-[1200px] mx-auto">
      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-5xl font-medium text-[#ffffff] tracking-tight" style="letter-spacing: -0.022em;">
          {fP.title}
        </h1>
        <p class="mt-3.5 text-sm sm:text-base text-[#8a8f98] leading-relaxed max-w-xl mx-auto">
          {fP.subtitle}
        </p>
      </div>

      <!-- Dropzone for Font Pairing Finder (Optical Identification & Matcher) -->
      <div class="mt-8 sm:mt-12 w-full max-w-[1020px] mx-auto text-left">
        <FontFinderApp
          lang={lang}
          dropzoneTitle={fP.dropzoneTitle}
          dropzoneSubtitle={fP.dropzoneSubtitle}
          buttonText={fP.buttonText}
        />
      </div>
    </div>
  </section>
</BaseLayout>
