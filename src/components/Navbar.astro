---
const currentPath = Astro.url.pathname;
---

<!-- Sticky Top Nav Bar -->
<header class="sticky top-0 z-50 w-full border-b border-[#e5e7eb] dark:border-[#202430] bg-white/85 dark:bg-[#0b0d11]/85 backdrop-blur-md transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 h-14 sm:h-15 flex items-center justify-between">
    
    <!-- Left: Geometric Logo + Wordmark -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 rounded-lg bg-[#ff4d00]/10 border border-[#ff4d00]/20 flex items-center justify-center text-[#ff4d00] group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2c-.8 2.2-2.8 4.2-4.5 6-2 2.2-3.5 4.8-3.5 7.8 0 4.4 3.6 8.2 8 8.2s8-3.8 8-8.2c0-2.5-1-4.8-2.6-6.7-1.5-1.8-3.4-3.5-4.4-5.3-.3-.6-.7-1.3-1-1.8zM12 20c-2.8 0-5-2.2-5-5 0-1.8 1-3.3 2.1-4.7 1.1-1.3 2.2-2.7 2.9-4.3.7 1.5 1.8 2.9 2.9 4.3 1.1 1.4 2.1 2.9 2.1 4.7 0 2.8-2.2 5-5 5z"/>
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-semibold tracking-tight text-sm text-[#111827] dark:text-[#f3f4f6]">Font Finder</span>
        <span class="font-mono text-[10px] text-[#6b7280] dark:text-[#9ca3af] border border-[#e5e7eb] dark:border-[#242834] px-1.5 py-0.5 rounded bg-[#f9fafb] dark:bg-[#131620] hidden sm:inline-block">
          OPEN SOURCE
        </span>
      </div>
    </a>

    <!-- Center: Main Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-xs font-medium" aria-label="Main Navigation">
      <a
        href="/"
        class={`px-3 py-1.5 rounded-lg transition-colors hover:text-[#ff4d00] ${
          currentPath === '/' ? 'text-[#ff4d00] bg-[#f3f4f6] dark:bg-[#161922] font-semibold' : 'text-[#4b5563] dark:text-[#9ca3af] hover:bg-[#f3f4f6] dark:hover:bg-[#161922]'
        }`}
      >
        Finder
      </a>
      <a
        href="/tools"
        class={`px-3 py-1.5 rounded-lg transition-colors hover:text-[#ff4d00] ${
          currentPath.startsWith('/tools') ? 'text-[#ff4d00] bg-[#f3f4f6] dark:bg-[#161922] font-semibold' : 'text-[#4b5563] dark:text-[#9ca3af] hover:bg-[#f3f4f6] dark:hover:bg-[#161922]'
        }`}
      >
        Tools
      </a>
      <a
        href="/fonts"
        class={`px-3 py-1.5 rounded-lg transition-colors hover:text-[#ff4d00] ${
          currentPath.startsWith('/fonts') ? 'text-[#ff4d00] bg-[#f3f4f6] dark:bg-[#161922] font-semibold' : 'text-[#4b5563] dark:text-[#9ca3af] hover:bg-[#f3f4f6] dark:hover:bg-[#161922]'
        }`}
      >
        Browse Fonts
      </a>
      <a
        href="/how-it-works"
        class={`px-3 py-1.5 rounded-lg transition-colors hover:text-[#ff4d00] ${
          currentPath === '/how-it-works' ? 'text-[#ff4d00] bg-[#f3f4f6] dark:bg-[#161922] font-semibold' : 'text-[#4b5563] dark:text-[#9ca3af] hover:bg-[#f3f4f6] dark:hover:bg-[#161922]'
        }`}
      >
        Anatomy & Guide
      </a>
      <a
        href="/about"
        class={`px-3 py-1.5 rounded-lg transition-colors hover:text-[#ff4d00] ${
          currentPath === '/about' ? 'text-[#ff4d00] bg-[#f3f4f6] dark:bg-[#161922] font-semibold' : 'text-[#4b5563] dark:text-[#9ca3af] hover:bg-[#f3f4f6] dark:hover:bg-[#161922]'
        }`}
      >
        About
      </a>
    </nav>

    <!-- Right: Theme Toggle & Primary Action -->
    <div class="flex items-center gap-2">
      <!-- Theme button toggle for dark / light mode -->
      <button
        id="theme-toggle"
        type="button"
        class="w-8 h-8 rounded-lg border border-[#e5e7eb] dark:border-[#242834] bg-white dark:bg-[#131620] flex items-center justify-center text-[#6b7280] dark:text-[#9ca3af] hover:text-[#111827] dark:hover:text-white transition-colors cursor-pointer shadow-2xs"
        aria-label="Toggle dark mode"
        title="Toggle dark / light mode"
      >
        <!-- Sun Icon (visible in dark mode) -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden text-[#ff4d00]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="4" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41"/>
        </svg>
        <!-- Moon Icon (visible in light mode) -->
        <svg id="theme-icon-moon" class="w-4 h-4 text-[#374151]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Primary Action: Clean Official Button -->
      <a
        href="/#finder"
        class="inline-flex items-center justify-center px-3.5 py-1.5 text-xs font-medium rounded-lg bg-[#111827] hover:bg-[#262626] dark:bg-[#ff4d00] dark:hover:bg-[#e04400] text-white transition-colors shadow-2xs"
      >
        Identify Font
      </a>
    </div>

  </div>

  <!-- Mobile Secondary Menu Bar -->
  <div class="flex md:hidden items-center justify-around border-t border-[#e5e7eb] dark:border-[#202430] py-2 px-3 text-[11px] font-medium text-[#6b7280] dark:text-[#9ca3af] bg-white/90 dark:bg-[#0b0d11]/90 backdrop-blur-md">
    <a href="/" class={`hover:text-[#ff4d00] ${currentPath === '/' ? 'text-[#ff4d00] font-semibold' : ''}`}>Finder</a>
    <a href="/tools" class={`hover:text-[#ff4d00] ${currentPath.startsWith('/tools') ? 'text-[#ff4d00] font-semibold' : ''}`}>Tools</a>
    <a href="/fonts" class={`hover:text-[#ff4d00] ${currentPath.startsWith('/fonts') ? 'text-[#ff4d00] font-semibold' : ''}`}>Browse</a>
    <a href="/how-it-works" class={`hover:text-[#ff4d00] ${currentPath === '/how-it-works' ? 'text-[#ff4d00] font-semibold' : ''}`}>Guide</a>
  </div>
</header>

<script is:inline>
  (function () {
    const toggleBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function syncThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (sunIcon && moonIcon) {
        if (isDark) {
          sunIcon.classList.remove('hidden');
          moonIcon.classList.add('hidden');
          if (toggleBtn) toggleBtn.setAttribute('title', 'Switch to light mode');
        } else {
          sunIcon.classList.add('hidden');
          moonIcon.classList.remove('hidden');
          if (toggleBtn) toggleBtn.setAttribute('title', 'Switch to dark mode');
        }
      }
    }

    syncThemeIcons();

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        syncThemeIcons();
      });
    }
  })();
</script>

