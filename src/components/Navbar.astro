---
import LanguagePicker from './LanguagePicker.astro';
import { useTranslations, getLocalizedPath, getCleanPath } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const cleanPath = getCleanPath(currentPath);
const t = useTranslations(lang);
const navT = t.common.nav;

const homeHref = getLocalizedPath('/', lang as SupportedLocale);
const toolsHref = getLocalizedPath('/tools', lang as SupportedLocale);
const guidesHref = getLocalizedPath('/guides', lang as SupportedLocale);
const aboutHref = getLocalizedPath('/about', lang as SupportedLocale);
const finderHref = `${homeHref === '/' ? '' : homeHref}/#finder`;
---

<!-- Linear Precision Top Nav Bar -->
<header class="sticky top-0 z-50 w-full border-b border-[#e2e4e8] dark:border-[#383b44] bg-white/85 dark:bg-[#08090a]/85 backdrop-blur-md transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    
    <!-- Left: Geometric Logo + Wordmark -->
    <a href={homeHref} class="flex items-center gap-2.5 group">
      <div class="w-6 h-6 rounded-[6px] bg-[#f1f3f6] dark:bg-[#161718] border border-[#e2e4e8] dark:border-[#383b44] flex items-center justify-center text-[#08090a] dark:text-[#ffffff] group-hover:border-[#ff4d00] dark:group-hover:border-[#64748b] transition-colors">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <span class="font-[510] tracking-[-0.015em] text-[14px] text-[#08090a] dark:text-[#ffffff]">{t.common.brandName}</span>
    </a>

    <!-- Center: Main Navigation Links (Pure Typographic Nav) -->
    <nav class="hidden md:flex items-center gap-1 text-[13px]" aria-label="Main Navigation">
      <a
        href={homeHref}
        class={`px-3 py-1.5 rounded-[6px] transition-colors ${
          cleanPath === '/' ? 'text-[#08090a] dark:text-[#ffffff] font-[510] bg-black/[0.05] dark:bg-white/[0.05]' : 'text-[#475569] dark:text-[#d0d6e0] hover:text-[#08090a] dark:hover:text-[#ffffff] hover:bg-black/[0.03] dark:hover:bg-white/[0.03]'
        }`}
      >
        {navT.finder}
      </a>
      <a
        href={toolsHref}
        class={`px-3 py-1.5 rounded-[6px] transition-colors ${
          cleanPath.startsWith('/tools') ? 'text-[#08090a] dark:text-[#ffffff] font-[510] bg-black/[0.05] dark:bg-white/[0.05]' : 'text-[#475569] dark:text-[#d0d6e0] hover:text-[#08090a] dark:hover:text-[#ffffff] hover:bg-black/[0.03] dark:hover:bg-white/[0.03]'
        }`}
      >
        {navT.tools}
      </a>
      <a
        href={guidesHref}
        class={`px-3 py-1.5 rounded-[6px] transition-colors ${
          cleanPath.startsWith('/guides') ? 'text-[#08090a] dark:text-[#ffffff] font-[510] bg-black/[0.05] dark:bg-white/[0.05]' : 'text-[#475569] dark:text-[#d0d6e0] hover:text-[#08090a] dark:hover:text-[#ffffff] hover:bg-black/[0.03] dark:hover:bg-white/[0.03]'
        }`}
      >
        {navT.guides}
      </a>
      <a
        href={aboutHref}
        class={`px-3 py-1.5 rounded-[6px] transition-colors ${
          cleanPath === '/about' ? 'text-[#08090a] dark:text-[#ffffff] font-[510] bg-black/[0.05] dark:bg-white/[0.05]' : 'text-[#475569] dark:text-[#d0d6e0] hover:text-[#08090a] dark:hover:text-[#ffffff] hover:bg-black/[0.03] dark:hover:bg-white/[0.03]'
        }`}
      >
        {navT.about}
      </a>
    </nav>

    <!-- Right: Language Switcher, Theme Switcher & High-emphasis CTA -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <!-- Language Picker -->
      <LanguagePicker currentLang={lang} />

      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle"
        type="button"
        aria-label={navT.toggleTheme}
        class="w-8 h-8 rounded-[6px] border border-[#e2e4e8] dark:border-[#383b44] bg-white dark:bg-[#161718] flex items-center justify-center text-[#475569] dark:text-[#8a8f98] hover:text-[#08090a] dark:hover:text-[#ffffff] hover:border-[#cbd5e1] dark:hover:border-[#64748b] transition-colors cursor-pointer shadow-sm dark:shadow-[0_1px_3px_rgba(0,0,0,0.5),inset_0_1px_0_rgba(255,255,255,0.08)]"
        title="Toggle dark / light mode"
      >
        <!-- Sun Icon (visible in dark mode) -->
        <svg class="sun-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <circle cx="12" cy="12" r="4"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41"></path>
        </svg>
        <!-- Moon Icon (visible in light mode) -->
        <svg class="moon-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <a
        href={finderHref}
        class="btn-white-pill inline-flex items-center justify-center px-4 py-1.5 text-[13px] font-[510] rounded-full bg-[#08090a] dark:bg-[#ffffff] text-white dark:text-[#08090a] hover:bg-[#23252a] dark:hover:bg-[#e5e5e6] transition-colors shadow-sm"
      >
        {navT.identifyFont}
      </a>
    </div>

  </div>

  <!-- Mobile Secondary Menu Bar -->
  <div class="flex md:hidden items-center justify-around border-t border-[#e2e4e8] dark:border-[#383b44] py-2.5 px-4 text-[13px] font-normal text-[#64748b] dark:text-[#8a8f98] bg-white/90 dark:bg-[#08090a]/90 backdrop-blur-md">
    <a href={homeHref} class={`hover:text-[#08090a] dark:hover:text-[#ffffff] ${cleanPath === '/' ? 'text-[#08090a] dark:text-[#ffffff] font-[510]' : ''}`}>{navT.finder}</a>
    <a href={toolsHref} class={`hover:text-[#08090a] dark:hover:text-[#ffffff] ${cleanPath.startsWith('/tools') ? 'text-[#08090a] dark:text-[#ffffff] font-[510]' : ''}`}>{navT.tools}</a>
    <a href={guidesHref} class={`hover:text-[#08090a] dark:hover:text-[#ffffff] ${cleanPath.startsWith('/guides') ? 'text-[#08090a] dark:text-[#ffffff] font-[510]' : ''}`}>{navT.guides}</a>
    <a href={aboutHref} class={`hover:text-[#08090a] dark:hover:text-[#ffffff] ${cleanPath === '/about' ? 'text-[#08090a] dark:text-[#ffffff] font-[510]' : ''}`}>{navT.about}</a>
  </div>

  <style>
    :global(.dark) .sun-icon { display: block !important; }
    :global(.dark) .moon-icon { display: none !important; }
    :global(html:not(.dark)) .sun-icon { display: none !important; }
    :global(html:not(.dark)) .moon-icon { display: block !important; }

    :global(html.dark) #theme-toggle {
      border-color: #383b44 !important;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.4), inset 0 1px 0 0 rgba(255, 255, 255, 0.08) !important;
    }
    :global(html.dark) #theme-toggle:hover {
      border-color: #64748b !important;
    }
  </style>

  <script is:inline>
    (function () {
      function setupThemeToggle() {
        const btn = document.getElementById('theme-toggle');

        function toggleTheme() {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
            try { localStorage.setItem('theme', 'light'); } catch (e) {}
          } else {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
            try { localStorage.setItem('theme', 'dark'); } catch (e) {}
          }
        }

        btn?.addEventListener('click', toggleTheme);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupThemeToggle);
      } else {
        setupThemeToggle();
      }
    })();
  </script>
</header>
