---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Font Finder — Free Image Font Identifier & Google Fonts Verification',
  description = 'Instantly identify fonts from any image or screenshot. Powered by optical typography analysis with verified Google Fonts matches, copy-ready CSS, and free alternatives.',
  canonicalUrl = Astro.url.href,
  ogImage = '/og-image.png',
  type = 'website'
} = Astro.props;

const siteName = 'Font Finder';
const siteOrigin = 'https://font-finder-zeta.vercel.app';

// Always provide absolute HTTPS URLs for social scrapers (WhatsApp, Twitter, LinkedIn, Slack, Discord)
const absoluteCanonical = canonicalUrl.startsWith('http')
  ? canonicalUrl
  : `${siteOrigin}${canonicalUrl.startsWith('/') ? '' : '/'}${canonicalUrl}`;

const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={absoluteCanonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Preconnect & Load Verified Google Fonts for local Canvas rendering -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Roboto:wght@400;700&family=Montserrat:wght@400;700&family=Poppins:wght@400;700&family=Plus+Jakarta+Sans:wght@400;700&family=DM+Sans:wght@400;700&family=Manrope:wght@400;700&family=Open+Sans:wght@400;700&family=Lato:wght@400;700&family=Raleway:wght@400;700&family=Nunito:wght@400;700&family=Oswald:wght@400;700&family=Playfair+Display:wght@400;700&family=Merriweather:wght@400;700&family=Lora:wght@400;700&family=EB+Garamond:wght@400;700&family=Cinzel:wght@400;700&family=Cormorant+Garamond:wght@400;700&family=Space+Mono:wght@400;700&family=Fira+Code:wght@400;700&family=Bebas+Neue:wght@400&family=Anton:wght@400&family=Pacifico:wght@400&family=Caveat:wght@400;700&family=Space+Grotesk:wght@400;700&family=Syne:wght@400;700&family=Outfit:wght@400;700&family=Work+Sans:wght@400;700&display=swap"
  rel="stylesheet"
/>

<!-- Open Graph / Facebook / WhatsApp / LinkedIn / Slack / Discord -->
<meta property="og:type" content={type} />
<meta property="og:url" content={absoluteCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:secure_url" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content="Font Finder - In-Browser Font Identification from Images & Screenshots" />
<meta property="og:site_name" content={siteName} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={absoluteCanonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:alt" content="Font Finder - In-Browser Font Identification from Images & Screenshots" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Font Finder",
    "url": "https://font-finder-zeta.vercel.app",
    "applicationCategory": "DesignApplication",
    "operatingSystem": "Any",
    "isAccessibleForFree": true,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Optical image font recognition",
      "100% verified Google Fonts matches",
      "Instant copy-ready CSS @import and font-family declarations",
      "Free open-source alternatives to commercial typefaces",
      "Live interactive font specimen tester",
      "Zero image storage, privacy-first in-browser processing"
    ],
    "description": "Free font finder tool. Identify typefaces from images, verify on Google Fonts, and copy ready-to-use CSS snippets."
  }
</script>
