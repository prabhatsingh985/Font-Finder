---
import { getHreflangTags, getCanonicalUrl, getCleanPath, getLocalizedPath } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/languages';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  keywords?: string[];
  noindex?: boolean;
  lang?: string;
  breadcrumbs?: { name: string; item?: string }[];
  /** Emit hreflang alternates. Disable for pages that only exist in one locale. */
  hreflang?: boolean;
}

const {
  title = 'Font Finder — Free Font Identifier: Find Font from Image',
  description = 'What font is this? Use our free font finder to identify font from image, photo, or picture. Upload a screenshot or logo and find the font in seconds — no signup.',
  canonicalUrl,
  ogImage = '/og-image.jpg?v=2',
  type = 'website',
  keywords,
  noindex = false,
  lang = (Astro.currentLocale as string) || 'en',
  breadcrumbs,
  hreflang = true
} = Astro.props;

const siteName = 'ProFontFinder';
const siteOrigin = 'https://profontfinder.com';

// Generate self-referencing canonical URL if not explicitly provided
const absoluteCanonical = canonicalUrl
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : `${siteOrigin}${canonicalUrl.startsWith('/') ? '' : '/'}${canonicalUrl}`)
  : getCanonicalUrl(Astro.url.pathname, lang, siteOrigin);

const hreflangs = hreflang ? getHreflangTags(Astro.url.pathname, siteOrigin) : [];

const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const isPng = absoluteOgImage.toLowerCase().endsWith('.png');
const ogImageType = isPng ? 'image/png' : 'image/jpeg';

// BreadcrumbList JSON-LD for inner pages (Tools, Fonts, Guides, About and sub-pages; not on homepage)
const cleanPath = getCleanPath(Astro.url.pathname);
const isHomePage = cleanPath === '/' || cleanPath === '';

let breadcrumbsList: { name: string; item: string }[] = [];

if (!isHomePage) {
  if (breadcrumbs && breadcrumbs.length > 0) {
    breadcrumbsList = breadcrumbs.map((b) => ({
      name: b.name,
      item: b.item
        ? (b.item.startsWith('http') ? b.item : `${siteOrigin}${b.item.startsWith('/') ? '' : '/'}${b.item}`)
        : absoluteCanonical
    }));
  } else {
    const homeNames: Record<string, string> = {
      en: 'Home',
      es: 'Inicio',
      de: 'Startseite',
      fr: 'Accueil',
      it: 'Home',
      ja: 'ホーム',
      ko: '홈',
      pt: 'Início'
    };

    const sectionNames: Record<string, Record<string, string>> = {
      tools: {
        en: 'Tools',
        es: 'Herramientas',
        de: 'Werkzeuge',
        fr: 'Outils',
        it: 'Strumenti',
        ja: 'ツール',
        ko: '도구',
        pt: 'Ferramentas'
      },
      fonts: {
        en: 'Fonts',
        es: 'Fuentes',
        de: 'Schriften',
        fr: 'Polices',
        it: 'Font',
        ja: 'フォント',
        ko: '폰트',
        pt: 'Fontes'
      },
      guides: {
        en: 'Guides',
        es: 'Guías',
        de: 'Ratgeber',
        fr: 'Guides',
        it: 'Guide',
        ja: 'ガイド',
        ko: '가이드',
        pt: 'Guias'
      },
      blog: {
        en: 'Blog',
        es: 'Blog',
        de: 'Blog',
        fr: 'Blog',
        it: 'Blog',
        ja: 'ブログ',
        ko: '블로그',
        pt: 'Blog'
      },
      about: {
        en: 'About',
        es: 'Acerca de',
        de: 'Über uns',
        fr: 'À propos',
        it: 'Chi siamo',
        ja: '概要',
        ko: '소개',
        pt: 'Sobre'
      },
      'how-it-works': {
        en: 'How It Works',
        es: 'Cómo funciona',
        de: "So funktioniert's",
        fr: 'Comment ça marche',
        it: 'Come funziona',
        ja: '使い方',
        ko: '작동 원리',
        pt: 'Como Funciona'
      },
      contact: {
        en: 'Contact',
        es: 'Contacto',
        de: 'Kontakt',
        fr: 'Contact',
        it: 'Contatto',
        ja: 'お問い合わせ',
        ko: '문의',
        pt: 'Contato'
      },
      privacy: {
        en: 'Privacy Policy',
        es: 'Política de privacidad',
        de: 'Datenschutzerklärung',
        fr: 'Politique de confidentialité',
        it: 'Informativa sulla privacy',
        ja: 'プライバシーポリシー',
        ko: '개인정보처리방침',
        pt: 'Política de Privacidade'
      },
      terms: {
        en: 'Terms of Service',
        es: 'Términos del servicio',
        de: 'Nutzungsbedingungen',
        fr: "Conditions d'utilisation",
        it: 'Termini di servizio',
        ja: '利用規約',
        ko: '이용약관',
        pt: 'Termos de Serviço'
      },
      'free-font-alternative-finder': {
        en: 'Free Font Alternatives',
        es: 'Alternativas Gratuitas de Fuentes',
        de: 'Kostenlose Schriftarten-Alternativen',
        fr: 'Alternatives Gratuites de Polices',
        it: 'Alternative Gratuite ai Font',
        ja: '無料代替フォント検索',
        ko: '무료 대체 폰트 찾기',
        pt: 'Alternativas Gratuitas de Fontes'
      },
      'screenshot-font-finder': {
        en: 'Screenshot Font Finder',
        es: 'Buscador de Fuentes por Captura',
        de: 'Screenshot-Schriftartenfinder',
        fr: 'Recherche de Polices par Capture',
        it: 'Trova Font da Screenshot',
        ja: 'スクリーンショットフォント検索',
        ko: '스크린샷 폰트 검색기',
        pt: 'Identificador de Fontes por Captura'
      },
      'logo-font-finder': {
        en: 'Logo Font Finder',
        es: 'Identificador de Fuentes de Logos',
        de: 'Logo-Schriftartenfinder',
        fr: 'Identificateur de Polices de Logos',
        it: 'Identificatore di Font per Loghi',
        ja: 'ロゴフォント検索',
        ko: '로고 폰트 식별기',
        pt: 'Identificador de Fontes de Logotipos'
      },
      'logo-font-identifier': {
        en: 'Logo Font Finder',
        es: 'Identificador de Fuentes de Logos',
        de: 'Logo-Schriftartenfinder',
        fr: 'Identificateur de Polices de Logos',
        it: 'Identificatore di Font per Loghi',
        ja: 'ロゴフォント検索',
        ko: '로고 폰트 식별기',
        pt: 'Identificador de Fontes de Logotipos'
      },
      'url-font-finder': {
        en: 'URL Font Finder',
        es: 'Buscador de Fuentes por URL',
        de: 'URL-Schriftartenfinder',
        fr: 'Recherche de Polices par URL',
        it: 'Trova Font da URL',
        ja: 'URLフォント検索',
        ko: 'URL 폰트 검색기',
        pt: 'Identificador de Fontes por URL'
      },
      'handwriting-font-finder': {
        en: 'Handwriting Font Finder',
        es: 'Buscador de Fuentes Manuscritas',
        de: 'Handschrift-Schriftartenfinder',
        fr: 'Recherche de Polices Manuscrites',
        it: 'Trova Font Manoscritti',
        ja: '手書きフォント検索',
        ko: '손글씨 폰트 검색기',
        pt: 'Identificador de Fontes Manuscritas'
      },
      'font-pairing': {
        en: 'Font Pairing',
        es: 'Combinación de Fuentes',
        de: 'Schriftkombinationen',
        fr: 'Combinaisons de Polices',
        it: 'Combinazione di Font',
        ja: 'フォントペアリング',
        ko: '폰트 조합',
        pt: 'Combinação de Fontes'
      },
      'font-pairing-finder': {
        en: 'Font Pairing',
        es: 'Combinación de Fuentes',
        de: 'Schriftkombinationen',
        fr: 'Combinaisons de Polices',
        it: 'Combinazione di Font',
        ja: 'フォントペアリング',
        ko: '폰트 조합',
        pt: 'Combinação de Fontes'
      },
      'pdf-font-detector': {
        en: 'PDF Font Detector',
        es: 'Detector de Fuentes en PDF',
        de: 'PDF-Schriftartenfinder',
        fr: 'Détecteur de Polices PDF',
        it: 'Rilevatore di Font PDF',
        ja: 'PDFフォント検出',
        ko: 'PDF 폰트 감지기',
        pt: 'Detector de Fontes em PDF'
      }
    };

    const homeUrl = getLocalizedPath('/', lang as SupportedLocale);
    breadcrumbsList.push({
      name: homeNames[lang] || 'Home',
      item: `${siteOrigin}${homeUrl === '/' ? '/' : homeUrl}`
    });

    const segments = cleanPath.split('/').filter(Boolean);
    let accumPath = '';

    segments.forEach((seg, idx) => {
      accumPath += `/${seg}`;
      const isLast = idx === segments.length - 1;
      const segLower = seg.toLowerCase();
      let segName = sectionNames[segLower]?.[lang] || sectionNames[segLower]?.en;

      if (!segName) {
        segName = decodeURIComponent(seg)
          .split('-')
          .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
          .join(' ');
      }

      const localizedSegPath = getLocalizedPath(accumPath, lang as SupportedLocale);
      const segUrl = `${siteOrigin}${localizedSegPath === '/' ? '/' : localizedSegPath}`;

      breadcrumbsList.push({
        name: isLast && title && segments.length === 1 ? title.split('—')[0].split('|')[0].trim() : segName,
        item: segUrl
      });
    });
  }
}

const breadcrumbJsonLd = !isHomePage && breadcrumbsList.length > 0
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbsList.map((crumb, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": crumb.name,
        "item": crumb.item
      }))
    }).replace(/</g, '\\u003c')
  : null;

// Site-wide entities go on every page; the application entity only on pages that
// actually host the tool, so catalog and guide pages don't claim to be the app.
const isToolPage = isHomePage || cleanPath === '/tools' || cleanPath.startsWith('/tools/');
const siteGraph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": "https://profontfinder.com/#website",
    "url": "https://profontfinder.com/",
    "name": "ProFontFinder",
    "alternateName": [
      "Pro Font Finder",
      "Font Finder",
      "Free Font Finder",
      "Font Identifier",
      "Image Font Finder",
      "Font Identifier by Image"
    ],
    "description": "Free font finder and font identifier: find the font from any image, photo, or screenshot and get matching Google Fonts.",
    "inLanguage": lang,
    "publisher": {
      "@id": "https://profontfinder.com/#organization"
    }
  },
  {
    "@type": "Organization",
    "@id": "https://profontfinder.com/#organization",
    "name": "ProFontFinder",
    "url": "https://profontfinder.com/",
    "logo": "https://profontfinder.com/favicon.svg"
  }
];
const appEntity = {
  "@type": [
    "WebApplication",
    "SoftwareApplication"
  ],
  "@id": "https://profontfinder.com/#webapp",
  "name": "ProFontFinder — Free Font Finder from Image",
  "alternateName": ["Font Identifier", "Image Font Finder", "Photo Font Identifier", "Picture Font Finder"],
  "url": "https://profontfinder.com/",
  "image": "https://profontfinder.com/og-image.png",
  "applicationCategory": "DesignApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires HTML5 Canvas and JavaScript",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Optical letterform recognition from images and screenshots",
    "100% verified free Google Fonts alternatives",
    "Client-side zero-storage privacy processing",
    "Instant copy-ready CSS @import declarations",
    "Interactive typography specimen test bench"
  ],
  "description": "Free font finder and font identifier. Identify fonts from images, photos, screenshots, and logos, match them to Google Fonts, and copy ready-to-use CSS.",
  "publisher": {
    "@id": "https://profontfinder.com/#organization"
  }
};
const siteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": isToolPage ? [...siteGraph, appEntity] : siteGraph
}).replace(/</g, '\\u003c');
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}
<link rel="canonical" href={absoluteCanonical} />

<!-- Reciprocal hreflang tags for all 8 supported languages + x-default -->
{hreflangs.map((entry) => (
  <link rel="alternate" hreflang={entry.lang} href={entry.href} />
))}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph / Facebook / WhatsApp / LinkedIn / Slack / Discord -->
<meta property="og:type" content={type} />
<meta property="og:url" content={absoluteCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:secure_url" content={absoluteOgImage} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={siteName} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:domain" content="profontfinder.com" />
<meta name="twitter:url" content={absoluteCanonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:src" content={absoluteOgImage} />
<meta name="twitter:image:width" content="1200" />
<meta name="twitter:image:height" content="630" />
<meta name="twitter:image:alt" content={title} />

<!-- Preconnect & Load Verified Google Fonts for local Canvas rendering -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- UI fonts (Inter, JetBrains Mono) stay render-blocking to avoid layout shift. -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<!-- Reference faces used only for canvas matching load without blocking first paint;
     FontFinderApp awaits document.fonts.load() before drawing with them. -->
<link
  href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Montserrat:wght@400;700&family=Poppins:wght@400;700&family=Plus+Jakarta+Sans:wght@400;700&family=DM+Sans:wght@400;700&family=Manrope:wght@400;700&family=Open+Sans:wght@400;700&family=Lato:wght@400;700&family=Raleway:wght@400;700&family=Nunito:wght@400;700&family=Oswald:wght@400;700&family=Playfair+Display:wght@400;700&family=Merriweather:wght@400;700&family=Lora:wght@400;700&family=EB+Garamond:wght@400;700&family=Cinzel:wght@400;700&family=Cormorant+Garamond:wght@400;700&family=Space+Mono:wght@400;700&family=Fira+Code:wght@400;700&family=Bebas+Neue:wght@400&family=Anton:wght@400&family=Pacifico:wght@400&family=Caveat:wght@400;700&family=Space+Grotesk:wght@400;700&family=Syne:wght@400;700&family=Outfit:wght@400;700&family=Work+Sans:wght@400;700&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>
<noscript><link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Montserrat:wght@400;700&family=Poppins:wght@400;700&family=Plus+Jakarta+Sans:wght@400;700&family=DM+Sans:wght@400;700&family=Manrope:wght@400;700&family=Open+Sans:wght@400;700&family=Lato:wght@400;700&family=Raleway:wght@400;700&family=Nunito:wght@400;700&family=Oswald:wght@400;700&family=Playfair+Display:wght@400;700&family=Merriweather:wght@400;700&family=Lora:wght@400;700&family=EB+Garamond:wght@400;700&family=Cinzel:wght@400;700&family=Cormorant+Garamond:wght@400;700&family=Space+Mono:wght@400;700&family=Fira+Code:wght@400;700&family=Bebas+Neue:wght@400&family=Anton:wght@400&family=Pacifico:wght@400&family=Caveat:wght@400;700&family=Space+Grotesk:wght@400;700&family=Syne:wght@400;700&family=Outfit:wght@400;700&family=Work+Sans:wght@400;700&display=swap" rel="stylesheet" /></noscript>

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" is:inline set:html={siteJsonLd}></script>

{breadcrumbJsonLd && (
  <script type="application/ld+json" is:inline set:html={breadcrumbJsonLd}></script>
)}

