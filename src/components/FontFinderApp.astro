    function updateAllSpecimensText(txt) {
      const fontFam = currentPrimaryFont ? currentPrimaryFont.family : 'Inter';
      const fontCat = currentPrimaryFont ? currentPrimaryFont.category : 'sans-serif';
      if (compareMatched) {
        compareMatched.textContent = txt;
        compareMatched.style.fontFamily = `'${fontFam}', ${fontCat}`;
      }
      if (specimenInput) {
        specimenInput.value = txt;
      }
      if (compareTextInput) {
        compareTextInput.value = txt;
      }
      document.querySelectorAll('.specimen-card-preview').forEach((el) => {
