---
import { VERIFIED_GOOGLE_FONTS } from '../services/googleFonts/data';

interface Props {
  dropzoneTitle?: string;
  dropzoneSubtitle?: string;
  buttonText?: string;
  accept?: string;
  wordmarkInputPlaceholder?: string;
}

const {
  dropzoneTitle = 'Drop an image or paste screenshot (⌘V)',
  dropzoneSubtitle = 'Supports PNG, JPG, WebP • 100% private in-browser detection',
  buttonText = 'Select Image File',
  accept = 'image/png, image/jpeg, image/jpg, image/webp',
  wordmarkInputPlaceholder = ''
} = Astro.props;

const fontsJson = JSON.stringify(VERIFIED_GOOGLE_FONTS);
---

<div id="finder" data-exclude-cursor-glow="true" class="w-full max-w-[1000px] mx-auto scroll-mt-20">
  <script id="fonts-data" type="application/json" is:inline set:html={fontsJson}></script>
  <script is:inline src="/vendor/tesseract.min.js"></script>
  <script is:inline>
    if (typeof Tesseract === 'undefined') {
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';
      document.head.appendChild(s);
    }
  </script>

  <!-- Step 1: Linear Precision Upload & Dropzone -->
  <div id="upload-stage" class="transition-all">
    <!-- Elevated Dropzone Card -->
    <div
      id="dropzone"
      class="relative rounded-[12px] border border-[#23252a] bg-[#0f1011] p-8 sm:p-12 shadow-sm hover:border-[#383b3f] transition-all cursor-pointer group"
    >
      <input
        type="file"
        id="file-input"
        accept={accept}
        class="sr-only"
      />

      <!-- Center Content -->
      <div class="text-center max-w-md mx-auto">
        <!-- Precision Line Icon Container -->
        <div class="mx-auto w-10 h-10 rounded-[6px] bg-[#161718] border border-[#23252a] flex items-center justify-center text-[#e4f222] mb-4 group-hover:border-[#383b3f] transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>

        <h3 class="text-[16px] sm:text-[17px] font-[510] text-[#ffffff] tracking-[-0.012em]">
          {dropzoneTitle}
        </h3>
        <p class="text-[13px] text-[#8a8f98] mt-1.5 font-normal">
          {dropzoneSubtitle}
        </p>

        <!-- Acid Lime Action Button -->
        <div class="mt-5">
          <span class="btn-acid-lime">
            <span>{buttonText}</span>
            <svg class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </span>
        </div>
      </div>

      <!-- Upload Error -->
      <div id="upload-error" class="hidden mt-4 p-3 rounded-[6px] bg-red-950/40 border border-red-800 text-xs text-red-400 font-normal text-center"></div>
    </div>
  </div>

  <!-- Step 2: Text Organization & Letter Verification Stage -->
  <div id="organize-stage" class="hidden rounded-[12px] border border-[#23252a] bg-[#0f1011] p-6 sm:p-8 shadow-sm space-y-6">
    
    <!-- Header / Status -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#23252a]">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-[#e4f222]"></div>
        <span class="font-mono text-[11px] font-normal uppercase tracking-wider text-[#8a8f98]">02 / Text Verification</span>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="btn-toggle-crop-panel"
          type="button"
          class="btn-ghost-linear font-mono text-[12px] px-3 py-1.5"
        >
          Crop manually
        </button>
        <button
          id="btn-new-image-top"
          type="button"
          class="btn-ghost-linear font-mono text-[12px] px-3 py-1.5"
        >
          New Image
        </button>
      </div>
    </div>

    <!-- Collapsible Manual Crop Area -->
    <div id="manual-crop-panel" class="hidden p-4 rounded-[12px] border border-[#23252a] bg-[#161718] space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-[13px] font-[510] text-[#ffffff]">Drag cursor across image to isolate a specific text region:</span>
        <button id="btn-apply-manual-crop" type="button" class="btn-acid-lime text-[12px] py-1.5 px-3.5">
          Apply & Re-detect
        </button>
      </div>
      <div class="relative bg-[#08090a] rounded-[6px] border border-[#23252a] overflow-hidden flex items-center justify-center p-2 min-h-[180px] max-h-[360px]">
        <canvas id="crop-canvas" class="max-h-[340px] max-w-full rounded-[4px] shadow-sm cursor-crosshair touch-none select-none"></canvas>
      </div>
    </div>

    <!-- Unified Section: Detected Sentence Region Preview & Text Verification -->
    <div class="space-y-5">
      <!-- Sentence Crop Preview Box -->
      <div id="stage2-sentence-preview-card" class="rounded-[12px] border border-[#23252a] bg-[#161718] p-4 flex flex-col items-center justify-center min-h-[90px] overflow-hidden transition-all">
        <div class="w-full flex items-center justify-between mb-2.5">
          <span class="text-[11px] font-mono uppercase tracking-wider text-[#8a8f98]">Detected text:</span>
          <span id="stage2-preview-badge" class="hidden"></span>
        </div>
        <div class="w-full flex items-center justify-center bg-[#08090a] rounded-[6px] border border-[#23252a] p-3 min-h-[70px]">
          <img id="stage2-sentence-preview-img" src="" alt="Detected Text Crop" class="max-h-[120px] max-w-full object-contain rounded-[4px]" />
        </div>
      </div>

      <!-- Text Verification & Direct Edit -->
      <div class="space-y-2">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="text-[14px] sm:text-[15px] font-[510] text-[#ffffff] tracking-[-0.011em]">
              Verify detected text
            </h3>
          </div>
          <div id="ocr-engine-badge" class="hidden">
            <span id="ocr-engine-badge-text"></span>
          </div>
        </div>

        <!-- Full Sentence Text Input -->
        <div class="relative flex items-center">
          <input
            id="selected-word-text-input"
            type="text"
            class="w-full px-4 py-3 text-[14px] sm:text-[15px] font-mono text-[#ffffff] bg-[#08090a] border border-[#23252a] rounded-[6px] focus:outline-none focus:border-[#d0d6e0] transition-all shadow-sm"
            placeholder="Verify or edit text..."
          />
        </div>
      </div>

      <!-- Progressive Disclosure: Advanced Word & Glyph Inspection -->
      <div class="pt-1">
        <button
          id="btn-toggle-advanced-inspection"
          type="button"
          class="font-mono text-[12px] text-[#8a8f98] hover:text-[#ffffff] transition-colors flex items-center gap-1.5 cursor-pointer select-none"
        >
          <span id="advanced-inspection-caret" class="text-[10px]">►</span>
          <span>Inspect individual words & letters</span>
        </button>

        <!-- Collapsible content -->
        <div id="advanced-inspection-panel" class="hidden mt-3 space-y-4 p-4 rounded-[12px] border border-[#23252a] bg-[#161718]">
          <div>
            <span class="text-[12px] font-[510] text-[#ffffff]">Word Segments (Click to isolate a specific word):</span>
            <div id="word-chips-container" class="mt-2 flex flex-wrap items-center gap-2 p-2.5 rounded-[6px] bg-[#08090a] border border-[#23252a] min-h-[50px]"></div>
          </div>
          <div>
            <span class="text-[12px] font-[510] text-[#ffffff]">Letter Glyphs (Fix individual characters or clear non-letters):</span>
            <div id="letter-tiles-container" class="mt-2 flex flex-wrap items-center gap-2 p-2.5 rounded-[6px] bg-[#08090a] border border-[#23252a] min-h-[70px] overflow-x-auto"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Action Bar: [ Identify this font ] [ Crop manually ] [ New image ] -->
    <div class="pt-4 border-t border-[#23252a] flex flex-wrap items-center gap-3">
      <button
        id="btn-identify-font"
        type="button"
        class="btn-acid-lime text-[14px] px-8 py-3 rounded-[6px] font-[510]"
      >
        <span>Identify font</span>
        <svg class="w-4 h-4 ml-2 fill-none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>

      <button
        id="btn-crop-manually-bar"
        type="button"
        class="btn-ghost-linear text-[13px] px-5 py-3 rounded-[6px]"
      >
        Crop manually
      </button>

      <button
        id="btn-new-image-bar"
        type="button"
        class="btn-ghost-linear text-[13px] px-5 py-3 rounded-[6px]"
      >
        New image
      </button>
    </div>

  </div>

  <!-- Step 3: Analysis Progress -->
  <div id="loading-stage" class="hidden rounded-[12px] border border-[#23252a] bg-[#0f1011] p-8 sm:p-12 text-center shadow-sm">
    <div class="max-w-md mx-auto">
      <div class="w-8 h-8 mx-auto rounded-full border-2 border-[#23252a] border-t-[#e4f222] animate-spin mb-4"></div>
      <h4 id="loading-step-title" class="text-[11px] font-mono font-normal uppercase tracking-wider text-[#8a8f98]">
        COMPARING LETTER SHAPES
      </h4>
      <div class="w-full bg-[#23252a] rounded-full h-1 mt-3 overflow-hidden">
        <div id="progress-bar" class="bg-[#e4f222] h-full w-1/4 rounded-full transition-all duration-300"></div>
      </div>
      <p id="loading-step-detail" class="text-[12px] text-[#d0d6e0] mt-3 font-mono">
        Matching against 1,935 fonts in your browser...
      </p>
    </div>
  </div>

  <!-- Step 4: Results Display -->
  <div id="results-stage" class="hidden space-y-6">

    <!-- Hidden container to satisfy internal script references without visual clutter -->
    <div id="results-sentence-bar" class="hidden">
      <div id="results-sentence-chips"></div>
    </div>

    <!-- Preview Text Input Bar -->
    <div class="rounded-[12px] border border-[#23252a] bg-[#0f1011] p-5 sm:p-6 shadow-sm space-y-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <span class="text-[14px] font-[510] text-[#ffffff]">Preview text.</span>
          <span class="text-[13px] text-[#8a8f98] ml-1.5">Type anything to see it set in each match.</span>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="btn-scroll-to-organize"
            type="button"
            class="btn-ghost-linear font-mono text-[11px] px-3 py-1.5 text-[#e4f222] border-[#23252a]"
          >
            <span>&uarr; Edit Text</span>
          </button>
        </div>
      </div>
      <input
        id="preview-text-input"
        type="text"
        placeholder="Type text to preview in matches..."
        class="w-full bg-[#08090a] border border-[#23252a] rounded-[6px] px-4 py-2.5 text-[14px] text-[#ffffff] font-mono focus:outline-none focus:border-[#d0d6e0] shadow-sm"
      />

      <!-- "▼ How this was matched" Collapsible Panel (hidden for minimal layout) -->
      <div class="hidden">
        <button id="btn-toggle-matched-details" type="button"></button>
        <div id="matched-details-content">
          <span id="meta-letters-read"></span>
          <span id="meta-letters-count"></span>
          <span id="meta-stroke-weight"></span>
        </div>
      </div>
    </div>
    
    <!-- Primary Match Card -->
    <div class="rounded-[12px] border border-[#23252a] bg-[#0f1011] p-6 sm:p-8 shadow-sm">
      
      <!-- Top Bar: Badge, Font Name, Match Quality, and Actions -->
      <div class="flex flex-wrap items-start justify-between gap-4 pb-6 border-b border-[#23252a]">
        <div class="space-y-2">
          <div class="flex items-center gap-2 flex-wrap">
            <span
              id="res-verified-badge"
              class="inline-flex items-center gap-1.5 text-[11px] font-mono px-2.5 py-0.5 rounded-[4px] bg-[#ff4d00]/10 text-[#e4f222] border border-[#ff4d00]/30 font-medium"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></span>
              <span>Best Match</span>
            </span>
            <div id="res-confidence-badge" class="hidden">
              <span id="res-confidence">--%</span>
              <span>Match</span>
              <span id="res-confidence-label" class="hidden"></span>
            </div>
          </div>

          <h2 id="res-font-family" class="text-3xl sm:text-4xl font-[510] tracking-[-0.022em] text-[#ffffff]">
            Inter
          </h2>

          <p id="res-font-designer" class="text-[13px] text-[#8a8f98]">
            Designed by Rasmus Andersson &bull; SIL Open Font License
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 flex-wrap">
          <button
            id="btn-copy-font-name"
            type="button"
            class="btn-ghost-linear text-[12px] px-3.5 py-1.5 rounded-[6px] flex items-center gap-1.5"
            title="Copy font name to clipboard"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="btn-copy-font-name-text">Copy Name</span>
          </button>

          <a
            id="link-google-fonts-top"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-acid-lime text-[12px] px-3.5 py-1.5 rounded-[6px] flex items-center gap-1.5"
          >
            <span>Google Fonts</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>

          <button
            id="btn-scan-another"
            type="button"
            class="btn-ghost-linear text-[12px] px-3.5 py-1.5 rounded-[6px]"
          >
            Scan Another
          </button>
        </div>
      </div>

      <!-- Commercial Alternative Notice -->
      <div id="res-commercial-alert" class="hidden mt-4 p-3 rounded-[6px] bg-[#161718] border border-[#23252a] text-[12px] text-[#8a8f98]">
        <span class="font-[510] text-[#ffffff]">Commercial Alternative:</span>
        <span id="res-commercial-text">Matches style of Helvetica. Free Google Fonts stand-in is Inter.</span>
      </div>

      <!-- Hidden container preserving technical traits for DOM compatibility -->
      <div id="res-technical-traits" class="hidden">
        <span id="res-trait-category"></span>
        <span id="res-trait-serif"></span>
        <span id="res-trait-contrast"></span>
        <span id="res-trait-weight"></span>
        <span id="res-shape-match-score"></span>
      </div>

      <!-- Side-by-Side Comparison (Uploaded vs Matched Specimen) -->
      <div class="mt-6 rounded-[12px] border border-[#23252a] bg-[#161718] p-4 sm:p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="text-[14px] sm:text-[15px] font-[510] text-[#ffffff] tracking-[-0.011em]">
              Compare with your image
            </h3>
          </div>
        </div>

        <!-- Interactive Specimen Text Input Bar -->
        <div>
          <input
            id="compare-text-input"
            type="text"
            placeholder="Type text to compare..."
            class="w-full bg-[#08090a] border border-[#23252a] rounded-[6px] px-4 py-2.5 text-[14px] text-[#ffffff] font-mono focus:outline-none focus:border-[#d0d6e0] shadow-sm"
          />
        </div>

        <!-- Comparison Cards: Your Image vs Matched Font -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-stretch">
          <div class="p-4 bg-[#08090a] rounded-[6px] border border-[#23252a] flex flex-col justify-between shadow-sm">
            <span class="font-mono text-[11px] text-[#8a8f98] uppercase tracking-wider block mb-3">Your Image</span>
            <div class="flex-1 flex items-center justify-center min-h-[72px] overflow-hidden">
              <img id="res-compare-uploaded" class="max-h-[80px] max-w-full object-contain rounded-[4px]" alt="Your cropped text specimen" />
            </div>
          </div>
          <div class="p-4 bg-[#08090a] rounded-[6px] border border-[#23252a] flex flex-col justify-between shadow-sm">
            <span id="res-compare-matched-title" class="font-mono text-[11px] text-[#8a8f98] uppercase tracking-wider block mb-3">Matched Font</span>
            <div id="res-compare-matched" class="flex-1 flex items-center justify-center min-h-[72px] text-2xl sm:text-3xl text-[#ffffff] font-medium overflow-hidden px-2 text-center break-all">
              Typography Specimen
            </div>
          </div>
        </div>
      </div>

      <!-- Ranked Google Font Matches -->
      <div class="mt-8">
        <div class="flex items-center justify-between pb-3 border-b border-[#23252a] mb-4">
          <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98] flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#e4f222]"></span>
            <span>CLOSEST GOOGLE FONT MATCHES</span>
          </span>
          <span class="text-[11px] text-[#8a8f98] font-mono">
            Live preview rendered with Google Fonts
          </span>
        </div>
        <div id="res-ranked-cards-list" class="space-y-4"></div>
      </div>

      <!-- Live Specimen Tester -->
      <div class="mt-8 rounded-[12px] border border-[#23252a] bg-[#161718] p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#23252a]">
          <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98]">
            02 / LIVE SPECIMEN TESTER
          </span>
          <div class="flex items-center gap-2">
            <span class="font-mono text-[11px] text-[#8a8f98]">Size:</span>
            <input
              id="specimen-size-slider"
              type="range"
              min="14"
              max="72"
              value="28"
              class="w-24 sm:w-32 accent-[#e4f222] cursor-pointer"
            />
            <span id="specimen-size-label" class="font-mono text-[11px] text-[#ffffff] w-8">28px</span>
          </div>
        </div>

        <div class="mt-4">
          <input
            id="specimen-text-input"
            type="text"
            value="The quick brown fox jumps over the lazy dog"
            class="w-full bg-transparent border-0 text-[#ffffff] focus:ring-0 focus:outline-none placeholder-[#62666d] transition-all"
            style="font-size: 28px; line-height: 1.2; font-weight: 400;"
            spellcheck="false"
          />
        </div>

        <!-- Weight Pills -->
        <div id="specimen-weight-pills" class="mt-5 flex flex-wrap gap-1.5 pt-4 border-t border-[#23252a]">
          <button type="button" data-weight="300" class="weight-pill cursor-pointer transition-all duration-150 active:scale-95 px-3 py-1 rounded-[6px] text-[12px] font-mono border border-[#23252a] bg-[#08090a] text-[#8a8f98] font-normal hover:text-[#ffffff] hover:border-[#383b3f]">Light 300</button>
          <button type="button" data-weight="400" class="weight-pill cursor-pointer transition-all duration-150 active:scale-95 px-3 py-1 rounded-[6px] text-[12px] font-mono border border-[#ffffff] bg-[#ffffff] text-[#08090a] font-medium shadow-sm hover:opacity-95">Regular 400</button>
          <button type="button" data-weight="600" class="weight-pill cursor-pointer transition-all duration-150 active:scale-95 px-3 py-1 rounded-[6px] text-[12px] font-mono border border-[#23252a] bg-[#08090a] text-[#8a8f98] font-normal hover:text-[#ffffff] hover:border-[#383b3f]">SemiBold 600</button>
          <button type="button" data-weight="700" class="weight-pill cursor-pointer transition-all duration-150 active:scale-95 px-3 py-1 rounded-[6px] text-[12px] font-mono border border-[#23252a] bg-[#08090a] text-[#8a8f98] font-normal hover:text-[#ffffff] hover:border-[#383b3f]">Bold 700</button>
        </div>
      </div>

      <!-- Linear Precision Code Windows: 12px radius, graphite hairline border, Berkeley/JetBrains Mono -->
      <div class="mt-8 space-y-4">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[#8a8f98] block">
          03 / PRODUCTION CSS BLUEPRINT
        </span>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Code Window 1: @import -->
          <div class="rounded-[12px] border border-[#23252a] bg-[#08090a] shadow-sm overflow-hidden">
            <div class="h-10 px-3.5 bg-[#161718] border-b border-[#23252a] flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <span class="font-mono text-[11px] text-[#8a8f98] ml-2">google-fonts.css</span>
              </div>
              <button
                id="btn-copy-import"
                type="button"
                class="copy-btn font-mono text-[11px] px-2.5 py-1 rounded-[4px] bg-white/[0.05] border border-[#23252a] hover:bg-white/[0.1] text-[#d0d6e0] hover:text-[#ffffff] transition-colors cursor-pointer"
              >
                Copy
              </button>
            </div>
            <pre id="code-import" class="p-4 font-mono text-[12px] text-[#d0d6e0] overflow-x-auto leading-relaxed"><code>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap');</code></pre>
          </div>

          <!-- Code Window 2: font-family -->
          <div class="rounded-[12px] border border-[#23252a] bg-[#08090a] shadow-sm overflow-hidden">
            <div class="h-10 px-3.5 bg-[#161718] border-b border-[#23252a] flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <div class="w-2 h-2 rounded-full bg-[#23252a]"></div>
                <span class="font-mono text-[11px] text-[#8a8f98] ml-2">style.css</span>
              </div>
              <button
                id="btn-copy-family"
                type="button"
                class="copy-btn font-mono text-[11px] px-2.5 py-1 rounded-[4px] bg-white/[0.05] border border-[#23252a] hover:bg-white/[0.1] text-[#d0d6e0] hover:text-[#ffffff] transition-colors cursor-pointer"
              >
                Copy
              </button>
            </div>
