          const altId = alt.font.id || alt.font.family.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          const altDesc = alt.font.description || `${alt.font.family} is a free open-source font.`;
          div.innerHTML = `
            <div class="flex items-center justify-between">
