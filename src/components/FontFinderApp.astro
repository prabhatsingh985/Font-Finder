          });
          altContainer.appendChild(div);
        });
      }

      resultsStage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function loadGoogleFontDynamically(family) {
      const id = 'dynamic-specimen-font';
      let link = document.getElementById(id);
      if (!link) {
        link = document.createElement('link');
        link.id = id;
        link.rel = 'stylesheet';
        document.head.appendChild(link);
      }
      const encoded = encodeURIComponent(family).replace(/%20/g, '+');
      link.href = `https://fonts.googleapis.com/css2?family=${encoded}:wght@300;400;500;600;700;800;900&display=swap`;
    }

    function preloadTopMatchesCss(candidates) {
      if (!candidates || candidates.length === 0) return;
      const families = candidates.slice(0, 6).map(c => encodeURIComponent(c.family).replace(/%20/g, '+'));
      const linkId = 'top-matches-specimens-css';
      let link = document.getElementById(linkId);
      if (!link) {
        link = document.createElement('link');
        link.id = linkId;
        link.rel = 'stylesheet';
        document.head.appendChild(link);
      }
      link.href = `https://fonts.googleapis.com/css2?family=${families.join(':wght@400;700&family=')}:wght@400;700&display=swap`;
    }

    specimenSlider.addEventListener('input', (e) => {
      const val = e.target.value;
      specimenLabel.textContent = `${val}px`;
      specimenInput.style.fontSize = `${val}px`;
    });

    const activeWeightClasses = ['border-[#ffffff]', 'bg-[#ffffff]', 'text-[#08090a]', 'font-medium', 'shadow-sm'];
    const inactiveWeightClasses = ['border-[#23252a]', 'bg-[#08090a]', 'text-[#8a8f98]', 'font-normal'];

    const weightPillsContainer = document.getElementById('specimen-weight-pills');
    if (weightPillsContainer) {
      weightPillsContainer.addEventListener('click', (e) => {
        const pill = e.target.closest('.weight-pill');
        if (!pill) return;

        const allPills = weightPillsContainer.querySelectorAll('.weight-pill');
        allPills.forEach((p) => {
          p.classList.remove(...activeWeightClasses);
          p.classList.add(...inactiveWeightClasses);
        });

        pill.classList.remove(...inactiveWeightClasses);
        pill.classList.add(...activeWeightClasses);

        const weight = pill.getAttribute('data-weight');
        if (specimenInput && weight) {
          specimenInput.style.fontWeight = weight;
        }
      });
    }

    setupCopyButton('btn-copy-import', 'code-import');
    setupCopyButton('btn-copy-family', 'code-family');

    function setupCopyButton(btnId, codeContainerId) {
      const btn = document.getElementById(btnId);
      if (!btn) return;
      btn.addEventListener('click', async () => {
        const text = document.getElementById(codeContainerId)?.textContent || '';
        let copied = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            copied = true;
          }
        } catch (err) {}

        if (!copied) {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          } catch (e) {}
        }

        const original = btn.innerHTML;
        btn.innerHTML = `<span class="text-[#27a644] font-normal">✓ Copied!</span>`;
        setTimeout(() => {
          btn.innerHTML = original;
        }, 2000);
      });
    }
  })();
</script>
