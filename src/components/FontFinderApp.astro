---
import { VERIFIED_GOOGLE_FONTS } from '../services/googleFonts/data';

const fontsJson = JSON.stringify(VERIFIED_GOOGLE_FONTS);
---

<div id="finder" class="w-full max-w-[1000px] mx-auto scroll-mt-20">
  <script id="fonts-data" type="application/json" is:inline set:html={fontsJson}></script>

  <!-- Step 1: Firecrawl-style Search & Upload Interaction Bar -->
  <div id="upload-stage" class="transition-all">
    <!-- Elevated Dropzone Card -->
    <div
      id="dropzone"
      class="relative rounded-2xl border border-[#e5e7eb] bg-[#ffffff] p-8 sm:p-10 shadow-[0_0_0_6px_rgb(249,249,249)] hover:border-[#ff4d00]/40 transition-all cursor-pointer group"
    >
      <input
        type="file"
        id="file-input"
        accept="image/png, image/jpeg, image/jpg, image/webp"
        class="sr-only"
      />

      <!-- Center Content -->
      <div class="text-center max-w-md mx-auto">
        <!-- Orange Flame Signal Icon -->
        <div class="mx-auto w-12 h-12 rounded-full bg-[#ff4d00]/10 border border-[#ff4d00]/20 flex items-center justify-center text-[#ff4d00] mb-4 group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2c-.8 2.2-2.8 4.2-4.5 6-2 2.2-3.5 4.8-3.5 7.8 0 4.4 3.6 8.2 8 8.2s8-3.8 8-8.2c0-2.5-1-4.8-2.6-6.7-1.5-1.8-3.4-3.5-4.4-5.3-.3-.6-.7-1.3-1-1.8zM12 20c-2.8 0-5-2.2-5-5 0-1.8 1-3.3 2.1-4.7 1.1-1.3 2.2-2.7 2.9-4.3.7 1.5 1.8 2.9 2.9 4.3 1.1 1.4 2.1 2.9 2.1 4.7 0 2.8-2.2 5-5 5z"/>
          </svg>
        </div>

        <h3 class="text-lg font-medium text-[#262626] tracking-tight">
          Drop an image or paste screenshot (<kbd class="font-mono text-xs bg-[#f9f9f9] border border-[#e5e7eb] px-1.5 py-0.5 rounded">⌘V</kbd>)
        </h3>
        <p class="text-xs text-[#727272] mt-1.5">
          Supports PNG, JPG, WebP &bull; 100% private in-browser detection
        </p>

        <!-- Pill Action Button inside Dropzone -->
        <div class="mt-5">
          <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#262626] text-white text-xs font-medium hover:bg-[#ff4d00] transition-colors shadow-sm">
            <span>Select Image File</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </span>
        </div>
      </div>

      <!-- Sample Specimen Action Chips -->
      <div class="mt-8 pt-6 border-t border-[#e5e7eb]">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
          <span class="font-mono text-[11px] text-[#727272] uppercase tracking-wider">
            Quick Test Samples:
          </span>
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              data-sample="inter"
              class="sample-btn font-mono text-xs px-3 py-1.5 rounded-full border border-[#e5e7eb] bg-[#f9f9f9] hover:bg-[#e5e7eb] hover:border-[#727272]/30 text-[#262626] transition-colors"
            >
              <span class="text-[#ff4d00] mr-1">&bull;</span> Clean Sans (Inter)
            </button>
            <button
              type="button"
              data-sample="playfair"
              class="sample-btn font-mono text-xs px-3 py-1.5 rounded-full border border-[#e5e7eb] bg-[#f9f9f9] hover:bg-[#e5e7eb] hover:border-[#727272]/30 text-[#262626] transition-colors"
            >
              <span class="text-[#ff4d00] mr-1">&bull;</span> Luxury Serif (Playfair)
            </button>
            <button
              type="button"
              data-sample="jetbrains"
              class="sample-btn font-mono text-xs px-3 py-1.5 rounded-full border border-[#e5e7eb] bg-[#f9f9f9] hover:bg-[#e5e7eb] hover:border-[#727272]/30 text-[#262626] transition-colors"
            >
              <span class="text-[#ff4d00] mr-1">&bull;</span> Dev Mono (JetBrains)
            </button>
            <button
              type="button"
              data-sample="oswald"
              class="sample-btn font-mono text-xs px-3 py-1.5 rounded-full border border-[#e5e7eb] bg-[#f9f9f9] hover:bg-[#e5e7eb] hover:border-[#727272]/30 text-[#262626] transition-colors"
            >
              <span class="text-[#ff4d00] mr-1">&bull;</span> Bold Poster (Oswald)
            </button>
          </div>
        </div>
      </div>

      <!-- Upload Error -->
      <div id="upload-error" class="hidden mt-4 p-3 rounded-lg bg-red-50 border border-red-200 text-xs text-red-600 font-medium text-center"></div>
    </div>
  </div>

  <!-- Step 2: Image Preview & Crop Stage -->
  <div id="crop-stage" class="hidden rounded-2xl border border-[#e5e7eb] bg-[#ffffff] p-6 sm:p-8 shadow-[0_0_0_6px_rgb(249,249,249)]">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#e5e7eb]">
      <div>
        <div class="flex items-center gap-2">
          <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
          <h3 class="text-sm font-semibold text-[#262626] uppercase tracking-wide">02 / Inspect & Crop Letterforms</h3>
        </div>
        <p class="text-xs text-[#727272] mt-0.5">Drag cursor across canvas to isolate words for tighter optical recognition.</p>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="btn-reset-crop"
          type="button"
          class="font-mono text-xs px-3 py-1.5 rounded-full border border-[#e5e7eb] bg-[#f9f9f9] text-[#262626] hover:bg-[#e5e7eb] transition-colors"
        >
          Reset Crop
        </button>
        <button
          id="btn-new-image"
          type="button"
          class="font-mono text-xs px-3 py-1.5 rounded-full border border-[#e5e7eb] bg-[#f9f9f9] text-[#262626] hover:bg-[#e5e7eb] transition-colors"
        >
          New Image
        </button>
      </div>
    </div>

    <!-- Canvas Surface on #f9f9f9 -->
    <div class="relative mt-4 bg-[#f9f9f9] rounded-lg border border-[#e5e7eb] overflow-hidden flex items-center justify-center p-3 min-h-[240px] max-h-[440px]">
      <canvas id="crop-canvas" class="max-h-[400px] max-w-full rounded shadow-sm cursor-crosshair touch-none select-none"></canvas>
    </div>

    <!-- Primary Action: Pill with Glow -->
    <div class="mt-5 flex justify-end">
      <button
        id="btn-run-analysis"
        type="button"
        class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-[#ff4d00] text-white font-medium text-xs tracking-wide hover:opacity-95 transition-all shadow-[0_0_0_0_transparent] hover:shadow-[0_0_0_6px_#fcddcc] flex items-center justify-center gap-2"
      >
        <span>Analyze Letterforms & Find Font</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Step 3: Analysis Progress -->
  <div id="loading-stage" class="hidden rounded-2xl border border-[#e5e7eb] bg-[#ffffff] p-8 sm:p-12 text-center shadow-[0_0_0_6px_rgb(249,249,249)]">
    <div class="max-w-md mx-auto">
      <div class="w-10 h-10 mx-auto rounded-full border-2 border-[#ff4d00]/20 border-t-[#ff4d00] animate-spin mb-4"></div>
      <h4 id="loading-step-title" class="text-sm font-semibold text-[#262626]">
        Scanning typography...
      </h4>
      <p id="loading-step-detail" class="text-xs text-[#727272] mt-1 font-mono">
        Binarizing pixels and separating connected glyphs
      </p>

      <div class="w-full bg-[#e5e7eb] rounded-full h-1.5 mt-6 overflow-hidden">
        <div id="progress-bar" class="bg-[#ff4d00] h-full w-1/4 rounded-full transition-all duration-300"></div>
      </div>
    </div>
  </div>

  <!-- Step 4: Results Display -->
  <div id="results-stage" class="hidden space-y-6">
    
    <!-- Primary Match Card (Firecrawl Elevated Card with 16px radius) -->
    <div class="rounded-2xl border border-[#e5e7eb] bg-[#ffffff] p-6 sm:p-8 shadow-[0_0_0_6px_rgb(249,249,249)]">
      <div class="flex flex-wrap items-start justify-between gap-4 pb-6 border-b border-[#e5e7eb]">
        <div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">01 / DETECTED FAMILY</span>
            <span
              id="res-verified-badge"
              class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#f9f9f9] text-[#262626] border border-[#e5e7eb]"
            >
              <span class="w-2 h-2 rounded-full bg-[#ff4d00]"></span>
              <span>Google Fonts Verified</span>
            </span>
          </div>
          <h2 id="res-font-family" class="text-3xl sm:text-4xl font-bold tracking-tight text-[#262626] mt-2">
            Inter
          </h2>
          <p id="res-font-designer" class="text-xs text-[#727272] mt-1">
            Designed by Rasmus Andersson &bull; SIL Open Font License
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="text-right">
            <div class="font-mono text-xs text-[#727272]">CONFIDENCE</div>
            <div id="res-confidence" class="font-mono text-xl font-bold text-[#ff4d00]">96%</div>
          </div>
          <button
            id="btn-scan-another"
            type="button"
            class="px-3.5 py-2 rounded-full border border-[#e5e7eb] bg-[#f9f9f9] hover:bg-[#e5e7eb] text-xs font-medium text-[#262626] transition-colors"
          >
            Scan Another
          </button>
        </div>
      </div>

      <!-- Commercial Alternative Notice -->
      <div id="res-commercial-alert" class="hidden mt-4 p-3 rounded-lg bg-[#f9f9f9] border border-[#e5e7eb] text-xs text-[#616161]">
        <span class="font-semibold text-[#262626]">Commercial Stand-in:</span>
        <span id="res-commercial-text">Matches style of Helvetica. Free verified Google Fonts alternative is Inter.</span>
      </div>

      <!-- Typographic Feature Tags (Pill shaped) -->
      <div class="mt-6 flex flex-wrap gap-2 text-xs">
        <div class="px-3 py-1 rounded-full bg-[#f9f9f9] border border-[#e5e7eb] font-mono">
          <span class="text-[#727272]">Category:</span>
          <span id="res-trait-category" class="font-semibold text-[#262626] ml-1">Sans-Serif</span>
        </div>
        <div class="px-3 py-1 rounded-full bg-[#f9f9f9] border border-[#e5e7eb] font-mono">
          <span class="text-[#727272]">Serifs:</span>
          <span id="res-trait-serif" class="font-semibold text-[#262626] ml-1">None</span>
        </div>
        <div class="px-3 py-1 rounded-full bg-[#f9f9f9] border border-[#e5e7eb] font-mono">
          <span class="text-[#727272]">Contrast:</span>
          <span id="res-trait-contrast" class="font-semibold text-[#262626] ml-1">Low</span>
        </div>
        <div class="px-3 py-1 rounded-full bg-[#f9f9f9] border border-[#e5e7eb] font-mono">
          <span class="text-[#727272]">Estimated Weight:</span>
          <span id="res-trait-weight" class="font-semibold text-[#262626] ml-1">400 Regular</span>
        </div>
      </div>

      <!-- Specimen Playground -->
      <div class="mt-8 rounded-xl border border-[#e5e7eb] bg-[#f9f9f9] p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#e5e7eb]">
          <span class="font-mono text-xs uppercase tracking-wider text-[#727272]">
            02 / LIVE SPECIMEN TESTER
          </span>
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs text-[#727272]">Size:</span>
            <input
              id="specimen-size-slider"
              type="range"
              min="14"
              max="72"
              value="28"
              class="w-24 sm:w-32 accent-[#ff4d00] cursor-pointer"
            />
            <span id="specimen-size-label" class="font-mono text-xs text-[#262626] w-8">28px</span>
          </div>
        </div>

        <div class="mt-4">
          <input
            id="specimen-text-input"
            type="text"
            value="The quick brown fox jumps over the lazy dog"
            class="w-full bg-transparent border-0 text-[#262626] focus:ring-0 focus:outline-none placeholder-[#c7c7c7] transition-all"
            style="font-size: 28px; line-height: 1.2;"
            spellcheck="false"
          />
        </div>

        <!-- Weight Pills -->
        <div id="specimen-weight-pills" class="mt-5 flex flex-wrap gap-1.5 pt-4 border-t border-[#e5e7eb]">
          <button type="button" data-weight="300" class="weight-pill px-3 py-1 rounded-full text-xs font-mono border border-[#e5e7eb] bg-white text-[#727272] hover:text-[#262626]">Light 300</button>
          <button type="button" data-weight="400" class="weight-pill px-3 py-1 rounded-full text-xs font-mono border border-[#262626] bg-[#262626] text-white font-medium">Regular 400</button>
          <button type="button" data-weight="600" class="weight-pill px-3 py-1 rounded-full text-xs font-mono border border-[#e5e7eb] bg-white text-[#727272] hover:text-[#262626]">SemiBold 600</button>
          <button type="button" data-weight="700" class="weight-pill px-3 py-1 rounded-full text-xs font-mono border border-[#e5e7eb] bg-white text-[#727272] hover:text-[#262626]">Bold 700</button>
        </div>
      </div>

      <!-- Firecrawl Code Windows: 8px radius, traffic light dots, Geist Mono -->
      <div class="mt-8 space-y-4">
        <span class="font-mono text-xs uppercase tracking-wider text-[#727272] block">
          03 / PRODUCTION CSS BLUEPRINT
        </span>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Code Window 1: @import -->
          <div class="rounded-lg border border-[#e5e7eb] bg-[#f9f9f9] shadow-[0_0_0_8px_rgb(253,253,253)] overflow-hidden">
            <div class="h-10 px-3 bg-[#f9f9f9] border-b border-[#e5e7eb] flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb]"></div>
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb]"></div>
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb]"></div>
                <span class="font-mono text-xs text-[#727272] ml-2">google-fonts.css</span>
              </div>
              <button
                id="btn-copy-import"
                type="button"
                class="copy-btn font-mono text-xs px-2.5 py-1 rounded-full bg-white border border-[#e5e7eb] hover:bg-[#f9f9f9] text-[#262626] transition-colors"
              >
                Copy
              </button>
            </div>
            <pre id="code-import" class="p-4 font-mono text-xs text-[#262626] overflow-x-auto leading-relaxed"><code>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap');</code></pre>
          </div>

          <!-- Code Window 2: font-family -->
          <div class="rounded-lg border border-[#e5e7eb] bg-[#f9f9f9] shadow-[0_0_0_8px_rgb(253,253,253)] overflow-hidden">
            <div class="h-10 px-3 bg-[#f9f9f9] border-b border-[#e5e7eb] flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb]"></div>
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb]"></div>
                <div class="w-2 h-2 rounded-full bg-[#e5e7eb]"></div>
                <span class="font-mono text-xs text-[#727272] ml-2">style.css</span>
              </div>
              <button
                id="btn-copy-family"
                type="button"
                class="copy-btn font-mono text-xs px-2.5 py-1 rounded-full bg-white border border-[#e5e7eb] hover:bg-[#f9f9f9] text-[#262626] transition-colors"
              >
                Copy
              </button>
            </div>
            <pre id="code-family" class="p-4 font-mono text-xs text-[#262626] overflow-x-auto leading-relaxed"><code>font-family: 'Inter', sans-serif;</code></pre>
          </div>
        </div>
      </div>

      <!-- Links & CTAs -->
      <div class="mt-6 pt-6 border-t border-[#e5e7eb] flex flex-wrap items-center justify-between gap-4">
        <a
          id="link-google-fonts"
          href="https://fonts.google.com/specimen/Inter"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs font-semibold text-[#ff4d00] hover:underline inline-flex items-center gap-1"
        >
          <span>Open in Google Fonts Repository</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <a
          id="link-font-page"
          href="/fonts/inter"
          class="font-mono text-xs text-[#727272] hover:text-[#262626] transition-colors"
        >
          Inspect Specimen Details &rarr;
        </a>
      </div>

    </div>

    <!-- Alternatives Card -->
    <div class="rounded-2xl border border-[#e5e7eb] bg-[#ffffff] p-6 sm:p-8 shadow-[0_0_0_6px_rgb(249,249,249)]">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></div>
        <h3 class="font-mono text-xs uppercase tracking-wider text-[#727272]">
          04 / CLOSEST VERIFIED ALTERNATIVES
        </h3>
      </div>
      <div id="res-alternatives-list" class="grid grid-cols-1 sm:grid-cols-3 gap-3"></div>
    </div>

  </div>

</div>

<!-- Client script handling drop, samples, canvas crop, optical engine, specimen, and copy -->
<script is:inline>
  (function () {
    const fontsDataElement = document.getElementById('fonts-data');
    let fontsCatalog = [];
    try {
      fontsCatalog = JSON.parse(fontsDataElement.textContent || '[]');
    } catch (e) {
      console.error('Failed to parse fonts database', e);
    }

    const uploadStage = document.getElementById('upload-stage');
    const cropStage = document.getElementById('crop-stage');
    const loadingStage = document.getElementById('loading-stage');
    const resultsStage = document.getElementById('results-stage');

    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input');
    const uploadError = document.getElementById('upload-error');
    const cropCanvas = document.getElementById('crop-canvas');
    const btnRunAnalysis = document.getElementById('btn-run-analysis');
    const btnResetCrop = document.getElementById('btn-reset-crop');
    const btnNewImage = document.getElementById('btn-new-image');
    const btnScanAnother = document.getElementById('btn-scan-another');

    let currentImage = null;
    let cropBox = null;
    let isDraggingCrop = false;
    let cropStartX = 0;
    let cropStartY = 0;

    const specimenInput = document.getElementById('specimen-text-input');
    const specimenSlider = document.getElementById('specimen-size-slider');
    const specimenLabel = document.getElementById('specimen-size-label');
    const specimenWeightPills = document.querySelectorAll('.weight-pill');
    let currentPrimaryFont = null;

    // Sample Presets Generation
    const sampleButtons = document.querySelectorAll('.sample-btn');
    sampleButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const sampleType = btn.getAttribute('data-sample');
        generateSampleCanvas(sampleType);
      });
    });

    function generateSampleCanvas(type) {
      const c = document.createElement('canvas');
      c.width = 680;
      c.height = 180;
      const ctx = c.getContext('2d');

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, c.width, c.height);

      ctx.fillStyle = '#262626';
      ctx.textBaseline = 'middle';

      if (type === 'inter') {
        ctx.font = '500 52px Inter, Arial, sans-serif';
        ctx.fillText('Inter Typography', 40, 90);
      } else if (type === 'playfair') {
        ctx.font = 'bold 52px "Playfair Display", Georgia, serif';
        ctx.fillText('Editorial Gazette', 40, 90);
      } else if (type === 'jetbrains') {
        ctx.font = '500 44px "JetBrains Mono", monospace';
        ctx.fillText('const type = "mono";', 40, 90);
      } else if (type === 'oswald') {
        ctx.font = '700 56px Oswald, Impact, sans-serif';
        ctx.fillText('MODERN POSTER', 40, 90);
      }

      const img = new Image();
      img.onload = () => {
        handleLoadedImage(img);
      };
      img.src = c.toDataURL('image/png');
    }

    // Dropzone & File Input Handlers
    dropzone.addEventListener('click', (e) => {
      if (e.target.closest('.sample-btn')) return;
      fileInput.click();
    });

    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-[#ff4d00]');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-[#ff4d00]');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      const files = e.dataTransfer.files;
      if (files && files.length > 0) {
        processUploadedFile(files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        processUploadedFile(fileInput.files[0]);
      }
    });

    document.addEventListener('paste', (e) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const blob = items[i].getAsFile();
          if (blob) processUploadedFile(blob);
          break;
        }
      }
    });

    function processUploadedFile(file) {
      uploadError.classList.add('hidden');
      uploadError.textContent = '';

      const validTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
      if (!validTypes.includes(file.type)) {
        showError('Please upload a PNG, JPG, or WebP image.');
        return;
      }

      if (file.size > 10 * 1024 * 1024) {
        showError('File exceeds 10MB limit.');
        return;
      }

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => handleLoadedImage(img);
        img.onerror = () => showError('Failed to parse image.');
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function showError(msg) {
      uploadError.textContent = msg;
      uploadError.classList.remove('hidden');
    }

    function handleLoadedImage(img) {
      currentImage = img;
      cropBox = null;

      uploadStage.classList.add('hidden');
      resultsStage.classList.add('hidden');
      loadingStage.classList.add('hidden');
      cropStage.classList.remove('hidden');

      renderCropCanvas();
    }

    function renderCropCanvas() {
      if (!currentImage) return;
      const ctx = cropCanvas.getContext('2d');

      const maxW = 760;
      const maxH = 400;
      let w = currentImage.width;
      let h = currentImage.height;

      const scale = Math.min(maxW / w, maxH / h, 1);
      cropCanvas.width = Math.round(w * scale);
      cropCanvas.height = Math.round(h * scale);

      ctx.drawImage(currentImage, 0, 0, cropCanvas.width, cropCanvas.height);

      if (cropBox) {
        ctx.fillStyle = 'rgba(38, 38, 38, 0.4)';
        ctx.fillRect(0, 0, cropCanvas.width, cropBox.y);
        ctx.fillRect(0, cropBox.y + cropBox.h, cropCanvas.width, cropCanvas.height - (cropBox.y + cropBox.h));
        ctx.fillRect(0, cropBox.y, cropBox.x, cropBox.h);
        ctx.fillRect(cropBox.x + cropBox.w, cropBox.y, cropCanvas.width - (cropBox.x + cropBox.w), cropBox.h);

        ctx.strokeStyle = '#ff4d00';
        ctx.lineWidth = 2;
        ctx.strokeRect(cropBox.x, cropBox.y, cropBox.w, cropBox.h);
      }
    }

    cropCanvas.addEventListener('pointerdown', (e) => {
      const rect = cropCanvas.getBoundingClientRect();
      cropStartX = e.clientX - rect.left;
      cropStartY = e.clientY - rect.top;
      isDraggingCrop = true;
      cropBox = { x: cropStartX, y: cropStartY, w: 0, h: 0 };
    });

    window.addEventListener('pointermove', (e) => {
      if (!isDraggingCrop || !currentImage) return;
      const rect = cropCanvas.getBoundingClientRect();
      const curX = Math.max(0, Math.min(cropCanvas.width, e.clientX - rect.left));
      const curY = Math.max(0, Math.min(cropCanvas.height, e.clientY - rect.top));

      cropBox.x = Math.min(cropStartX, curX);
      cropBox.y = Math.min(cropStartY, curY);
      cropBox.w = Math.abs(curX - cropStartX);
      cropBox.h = Math.abs(curY - cropStartY);

      renderCropCanvas();
    });

    window.addEventListener('pointerup', () => {
      if (isDraggingCrop) {
        isDraggingCrop = false;
        if (cropBox && (cropBox.w < 15 || cropBox.h < 15)) {
          cropBox = null;
          renderCropCanvas();
        }
      }
    });

    btnResetCrop.addEventListener('click', () => {
      cropBox = null;
      renderCropCanvas();
    });

    btnNewImage.addEventListener('click', resetAll);
    btnScanAnother.addEventListener('click', resetAll);

    function resetAll() {
      currentImage = null;
      cropBox = null;
      fileInput.value = '';
      uploadStage.classList.remove('hidden');
      cropStage.classList.add('hidden');
      loadingStage.classList.add('hidden');
      resultsStage.classList.add('hidden');
    }

    btnRunAnalysis.addEventListener('click', () => {
      if (!currentImage) return;

      cropStage.classList.add('hidden');
      loadingStage.classList.remove('hidden');

      const progressBar = document.getElementById('progress-bar');
      const stepTitle = document.getElementById('loading-step-title');
      const stepDetail = document.getElementById('loading-step-detail');

      progressBar.style.width = '30%';
      stepTitle.textContent = 'Binarizing letterforms...';
      stepDetail.textContent = 'Thresholding image and isolating glyph contours';

      setTimeout(() => {
        progressBar.style.width = '70%';
        stepTitle.textContent = 'Extracting typographic metrics...';
        stepDetail.textContent = 'Measuring serifs, aspect ratio, stroke weight, and contrast';

        setTimeout(() => {
          progressBar.style.width = '100%';
          stepTitle.textContent = 'Comparing Google Fonts catalog...';
          stepDetail.textContent = 'Calculating distance against verified open-source typefaces';

          setTimeout(() => {
            executeAnalysis();
          }, 200);
        }, 250);
      }, 200);
    });

    function executeAnalysis() {
      const offscreen = document.createElement('canvas');
      const offCtx = offscreen.getContext('2d');

      let sourceX = 0;
      let sourceY = 0;
      let sourceW = cropCanvas.width;
      let sourceH = cropCanvas.height;

      if (cropBox && cropBox.w > 10 && cropBox.h > 10) {
        sourceX = cropBox.x;
        sourceY = cropBox.y;
        sourceW = cropBox.w;
        sourceH = cropBox.h;
      }

      offscreen.width = Math.min(800, sourceW);
      offscreen.height = Math.min(400, sourceH);

      offCtx.drawImage(
        cropCanvas,
        sourceX, sourceY, sourceW, sourceH,
        0, 0, offscreen.width, offscreen.height
      );

      const imgData = offCtx.getImageData(0, 0, offscreen.width, offscreen.height);
      const result = analyzePixelsInBrowser(imgData);

      displayResults(result);
    }

    function analyzePixelsInBrowser(pixels) {
      const { width, height, data } = pixels;
      const totalPixels = width * height;
      const grayscale = new Uint8Array(totalPixels);

      let sumLum = 0;
      for (let i = 0; i < totalPixels; i++) {
        const idx = i * 4;
        const lum = Math.round(0.2126 * data[idx] + 0.7152 * data[idx + 1] + 0.0722 * data[idx + 2]);
        grayscale[i] = lum;
        sumLum += lum;
      }

      const avgLum = sumLum / totalPixels;

      let borderLum = 0;
      let borderCount = 0;
      for (let x = 0; x < width; x++) {
        borderLum += grayscale[x];
        borderLum += grayscale[(height - 1) * width + x];
        borderCount += 2;
      }
      const isLightOnDark = (borderLum / borderCount) < avgLum;

      const threshold = avgLum;
      const binary = new Uint8Array(totalPixels);
      for (let i = 0; i < totalPixels; i++) {
        const lum = grayscale[i];
        binary[i] = isLightOnDark ? (lum > threshold + 15 ? 1 : 0) : (lum < threshold - 15 ? 1 : 0);
      }

      let totalAspect = 0;
      let count = 0;
      let totalStroke = 0;
      let serifScores = 0;

      const colDensity = new Float32Array(width);
      for (let x = 0; x < width; x++) {
        let c = 0;
        for (let y = 0; y < height; y++) {
          if (binary[y * width + x] === 1) c++;
        }
        colDensity[x] = c;
      }

      let inGlyph = false;
      let startX = 0;
      for (let x = 0; x < width; x++) {
        if (!inGlyph && colDensity[x] > 2) {
          inGlyph = true;
          startX = x;
        } else if (inGlyph && colDensity[x] <= 2) {
          inGlyph = false;
          const gw = x - startX;
          if (gw >= 4 && gw < width * 0.8) {
            let gTop = height;
            let gBottom = 0;
            for (let y = 0; y < height; y++) {
              for (let gx = startX; gx < x; gx++) {
                if (binary[y * width + gx] === 1) {
                  if (y < gTop) gTop = y;
                  if (y > gBottom) gBottom = y;
                }
              }
            }
            const gh = gBottom - gTop + 1;
            if (gh >= 8) {
              const asp = gw / gh;
              totalAspect += asp;
              count++;

              const midY = Math.round(gTop + gh * 0.5);
              let run = 0;
              let maxRun = 0;
              for (let gx = startX; gx < x; gx++) {
                if (binary[midY * width + gx] === 1) {
                  run++;
                  if (run > maxRun) maxRun = run;
                } else run = 0;
              }

              const baseY = Math.round(gTop + gh * 0.88);
              let baseRun = 0;
              let maxBaseRun = 0;
              for (let gx = startX; gx < x; gx++) {
                if (binary[baseY * width + gx] === 1) {
                  baseRun++;
                  if (baseRun > maxBaseRun) maxBaseRun = baseRun;
                } else baseRun = 0;
              }

              totalStroke += maxRun || 2;
              if (maxBaseRun >= maxRun * 1.45 && maxRun > 1) {
                serifScores++;
              }
            }
          }
        }
      }

      const avgAspect = count > 0 ? totalAspect / count : 0.62;
      const avgStroke = count > 0 ? totalStroke / count : 3;
      const serifRatio = count > 0 ? serifScores / count : 0;

      let classification = 'sans-serif';
      let serifType = 'none';
      if (serifRatio >= 0.4) {
        classification = 'serif';
        serifType = 'bracketed';
      }

      let proportions = 'regular';
      if (avgAspect < 0.52) proportions = 'condensed';
      else if (avgAspect >= 0.67) proportions = 'geometric';

      let contrast = 'low';
      if (classification === 'serif') contrast = 'medium';

      let weight = 400;
      if (avgStroke > 6) weight = 700;
      else if (avgStroke > 4.5) weight = 600;
      else if (avgStroke < 2.2) weight = 300;

      const candidates = fontsCatalog.map((font) => {
        let score = 50;
        if (font.category === classification) score += 25;
        if (font.typographicMetrics.serif === serifType) score += 12;
        if (font.typographicMetrics.proportions === proportions) score += 10;
        
        const aspectDelta = Math.abs(font.typographicMetrics.avgAspect - avgAspect);
        score -= Math.round(aspectDelta * 20);

        const confidence = Math.min(98, Math.max(72, score));
        return {
          font,
          family: font.family,
          confidence,
          weight,
          classification,
          serifType,
          proportions,
          contrast
        };
      });

      candidates.sort((a, b) => b.confidence - a.confidence);

      return {
        primary: candidates[0] || { font: fontsCatalog[0], family: 'Inter', confidence: 95 },
        runnersUp: candidates.slice(1, 4),
        traits: { classification, serifType, proportions, contrast, weight }
      };
    }

    function displayResults(data) {
      loadingStage.classList.add('hidden');
      resultsStage.classList.remove('hidden');

      const primary = data.primary.font;
      currentPrimaryFont = primary;

      document.getElementById('res-font-family').textContent = primary.family;
      document.getElementById('res-font-designer').textContent = `Designed by ${primary.designer} \u2022 SIL Open Font License`;
      document.getElementById('res-confidence').textContent = `${data.primary.confidence}%`;

      document.getElementById('res-trait-category').textContent = primary.category;
      document.getElementById('res-trait-serif').textContent = primary.typographicMetrics.serif;
      document.getElementById('res-trait-contrast').textContent = primary.typographicMetrics.contrast;
      document.getElementById('res-trait-weight').textContent = `${data.primary.weight} Regular`;

      const commAlert = document.getElementById('res-commercial-alert');
      const commText = document.getElementById('res-commercial-text');
      if (primary.commercialAlternativesFor && primary.commercialAlternativesFor.length > 0) {
        commText.textContent = `Matches style of ${primary.commercialAlternativesFor.join(', ')}. Free verified Google Fonts stand-in is ${primary.family}.`;
        commAlert.classList.remove('hidden');
      } else {
        commAlert.classList.add('hidden');
      }

      const encodedFamily = encodeURIComponent(primary.family).replace(/%20/g, '+');
      const importUrl = `@import url('https://fonts.googleapis.com/css2?family=${encodedFamily}:wght@300;400;500;600;700&display=swap');`;
      const familyCss = `font-family: '${primary.family}', ${primary.category};`;

      document.getElementById('code-import').querySelector('code').textContent = importUrl;
      document.getElementById('code-family').querySelector('code').textContent = familyCss;

      document.getElementById('link-google-fonts').href = primary.googleFontsUrl;
      document.getElementById('link-font-page').href = `/fonts/${primary.id}`;

      loadGoogleFontDynamically(primary.family);

      specimenInput.style.fontFamily = `'${primary.family}', sans-serif`;
      specimenInput.style.fontWeight = '400';

      const altContainer = document.getElementById('res-alternatives-list');
      altContainer.innerHTML = '';
      data.runnersUp.forEach((alt) => {
        const div = document.createElement('div');
        div.className = 'p-4 rounded-xl border border-[#e5e7eb] bg-[#f9f9f9] hover:bg-[#ffffff] hover:border-[#ff4d00]/30 transition-all cursor-pointer text-left';
        div.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-semibold text-sm text-[#262626]">${alt.font.family}</span>
            <span class="font-mono text-xs text-[#ff4d00]">${alt.confidence}%</span>
          </div>
          <p class="text-xs text-[#727272] mt-1 line-clamp-1">${alt.font.description}</p>
          <div class="mt-3 flex items-center justify-between font-mono text-[11px] text-[#727272]">
            <span class="capitalize">${alt.font.category}</span>
            <span class="font-medium text-[#262626]">View Specimen &rarr;</span>
          </div>
        `;
        div.addEventListener('click', () => {
          window.location.href = `/fonts/${alt.font.id}`;
        });
        altContainer.appendChild(div);
      });

      resultsStage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function loadGoogleFontDynamically(family) {
      const id = 'dynamic-specimen-font';
      let link = document.getElementById(id);
      if (!link) {
        link = document.createElement('link');
        link.id = id;
        link.rel = 'stylesheet';
        document.head.appendChild(link);
      }
      const encoded = encodeURIComponent(family).replace(/%20/g, '+');
      link.href = `https://fonts.googleapis.com/css2?family=${encoded}:wght@300;400;500;600;700;800;900&display=swap`;
    }

    specimenSlider.addEventListener('input', (e) => {
      const val = e.target.value;
      specimenLabel.textContent = `${val}px`;
      specimenInput.style.fontSize = `${val}px`;
    });

    specimenWeightPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        specimenWeightPills.forEach((p) => {
          p.classList.remove('bg-[#262626]', 'text-white', 'border-[#262626]');
          p.classList.add('bg-white', 'text-[#727272]', 'border-[#e5e7eb]');
        });
        pill.classList.remove('bg-white', 'text-[#727272]', 'border-[#e5e7eb]');
        pill.classList.add('bg-[#262626]', 'text-white', 'border-[#262626]');

        const weight = pill.getAttribute('data-weight');
        specimenInput.style.fontWeight = weight;
      });
    });

    setupCopyButton('btn-copy-import', 'code-import');
    setupCopyButton('btn-copy-family', 'code-family');

    function setupCopyButton(btnId, codeContainerId) {
      const btn = document.getElementById(btnId);
      if (!btn) return;
      btn.addEventListener('click', async () => {
        const text = document.getElementById(codeContainerId)?.textContent || '';
        let copied = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            copied = true;
          }
        } catch (err) {}

        if (!copied) {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          } catch (e) {}
        }

        const original = btn.innerHTML;
        btn.innerHTML = `<span class="text-[#ff4d00] font-semibold">Copied!</span>`;
        setTimeout(() => {
          btn.innerHTML = original;
        }, 2000);
      });
    }
  })();
</script>
