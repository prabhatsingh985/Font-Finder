    btnNewImageTop?.addEventListener('click', resetAll);
    btnNewImageBar?.addEventListener('click', resetAll);
    btnScanAnother?.addEventListener('click', resetAll);

    const btnCopyFontName = document.getElementById('btn-copy-font-name');
    const btnCopyFontNameText = document.getElementById('btn-copy-font-name-text');
    if (btnCopyFontName) {
