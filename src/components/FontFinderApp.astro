    // ==========================================
    // PHASES 1-4: CLIENT-SIDE WORD & GLYPH SEGMENTATION
    // ==========================================

    function createEmergencyFallbackWord(sourceImg, customCropBox) {
      const origW = (sourceImg.naturalWidth || sourceImg.width || 400);
      const origH = (sourceImg.naturalHeight || sourceImg.height || 100);
      let sx = 0, sy = 0, sw = origW, sh = origH;
      if (customCropBox && customCropBox.w > 10 && customCropBox.h > 10) {
        const scaleX = origW / (cropCanvas?.width || origW);
        const scaleY = origH / (cropCanvas?.height || origH);
        sx = Math.round(customCropBox.x * scaleX);
        sy = Math.round(customCropBox.y * scaleY);
        sw = Math.round(customCropBox.w * scaleX);
        sh = Math.round(customCropBox.h * scaleY);
      }
      sx = Math.max(0, Math.min(origW - 1, sx));
      sy = Math.max(0, Math.min(origH - 1, sy));
      sw = Math.max(1, Math.min(origW - sx, sw));
      sh = Math.max(1, Math.min(origH - sy, sh));

      const c = document.createElement('canvas');
      c.width = sw;
      c.height = sh;
      const ctx = c.getContext('2d');
      ctx.drawImage(sourceImg, sx, sy, sw, sh, 0, 0, sw, sh);
      const url = c.toDataURL('image/png');

      const fallbackText = (currentSampleText || 'Text').trim();
      const chars = Array.from(fallbackText.length > 0 ? fallbackText : 'Font');
      const charW = sw / Math.max(1, chars.length);
      const glyphs = chars.map((ch, idx) => {
        const gx = Math.round(sx + idx * charW);
        const gw = Math.max(4, Math.round(charW));
        return {
          id: `glyph-0-${idx}`,
          char: ch,
          confidence: 85,
          signature: new Uint8Array(32),
          box: { x: gx, y: sy, w: gw, h: sh },
          boxWork: { x: 0, y: 0, w: Math.max(10, sw), h: Math.max(10, sh) },
          glyphImgDataUrl: url
        };
      });

      detectedWords = [{
        id: 'word-0',
        text: chars.join(''),
        box: { x: sx, y: sy, w: sw, h: sh },
        wordImgDataUrl: url,
        wordCanvas: c,
        glyphs,
        confidence: 85
      }];
    }

    async function detectWordsAndGlyphs(sourceImg, customCropBox) {
      if (wordChipsContainer) {
        wordChipsContainer.innerHTML = `
          <div class="flex items-center gap-2.5 py-3 px-3 text-xs font-mono text-[#8a8f98]">
            <div class="w-4 h-4 rounded-full border-2 border-[#e4f222]/30 border-t-[#e4f222] animate-spin"></div>
            <span>Detecting text and letterforms...</span>
          </div>
        `;
      }
      if (letterTilesContainer) {
        letterTilesContainer.innerHTML = '<span class="text-xs text-[#727272] dark:text-[#9ca3af]">Letters will appear here once words are detected.</span>';
      }

      try {
        const origW = (sourceImg.naturalWidth || sourceImg.width);
        const origH = (sourceImg.naturalHeight || sourceImg.height);

        let sx = 0, sy = 0, sw = origW, sh = origH;
        if (customCropBox && customCropBox.w > 10 && customCropBox.h > 10) {
          const scaleX = origW / cropCanvas.width;
          const scaleY = origH / cropCanvas.height;
          sx = Math.round(customCropBox.x * scaleX);
          sy = Math.round(customCropBox.y * scaleY);
          sw = Math.round(customCropBox.w * scaleX);
          sh = Math.round(customCropBox.h * scaleY);
        }
        sx = Math.max(0, Math.min(origW - 1, sx));
        sy = Math.max(0, Math.min(origH - 1, sy));
        sw = Math.max(1, Math.min(origW - sx, sw));
        sh = Math.max(1, Math.min(origH - sy, sh));

        // Offscreen canvas for binarization and OCR
        const workCanvas = document.createElement('canvas');
        const maxDim = 1400;
        const workScale = Math.min(1, maxDim / Math.max(sw, sh));
        workCanvas.width = Math.round(sw * workScale);
        workCanvas.height = Math.round(sh * workScale);

        const workCtx = workCanvas.getContext('2d');
        workCtx.drawImage(sourceImg, sx, sy, sw, sh, 0, 0, workCanvas.width, workCanvas.height);

        const imgData = workCtx.getImageData(0, 0, workCanvas.width, workCanvas.height);
        const { width: w, height: h, data } = imgData;
        currentWorkBinaryMask = binarizeColorDist(data, w, h);
        const binary = currentWorkBinaryMask.bits;
        const isLightOnDark = !!currentWorkBinaryMask.isLightOnDark;

        const toOrigScale = 1 / workScale;
        detectedWords = [];

        // ========================================================
        // PRIMARY: INDUSTRY-STANDARD TESSERACT.JS OCR RECOGNITION
        // ========================================================
        let tesseractUsed = false;
        try {
          const ocrWorker = await Promise.race([
            getTesseractWorker(),
            new Promise(r => setTimeout(() => r(null), 3500))
          ]);

          if (ocrWorker) {
            // Prepare specialized high-accuracy OCR canvas
            let ocrScale = 1.0;
            if (sh < 80) ocrScale = 2.0;
            else if (sh < 140) ocrScale = 1.5;
            else if (Math.max(sw, sh) > 1600) ocrScale = 1600 / Math.max(sw, sh);

            const ocrPad = 40; // 40px solid padding prevents Tesseract clipping boundary letters
            const scaledW = Math.round(sw * ocrScale);
            const scaledH = Math.round(sh * ocrScale);

            const ocrCanvas = document.createElement('canvas');
            ocrCanvas.width = scaledW + ocrPad * 2;
            ocrCanvas.height = scaledH + ocrPad * 2;
            const ocrCtx = ocrCanvas.getContext('2d');
            ocrCtx.imageSmoothingEnabled = true;
            ocrCtx.imageSmoothingQuality = 'high';

            // Fill clean background (white for dark text)
            ocrCtx.fillStyle = '#ffffff';
            ocrCtx.fillRect(0, 0, ocrCanvas.width, ocrCanvas.height);

            // Draw scaled source image crop into padded area
            ocrCtx.drawImage(sourceImg, sx, sy, sw, sh, ocrPad, ocrPad, scaledW, scaledH);

            // If light text on dark background, invert so Tesseract always gets dark text on white
            if (isLightOnDark) {
              const ocrImgData = ocrCtx.getImageData(ocrPad, ocrPad, scaledW, scaledH);
              const d = ocrImgData.data;
              for (let i = 0; i < d.length; i += 4) {
                d[i] = 255 - d[i];
                d[i + 1] = 255 - d[i + 1];
                d[i + 2] = 255 - d[i + 2];
              }
              ocrCtx.putImageData(ocrImgData, ocrPad, ocrPad);
            }

            // CRITICAL: Request granular blocks & text output formats with timeout
            const ocrResult = await Promise.race([
              ocrWorker.recognize(ocrCanvas, {}, { blocks: true, text: true }),
              new Promise((_, reject) => setTimeout(() => reject(new Error('OCR Timeout')), 8000))
            ]);

            const blocks = (ocrResult && ocrResult.data && ocrResult.data.blocks) || [];
            const extractedTesseractWords = [];

            for (const block of blocks) {
              for (const para of (block.paragraphs || [])) {
                for (const line of (para.lines || [])) {
                  for (const word of (line.words || [])) {
                    const rawWordText = (word.text || '').trim();
                    if (!rawWordText) continue;

                    // Clean leading and trailing punctuation (e.g. "instruments." -> "instruments")
                    const cleanedWordText = rawWordText.replace(/^[.,\/#!$%\^&\*;:{}=\-_`~()]+|[.,\/#!$%\^&\*;:{}=\-_`~()]+$/g, '');
                    const wordTextToUse = cleanedWordText.length > 0 ? cleanedWordText : rawWordText;

                    // Bounding box in ocrCanvas coordinates
                    const wb = word.bbox;
                    // Map back to original unpadded sourceImg coordinates
                    const origX0 = Math.max(0, Math.min(origW - 1, Math.round(sx + (wb.x0 - ocrPad) / ocrScale)));
                    const origY0 = Math.max(0, Math.min(origH - 1, Math.round(sy + (wb.y0 - ocrPad) / ocrScale)));
                    const origX1 = Math.max(origX0 + 1, Math.min(origW, Math.round(sx + (wb.x1 - ocrPad) / ocrScale)));
                    const origY1 = Math.max(origY0 + 1, Math.min(origH, Math.round(sy + (wb.y1 - ocrPad) / ocrScale)));

                    // Extract individual symbols
                    const symbols = [];
                    const rawSyms = (word.symbols || []).filter(s => {
                      const t = (s.text || '').trim();
                      return t.length > 0 && /^[a-zA-Z0-9]$/.test(t);
                    });

                    if (rawSyms.length > 0) {
                      for (const sym of rawSyms) {
                        const sb = sym.bbox;
                        const sOrigX0 = Math.max(0, Math.min(origW - 1, Math.round(sx + (sb.x0 - ocrPad) / ocrScale)));
                        const sOrigY0 = Math.max(0, Math.min(origH - 1, Math.round(sy + (sb.y0 - ocrPad) / ocrScale)));
                        const sOrigX1 = Math.max(sOrigX0 + 1, Math.min(origW, Math.round(sx + (sb.x1 - ocrPad) / ocrScale)));
                        const sOrigY1 = Math.max(sOrigY0 + 1, Math.min(origH, Math.round(sy + (sb.y1 - ocrPad) / ocrScale)));
                        symbols.push({
                          char: sym.text,
                          confidence: sym.confidence ?? 90,
                          box: { x: sOrigX0, y: sOrigY0, w: Math.max(3, sOrigX1 - sOrigX0), h: Math.max(3, sOrigY1 - sOrigY0) }
                        });
                      }
                    } else {
                      // Robust synthesizer: distribute word characters evenly across word bounding box
                      const chars = Array.from(wordTextToUse);
                      const charW = (origX1 - origX0) / Math.max(1, chars.length);
                      chars.forEach((ch, cIdx) => {
                        const cx = Math.round(origX0 + cIdx * charW);
                        symbols.push({
                          char: ch,
                          confidence: 85,
                          box: { x: cx, y: origY0, w: Math.max(3, Math.round(charW)), h: Math.max(3, origY1 - origY0) }
                        });
                      });
                    }

                    extractedTesseractWords.push({
                      text: wordTextToUse,
                      confidence: word.confidence ?? 90,
                      bbox: { x0: origX0, y0: origY0, x1: origX1, y1: origY1 },
                      symbols
                    });
                  }
                }
              }
            }

            // Full-text fallback if blocks was empty
            if (extractedTesseractWords.length === 0 && ocrResult && ocrResult.data && ocrResult.data.text) {
              const rawTokens = ocrResult.data.text.trim().split(/\s+/).filter(Boolean);
              if (rawTokens.length > 0) {
                const totalLen = rawTokens.reduce((acc, t) => acc + t.length, 0);
                let currX = sx;
                rawTokens.forEach(tok => {
                  const cleaned = tok.replace(/^[.,\/#!$%\^&\*;:{}=\-_`~()]+|[.,\/#!$%\^&\*;:{}=\-_`~()]+$/g, '');
                  const textStr = cleaned.length > 0 ? cleaned : tok;
                  const tokW = Math.max(20, Math.round((textStr.length / Math.max(1, totalLen)) * sw));
                  const wBox = { x: currX, y: sy, w: Math.min(sw - (currX - sx), tokW), h: sh };
                  currX += tokW;
                  const symbols = [];
                  const chars = Array.from(textStr);
                  const cW = wBox.w / Math.max(1, chars.length);
                  chars.forEach((ch, cIdx) => {
                    symbols.push({
                      char: ch,
                      confidence: 80,
                      box: { x: Math.round(wBox.x + cIdx * cW), y: wBox.y, w: Math.max(3, Math.round(cW)), h: wBox.h }
                    });
                  });
                  extractedTesseractWords.push({
                    text: textStr,
                    confidence: 80,
                    bbox: { x0: wBox.x, y0: wBox.y, x1: wBox.x + wBox.w, y1: wBox.y + wBox.h },
                    symbols
                  });
                });
              }
            }

            if (extractedTesseractWords.length > 0) {
              tesseractUsed = true;
              for (let wIdx = 0; wIdx < extractedTesseractWords.length; wIdx++) {
                const tWord = extractedTesseractWords[wIdx];
                const wb = tWord.bbox;
                const pad = Math.max(4, Math.round(4 * toOrigScale));
                const origWordX = Math.max(0, Math.min(origW - 1, wb.x0 - pad));
                const origWordY = Math.max(0, Math.min(origH - 1, wb.y0 - pad));
                const origWordR = Math.max(origWordX + 1, Math.min(origW, wb.x1 + pad));
                const origWordB = Math.max(origWordY + 1, Math.min(origH, wb.y1 + pad));
                const origWordW = origWordR - origWordX;
                const origWordH = origWordB - origWordY;

                const wordCropCanvas = document.createElement('canvas');
                wordCropCanvas.width = origWordW;
                wordCropCanvas.height = origWordH;
                const wordCropCtx = wordCropCanvas.getContext('2d');
                wordCropCtx.drawImage(sourceImg, origWordX, origWordY, origWordW, origWordH, 0, 0, origWordW, origWordH);
                const wordImgDataUrl = wordCropCanvas.toDataURL('image/png');

                const wordGlyphs = [];
                for (let gIdx = 0; gIdx < tWord.symbols.length; gIdx++) {
                  const sym = tWord.symbols[gIdx];
                  const sb = sym.box;
                  const gPad = Math.max(2, Math.round(2 * toOrigScale));
                  let gOrigX = Math.max(0, Math.min(origW - 1, sb.x - gPad));
                  let gOrigY = Math.max(0, Math.min(origH - 1, sb.y - gPad));
                  let gOrigR = Math.max(gOrigX + 1, Math.min(origW, sb.x + sb.w + gPad));
                  let gOrigB = Math.max(gOrigY + 1, Math.min(origH, sb.y + sb.h + gPad));
                  let gOrigW = gOrigR - gOrigX;
                  let gOrigH = gOrigB - gOrigY;

                  if (gOrigW < 4) gOrigW = 4;
                  if (gOrigH < 4) gOrigH = 4;

                  const gCanvas = document.createElement('canvas');
                  gCanvas.width = gOrigW;
                  gCanvas.height = gOrigH;
                  const gCtx = gCanvas.getContext('2d');
                  gCtx.drawImage(sourceImg, gOrigX, gOrigY, gOrigW, gOrigH, 0, 0, gOrigW, gOrigH);
                  const glyphImgDataUrl = gCanvas.toDataURL('image/png');

                  const rawSymBoxWork = {
                    x: Math.max(0, Math.min(w - 1, Math.round((sb.x - sx) * workScale))),
                    y: Math.max(0, Math.min(h - 1, Math.round((sb.y - sy) * workScale))),
                    w: Math.max(1, Math.round(sb.w * workScale)),
                    h: Math.max(1, Math.round(sb.h * workScale))
                  };
                  const tightenedBoxWork = tightenBox(currentWorkBinaryMask, rawSymBoxWork) || rawSymBoxWork;
                  const sig = compute16x16Sig(currentWorkBinaryMask, tightenedBoxWork);

                  wordGlyphs.push({
                    id: `glyph-${wIdx}-${gIdx}`,
                    char: sym.char,
                    confidence: sym.confidence ?? 90,
                    signature: sig,
                    box: { x: gOrigX, y: gOrigY, w: gOrigW, h: gOrigH },
                    boxWork: tightenedBoxWork,
                    glyphImgDataUrl
                  });
                }

                const wordString = wordGlyphs.map(gl => gl.char).join('') || tWord.text;
                detectedWords.push({
                  id: `word-${wIdx}`,
                  text: wordString,
                  originalText: wordString,
                  box: { x: origWordX, y: origWordY, w: origWordW, h: origWordH },
                  wordImgDataUrl,
                  wordCanvas: wordCropCanvas,
                  glyphs: wordGlyphs,
                  originalGlyphs: wordGlyphs.map(g => ({ ...g })),
                  confidence: tWord.confidence ?? 90
                });
              }
            }
          }
        } catch (ocrErr) {
          console.warn('[FontFinder] Tesseract recognize failed, falling back to optical segmentation:', ocrErr);
        }

        // ========================================================
        // FALLBACK: ENHANCED OPTICAL SEGMENTATION WITH TOUCHING-GLYPH SPLIT
        // ========================================================
        if (!tesseractUsed || detectedWords.length === 0) {
          const totalPixels = w * h;
          // Row density for vertical bounds
          const rowDensity = new Float32Array(h);
          for (let y = 0; y < h; y++) {
            let count = 0;
            const offset = y * w;
            for (let x = 0; x < w; x++) {
              if (binary[offset + x] === 1) count++;
            }
            rowDensity[y] = count;
          }
          let textTop = 0, textBottom = h - 1;
          const minRowInk = Math.max(2, Math.round(w * 0.008));
          for (let y = 0; y < h; y++) {
            if (rowDensity[y] >= minRowInk) { textTop = y; break; }
          }
          for (let y = h - 1; y >= 0; y--) {
            if (rowDensity[y] >= minRowInk) { textBottom = y; break; }
          }
          const textH = Math.max(12, textBottom - textTop + 1);

          // 8-connected components
          const visited = new Uint8Array(totalPixels);
          const rawBoxes = [];
          const queue = new Int32Array(totalPixels);

          for (let y = textTop; y <= textBottom; y++) {
            const yOff = y * w;
            for (let x = 0; x < w; x++) {
              const idx = yOff + x;
              if (binary[idx] === 1 && visited[idx] === 0) {
                let minX = x, maxX = x, minY = y, maxY = y;
                let ink = 0;
                let head = 0, tail = 0;
                queue[tail++] = idx;
                visited[idx] = 1;

                while (head < tail) {
                  const cur = queue[head++];
                  ink++;
                  const cx = cur % w;
                  const cy = (cur / w) | 0;
                  if (cx < minX) minX = cx;
                  if (cx > maxX) maxX = cx;
                  if (cy < minY) minY = cy;
                  if (cy > maxY) maxY = cy;

                  for (let dy = -1; dy <= 1; dy++) {
                    const ny = cy + dy;
                    if (ny < textTop || ny > textBottom) continue;
                    const nRow = ny * w;
                    for (let dx = -1; dx <= 1; dx++) {
                      if (dx === 0 && dy === 0) continue;
                      const nx = cx + dx;
                      if (nx < 0 || nx >= w) continue;
                      const nidx = nRow + nx;
                      if (binary[nidx] === 1 && visited[nidx] === 0) {
                        visited[nidx] = 1;
                        queue[tail++] = nidx;
                      }
                    }
                  }
                }

                const gw = maxX - minX + 1;
                const gh = maxY - minY + 1;
                if (ink >= 5 && gw >= 2 && gh >= 3) {
                  rawBoxes.push({ x: minX, y: minY, w: gw, h: gh, ink });
                }
              }
            }
          }

          // Smart component merging (dots on i, j, accents)
          rawBoxes.sort((a, b) => a.x - b.x);
          const dotHThresh = textH * 0.40;
          const gapThresh = textH * 0.50;
          const horizTol = Math.max(3, textH * 0.20);
          const mergedFlags = new Uint8Array(rawBoxes.length);
          const mergedBoxes = [];

          for (let i = 0; i < rawBoxes.length; i++) {
            if (mergedFlags[i]) continue;
            let a = { ...rawBoxes[i] };
            for (let j = i + 1; j < rawBoxes.length; j++) {
              if (mergedFlags[j]) continue;
              const b = rawBoxes[j];
              if (b.x > a.x + a.w + horizTol) break;
              const xOverlap = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x);
              const isVertStacked = xOverlap >= Math.min(a.w, b.w) * 0.25;
              const vertGap = Math.max(0, Math.max(a.y, b.y) - Math.min(a.y + a.h, b.y + b.h));
              const oneIsSmall = a.h <= dotHThresh || b.h <= dotHThresh;

              if (isVertStacked && vertGap <= gapThresh && oneIsSmall) {
                const nx0 = Math.min(a.x, b.x);
                const ny0 = Math.min(a.y, b.y);
                const nx1 = Math.max(a.x + a.w, b.x + b.w);
                const ny1 = Math.max(a.y + a.h, b.y + b.h);
                a = { x: nx0, y: ny0, w: nx1 - nx0, h: ny1 - ny0, ink: a.ink + b.ink };
                mergedFlags[j] = 1;
              }
            }
            mergedBoxes.push(a);
          }

          // Filter out tiny noise
          const heights = mergedBoxes.map(b => b.h).sort((a, b) => a - b);
          const medianH = heights[Math.floor(heights.length / 2)] || 16;
          const baseBoxes = mergedBoxes.filter(b => b.h >= medianH * 0.25 && b.w >= 2);

          // Split touching characters (e.g. touching 'qu', 'fi', 'oo')
          const filteredBoxes = [];
          for (const b of baseBoxes) {
            const aspect = b.w / Math.max(1, b.h);
            if (aspect > 1.35 && b.w >= medianH * 0.85 && b.h >= medianH * 0.5) {
              const colSums = new Int32Array(b.w);
              for (let col = 0; col < b.w; col++) {
                const absX = b.x + col;
                for (let row = 0; row < b.h; row++) {
                  const absY = b.y + row;
                  if (binary[absY * w + absX]) colSums[col]++;
                }
              }
              const minCol = Math.floor(b.w * 0.35);
              const maxCol = Math.floor(b.w * 0.65);
              let valleyCol = -1;
              let minVal = Infinity;
              for (let c = minCol; c <= maxCol; c++) {
                if (colSums[c] < minVal) {
                  minVal = colSums[c];
                  valleyCol = c;
                }
              }
              const peak = Math.max(...colSums);
              if (valleyCol > 0 && minVal <= peak * 0.45) {
                filteredBoxes.push({ x: b.x, y: b.y, w: valleyCol, h: b.h, ink: Math.floor(b.ink / 2) });
                filteredBoxes.push({ x: b.x + valleyCol, y: b.y, w: b.w - valleyCol, h: b.h, ink: Math.floor(b.ink / 2) });
                continue;
              }
            }
            filteredBoxes.push(b);
          }

          // Group into lines by vertical position
          filteredBoxes.sort((a, b) => (a.y + a.h / 2) - (b.y + b.h / 2));
          const lines = [];
          for (const box of filteredBoxes) {
            const boxMid = box.y + box.h / 2;
            let placed = false;
            for (const line of lines) {
              const lineMid = line.reduce((sum, b) => sum + (b.y + b.h / 2), 0) / line.length;
              if (Math.abs(boxMid - lineMid) <= medianH * 0.55) {
                line.push(box);
                placed = true;
                break;
              }
            }
            if (!placed) {
              lines.push([box]);
            }
          }

          // Sort lines from top to bottom
          lines.sort((lineA, lineB) => {
            const midA = lineA.reduce((sum, b) => sum + (b.y + b.h / 2), 0) / lineA.length;
            const midB = lineB.reduce((sum, b) => sum + (b.y + b.h / 2), 0) / lineB.length;
            return midA - midB;
          });

          // Segment glyphs on each line into words using inter-glyph gaps
          const wordsRaw = [];
          for (const line of lines) {
            line.sort((a, b) => a.x - b.x);
            if (line.length < 2) {
              if (line.length === 1) wordsRaw.push(line);
              continue;
            }

            const gaps = [];
            for (let i = 1; i < line.length; i++) {
              gaps.push(line[i].x - (line[i - 1].x + line[i - 1].w));
            }
            const sortedGaps = gaps.slice().sort((a, b) => a - b);
            const medianGap = Math.max(1, sortedGaps[Math.floor(sortedGaps.length / 2)] || 3);
            const wordBreakThresh = Math.max(medianGap * 1.85, medianH * 0.28);

            let curWord = [line[0]];
            for (let i = 1; i < line.length; i++) {
              const gap = gaps[i - 1];
              if (gap > wordBreakThresh) {
                wordsRaw.push(curWord);
                curWord = [];
              }
              curWord.push(line[i]);
            }
            if (curWord.length > 0) wordsRaw.push(curWord);
          }

          if (wordsRaw.length === 0 && filteredBoxes.length > 0) {
            wordsRaw.push(filteredBoxes);
          }
          if (wordsRaw.length === 0) {
            wordsRaw.push([{ x: 10, y: 10, w: Math.max(50, w - 20), h: Math.max(30, h - 20), ink: 100 }]);
          }

          const sampleWords = currentSampleText ? currentSampleText.trim().split(/\s+/).filter(Boolean) : [];

          for (let wIdx = 0; wIdx < wordsRaw.length; wIdx++) {
            const rawGlyphs = wordsRaw[wIdx];
            const minWorkX = Math.min(...rawGlyphs.map(g => g.x));
            const maxWorkX = Math.max(...rawGlyphs.map(g => g.x + g.w));
            const minWorkY = Math.min(...rawGlyphs.map(g => g.y));
            const maxWorkY = Math.max(...rawGlyphs.map(g => g.y + g.h));

            const pad = Math.max(4, Math.round(medianH * 0.15 * toOrigScale));
            const origWordX = Math.max(0, Math.min(origW - 1, Math.round(sx + minWorkX * toOrigScale) - pad));
            const origWordY = Math.max(0, Math.min(origH - 1, Math.round(sy + minWorkY * toOrigScale) - pad));
            const origWordR = Math.max(origWordX + 1, Math.min(origW, Math.round(sx + maxWorkX * toOrigScale) + pad));
            const origWordB = Math.max(origWordY + 1, Math.min(origH, Math.round(sy + maxWorkY * toOrigScale) + pad));
            const origWordW = origWordR - origWordX;
            const origWordH = origWordB - origWordY;

            const wordCropCanvas = document.createElement('canvas');
            wordCropCanvas.width = origWordW;
            wordCropCanvas.height = origWordH;
            const wordCropCtx = wordCropCanvas.getContext('2d');
            wordCropCtx.drawImage(sourceImg, origWordX, origWordY, origWordW, origWordH, 0, 0, origWordW, origWordH);
            const wordImgDataUrl = wordCropCanvas.toDataURL('image/png');

            const expectedWordStr = sampleWords[wIdx] || '';
            const wordGlyphs = [];

            for (let gIdx = 0; gIdx < rawGlyphs.length; gIdx++) {
              const g = rawGlyphs[gIdx];
              const gPad = Math.max(2, Math.round(2 * toOrigScale));
              const gOrigX = Math.max(0, Math.min(origW - 1, Math.round(sx + g.x * toOrigScale) - gPad));
              const gOrigY = Math.max(0, Math.min(origH - 1, Math.round(sy + g.y * toOrigScale) - gPad));
              const gOrigR = Math.max(gOrigX + 1, Math.min(origW, Math.round(sx + (g.x + g.w) * toOrigScale) + gPad));
              const gOrigB = Math.max(gOrigY + 1, Math.min(origH, Math.round(sy + (g.y + g.h) * toOrigScale) + gPad));
              const gOrigW = gOrigR - gOrigX;
              const gOrigH = gOrigB - gOrigY;

              const gCanvas = document.createElement('canvas');
              gCanvas.width = gOrigW;
              gCanvas.height = gOrigH;
              const gCtx = gCanvas.getContext('2d');
              gCtx.drawImage(sourceImg, gOrigX, gOrigY, gOrigW, gOrigH, 0, 0, gOrigW, gOrigH);
              const glyphImgDataUrl = gCanvas.toDataURL('image/png');

              const sig = compute16x16Sig(binary, w, g);

              let assignedChar = '?';
              if (expectedWordStr && gIdx < expectedWordStr.length) {
                assignedChar = expectedWordStr[gIdx];
              } else if (sigRegularCharMap && sigManifest) {
                assignedChar = classifySig(sig, sigRegularCharMap, sigManifest, g, { baseline: textBottom, xHeight: textTop + textH * 0.45, xSize: textH * 0.55, isReliable: true });
              } else {
                assignedChar = 'e';
              }

              wordGlyphs.push({
                id: `glyph-${wIdx}-${gIdx}`,
                char: assignedChar,
                signature: sig,
                box: { x: gOrigX, y: gOrigY, w: gOrigW, h: gOrigH },
                glyphImgDataUrl
              });
            }

            const wText = wordGlyphs.map(gl => gl.char).join('');
            detectedWords.push({
              id: `word-${wIdx}`,
              text: wText,
              originalText: wText,
              box: { x: origWordX, y: origWordY, w: origWordW, h: origWordH },
              wordImgDataUrl,
              wordCanvas: wordCropCanvas,
              glyphs: wordGlyphs,
              originalGlyphs: wordGlyphs.map(g => ({ ...g }))
            });
          }
        }
      } catch (err) {
        console.error('[FontFinder] detectWordsAndGlyphs unexpected error:', err);
      } finally {
        if (!detectedWords || detectedWords.length === 0) {
          createEmergencyFallbackWord(sourceImg, customCropBox);
        }
        renderWordChips();
        if (detectedWords && detectedWords.length > 1) {
          selectTarget('sentence');
        } else {
          selectTarget('word', 0);
        }
      }
    }

    function classifySig(sig, charMap, manifest, box, typo) {
      let isAllZero = true;
      for (let i = 0; i < sig.length; i++) {
        if (sig[i] !== 0) { isAllZero = false; break; }
      }
      if (isAllZero) return 'e';

      let bestChar = 'e';
      let minDistance = 999;
      const numFonts = manifest.fonts.length;
      const topK = Math.max(5, Math.floor(numFonts * 0.05));

      let allowedChars = manifest.chars;
      if (box && typo && typo.isReliable) {
        const tol = typo.xSize * 0.25;
        const isAscender = box.y < typo.xHeight - tol;
        const isDescender = box.y + box.h > typo.baseline + tol;
        if (isDescender && !isAscender) {
          allowedChars = 'gjpqy';
        } else if (isAscender && !isDescender) {
          allowedChars = 'bdfhiklt0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        } else if (!isAscender && !isDescender) {
          allowedChars = 'aceimnorsuvwxz';
        }
      }

      for (const ch of allowedChars) {
        const slice = charMap.get(ch);
        if (!slice) continue;
        const distances = [];
        for (let f = 0; f < numFonts; f += 8) {
          const offset = f * 32;
          if (isBlankSig(slice, offset, 32)) continue;
          distances.push(hammingDist(sig, slice, offset));
        }
        if (distances.length === 0) continue;
        distances.sort((a, b) => a - b);
        const topKDist = distances.slice(0, topK);
        const avgTop = topKDist.reduce((a, b) => a + b, 0) / topKDist.length;
        if (avgTop < minDistance) {
          minDistance = avgTop;
          bestChar = ch;
        }
      }
      return bestChar;
    }

    function renderWordChips() {
      if (!wordChipsContainer) return;
      wordChipsContainer.innerHTML = '';

      if (detectedWords.length > 1) {
        const isSentenceActive = (currentTargetMode === 'sentence');
        const sBtn = document.createElement('button');
        sBtn.type = 'button';
        sBtn.className = `word-chip px-3.5 py-2 rounded-[8px] border transition-all flex items-center justify-center cursor-pointer ${
          isSentenceActive
            ? 'border-[#e4f222] bg-[#161718] text-[#ffffff] shadow-xs'
            : 'border-[#23252a] bg-[#0f1011] text-[#8a8f98] hover:border-[#383b3f]'
        }`;
        sBtn.innerHTML = `
          <div class="flex items-center gap-1.5 pointer-events-none py-1">
            <span class="w-2 h-2 rounded-full ${isSentenceActive ? 'bg-[#e4f222]' : 'bg-[#62666d]'}"></span>
            <span class="text-xs font-mono font-medium ${isSentenceActive ? 'text-[#ffffff]' : 'text-[#8a8f98]'}">Entire Sentence (All)</span>
          </div>
        `;
        sBtn.addEventListener('click', () => {
          selectTarget('sentence');
        });
        wordChipsContainer.appendChild(sBtn);
      }

      detectedWords.forEach((word, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isSelected = (currentTargetMode === 'word' && idx === currentSelectedWordIndex);
        btn.className = `word-chip px-3.5 py-2.5 rounded-[8px] border transition-all flex items-center justify-center cursor-pointer ${
          isSelected
            ? 'border-[#e4f222] bg-[#161718] text-[#ffffff] shadow-xs'
            : 'border-[#23252a] bg-[#0f1011] text-[#8a8f98] hover:border-[#383b3f]'
        }`;
        btn.setAttribute('data-word-idx', String(idx));
        btn.innerHTML = `
          <div class="flex flex-col items-center gap-1.5 pointer-events-none">
            <img src="${word.wordImgDataUrl}" alt="${word.text}" class="max-h-9 max-w-[150px] object-contain" />
            <span class="word-chip-text text-xs font-mono font-medium ${isSelected ? 'text-[#ffffff]' : 'text-[#8a8f98]'} px-2 py-0.5 rounded-[4px] bg-[#08090a] border border-[#23252a] max-w-[140px] truncate">${word.text}</span>
          </div>
        `;
        btn.addEventListener('click', () => {
          selectTarget('word', idx);
        });
        wordChipsContainer.appendChild(btn);
      });
    }

    function renderResultsSentenceBar() {
      // Intentionally hidden: Entire Sentence font result is the single, direct primary result.
      const sentenceBar = document.getElementById('results-sentence-bar');
      if (sentenceBar) sentenceBar.classList.add('hidden');

      const btnScrollOrganize = document.getElementById('btn-scroll-to-organize');
      if (btnScrollOrganize) {
        btnScrollOrganize.onclick = () => {
          organizeStage?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };
      }
    }

    function prepareAndSegmentSelectedWord(word) {
      if (!word) return null;
      const origW = (currentImage && (currentImage.naturalWidth || currentImage.width)) || 1000;
      const origH = (currentImage && (currentImage.naturalHeight || currentImage.height)) || 1000;

      // 1. Ensure word canvas and thumbnail exist
      if (!word.wordCanvas) {
        const wb = word.box || { x: 0, y: 0, w: origW, h: origH };
        const pad = Math.max(6, Math.round(wb.h * 0.12));
        const cropX = Math.max(0, wb.x - pad);
        const cropY = Math.max(0, wb.y - pad);
        const cropR = Math.min(origW, wb.x + wb.w + pad);
        const cropB = Math.min(origH, wb.y + wb.h + pad);
        const cropW = Math.max(10, cropR - cropX);
        const cropH = Math.max(10, cropB - cropY);

        const wordCropCanvas = document.createElement('canvas');
        wordCropCanvas.width = cropW;
        wordCropCanvas.height = cropH;
        const wordCropCtx = wordCropCanvas.getContext('2d');
        if (currentImage) {
          wordCropCtx.drawImage(currentImage, cropX, cropY, cropW, cropH, 0, 0, cropW, cropH);
        }
        word.wordCanvas = wordCropCanvas;
        word.wordImgDataUrl = wordCropCanvas.toDataURL('image/png');
      }

      // Update chip thumbnail if present
      const chipImg = wordChipsContainer?.querySelector(`[data-word-idx="${currentSelectedWordIndex}"] img`);
      if (chipImg && word.wordImgDataUrl) chipImg.src = word.wordImgDataUrl;

      // Cache original glyphs permanently on first access if not already cached
      if ((!word.originalGlyphs || word.originalGlyphs.length === 0) && word.glyphs && word.glyphs.length > 0) {
        word.originalGlyphs = word.glyphs.map(g => ({ ...g }));
        word.originalText = word.text;
      }

      // 2. Determine verified text string for this word
      const wordInput = document.getElementById('selected-word-text-input');
      const currentTextInput = (wordInput && wordInput.value.trim());
      const rawText = currentTextInput || word.text || 'word';

      // 3. If word has authentic originalGlyphs and text is unchanged, USE AUTHENTIC ORIGINAL GLYPHS!
      const isTextUnchanged = (!currentTextInput || currentTextInput === word.originalText || currentTextInput === word.text);
      if (word.originalGlyphs && word.originalGlyphs.length > 0 && isTextUnchanged) {
        word.glyphs = word.originalGlyphs.map(g => ({ ...g }));
        word.text = word.originalText || rawText;
        renderLetterTiles(word);
        return {
          wordMask: currentWorkBinaryMask,
          freshGlyphs: word.glyphs,
          wordText: word.text
        };
      }

      // 4. If user edited the text manually, adapt glyphs for the edited text string
      const cleanChars = Array.from(rawText).filter(c => c && c.trim().length > 0);
      const chars = cleanChars.length > 0 ? cleanChars : ['w'];
      word.text = chars.join('');

      const wb = word.box || { x: 0, y: 0, w: origW, h: origH };
      const pad = Math.max(6, Math.round(wb.h * 0.12));
      const cropX = Math.max(0, wb.x - pad);
      const cropY = Math.max(0, wb.y - pad);
      const cropR = Math.min(origW, wb.x + wb.w + pad);
      const cropB = Math.min(origH, wb.y + wb.h + pad);
      const cropW = Math.max(10, cropR - cropX);
      const cropH = Math.max(10, cropB - cropY);

      const wordCropCanvas = document.createElement('canvas');
      wordCropCanvas.width = cropW;
      wordCropCanvas.height = cropH;
      const wordCropCtx = wordCropCanvas.getContext('2d');
      if (currentImage) {
        wordCropCtx.drawImage(currentImage, cropX, cropY, cropW, cropH, 0, 0, cropW, cropH);
      }
      word.wordCanvas = wordCropCanvas;
      word.wordImgDataUrl = wordCropCanvas.toDataURL('image/png');

      const imgData = wordCropCtx.getImageData(0, 0, cropW, cropH);
      const wordMask = binarizeColorDist(imgData.data, cropW, cropH);

      // Distribute character boxes across ink span
      let minInkX = cropW, maxInkX = -1, minInkY = cropH, maxInkY = -1;
      for (let y = 0; y < cropH; y++) {
        const rOff = y * cropW;
        for (let x = 0; x < cropW; x++) {
          if (wordMask.bits[rOff + x]) {
            if (x < minInkX) minInkX = x;
            if (x > maxInkX) maxInkX = x;
            if (y < minInkY) minInkY = y;
            if (y > maxInkY) maxInkY = y;
          }
        }
      }
      if (maxInkX < minInkX) {
        minInkX = 0; maxInkX = cropW - 1; minInkY = 0; maxInkY = cropH - 1;
      }
      const inkW = Math.max(4, maxInkX - minInkX + 1);
      const inkH = Math.max(4, maxInkY - minInkY + 1);

      const charWidth = inkW / chars.length;
      const freshGlyphs = chars.map((ch, cIdx) => {
        let rawBox = {
          x: Math.round(minInkX + cIdx * charWidth),
          y: minInkY,
          w: Math.max(3, Math.round(charWidth)),
          h: Math.max(3, inkH)
        };

        if (word.originalGlyphs && word.originalGlyphs[cIdx] && word.originalGlyphs[cIdx].box) {
          const oldB = word.originalGlyphs[cIdx].box;
          const oldRelX = oldB.x - cropX;
          const oldRelY = oldB.y - cropY;
          if (oldRelX >= 0 && oldRelX + oldB.w <= cropW && oldRelY >= 0 && oldRelY + oldB.h <= cropH && oldB.w >= 3 && oldB.h >= 3) {
            rawBox = { x: oldRelX, y: oldRelY, w: oldB.w, h: oldB.h };
          }
        }

        const tight = tightenBox(wordMask, rawBox) || rawBox;
        const sig = compute16x16Sig(wordMask, tight);

        const gCanvas = document.createElement('canvas');
        gCanvas.width = Math.max(4, tight.w);
        gCanvas.height = Math.max(4, tight.h);
        const gCtx = gCanvas.getContext('2d');
        gCtx.drawImage(wordCropCanvas, tight.x, tight.y, tight.w, tight.h, 0, 0, gCanvas.width, gCanvas.height);

        return {
          id: `glyph-${currentSelectedWordIndex}-${cIdx}`,
          char: ch,
          confidence: 90,
          signature: sig,
          boxWork: tight,
          box: { x: cropX + tight.x, y: cropY + tight.y, w: tight.w, h: tight.h },
          glyphImgDataUrl: gCanvas.toDataURL('image/png')
        };
      });

      word.glyphs = freshGlyphs;
      renderLetterTiles(word);
      return { wordMask, freshGlyphs, wordText: word.text };
    }

    let currentTargetMode = 'sentence'; // 'sentence' | 'word'
    let lastSentenceCandidates = null;
    let lastSentenceFont = null;
    let sentenceImgDataUrl = '';

    function getSentenceImageDataUrl() {
      if (sentenceImgDataUrl) return sentenceImgDataUrl;
      const img = currentImage;
      if (!img || !detectedWords || detectedWords.length === 0) return '';
      const origW = img.naturalWidth || img.width || 1000;
      const origH = img.naturalHeight || img.height || 1000;

      let minX = origW, minY = origH, maxX = 0, maxY = 0;
      for (const w of detectedWords) {
        const b = w.box;
        if (b) {
          if (b.x < minX) minX = b.x;
          if (b.y < minY) minY = b.y;
          if (b.x + b.w > maxX) maxX = b.x + b.w;
          if (b.y + b.h > maxY) maxY = b.y + b.h;
        }
      }

      if (minX >= maxX || minY >= maxY) {
        return detectedWords[0]?.wordImgDataUrl || '';
      }

      const padX = Math.max(6, Math.round((maxY - minY) * 0.12));
      const padY = Math.max(6, Math.round((maxY - minY) * 0.12));
      const sX = Math.max(0, minX - padX);
      const sY = Math.max(0, minY - padY);
      const sR = Math.min(origW, maxX + padX);
      const sB = Math.min(origH, maxY + padY);
      const sW = Math.max(10, sR - sX);
      const sH = Math.max(10, sB - sY);

      const sCanvas = document.createElement('canvas');
      sCanvas.width = sW;
      sCanvas.height = sH;
      const sCtx = sCanvas.getContext('2d');
      sCtx.drawImage(img, sX, sY, sW, sH, 0, 0, sW, sH);
      sentenceImgDataUrl = sCanvas.toDataURL('image/png');
      return sentenceImgDataUrl;
    }

    function selectTarget(mode, idx = 0) {
      if (mode === 'sentence' && detectedWords.length > 1) {
        currentTargetMode = 'sentence';
        currentSelectedWordIndex = -1;
        if (detectedWords.length > 0) {
          currentSelectedWord = detectedWords[0];
        }

        // Update Stage 02 sentence crop preview
        if (stage2SentencePreviewImg) {
          const sUrl = getSentenceImageDataUrl();
          if (sUrl) stage2SentencePreviewImg.src = sUrl;
          else if (detectedWords[0]?.wordImgDataUrl) stage2SentencePreviewImg.src = detectedWords[0].wordImgDataUrl;
        }
        if (stage2PreviewBadge) {
          stage2PreviewBadge.textContent = '';
        }

        // Visual update on organize chips
        renderWordChips();

        const wordInput = document.getElementById('selected-word-text-input');
        if (wordInput) {
          wordInput.value = detectedWords.map(w => w.text).join(' ');
        }
        const badgeText = document.getElementById('ocr-engine-badge-text');
        if (badgeText) {
          badgeText.textContent = '';
        }
        if (btnIdentifyFont) {
          const btnSpan = btnIdentifyFont.querySelector('span');
          if (btnSpan) {
            btnSpan.textContent = 'Identify font';
          }
        }
        
        // Pool glyphs across all detected words for advanced inspection tray
        const allSentenceGlyphs = [];
        detectedWords.forEach((w) => {
          if (w.glyphs && w.glyphs.length > 0) {
            allSentenceGlyphs.push(...w.glyphs);
          } else if (w.originalGlyphs && w.originalGlyphs.length > 0) {
            allSentenceGlyphs.push(...w.originalGlyphs);
          }
        });
        renderLetterTiles(null, allSentenceGlyphs);
      } else {
        currentTargetMode = 'word';
        if (idx < 0 || idx >= detectedWords.length) return;
        currentSelectedWordIndex = idx;
        currentSelectedWord = detectedWords[idx];

        // Update Stage 02 crop preview for single word
        if (stage2SentencePreviewImg) {
          stage2SentencePreviewImg.src = currentSelectedWord.wordImgDataUrl || '';
        }
        if (stage2PreviewBadge) {
          stage2PreviewBadge.textContent = '';
        }

        renderWordChips();

        const wordInput = document.getElementById('selected-word-text-input');
        if (wordInput) {
          wordInput.value = currentSelectedWord.text || '';
        }
        const badgeText = document.getElementById('ocr-engine-badge-text');
        if (badgeText) {
          badgeText.textContent = '';
        }
        if (btnIdentifyFont) {
          const btnSpan = btnIdentifyFont.querySelector('span');
          if (btnSpan) {
            btnSpan.textContent = 'Identify font';
          }
        }
        prepareAndSegmentSelectedWord(currentSelectedWord);
      }

      renderResultsSentenceBar();

      // If user is already on the results stage, re-run full identification pipeline freshly!
      if (resultsStage && !resultsStage.classList.contains('hidden')) {
        runIdentificationPipeline();
      }
    }

    function selectWord(idx) {
      selectTarget('word', idx);
    }

    // Bi-directional sync for selected word / sentence text input
    const selectedWordInputElem = document.getElementById('selected-word-text-input');
    if (selectedWordInputElem) {
      selectedWordInputElem.addEventListener('input', (e) => {
        const newText = e.target.value;
        if (currentTargetMode === 'sentence' && detectedWords.length > 1) {
          currentVerifiedText = newText;
          const words = newText.trim().split(/\s+/).filter(Boolean);
          words.forEach((wStr, wIdx) => {
            if (detectedWords[wIdx]) {
              detectedWords[wIdx].text = wStr;
            }
          });
          const badgeText = document.getElementById('ocr-engine-badge-text');
          if (badgeText) {
            badgeText.textContent = '';
          }
          if (btnIdentifyFont) {
            const btnSpan = btnIdentifyFont.querySelector('span');
            if (btnSpan) {
              btnSpan.textContent = 'Identify font';
            }
          }
        } else if (currentSelectedWord) {
          currentSelectedWord.text = newText;
          
          // Sync characters with existing glyph objects
          const newChars = Array.from(newText);
          for (let i = 0; i < currentSelectedWord.glyphs.length; i++) {
            if (i < newChars.length) {
              currentSelectedWord.glyphs[i].char = newChars[i];
            }
          }

          // Update tile inputs
          const tileInputs = letterTilesContainer?.querySelectorAll('.glyph-char-input');
          if (tileInputs) {
            tileInputs.forEach((inp, idx) => {
              if (idx < newChars.length) {
                inp.value = newChars[idx];
              }
            });
          }

          // Update active word chip subtitle
          const activeChipLabel = wordChipsContainer?.querySelector(`[data-word-idx="${currentSelectedWordIndex}"] .word-chip-text`);
          if (activeChipLabel) {
            activeChipLabel.textContent = newText;
          }

          // Update identify button text
          if (btnIdentifyFont) {
            const btnSpan = btnIdentifyFont.querySelector('span');
            if (btnSpan) {
              btnSpan.textContent = `Identify "${newText}" font`;
            }
          }
        }
      });

      selectedWordInputElem.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          runIdentificationPipeline();
        }
      });
    }

    function renderLetterTiles(word, customGlyphs = null) {
      if (!letterTilesContainer) return;
      letterTilesContainer.innerHTML = '';

      const glyphList = customGlyphs || (word ? word.glyphs : []);
      if (!glyphList || glyphList.length === 0) {
        letterTilesContainer.innerHTML = '<span class="text-xs text-[#727272] dark:text-[#9ca3af]">No letters detected. You can use "Crop manually" to select a clear text area.</span>';
        return;
      }

      glyphList.forEach((glyph, gIdx) => {
        const tile = document.createElement('div');
        tile.className = 'letter-tile flex flex-col items-center gap-1.5 p-2 rounded-[8px] border border-[#23252a] bg-[#161718] shadow-xs relative group shrink-0';
        tile.innerHTML = `
          <button
            type="button"
            class="btn-remove-glyph absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-[#23252a] text-[#ffffff] text-[10px] flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer hover:bg-[#eb5757] shadow-xs"
            title="Remove non-letter"
          >
            &times;
          </button>
          <div class="w-12 h-12 flex items-center justify-center bg-[#08090a] rounded-[6px] border border-[#23252a] overflow-hidden p-1">
            <img src="${glyph.glyphImgDataUrl}" alt="${glyph.char}" class="max-h-full max-w-full object-contain pointer-events-none" />
          </div>
          <input
            type="text"
            value="${glyph.char}"
            maxlength="2"
            class="glyph-char-input w-10 h-7 text-center text-xs font-mono font-medium text-[#ffffff] bg-[#08090a] border border-[#23252a] rounded-[4px] focus:outline-none focus:border-[#e4f222] transition-colors"
          />
        `;

        const input = tile.querySelector('.glyph-char-input');
        if (input) {
          input.addEventListener('input', (e) => {
            glyph.char = e.target.value;
            if (word) {
              if (word.originalGlyphs && word.originalGlyphs[gIdx]) {
                word.originalGlyphs[gIdx].char = e.target.value;
              }
              word.text = word.glyphs.map(gl => gl.char).join('');
              word.originalText = word.text;
              const wordInput = document.getElementById('selected-word-text-input');
              if (wordInput) wordInput.value = word.text;
              const activeChipLabel = wordChipsContainer?.querySelector(`[data-word-idx="${currentSelectedWordIndex}"] .word-chip-text`);
              if (activeChipLabel) activeChipLabel.textContent = word.text;
              if (btnIdentifyFont) {
                const btnSpan = btnIdentifyFont.querySelector('span');
                if (btnSpan) btnSpan.textContent = `Identify "${word.text}" font`;
              }
            } else {
              const wordInput = document.getElementById('selected-word-text-input');
              if (wordInput) {
                wordInput.value = detectedWords.map(w => w.text).join(' ');
              }
            }
          });
          input.addEventListener('focus', () => input.select());
        }

        const removeBtn = tile.querySelector('.btn-remove-glyph');
        if (removeBtn) {
          removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            glyphList.splice(gIdx, 1);
            if (word) {
              if (word.originalGlyphs && word.originalGlyphs.length > gIdx) {
                word.originalGlyphs.splice(gIdx, 1);
              }
              word.text = word.glyphs.map(gl => gl.char).join('');
              word.originalText = word.text;
              const wordInput = document.getElementById('selected-word-text-input');
              if (wordInput) wordInput.value = word.text;
              const activeChipLabel = wordChipsContainer?.querySelector(`[data-word-idx="${currentSelectedWordIndex}"] .word-chip-text`);
              if (activeChipLabel) activeChipLabel.textContent = word.text;
              if (btnIdentifyFont) {
                const btnSpan = btnIdentifyFont.querySelector('span');
                if (btnSpan) btnSpan.textContent = `Identify "${word.text}" font`;
              }
              renderLetterTiles(word);
            } else {
              renderLetterTiles(null, glyphList);
            }
          });
        }

        letterTilesContainer.appendChild(tile);
      });
    }

    // ==========================================
    // PHASES 6-10: TWO-STAGE FONT IDENTIFICATION ENGINE
    // ==========================================

    btnIdentifyFont?.addEventListener('click', () => {
      runIdentificationPipeline();
    });

    let pipelineSequence = 0;

    async function runIdentificationPipeline() {
      const isSentenceMode = (currentTargetMode === 'sentence' && detectedWords && detectedWords.length > 1);

      if (!isSentenceMode && !currentSelectedWord) {
        alert('Please select a word to identify.');
        return;
      }
      if (isSentenceMode && (!detectedWords || detectedWords.length === 0)) {
        alert('Please select a word to identify.');
        return;
      }

      const thisRunId = ++pipelineSequence;

      let validGlyphs = [];
      let verifiedWordText = '';
      let wordBinaryMask = null;
      let representativeThumb = '';

      if (isSentenceMode) {
        for (const w of detectedWords) {
          if (!w.originalGlyphs || w.originalGlyphs.length === 0) {
            prepareAndSegmentSelectedWord(w);
          }
          const glyphsToAdd = (w.glyphs && w.glyphs.length > 0) ? w.glyphs : (w.originalGlyphs || []);
          validGlyphs.push(...glyphsToAdd);
        }
        verifiedWordText = selectedWordInputElem?.value.trim() || detectedWords.map(w => w.text).join(' ');
        currentVerifiedText = verifiedWordText;
        wordBinaryMask = currentWorkBinaryMask;
        representativeThumb = getSentenceImageDataUrl() || detectedWords[0]?.wordImgDataUrl || '';
      } else {
        const segData = prepareAndSegmentSelectedWord(currentSelectedWord);
        if (!segData || !segData.freshGlyphs || segData.freshGlyphs.length === 0) {
          alert('Please ensure at least one letter is entered or detected for this word.');
          return;
        }
        validGlyphs = segData.freshGlyphs;
        verifiedWordText = segData.wordText;
        currentVerifiedText = verifiedWordText;
        wordBinaryMask = segData.wordMask;
        representativeThumb = currentSelectedWord.wordImgDataUrl;
      }

      if (validGlyphs.length === 0) {
        alert('Please ensure at least one letter is entered or detected.');
        return;
      }

      // Keep organizeStage visible so sentence words are never hidden!
      loadingStage.classList.remove('hidden');
      loadingStage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      if (btnIdentifyFont) {
        btnIdentifyFont.disabled = true;
        btnIdentifyFont.classList.add('opacity-70', 'cursor-not-allowed');
      }

      const progressBar = document.getElementById('progress-bar');
      const stepTitle = document.getElementById('loading-step-title');
      const stepDetail = document.getElementById('loading-step-detail');

      if (progressBar) progressBar.style.width = '20%';
      if (stepTitle) stepTitle.textContent = isSentenceMode ? 'SENTENCE CONSENSUS: 16×16 GLYPH MATCHING' : 'STAGE A: 16×16 GLYPH FINGERPRINT MATCHING';
      if (stepDetail) stepDetail.textContent = `Evaluating ${validGlyphs.length} letterforms across 1,935 Google Fonts in browser...`;

      const sigDb = await loadSignatureDb();
      if (thisRunId !== pipelineSequence) return;
      if (!sigDb) {
        console.error('Failed to load signatures DB');
        loadingStage.classList.add('hidden');
        organizeStage.classList.remove('hidden');
        if (btnIdentifyFont) {
          btnIdentifyFont.disabled = false;
          btnIdentifyFont.classList.remove('opacity-70', 'cursor-not-allowed');
        }
        return;
      }

      const { manifest, regMap, boldMap } = sigDb;
      const cuts = [{ name: 'regular', data: regMap }, { name: 'bold', data: boldMap }];

      if (progressBar) progressBar.style.width = '45%';
      if (stepDetail) stepDetail.textContent = `Matching ${validGlyphs.length} verified letterforms with multi-level stroke thinning...`;

      await new Promise(r => setTimeout(r, 40));
      if (thisRunId !== pipelineSequence) return;

      // 1. Gather glyph bounding boxes and erosion signatures
      let erosionPasses = [];
      let bestThinningLevel = 0;

      if (!isSentenceMode) {
        const activeGlyphBoxes = validGlyphs.map(g => g.boxWork || g.box);
        const maskToUse = wordBinaryMask || currentWorkBinaryMask;
        let maxErosion = 1;
        if (activeGlyphBoxes.length > 0 && maskToUse) {
          let totalInk = 0;
          let totalArea = 0;
          for (const b of activeGlyphBoxes) {
            if (!b) continue;
            totalArea += (b.w * b.h);
            for (let y = b.y; y < b.y + b.h && y < maskToUse.height; y++) {
              const rOff = y * maskToUse.width;
              for (let x = b.x; x < b.x + b.w && x < maskToUse.width; x++) {
                if (maskToUse.bits[rOff + x]) totalInk++;
              }
            }
          }
          const density = totalArea > 0 ? (totalInk / totalArea) : 0.35;
          const avgH = activeGlyphBoxes.reduce((sum, b) => sum + (b?.h || 30), 0) / activeGlyphBoxes.length;
          if (density < 0.28 || avgH < 22) {
            maxErosion = 0;
          } else if (density > 0.45 && avgH >= 35) {
            maxErosion = 2;
          } else {
            maxErosion = 1;
          }
        }

        if (maskToUse && activeGlyphBoxes.length > 0 && maxErosion > 0) {
          erosionPasses = computeErosionSignatures(maskToUse, activeGlyphBoxes, maxErosion);
        } else {
          erosionPasses = [validGlyphs.map(g => g.signature)];
        }
      } else {
        erosionPasses = [validGlyphs.map(g => g.signature)];
      }

      // 2. Stage A: Multi-cut & multi-thinning matching with expanded bogus variant filter
      const isBogusVariant = (slug) => {
        const s = (slug || '').toLowerCase();
        return s.includes('outline') || s.includes('dots') || s.includes('hairline') ||
               s.includes('puddles') || s.includes('pinstripe') || s.includes('inline') ||
               s.includes('wireframe') || s.includes('sketch') || s.includes('shadow');
      };

      let bestMatchingScore = -1;
      let bestCandidatesA = [];

      for (let passIdx = 0; passIdx < erosionPasses.length; passIdx++) {
        const passSigs = erosionPasses[passIdx];
        const queryGlyphs = validGlyphs.map((g, idx) => ({
          char: g.char,
          signature: passSigs[idx]
        }));

        const rawScored = scoreAllCuts(manifest, cuts, queryGlyphs);
        const scored = rawScored.filter(c => !isBogusVariant(c.slug));
        if (scored.length > 0) {
          const threshold = (passIdx === 0) ? bestMatchingScore : (bestMatchingScore + 0.015);
          if (scored[0].score > threshold) {
            bestMatchingScore = scored[0].score;
            bestCandidatesA = scored;
            bestThinningLevel = passIdx;
          } else if (bestCandidatesA.length === 0) {
            bestMatchingScore = scored[0].score;
            bestCandidatesA = scored;
            bestThinningLevel = passIdx;
          }
        }
      }

      if (bestCandidatesA.length === 0) {
        const queryGlyphs = validGlyphs.map(g => ({ char: g.char, signature: g.signature }));
        bestCandidatesA = scoreAllCuts(manifest, cuts, queryGlyphs).filter(c => !isBogusVariant(c.slug));
      }

      if (isSentenceMode) {
        lastSentenceCandidates = bestCandidatesA;
        lastSentenceFont = bestCandidatesA[0]?.family;
      }

      // Ensure sentence prior exists if not already present
      if (!isSentenceMode && !lastSentenceCandidates && detectedWords && detectedWords.length > 1) {
        const allSentenceGlyphs = [];
        for (const w of detectedWords) {
          const gList = (w.glyphs && w.glyphs.length > 0) ? w.glyphs : (w.originalGlyphs || []);
          allSentenceGlyphs.push(...gList);
        }
        if (allSentenceGlyphs.length > 0) {
          const qG = allSentenceGlyphs.map(g => ({ char: g.char, signature: g.signature }));
          const scoredSentence = scoreAllCuts(manifest, cuts, qG).filter(c => !isBogusVariant(c.slug));
          if (scoredSentence.length > 0) {
            lastSentenceCandidates = scoredSentence;
            lastSentenceFont = scoredSentence[0].family;
          }
        }
      }

      // 3. Score composition: Empirical Bayes shrinkage and outlier protection
      let scoredFinal = [];
      let isDistinctFont = false;

      if (isSentenceMode) {
        scoredFinal = bestCandidatesA.slice(0, 40);
      } else if (lastSentenceCandidates && lastSentenceCandidates.length > 0) {
        const N = validGlyphs.length;
        const alpha = N / (N + 5);

        const topLocal = bestCandidatesA[0];
        const sentenceFontInLocal = bestCandidatesA.find(c => c.family.toLowerCase() === lastSentenceFont?.toLowerCase());
        const divergence = (topLocal && sentenceFontInLocal) ? (topLocal.score - sentenceFontInLocal.score) : 0;

        if (N >= 4 && divergence > 0.08 && topLocal.score >= 0.88) {
          isDistinctFont = true;
          scoredFinal = bestCandidatesA.slice(0, 40);
        } else {
          const sentScoreMap = new Map();
          for (const c of lastSentenceCandidates) {
            sentScoreMap.set(c.family.toLowerCase(), c.score);
          }

          const compositeList = bestCandidatesA.map(localCand => {
            const sentScore = sentScoreMap.get(localCand.family.toLowerCase()) ?? (localCand.score * 0.7);
            const compositeScore = (alpha * localCand.score) + ((1 - alpha) * sentScore);
            return {
              ...localCand,
              score: compositeScore,
              localScore: localCand.score,
              sentScore: sentScore
            };
          });

          compositeList.sort((a, b) => b.score - a.score);
          scoredFinal = compositeList.slice(0, 40);
        }
      } else {
        scoredFinal = bestCandidatesA.slice(0, 40);
      }

      // Stage B: Deterministic Optical Match Ranking & Verification
      if (progressBar) progressBar.style.width = '85%';
      if (stepTitle) stepTitle.textContent = 'STAGE B: RANKING & VERIFICATION';
      if (stepDetail) stepDetail.textContent = `Ranking optical matches for "${verifiedWordText}" across 1,935 Google Fonts...`;
      await new Promise(r => setTimeout(r, 40));
      if (thisRunId !== pipelineSequence) return;

      const topScore = scoredFinal[0]?.score ?? 0.8;
      const medianScore = scoredFinal[Math.floor(scoredFinal.length / 2)]?.score ?? 0.5;
      const denom = Math.max(topScore - medianScore, 1e-6);
      const scoreMargin = Math.max(0, topScore - (scoredFinal[1]?.score ?? 0.7));

      const rankedFormatted = scoredFinal.map((c, idx) => {
        let conf = Math.max(0, Math.min(100, Math.round(((c.score - medianScore) / denom) * 100)));
        if (idx === 0) {
          conf = Math.max(88, Math.min(99, conf));
        } else {
          conf = Math.max(35, Math.min(conf, 96 - (idx * 2)));
        }

        let confidenceLabel = 'Good Match';
        if (isSentenceMode) {
          confidenceLabel = 'Sentence Consensus Match';
        } else if (isDistinctFont) {
          confidenceLabel = 'Distinct Font Detected';
        } else if (conf >= 92 && scoreMargin >= 0.035) {
          confidenceLabel = 'Exact / Near-Exact Match';
        } else if (conf >= 84) {
          confidenceLabel = 'High Confidence';
        } else if (scoreMargin < 0.02 || conf < 75) {
          confidenceLabel = 'Close / Competitive Match';
        }

        const matchedFontObj = fontsCatalog.find(f => f.family.toLowerCase() === c.family.toLowerCase()) || {
          family: c.family,
          category: c.category,
          designer: 'Google Fonts',
          googleFontsUrl: `https://fonts.google.com/specimen/${encodeURIComponent(c.family).replace(/%20/g, '+')}`
        };

        return {
          family: c.family,
          font: matchedFontObj,
          category: c.category,
          confidence: conf,
          confidenceLabel,
          weight: c.weight === 'bold' ? 700 : 400,
          scoreMargin: idx === 0 ? scoreMargin : undefined,
          thinningLevel: bestThinningLevel
        };
      });

      const detectionResult = {
        primary: rankedFormatted[0],
        runnersUp: rankedFormatted.slice(1, 4),
        allTopMatches: rankedFormatted.slice(0, 6),
        meta: {
          isSentenceMode,
          isDistinctFont,
          parentSentenceFont: lastSentenceFont,
          letterCount: validGlyphs.length,
          wordText: verifiedWordText
        },
        traits: {
          classification: rankedFormatted[0].category,
          serifType: rankedFormatted[0].category === 'serif' ? 'bracketed' : 'none',
          proportions: 'regular',
          contrast: 'medium',
          weight: rankedFormatted[0].weight,
          scoreMargin
        }
      };

      if (thisRunId !== pipelineSequence) return;
      displayResults(detectionResult, representativeThumb, verifiedWordText, detectionResult.meta);
    }

    async function executeAnalysis(progressBar, stepTitle, stepDetail) {
      const offscreen = document.createElement('canvas');
      const offCtx = offscreen.getContext('2d');

      let sourceX = 0;
      let sourceY = 0;
      let sourceW = cropCanvas.width;
      let sourceH = cropCanvas.height;

      // Extract at high resolution directly from source image when available
      const origW = (currentImage && (currentImage.naturalWidth || currentImage.width)) || cropCanvas.width;
      const origH = (currentImage && (currentImage.naturalHeight || currentImage.height)) || cropCanvas.height;
      const hasCrop = cropBox && cropBox.w > 10 && cropBox.h > 10;

      if (hasCrop) {
        const scaleX = origW / cropCanvas.width;
        const scaleY = origH / cropCanvas.height;
        sourceX = Math.round(cropBox.x * scaleX);
        sourceY = Math.round(cropBox.y * scaleY);
        sourceW = Math.round(cropBox.w * scaleX);
        sourceH = Math.round(cropBox.h * scaleY);
      } else {
        sourceX = 0;
        sourceY = 0;
        sourceW = origW;
        sourceH = origH;
      }

      // Clamp coordinates to image boundaries
      sourceX = Math.max(0, Math.min(origW - 1, sourceX));
      sourceY = Math.max(0, Math.min(origH - 1, sourceY));
      sourceW = Math.max(1, Math.min(origW - sourceX, sourceW));
      sourceH = Math.max(1, Math.min(origH - sourceY, sourceH));

      // Standardize analysis offscreen canvas resolution (crisp glyph rendering)
      offscreen.width = Math.min(1000, Math.max(200, sourceW));
      offscreen.height = Math.round((offscreen.width / sourceW) * sourceH);
      if (offscreen.height > 500) {
        offscreen.height = 500;
        offscreen.width = Math.round((offscreen.height / sourceH) * sourceW);
      }

      const drawSource = currentImage || cropCanvas;
      offCtx.drawImage(
        drawSource,
        sourceX, sourceY, sourceW, sourceH,
        0, 0, offscreen.width, offscreen.height
      );

      const croppedDataUrl = offscreen.toDataURL('image/png');
      const imgData = offCtx.getImageData(0, 0, offscreen.width, offscreen.height);
      const knownText = (cropTextInput && cropTextInput.value.trim()) || (compareTextInput && compareTextInput.value.trim()) || currentSampleText || '';

      let activeCatalog = (fullCatalog && fullCatalog.length > 100) ? fullCatalog : fontsCatalog;
      if (activeCatalog.length < 100) {
        try {
          const res = await fetch('/data/google-fonts-catalog.json');
          const data = await res.json();
          if (Array.isArray(data) && data.length > 100) {
            fullCatalog = data;
            activeCatalog = fullCatalog;
          }
        } catch (e) {}
      }
      const count = activeCatalog.length;

      if (progressBar) {
        progressBar.style.width = '30%';
        stepTitle.textContent = 'COMPARING LETTER SHAPES';
        stepDetail.textContent = `Matching against ${count.toLocaleString()} fonts in your browser...`;
      }

      // Load signature database and preload benchmark fonts concurrently
      const [sigDb, fontsLoaded] = await Promise.all([
        loadSignatureDb(),
        preloadAllFonts(fontsCatalog)
      ]);

      if (progressBar) {
        progressBar.style.width = '70%';
        stepTitle.textContent = 'STAGE A: 16×16 GLYPH FINGERPRINT MATCHING';
        stepDetail.textContent = `Evaluating letter contours across ${count.toLocaleString()} fonts...`;
      }

      await new Promise(r => setTimeout(r, 60));

      if (progressBar) {
        progressBar.style.width = '95%';
        stepTitle.textContent = 'STAGE B: RANKING CANDIDATES';
        stepDetail.textContent = 'Ranking closest Google Fonts matches...';
      }

      const result = analyzePixelsInBrowser(imgData, knownText, fontsLoaded, activeCatalog, sigDb);
      displayResults(result, croppedDataUrl);
    }

    // Session-level cache so fonts are only loaded once per page session
    let _fontsLoadedCache = null;

    // Pre-load all catalog fonts and return a Set of successfully loaded family names
    async function preloadAllFonts(catalog) {
      // Return cached result if already computed this session
      if (_fontsLoadedCache !== null) {
        console.log(`[FontFinder] Using cached font set: ${_fontsLoadedCache.size} loaded`);
        return _fontsLoadedCache;
      }

      const loaded = new Set();
      const PROBE_TEXT = 'Handgloves';
      const PROBE_SIZE = '32px';

      // Inject all Google Font stylesheets at once
      const bulkUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Roboto:wght@400;700&family=Montserrat:wght@400;700&family=Poppins:wght@400;700&family=Plus+Jakarta+Sans:wght@400;700&family=DM+Sans:wght@400;700&family=Manrope:wght@400;700&family=Open+Sans:wght@400;700&family=Lato:wght@400;700&family=Raleway:wght@400;700&family=Nunito:wght@400;700&family=Oswald:wght@400;700&family=Playfair+Display:wght@400;700&family=Merriweather:wght@400;700&family=Lora:wght@400;700&family=EB+Garamond:wght@400;700&family=Cinzel:wght@400;700&family=Cormorant+Garamond:wght@400;700&family=JetBrains+Mono:wght@400;700&family=Space+Mono:wght@400;700&family=Fira+Code:wght@400;700&family=Bebas+Neue:wght@400&family=Anton:wght@400&family=Pacifico:wght@400&family=Caveat:wght@400;700&family=Space+Grotesk:wght@400;700&family=Syne:wght@400;700&family=Outfit:wght@400;700&family=Work+Sans:wght@400;700&display=swap';

      // Add stylesheet if not already added
      const existingLink = document.getElementById('bulk-font-preload');
      if (!existingLink) {
        const link = document.createElement('link');
        link.id = 'bulk-font-preload';
        link.rel = 'stylesheet';
        link.href = bulkUrl;
        document.head.appendChild(link);
      }

      // Wait for document.fonts to process the new stylesheet (max 5s)
      try {
        await Promise.race([
          document.fonts.ready,
          new Promise(r => setTimeout(r, 5000))
        ]);
      } catch (e) {}

      // Verify each font individually
      await Promise.all(catalog.map(async (font) => {
        try {
          const spec = `${PROBE_SIZE} "${font.family}"`;
          await Promise.race([
            document.fonts.load(spec, PROBE_TEXT),
            new Promise(r => setTimeout(r, 2500))
          ]);
          // Confirm the font is actually the right one (not fallback)
          // by checking if measureText differs from generic fallback
          const probeCanvas = document.createElement('canvas');
          const probeCtx = probeCanvas.getContext('2d');
          probeCanvas.width = 300; probeCanvas.height = 50;

          probeCtx.font = `400 ${PROBE_SIZE} sans-serif`;
          const fallbackW = probeCtx.measureText(PROBE_TEXT).width;

          probeCtx.font = `400 ${PROBE_SIZE} "${font.family}", sans-serif`;
          const fontW = probeCtx.measureText(PROBE_TEXT).width;

          // If width differs by >= 0.5px OR the font is a monospace (always distinct) OR serif
          if (Math.abs(fontW - fallbackW) >= 0.5 || font.category === 'monospace' || font.category === 'handwriting') {
            loaded.add(font.family);
          }
        } catch (e) {
          // Font load failed
        }
      }));

      console.log(`[FontFinder] Fonts loaded: ${loaded.size}/${catalog.length}`, [...loaded]);
      // Only cache if we successfully loaded a meaningful number of fonts
      // (prevents bad network responses from permanently disabling glyph comparison)
      if (loaded.size >= Math.floor(catalog.length * 0.35)) {
        _fontsLoadedCache = loaded;
      }
      return loaded;
    }


    function analyzePixelsInBrowser(pixels, knownText, fontsLoaded, targetCatalog, sigDb) {
      const { width, height, data } = pixels;
      const totalPixels = width * height;
      const grayscale = new Uint8Array(totalPixels);

      // 1. Grayscale luminance & histogram
      const hist = new Int32Array(256);
      let sumLum = 0;
      for (let i = 0; i < totalPixels; i++) {
        const idx = i * 4;
        const lum = Math.round(0.2126 * data[idx] + 0.7152 * data[idx + 1] + 0.0722 * data[idx + 2]);
        grayscale[i] = lum;
        hist[lum]++;
        sumLum += lum;
      }
      const avgLum = sumLum / Math.max(1, totalPixels);

      // 2. Robust polarity detection: Check 4 corners & outer borders for background
      let cornerLum = 0;
      let cornerCount = 0;
      const cornerSize = Math.min(8, Math.floor(width / 4), Math.floor(height / 4));
      for (let cy = 0; cy < cornerSize; cy++) {
        for (let cx = 0; cx < cornerSize; cx++) {
          cornerLum += grayscale[cy * width + cx];
          cornerLum += grayscale[cy * width + (width - 1 - cx)];
          cornerLum += grayscale[(height - 1 - cy) * width + cx];
          cornerLum += grayscale[(height - 1 - cy) * width + (width - 1 - cx)];
          cornerCount += 4;
        }
      }
      const avgCorner = cornerCount > 0 ? (cornerLum / cornerCount) : avgLum;
      const isLightOnDark = avgCorner < 128;

      // 3. Otsu-based thresholding preserving hairlines
      let sumAll = 0;
      for (let t = 0; t < 256; t++) sumAll += t * hist[t];
      let sumB = 0;
      let wB = 0;
      let varMax = 0;
      let threshold = Math.round(avgLum);
      for (let t = 0; t < 256; t++) {
        wB += hist[t];
        if (wB === 0) continue;
        const wF = totalPixels - wB;
        if (wF === 0) break;
        sumB += t * hist[t];
        const mB = sumB / wB;
        const mF = (sumAll - sumB) / wF;
        const varBetween = wB * wF * (mB - mF) * (mB - mF);
        if (varBetween > varMax) {
          varMax = varBetween;
          threshold = t;
        }
      }
      if (threshold < 35) threshold = 45;
      if (threshold > 225) threshold = 210;

      const binary = new Uint8Array(totalPixels);
      for (let i = 0; i < totalPixels; i++) {
        const lum = grayscale[i];
        const isInk = isLightOnDark ? (lum > threshold) : (lum < threshold);
        binary[i] = isInk ? 1 : 0;
      }

      // 4. Find vertical text bounds
      const rowDensity = new Float32Array(height);
      for (let y = 0; y < height; y++) {
        let count = 0;
        const offset = y * width;
        for (let x = 0; x < width; x++) {
          if (binary[offset + x] === 1) count++;
        }
        rowDensity[y] = count;
      }

      let textTop = 0;
      let textBottom = height - 1;
      const minRowInk = Math.max(2, Math.round(width * 0.01));
      for (let y = 0; y < height; y++) {
        if (rowDensity[y] >= minRowInk) { textTop = y; break; }
      }
      for (let y = height - 1; y >= 0; y--) {
        if (rowDensity[y] >= minRowInk) { textBottom = y; break; }
      }
      const textH = Math.max(12, textBottom - textTop + 1);

      // 5. Isolate glyph bounding boxes via 8-connected components (preserves crossbars & letter integrity)
      const visited = new Uint8Array(width * height);
      const rawGlyphBoxes = [];
      const queue = new Int32Array(width * height);

      for (let y = textTop; y <= textBottom; y++) {
        const yOffset = y * width;
        for (let x = 0; x < width; x++) {
          const idx = yOffset + x;
          if (binary[idx] === 1 && visited[idx] === 0) {
            let minX = x, maxX = x, minY = y, maxY = y;
            let inkCount = 0;
            let qHead = 0, qTail = 0;
            queue[qTail++] = idx;
            visited[idx] = 1;

            while (qHead < qTail) {
              const cur = queue[qHead++];
              inkCount++;
              const cx = cur % width;
              const cy = (cur / width) | 0;

              if (cx < minX) minX = cx;
              if (cx > maxX) maxX = cx;
              if (cy < minY) minY = cy;
              if (cy > maxY) maxY = cy;

              for (let dy = -1; dy <= 1; dy++) {
                const ny = cy + dy;
                if (ny < textTop || ny > textBottom) continue;
                const nRow = ny * width;
                for (let dx = -1; dx <= 1; dx++) {
                  if (dx === 0 && dy === 0) continue;
                  const nx = cx + dx;
                  if (nx < 0 || nx >= width) continue;
                  const nidx = nRow + nx;
                  if (binary[nidx] === 1 && visited[nidx] === 0) {
                    visited[nidx] = 1;
                    queue[qTail++] = nidx;
                  }
                }
              }
            }

            const gw = maxX - minX + 1;
            const gh = maxY - minY + 1;
            // Filter out noise specks (< 6 pixels ink)
            if (inkCount >= 6 && gw >= 2 && gh >= 3) {
              rawGlyphBoxes.push({ x: minX, y: minY, w: gw, h: gh, inkCount });
            }
          }
        }
      }

      // Sort by x
      rawGlyphBoxes.sort((a, b) => a.x - b.x);

      // Smart component merging: handles i, j, !, ?, :, accents, and slightly slanted dots
      const dotHeightThresh = textH * 0.38;
      const mergeGapThresh = textH * 0.45;
      const horizTol = Math.max(3, textH * 0.18);
      const glyphBoxes = [];
      const merged = new Uint8Array(rawGlyphBoxes.length);

      for (let i = 0; i < rawGlyphBoxes.length; i++) {
        if (merged[i]) continue;
        const a = rawGlyphBoxes[i];
        if (a.h <= dotHeightThresh) {
          let bestJ = -1, bestDist = Infinity;
          for (let j = 0; j < rawGlyphBoxes.length; j++) {
            if (i === j || merged[j]) continue;
            const b = rawGlyphBoxes[j];
            // Check horizontal overlap with slant tolerance
            const xOverlap = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x) + horizTol;
            if (xOverlap <= 0) continue;

            // Check vertical distance (either a above b or b above a)
            const yDist = Math.max(0, Math.max(a.y, b.y) - Math.min(a.y + a.h, b.y + b.h));
            if (yDist <= mergeGapThresh && yDist < bestDist) {
              bestDist = yDist;
              bestJ = j;
            }
          }
          if (bestJ >= 0) {
            const b = rawGlyphBoxes[bestJ];
            const mx = Math.min(a.x, b.x);
            const my = Math.min(a.y, b.y);
            rawGlyphBoxes[bestJ] = {
              x: mx, y: my,
              w: Math.max(a.x + a.w, b.x + b.w) - mx,
              h: Math.max(a.y + a.h, b.y + b.h) - my,
              inkCount: a.inkCount + b.inkCount
            };
            merged[i] = 1;
            continue;
          }
        }
        glyphBoxes.push(a);
      }
      glyphBoxes.sort((a, b) => a.x - b.x);
      if (glyphBoxes.length > 35) glyphBoxes.length = 35;

      function getPercentile(arr, p, defaultVal) {
        if (!arr || arr.length === 0) return defaultVal;
        const sorted = arr.slice().sort((a, b) => a - b);
        const idx = Math.min(sorted.length - 1, Math.max(0, Math.floor(sorted.length * p)));
        return sorted[idx] !== undefined ? sorted[idx] : defaultVal;
      }

      // 6. Measure Vertical Stems vs Horizontal Bars
      const stemRuns = [];
      const barRuns = [];

      for (const g of glyphBoxes) {
        const yStart = Math.round(g.y + g.h * 0.30);
        const yEnd = Math.round(g.y + g.h * 0.70);
        for (let y = yStart; y <= yEnd; y += 2) {
          let run = 0;
          for (let x = g.x; x < g.x + g.w; x++) {
            if (binary[y * width + x] === 1) {
              run++;
            } else {
              if (run >= 1 && run <= g.w * 0.75) stemRuns.push(run);
              run = 0;
            }
          }
          if (run >= 1 && run <= g.w * 0.75) stemRuns.push(run);
        }

        // Measure vertical runs for bars in the inner 60% of the glyph to avoid edge fringe pixels
        const xStart = Math.round(g.x + g.w * 0.20);
        const xEnd = Math.round(g.x + g.w * 0.80);
        for (let x = xStart; x <= xEnd; x += 2) {
          let vrun = 0;
          for (let y = g.y; y < g.y + g.h; y++) {
            if (binary[y * width + x] === 1) {
              vrun++;
            } else {
              if (vrun >= 1 && vrun <= g.h * 0.55) barRuns.push(vrun);
              vrun = 0;
            }
          }
          if (vrun >= 1 && vrun <= g.h * 0.55) barRuns.push(vrun);
        }
      }

      // 75th percentile for primary vertical stem (avoids hairline collapse)
      const primaryStem = getPercentile(stemRuns, 0.75, 3);
      // 45th percentile captures true horizontal bar thickness without edge fringe noise
      const medianBar = getPercentile(barRuns.length > 0 ? barRuns : stemRuns, 0.45, 2);
      const contrastRatio = medianBar > 0 ? (primaryStem / medianBar) : 1.0;

      // 7. Selective straight-stem baseline foot detection (local stem flaring)
      let serifStemsCount = 0;
      let stemsAnalyzed = 0;

      for (const g of glyphBoxes) {
        if (g.w < 5 || g.h < 10) continue;

        const y1 = Math.round(g.y + g.h * 0.65);
        const y2 = Math.round(g.y + g.h * 0.80);
        const baseY = Math.round(g.y + g.h * 0.93);

        // Scan runs at y1
        const runs1 = [];
        let cS1 = -1;
        for (let x = g.x; x < g.x + g.w; x++) {
          if (binary[y1 * width + x] === 1) {
            if (cS1 === -1) cS1 = x;
          } else if (cS1 !== -1) {
            runs1.push({ s: cS1, e: x - 1, w: x - cS1 });
            cS1 = -1;
          }
        }
        if (cS1 !== -1) runs1.push({ s: cS1, e: g.x + g.w - 1, w: g.x + g.w - cS1 });

        // Scan runs at y2
        const runs2 = [];
        let cS2 = -1;
        for (let x = g.x; x < g.x + g.w; x++) {
          if (binary[y2 * width + x] === 1) {
            if (cS2 === -1) cS2 = x;
          } else if (cS2 !== -1) {
            runs2.push({ s: cS2, e: x - 1, w: x - cS2 });
            cS2 = -1;
          }
        }
        if (cS2 !== -1) runs2.push({ s: cS2, e: g.x + g.w - 1, w: g.x + g.w - cS2 });

        // Check if there is a vertical straight stem matching at y1 and y2
        for (const r1 of runs1) {
          if (r1.w < 2 || r1.w > g.w * 0.55) continue;
          const match2 = runs2.find(r2 => Math.abs(r1.s - r2.s) <= 2.5 && Math.abs(r1.w - r2.w) <= 2.5);
          if (!match2) continue;

          const stemStart = (r1.s + match2.s) / 2;
          const stemEnd = (r1.e + match2.e) / 2;
          const stemW = stemEnd - stemStart + 1;

          // Check baseline foot at baseY
          let baseStart = -1, baseEnd = -1;
          for (let x = g.x; x < g.x + g.w; x++) {
            if (binary[baseY * width + x] === 1) {
              const bS = x;
              while (x < g.x + g.w && binary[baseY * width + x] === 1) x++;
              const bE = x - 1;
              if (bS <= stemEnd && bE >= stemStart) {
                baseStart = bS;
                baseEnd = bE;
                break;
              }
            }
          }

          if (baseStart !== -1) {
            stemsAnalyzed++;
            const leftFlare = stemStart - baseStart;
            const rightFlare = baseEnd - stemEnd;
            const baseW = baseEnd - baseStart + 1;
            const isBilateral = leftFlare >= 1.2 && rightFlare >= 1.2 && (Math.min(leftFlare, rightFlare) / Math.max(leftFlare, rightFlare) >= 0.20);
            if (isBilateral && baseW >= stemW * 1.25) {
              serifStemsCount++;
            }
          }
        }
      }

      const serifRatio = stemsAnalyzed > 0 ? (serifStemsCount / stemsAnalyzed) : 0;

      // 8. Aspect Ratio & Monospace
      let avgAspect = 0.62;
      if (glyphBoxes.length >= 3) {
        const aspects = glyphBoxes.map(g => g.w / g.h);
        avgAspect = aspects.reduce((a, b) => a + b, 0) / aspects.length;
      }

      // Robust Monospace check: monospace fonts have low width variance and small widthSpread
      const letterGlyphs = glyphBoxes.filter(g => g.h >= textH * 0.35 && g.w >= 4);
      let isMonospace = false;
      if (letterGlyphs.length >= 4) {
        const widths = letterGlyphs.map(g => g.w).sort((a, b) => a - b);
        const p10 = widths[Math.floor(widths.length * 0.10)];
        const p90 = widths[Math.floor(widths.length * 0.90)];
        const widthSpread = p10 > 0 ? (p90 / p10) : 3.0;

        const avgW = widths.reduce((a, b) => a + b, 0) / widths.length;
        const variance = widths.reduce((a, b) => a + Math.pow(b - avgW, 2), 0) / widths.length;
        const relWidthStdDev = Math.sqrt(variance) / Math.max(1, avgW);

        if (relWidthStdDev < 0.18 && widthSpread <= 1.35) {
          isMonospace = true;
        }
      }

      // Slant & Handwriting Detection:
      // 1. Measure left-edge slope of stems (immune to right-hand loops in 'P', 'R', 'B')
      // 2. Scan vertical stroke slices for wide connected cursive boxes
      const slantAngles = [];
      for (const g of glyphBoxes) {
        if (g.w < 6 || g.h < 14) continue;
        if (g.w > g.h * 1.2) {
          // Wide connected box: sweep slices of width 0.4 * g.h
          const sliceW = Math.max(6, Math.round(g.h * 0.40));
          for (let sx = g.x; sx < g.x + g.w - sliceW; sx += Math.round(sliceW * 0.75)) {
            const yTop = Math.round(g.y + g.h * 0.25);
            const yBot = Math.round(g.y + g.h * 0.75);
            let sTop = -1, sBot = -1;
            for (let x = sx; x < sx + sliceW; x++) {
              if (binary[yTop * width + x] === 1 && sTop < 0) sTop = x;
              if (binary[yBot * width + x] === 1 && sBot < 0) sBot = x;
              if (sTop >= 0 && sBot >= 0) break;
            }
            if (sTop >= 0 && sBot >= 0) {
              const dx = sTop - sBot;
              const dy = yBot - yTop;
              const angle = Math.atan2(dx, dy) * (180 / Math.PI);
              if (angle > -15 && angle < 45) {
                slantAngles.push(angle);
              }
            }
          }
        } else {
          // Standard glyph: measure leftmost stem edge with 3-point collinearity check
          // to ensure we only measure straight vertical/italic stems and ignore curved curves (e.g. '2', 'S', 'O')
          const yTop = Math.round(g.y + g.h * 0.30);
          const yMid = Math.round(g.y + g.h * 0.50);
          const yBot = Math.round(g.y + g.h * 0.70);
          let leftTop = -1, leftMid = -1, leftBot = -1;
          for (let x = g.x; x < g.x + g.w; x++) {
            if (binary[yTop * width + x] === 1 && leftTop < 0) leftTop = x;
            if (binary[yMid * width + x] === 1 && leftMid < 0) leftMid = x;
            if (binary[yBot * width + x] === 1 && leftBot < 0) leftBot = x;
            if (leftTop >= 0 && leftMid >= 0 && leftBot >= 0) break;
          }
          if (leftTop >= 0 && leftMid >= 0 && leftBot >= 0) {
            const expMid = (leftTop + leftBot) / 2;
            if (Math.abs(leftMid - expMid) <= 1.2) {
              const dx = leftTop - leftBot;
              const dy = yBot - yTop;
              const angle = Math.atan2(dx, dy) * (180 / Math.PI);
              if (angle > -10 && angle < 45) {
                slantAngles.push(angle);
              }
            }
          }
        }
      }
      slantAngles.sort((a, b) => a - b);
      const avgSlant = slantAngles.length > 0 ? slantAngles[Math.floor(slantAngles.length * 0.5)] : 0;

      // Cursive connected component detection
      const wideConnectedCount = glyphBoxes.filter(g => (g.w / g.h) >= 1.8).length;
      const isCursiveConnected = (wideConnectedCount >= 2 && avgSlant >= 2.5) ||
                                 (wideConnectedCount >= 1 && glyphBoxes.length <= 4 && avgSlant >= 3.0) ||
                                 (knownText && knownText.length >= 6 && glyphBoxes.length <= Math.ceil(knownText.length * 0.45) && avgSlant >= 3.0);

      // Upright print fonts with serifs, stroke contrast, or code syntax MUST NEVER trigger handwriting
      const isPrintWithSerifOrContrast = (serifRatio >= 0.12 || contrastRatio >= 1.6);
      const isCodeSnippet = knownText && (/[;{}()=>]/.test(knownText) || /\b(fn|const|let|var|def|class|import)\b/.test(knownText));
      const isHandwriting = !isPrintWithSerifOrContrast && !isMonospace && !isCodeSnippet && ((avgSlant >= 4.5 && serifRatio < 0.10) || (isCursiveConnected && avgSlant >= 3.0));

      // 9. Trait classification
      let contrast = 'low';
      if (contrastRatio >= 1.9) contrast = 'high';
      else if (contrastRatio >= 1.35) contrast = 'medium';
      else if (contrastRatio >= 1.15) contrast = 'low';
      else contrast = 'none';

      let serifType = 'none';
      let classification = 'sans-serif';

      if (isHandwriting) {
        classification = 'handwriting';
        serifType = 'none';
        contrast = 'low';
      } else if (isMonospace) {
        classification = 'monospace';
        serifType = 'none';
        contrast = 'none';
      } else if (serifRatio >= 0.18 || contrastRatio >= 1.75 || (contrast === 'high' && (serifRatio >= 0.12 || contrastRatio >= 2.0))) {
        classification = 'serif';
        serifType = contrastRatio >= 2.2 ? 'hairline' : 'bracketed';
      } else if (avgAspect < 0.54 && (primaryStem / textH) > 0.12) {
        classification = 'display';
        serifType = 'none';
        contrast = 'low';
      } else {
        classification = 'sans-serif';
        serifType = 'none';
      }

      // All-caps aspect ratio compensation
      const isAllCaps = (knownText && knownText.trim().length >= 3 && knownText === knownText.toUpperCase() && /[A-Z]/.test(knownText));
      const condThresh = isAllCaps ? 0.62 : 0.52;
      const geomThresh = isAllCaps ? 0.78 : 0.72;

      let proportions = 'regular';
      if (avgAspect < condThresh) proportions = 'condensed';
      else if (avgAspect >= geomThresh) proportions = 'geometric';

      const stemRatio = primaryStem / textH;
      let weight = 400;
      if (contrast === 'high') {
        weight = stemRatio > 0.13 ? 700 : (stemRatio > 0.10 ? 600 : 400);
      } else {
        if (stemRatio > 0.17) weight = 700;
        else if (stemRatio > 0.13) weight = 600;
        else if (stemRatio < 0.07) weight = 300;
        else weight = 400;
      }
      // 10. Multi-Resolution Glyph Extraction & Comparison Utilities
      function detectEnclosedCounter(bin, imgW, gx, gy, gw, gh) {
        if (gw < 6 || gh < 6) return false;
        const visited = new Uint8Array(gw * gh);
        const queue = [];
        for (let x = 0; x < gw; x++) {
          if (bin[gy * imgW + (gx + x)] === 0) { visited[x] = 1; queue.push(x); }
          const bRow = (gh - 1) * gw;
          if (bin[(gy + gh - 1) * imgW + (gx + x)] === 0 && visited[bRow + x] === 0) { visited[bRow + x] = 1; queue.push(bRow + x); }
        }
        for (let y = 1; y < gh - 1; y++) {
          const row = y * gw;
          if (bin[(gy + y) * imgW + gx] === 0 && visited[row] === 0) { visited[row] = 1; queue.push(row); }
          if (bin[(gy + y) * imgW + (gx + gw - 1)] === 0 && visited[row + gw - 1] === 0) { visited[row + gw - 1] = 1; queue.push(row + gw - 1); }
        }
        let head = 0;
        while (head < queue.length) {
          const curr = queue[head++];
          const cy = Math.floor(curr / gw);
          const cx = curr % gw;
          const neighbors = [cx > 0 ? curr - 1 : -1, cx < gw - 1 ? curr + 1 : -1, cy > 0 ? curr - gw : -1, cy < gh - 1 ? curr + gw : -1];
          for (const nb of neighbors) {
            if (nb >= 0 && visited[nb] === 0) {
              const ny = Math.floor(nb / gw);
              const nx = nb % gw;
              if (bin[(gy + ny) * imgW + (gx + nx)] === 0) { visited[nb] = 1; queue.push(nb); }
            }
          }
        }
        let unreached = 0;
        const mx = Math.max(1, Math.floor(gw * 0.15));
        const my = Math.max(1, Math.floor(gh * 0.15));
        for (let y = my; y < gh - my; y++) {
          for (let x = mx; x < gw - mx; x++) {
            if (bin[(gy + y) * imgW + (gx + x)] === 0 && visited[y * gw + x] === 0) unreached++;
          }
        }
        return unreached >= 4;
      }

      function normalizeSubGrid(bin, imgW, gx, gy, gw, gh, targetSize) {
        const result = new Uint8Array(targetSize * targetSize);
        const margin = Math.max(2, Math.round(targetSize * 0.05));
        const maxInner = targetSize - margin * 2;
        const scale = Math.min(maxInner / gw, maxInner / gh);
        const nw = Math.max(1, Math.round(gw * scale));
        const nh = Math.max(1, Math.round(gh * scale));
        const offsetX = Math.floor((targetSize - nw) / 2);
        const offsetY = Math.floor((targetSize - nh) / 2);

        for (let ty = 0; ty < nh; ty++) {
          const sy = Math.min(gh - 1, Math.floor(ty / scale));
          const targetRow = (offsetY + ty) * targetSize;
          const srcRow = (gy + sy) * imgW;
          for (let tx = 0; tx < nw; tx++) {
            const sx = Math.min(gw - 1, Math.floor(tx / scale));
            if (bin[srcRow + gx + sx] === 1) {
              result[targetRow + offsetX + tx] = 1;
            }
          }
        }
        return result;
      }

      function extractProfiles(bitmap, size) {
        const horiz = new Float32Array(16);
        const vert = new Float32Array(16);
        const binSize = size / 16;
        for (let y = 0; y < size; y++) {
          const yBin = Math.min(15, Math.floor(y / binSize));
          const rOff = y * size;
          for (let x = 0; x < size; x++) {
            if (bitmap[rOff + x] === 1) {
              const xBin = Math.min(15, Math.floor(x / binSize));
              horiz[yBin]++;
              vert[xBin]++;
            }
          }
        }
        let hMax = 0, vMax = 0;
        for (let i = 0; i < 16; i++) {
          if (horiz[i] > hMax) hMax = horiz[i];
          if (vert[i] > vMax) vMax = vert[i];
        }
        if (hMax > 0) for (let i = 0; i < 16; i++) horiz[i] /= hMax;
        if (vMax > 0) for (let i = 0; i < 16; i++) vert[i] /= vMax;
        return { horiz, vert };
      }

      function compareGlyphs(a, b) {
        let inter64 = 0, union64 = 0;
        for (let i = 0; i < 4096; i++) {
          const va = a.bitmap64[i];
          const vb = b.bitmap64[i];
          if (va === 1 && vb === 1) inter64++;
          if (va === 1 || vb === 1) union64++;
        }
        const iou64 = union64 > 0 ? inter64 / union64 : 1.0;

        let inter128 = 0, union128 = 0;
        for (let i = 0; i < 16384; i++) {
          const va = a.bitmap128[i];
          const vb = b.bitmap128[i];
          if (va === 1 && vb === 1) inter128++;
          if (va === 1 || vb === 1) union128++;
        }
        const iou128 = union128 > 0 ? inter128 / union128 : 1.0;
        const multiResIoU = 0.40 * iou64 + 0.60 * iou128;

        let dotH = 0, magHa = 0, magHb = 0;
        let dotV = 0, magVa = 0, magVb = 0;
        for (let i = 0; i < 16; i++) {
          const ha = a.profile.horiz[i];
          const hb = b.profile.horiz[i];
          dotH += ha * hb; magHa += ha * ha; magHb += hb * hb;
          const va = a.profile.vert[i];
          const vb = b.profile.vert[i];
          dotV += va * vb; magVa += va * va; magVb += vb * vb;
        }
        const cosH = (magHa > 0 && magHb > 0) ? dotH / (Math.sqrt(magHa) * Math.sqrt(magHb)) : 0.8;
        const cosV = (magVa > 0 && magVb > 0) ? dotV / (Math.sqrt(magVa) * Math.sqrt(magVb)) : 0.8;
        const profileSim = 0.50 * cosH + 0.50 * cosV;

        const counterSim = (a.hasEnclosedCounter === b.hasEnclosedCounter) ? 1.0 : 0.65;
        const aspectSim = Math.max(0, 1.0 - Math.abs(a.aspectRatio - b.aspectRatio) * 1.5);

        return 0.45 * multiResIoU + 0.25 * profileSim + 0.15 * counterSim + 0.15 * aspectSim;
      }

      const glyphSignatures = glyphBoxes.map((g) => {
        let inkCount = 0;
        for (let y = g.y; y < g.y + g.h; y++) {
          const row = y * width;
          for (let x = g.x; x < g.x + g.w; x++) {
            if (binary[row + x] === 1) inkCount++;
          }
        }
        const bitmap128 = normalizeSubGrid(binary, width, g.x, g.y, g.w, g.h, 128);
        const bitmap64 = normalizeSubGrid(binary, width, g.x, g.y, g.w, g.h, 64);
        const profile = extractProfiles(bitmap128, 128);
        return {
          box: g,
          aspectRatio: g.w / Math.max(1, g.h),
          density: inkCount / Math.max(1, g.w * g.h),
          hasEnclosedCounter: detectEnclosedCounter(binary, width, g.x, g.y, g.w, g.h),
          bitmap64,
          bitmap128,
          profile
        };
      });

      const DISTINCTIVE_CHARS = new Set(['a', 'e', 'g', 'f', 't', 'r', 'R', 'Q', 'M', 'W', '1', '2', '4', '6', '7', '&']);
      const glyph16Sigs = glyphBoxes.map(g => compute16x16Sig(binary, width, g));

      let activeText = (knownText || '').trim();
      let recognizedChars = [];

      // If text is not provided, perform visually grounded OCR using the 16x16 signature database
      if (!activeText && sigDb && sigDb.manifest && sigDb.regMap && glyph16Sigs.length > 0) {
        const manifest = sigDb.manifest;
        const regMap = sigDb.regMap;
        const numFonts = manifest.fonts.length;
        const bpg = manifest.bytesPerGlyph;
        const topK = Math.max(5, Math.floor(numFonts * 0.05));

        for (let gi = 0; gi < glyph16Sigs.length; gi++) {
          const sig = glyph16Sigs[gi];
          const gBox = glyphBoxes[gi];
          let bestChar = '?';
          let bestSim = -1;

          // Typographic zone filter
          let candidateChars = manifest.chars;
          if (gBox.h < textH * 0.65 && gBox.y > textTop + textH * 0.20) {
            candidateChars = 'abceimnorsuvwxz';
          }

          for (let pass = 0; pass < 2; pass++) {
            const testSet = (pass === 0) ? candidateChars : manifest.chars;
            if (pass === 1 && bestSim >= 0.72) break;

            for (let ci = 0; ci < testSet.length; ci++) {
              const ch = testSet[ci];
              const slice = regMap.get(ch);
              if (!slice) continue;

              const distances = [];
              for (let fi = 0; fi < numFonts; fi++) {
                const off = fi * bpg;
                if (isBlankSig(slice, off, bpg)) continue;
                distances.push(hammingDist(sig, slice, off));
              }
              if (distances.length === 0) continue;
              distances.sort((a, b) => a - b);
              const k = Math.min(topK, distances.length);
              let sum = 0;
              for (let ki = 0; ki < k; ki++) sum += distances[ki];
              const avg = sum / k;
              const sim = 1 - avg / 256;
              if (sim > bestSim) {
                bestSim = sim;
                bestChar = ch;
              }
            }
          }
          recognizedChars.push(bestChar);
        }
        activeText = recognizedChars.join('');
        console.log('[FontFinder] OCR Recognized Text:', activeText);

        if (cropTextInput && !cropTextInput.value.trim()) {
          cropTextInput.value = activeText;
        }
        if (compareTextInput && !compareTextInput.value.trim()) {
          compareTextInput.value = activeText;
        }
      }

      const activeCharList = activeText.split('').filter(c => !/\s/.test(c));
      const hasReliableText = activeCharList.length >= 2;

      // Sequential character mapping to glyph boxes (immune to letter duplication/skipping)
      const glyphCharAssignments = [];
      if (activeCharList.length > 0 && glyphBoxes.length > 0) {
        if (glyphBoxes.length === activeCharList.length) {
          for (let i = 0; i < glyphBoxes.length; i++) {
            glyphCharAssignments.push(activeCharList[i]);
          }
        } else {
          for (let i = 0; i < glyphBoxes.length; i++) {
            const mappedIdx = Math.min(activeCharList.length - 1, Math.floor((i / glyphBoxes.length) * activeCharList.length));
            glyphCharAssignments.push(activeCharList[mappedIdx]);
          }
        }
      }

      // Fast bitwise 16x16 signature fingerprint matching across all 1,935 catalog fonts
      const fontSigScores = new Map();
      if (sigDb && sigDb.manifest && sigDb.regMap && glyphCharAssignments.length > 0) {
        const manifest = sigDb.manifest;
        const regMap = sigDb.regMap;
        const boldMap = sigDb.boldMap;
        const numFonts = manifest.fonts.length;
        const bpg = manifest.bytesPerGlyph;

        for (let fi = 0; fi < numFonts; fi++) {
          let totalDistReg = 0;
          let totalDistBold = 0;
          let matchedChars = 0;
          const off = fi * bpg;

          for (let gi = 0; gi < glyphBoxes.length; gi++) {
            const ch = glyphCharAssignments[gi];
            const sig = glyph16Sigs[gi];
            const regSlice = regMap.get(ch);
            const boldSlice = boldMap ? boldMap.get(ch) : null;
            if (!regSlice && !boldSlice) continue;

            const isRegBlank = !regSlice || isBlankSig(regSlice, off, bpg);
            const isBoldBlank = !boldSlice || isBlankSig(boldSlice, off, bpg);
            if (isRegBlank && isBoldBlank) continue;

            const dReg = !isRegBlank ? hammingDist(sig, regSlice, off) : 256;
            const dBold = !isBoldBlank ? hammingDist(sig, boldSlice, off) : 256;

            totalDistReg += dReg;
            totalDistBold += dBold;
            matchedChars++;
          }

          if (matchedChars > 0) {
            const avgReg = totalDistReg / matchedChars;
            const avgBold = totalDistBold / matchedChars;
            const isBold = avgBold < avgReg;
            const bestDist = isBold ? avgBold : avgReg;
            const shapeScore = Math.max(0, 1 - bestDist / 256);

            const familyName = manifest.families[fi] || manifest.fonts[fi] || '';
            const key = familyName.toLowerCase();
            const fontScoreObj = {
              shapeScore,
              bestWeight: isBold ? 700 : 400
            };
            fontSigScores.set(key, fontScoreObj);
            if (manifest.fonts[fi]) {
              fontSigScores.set(manifest.fonts[fi].toLowerCase(), fontScoreObj);
            }
          }
        }
      }

      let renderCanvas = null;
      let renderCtx = null;
      if (typeof document !== 'undefined') {
        renderCanvas = document.createElement('canvas');
        renderCtx = renderCanvas.getContext('2d', { willReadFrequently: true });
      }

      // Estimate xHeightRatio from glyph heights
      // X-height glyphs (short lowercase) should cluster around x-height / textH
      // Cap-height = textH (assumed). Median short-glyph height = x-height proxy.
      let imgXHeightRatio = 0;
      if (glyphSignatures.length >= 2) {
        const shortGlyphs = glyphSignatures
          .map(g => g.box.h)
          .filter(h => h < textH * 0.95) // exclude ascenders/caps
          .sort((a, b) => a - b);
        if (shortGlyphs.length >= 1) {
          const medH = shortGlyphs[Math.floor(shortGlyphs.length * 0.5)];
          imgXHeightRatio = Math.min(0.95, Math.max(0.50, medH / textH));
        }
      }

      function getFontMetrics(f) {
        if (f.typographicMetrics) return f.typographicMetrics;
        let serif = 'none';
        if (f.stroke === 'serif') serif = 'bracketed';
        else if (f.stroke === 'slab-serif') serif = 'slab';
        else if (f.category === 'serif') serif = 'bracketed';

        let contrast = 'low';
        if (f.category === 'serif' || f.stroke === 'serif') {
          contrast = (f.thickness && f.thickness <= 4) ? 'high' : 'medium';
        } else if (f.category === 'display') {
          contrast = 'medium';
        }

        const avgAspect = 0.40 + (f.width || 6) * 0.035;
        let proportions = 'regular';
        if ((f.width || 6) <= 4) proportions = 'condensed';
        else if ((f.width || 6) >= 8) proportions = 'geometric';

        return {
          serif,
          contrast,
          avgAspect,
          proportions,
          xHeightRatio: f.category === 'display' ? 0.62 : 0.70
        };
      }

      const verifiedMap = new Map();
      for (const vf of fontsCatalog) {
        verifiedMap.set(vf.family.toLowerCase(), vf);
      }

      const catalogToSearch = (targetCatalog && targetCatalog.length > 0) ? targetCatalog : fontsCatalog;

      // STAGE 1: Fast Macro Geometry & Typographic Profile Matching across all catalog fonts (~1,946 fonts)
      const macroCandidates = catalogToSearch.map((rawFont) => {
        const verified = verifiedMap.get(rawFont.family.toLowerCase());
        const font = verified ? { ...rawFont, ...verified } : rawFont;
        const metrics = font.typographicMetrics || getFontMetrics(font);
        const cat = (font.category || 'sans-serif').toLowerCase();
        const slant = font.slant || 1;
        const thickness = font.thickness || 5;

        let geomScore = 50;
        const reasons = [];

        // Category & Script Specific Scoring
        if (classification === 'handwriting') {
          if (cat === 'handwriting') {
            geomScore += 35;
            reasons.push('Handwriting / cursive style match');
            if (avgSlant >= 4.5 && slant >= 5) {
              geomScore += 16;
              reasons.push('Cursive slant profile match');
            } else if (avgSlant >= 3 && slant >= 3) {
              geomScore += 10;
            }
            if (thickness <= 5) {
              geomScore += 8;
              reasons.push('Fine script stroke weight');
            }
          } else if (cat === 'display') {
            geomScore -= 12;
          } else {
            geomScore -= 35; // Strongly penalize sans-serif / serif so Nunito never beats script
          }
        } else if (classification === 'monospace') {
          if (cat === 'monospace') {
            geomScore += 32;
            reasons.push('Monospace fixed-pitch alignment');
          } else {
            geomScore -= 22;
          }
        } else if (classification === 'serif') {
          if (cat === 'serif') {
            geomScore += 20;
            reasons.push('Serif classification match');
          } else if (cat === 'sans-serif') {
            geomScore -= 10;
          } else {
            geomScore -= 20;
          }
        } else if (classification === 'display') {
          if (cat === 'display') {
            geomScore += 18;
            reasons.push('Display classification match');
          } else if (cat === 'sans-serif') {
            geomScore += 8;
          } else {
            geomScore -= 20;
          }
        } else {
          // sans-serif
          if (cat === 'sans-serif') {
            geomScore += 15;
            reasons.push('Sans-serif classification match');
          } else if (cat === 'display') {
            geomScore += 6;
          } else if (cat === 'handwriting') {
            geomScore -= 25;
          } else {
            geomScore -= 10;
          }
        }

        // Contrast Match (20 pts max)
        const candContrast =
          metrics.contrast === 'high' ? 3.0 :
          metrics.contrast === 'medium' ? 1.6 :
          metrics.contrast === 'low' ? 1.25 : 1.05;
        if (contrastRatio >= 2.5) {
          if (metrics.contrast === 'high') {
            geomScore += 24;
            reasons.push('High-contrast editorial profile');
          } else if (metrics.contrast === 'medium') {
            geomScore -= 8;
          } else {
            geomScore -= 18;
          }
        } else if ((contrastRatio >= 1.75 && metrics.contrast === 'high') ||
            (contrastRatio >= 1.35 && contrastRatio < 2.0 && (metrics.contrast === 'medium' || metrics.contrast === 'high')) ||
            (contrastRatio < 1.35 && (metrics.contrast === 'low' || metrics.contrast === 'none'))) {
          geomScore += 20;
          reasons.push(`${metrics.contrast} contrast profile`);
        } else {
          const contrastDiff = Math.abs(contrastRatio - candContrast);
          const contrastScore = Math.round(20 * Math.exp(-(contrastDiff * contrastDiff) / (2 * 1.2 * 1.2)));
          geomScore += contrastScore;
        }

        // Serif Terminals (Soft signals, 16 pts max)
        const isImageSerif = serifRatio >= 0.18 || contrastRatio >= 1.75 || classification === 'serif';
        let serifScore = 0;
        if (isImageSerif) {
          if (metrics.serif === 'bracketed' || metrics.serif === 'hairline') {
            serifScore = 16;
            reasons.push(`${metrics.serif} serif terminals`);
          } else if (metrics.serif === 'slab') {
            serifScore = 14;
          } else if (metrics.serif === 'subtle') {
            serifScore = 10;
          } else {
            serifScore = 4;
          }
        } else {
          if (metrics.serif === 'none') {
            serifScore = 16;
            reasons.push('Sans-serif terminal structure');
          } else if (metrics.serif === 'subtle') {
            serifScore = 12;
          } else {
            serifScore = 4;
          }
        }
        geomScore += serifScore;

        // xHeightRatio scoring (5 pts max)
        const catalogXH = metrics.xHeightRatio || 0.70;
        if (imgXHeightRatio > 0) {
          const xhDelta = Math.abs(imgXHeightRatio - catalogXH);
          geomScore += Math.max(0, 5 - Math.round(xhDelta * 30));
        }

        // Proportions & Condensed Geometry (18 pts max)
        if (proportions === 'condensed') {
          if (metrics.proportions === 'condensed' || (font.width && font.width <= 4)) {
            geomScore += 20;
            reasons.push('Condensed vertical rhythm');
          } else {
            geomScore += Math.max(0, 18 - Math.round(Math.abs(metrics.avgAspect - 0.44) * 65));
          }
        } else if (proportions === 'geometric') {
          if (metrics.proportions === 'geometric' || (font.width && font.width >= 8)) {
            geomScore += 20;
            reasons.push('Geometric wide proportions');
          } else {
            geomScore += Math.max(0, 18 - Math.round(Math.abs(metrics.avgAspect - 0.68) * 65));
          }
        } else {
          const aspectDelta = Math.abs(metrics.avgAspect - 0.61);
          geomScore += Math.max(0, 18 - Math.round(aspectDelta * 55));
        }

        // Weight match (14 pts max)
        const variants = font.variants || (font.weights ? font.weights.map(w => ({ weight: w, style: 'normal' })) : [{ weight: 400, style: 'normal' }]);
        const hasWeight = variants && variants.some(v => v.weight === weight);
        if (hasWeight) {
          geomScore += 14;
          reasons.push(`Weight ${weight} match`);
        } else if (variants && variants.length > 0) {
          const closestDelta = Math.min(...variants.map(v => Math.abs(Number(v.weight) - weight)));
          geomScore += Math.max(3, 14 - Math.round(closestDelta / 100) * 3);
        }

        // Popularity soft boost (0 to 5 points max for reputable Google Fonts)
        if (font.popularity && font.popularity > 0) {
          geomScore += Math.max(0, 5 - (font.popularity / 250));
        }

        // Curated dataset boost (3 pts)
        if (verified) {
          geomScore += 3;
        }

        // 16x16 Signature Correlation Boost: Rewards fonts that strongly align with letterforms
        const sigData = fontSigScores.get(font.family.toLowerCase()) || (font.id ? fontSigScores.get(font.id.toLowerCase()) : null);
        const sigScore = sigData ? Math.round(sigData.shapeScore * 100) : 65;
        if (sigData && sigData.shapeScore > 0.70) {
          geomScore += Math.round((sigData.shapeScore - 0.70) * 35);
        }

        // Ensure safe defaults on font object
        font.designer = font.designer || (Array.isArray(font.designers) ? font.designers.join(', ') : 'Google Fonts');
        font.googleFontsUrl = font.googleFontsUrl || `https://fonts.google.com/specimen/${encodeURIComponent(font.family).replace(/%20/g, '+')}`;
        font.id = font.id || font.family.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        font.description = font.description || `${font.family} is a free open-source font available from Google Fonts.`;
        font.typographicMetrics = metrics;
        font.variants = variants;

        return {
          font,
          family: font.family,
          geomScore: Math.round(geomScore),
          rawScore: Math.round(geomScore),
          glyphScore: sigScore,
          sigScore,
          sigWeight: sigData ? sigData.bestWeight : weight,
          weight: sigData ? sigData.bestWeight : weight,
          classification,
          serifType,
          proportions,
          contrast,
          reasons
        };
      });

      // Sort by macro geometry score
      macroCandidates.sort((a, b) => b.geomScore - a.geomScore);

      // STAGE 2: Fine Optical Glyph Comparison on Top Candidates + Loaded Benchmark Fonts
      const top35 = macroCandidates.slice(0, 35);
      const topSet = new Set(top35.map(c => c.family));
      for (let i = 35; i < Math.min(80, macroCandidates.length); i++) {
        const c = macroCandidates[i];
        if (fontsLoaded && fontsLoaded.has(c.family) && !topSet.has(c.family)) {
          top35.push(c);
          topSet.add(c.family);
        }
      }
      const topCandidates = top35;
      const otherCandidates = macroCandidates.filter(c => !topSet.has(c.family));

      topCandidates.forEach((cand) => {
        const font = cand.font;
        let glyphScore = cand.sigScore || 70;
        const fontIsLoaded = fontsLoaded && fontsLoaded.has(font.family);

        if (hasReliableText && renderCtx && renderCanvas && fontIsLoaded) {
          // MODE A: Character-Aware Isolated Glyph Matching for loaded fonts
          try {
            const activeChars = activeText.split('').filter(c => !/\s/.test(c));
            const renderFontSize = Math.max(36, Math.min(60, textH));
            const cDim = Math.max(80, Math.ceil(renderFontSize * 1.8));

            // Render each unique character in an isolated cell
            const charGlyphMap = new Map();
            const uniqueChars = Array.from(new Set(activeChars));

            for (const ch of uniqueChars) {
              renderCanvas.width = cDim;
              renderCanvas.height = cDim;
              renderCtx.fillStyle = '#ffffff';
              renderCtx.fillRect(0, 0, cDim, cDim);
              renderCtx.fillStyle = '#000000';
              renderCtx.font = `${cand.weight} ${renderFontSize}px "${font.family}", ${font.category}`;
              renderCtx.textBaseline = 'middle';
              renderCtx.textAlign = 'center';
              renderCtx.fillText(ch, cDim / 2, cDim / 2);

              const cImg = renderCtx.getImageData(0, 0, cDim, cDim);
              const cData = cImg.data;
              let minX = cDim, maxX = 0, minY = cDim, maxY = 0;
              const cBin = new Uint8Array(cDim * cDim);
              for (let y = 0; y < cDim; y++) {
                const row = y * cDim;
                for (let x = 0; x < cDim; x++) {
                  if (cData[(row + x) * 4] < 200) {
                    cBin[row + x] = 1;
                    if (x < minX) minX = x;
                    if (x > maxX) maxX = x;
                    if (y < minY) minY = y;
                    if (y > maxY) maxY = y;
                  }
                }
              }

              if (maxX >= minX && maxY >= minY) {
                const gw = maxX - minX + 1;
                const gh = maxY - minY + 1;
                charGlyphMap.set(ch, {
                  aspectRatio: gw / Math.max(1, gh),
                  hasEnclosedCounter: detectEnclosedCounter(cBin, cDim, minX, minY, gw, gh),
                  bitmap64: normalizeSubGrid(cBin, cDim, minX, minY, gw, gh, 64),
                  bitmap128: normalizeSubGrid(cBin, cDim, minX, minY, gw, gh, 128),
                  profile: extractProfiles(normalizeSubGrid(cBin, cDim, minX, minY, gw, gh, 128), 128)
                });
              }
            }

            if (charGlyphMap.size > 0 && glyphSignatures.length > 0) {
              let totalGlyphSim = 0;
              let totalWeight = 0;

              for (let i = 0; i < glyphSignatures.length; i++) {
                const upGlyph = glyphSignatures[i];
                const ch = glyphCharAssignments[i] || (glyphSignatures.length === activeChars.length ? activeChars[i] : activeChars[0]);
                const candGlyph = charGlyphMap.get(ch);
                if (candGlyph) {
                  const isDistinctive = DISTINCTIVE_CHARS.has(ch);
                  const w = isDistinctive ? 1.8 : 1.0;
                  const pairSim = compareGlyphs(upGlyph, candGlyph);
                  totalGlyphSim += pairSim * w;
                  totalWeight += w;
                }
              }

              if (totalWeight > 0) {
                const avgSim = totalGlyphSim / totalWeight;
                const renderedScore = Math.round(avgSim * 100);
                // Blend with 16x16 signature score
                glyphScore = Math.round(0.40 * (cand.sigScore || 70) + 0.60 * renderedScore);
              }
            }
          } catch (e) {
            glyphScore = cand.sigScore || 70;
          }
        }

        const normGeom = Math.min(100, Math.round((cand.geomScore / 135) * 100));
        cand.glyphScore = glyphScore;
        // Fair scoring without artificial cap: 65% glyph shape fingerprint + 35% geometric profile
        cand.rawScore = Math.round(0.35 * normGeom + 0.65 * glyphScore);
      });

      // Sort Top Candidates by optical raw score
      topCandidates.sort((a, b) => b.rawScore - a.rawScore);

      otherCandidates.forEach((cand) => {
        const normGeom = Math.min(100, Math.round((cand.geomScore / 135) * 100));
        cand.glyphScore = cand.sigScore || 60;
        cand.rawScore = Math.round(0.35 * normGeom + 0.65 * cand.glyphScore);
      });

      const candidateScores = [...topCandidates, ...otherCandidates];
      candidateScores.sort((a, b) => b.rawScore - a.rawScore);

      const top1 = candidateScores[0] || { rawScore: 75, geomScore: 75, font: fontsCatalog[0], family: 'Inter' };
      const top2 = candidateScores[1] || { rawScore: top1.rawScore - 12 };
      const scoreMargin = Math.max(0, (top1.rawScore - top2.rawScore) / 100);

      const marginBoost = scoreMargin >= 0.05 ? 6 : scoreMargin >= 0.025 ? 3 : 0;
      const validGlyphsCount = glyphSignatures.length > 0 ? glyphSignatures.length : 4;
      const sampleFactor = Math.min(1.0, Math.sqrt(validGlyphsCount / 5));

      const rankedCandidates = candidateScores.map((c, idx) => {
        let conf = Math.round(c.rawScore * sampleFactor);
        if (idx === 0) {
          conf = Math.max(72, Math.min(99, conf + marginBoost));
        } else {
          conf = Math.max(50, Math.min(conf, top1.rawScore - (idx * 3)));
        }

        let confidenceLabel = 'Good Match';
        if (conf >= 90 && scoreMargin >= 0.04) {
          confidenceLabel = 'Exact / Near-Exact Match';
        } else if (conf >= 84) {
          confidenceLabel = 'High Confidence';
        } else if (scoreMargin < 0.035 || conf < 75) {
          confidenceLabel = 'Close / Competitive Match';
        }

        return {
          ...c,
          confidence: conf,
          confidenceLabel,
          scoreMargin: idx === 0 ? scoreMargin : undefined
        };
      });

      console.log('[FontFinder] DEBUG OPTICAL ENGINE:', JSON.stringify({
        knownText: activeText,
        classification,
        proportions,
        avgAspect: Math.round(avgAspect * 100) / 100,
        contrastRatio: Math.round(contrastRatio * 100) / 100,
        serifRatio: Math.round(serifRatio * 100) / 100,
        top1: rankedCandidates[0]?.family,
        top2: rankedCandidates[1]?.family,
        top3: rankedCandidates[2]?.family,
        topScores: rankedCandidates.slice(0, 5).map(c => `${c.family}:${c.rawScore}(geom:${c.geomScore},glyph:${c.glyphScore})`)
      }));

      return {
        primary: rankedCandidates[0],
        runnersUp: rankedCandidates.slice(1, 4),
        allTopMatches: rankedCandidates.slice(0, 6),
        traits: { classification, serifType, proportions, contrast, weight, contrastRatio, serifRatio, scoreMargin }
      };
    }

    if (typeof window !== 'undefined') {
      window.analyzePixelsInBrowser = analyzePixelsInBrowser;
    }

    function displayResults(data, croppedDataUrl, verifiedText, meta = {}) {
