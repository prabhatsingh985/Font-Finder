<!-- Client script handling drop, samples, canvas crop, optical engine, specimen, and copy -->
<script is:inline>
  (function () {
    const fontsDataElement = document.getElementById('fonts-data');
    let fontsCatalog = [];
    try {
      fontsCatalog = JSON.parse(fontsDataElement.textContent || '[]');
    } catch (e) {
      console.error('Failed to parse fonts database', e);
    }

    let fullCatalog = [];
    fetch('/data/google-fonts-catalog.json')
      .then(res => res.json())
      .then(data => {
        if (Array.isArray(data) && data.length > 100) {
          fullCatalog = data;
          console.log(`[FontFinder] Full catalog loaded: ${fullCatalog.length} fonts ready in browser`);
        }
      })
      .catch(err => {
        console.warn('Full catalog fetch error, fallback active', err);
      });

    // ===== Signature Database for 16x16 Glyph Fingerprint Matching =====
    let sigManifest = null;
    let sigRegularCharMap = null; // Map<char, Uint8Array>
    let sigBoldCharMap = null;
    let sigDbLoading = null;

    async function decompressGzipBrowser(buffer) {
      const bytes = new Uint8Array(buffer);
      if (bytes[0] === 31 && bytes[1] === 139 && typeof DecompressionStream !== 'undefined') {
        const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
        return new Uint8Array(await new Response(stream).arrayBuffer());
      }
      return bytes;
    }

    function indexSigBuffer(buffer, manifest) {
      const charMap = new Map();
      const stride = manifest.fonts.length * manifest.bytesPerGlyph;
      for (let i = 0; i < manifest.chars.length; i++) {
        const ch = manifest.chars[i];
        const start = i * stride;
        charMap.set(ch, buffer.subarray(start, start + stride));
      }
      return charMap;
    }

    async function loadSignatureDb() {
      if (sigManifest && sigRegularCharMap) return { manifest: sigManifest, regMap: sigRegularCharMap, boldMap: sigBoldCharMap };
      if (sigDbLoading) return sigDbLoading;
      sigDbLoading = (async () => {
        try {
          const [manifestRes, allRes, boldRes] = await Promise.all([
            fetch('/signatures/manifest.json'),
            fetch('/signatures/all.bin.gz'),
            fetch('/signatures/bold.bin.gz')
          ]);
          sigManifest = await manifestRes.json();
          const allBuf = await decompressGzipBrowser(await allRes.arrayBuffer());
          const boldBuf = await decompressGzipBrowser(await boldRes.arrayBuffer());
          sigRegularCharMap = indexSigBuffer(allBuf, sigManifest);
          sigBoldCharMap = indexSigBuffer(boldBuf, sigManifest);
          console.log(`[FontFinder] Signature DB loaded: ${sigManifest.fonts.length} fonts × ${sigManifest.chars.length} chars`);
          return { manifest: sigManifest, regMap: sigRegularCharMap, boldMap: sigBoldCharMap };
        } catch (err) {
          console.warn('[FontFinder] Signature DB load failed:', err);
          sigDbLoading = null;
          return null;
        }
      })();
      const result = await sigDbLoading;
      sigDbLoading = null;
      return result;
    }

    // Start loading signature DB eagerly in background
    loadSignatureDb();

    // ===== AI OCR Engine (Tesseract.js) for 100% Precision Text Recognition =====
    let tesseractWorker = null;
    let tesseractWorkerPromise = null;

    async function getTesseractWorker() {
      if (tesseractWorker) return tesseractWorker;
      if (tesseractWorkerPromise) return tesseractWorkerPromise;

      tesseractWorkerPromise = (async () => {
        try {
          if (typeof Tesseract === 'undefined') {
            for (let i = 0; i < 25; i++) {
              if (typeof Tesseract !== 'undefined') break;
              await new Promise(r => setTimeout(r, 100));
            }
          }
          if (typeof Tesseract === 'undefined') {
            console.warn('[FontFinder] Tesseract library not loaded yet');
            return null;
          }

          let worker = null;
          try {
            // Attempt fast local initialization (0ms network latency)
            worker = await Tesseract.createWorker('eng', 1, {
              workerPath: '/vendor/worker.min.js',
              corePath: '/vendor/tesseract-core-lstm.wasm.js',
              langPath: '/tessdata',
              gzip: true,
              logger: () => {}
            });
          } catch (localErr) {
            console.warn('[FontFinder] Local worker init fallback to standard paths:', localErr);
            worker = await Tesseract.createWorker('eng', 1, {
              logger: () => {}
            });
          }

          await worker.setParameters({
            tessedit_char_whitelist: 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,!?-\'"&@()/:; ',
            tessedit_pageseg_mode: '3' // Fully automatic page segmentation (supports single/multiple lines)
          });
          tesseractWorker = worker;
          console.log('[FontFinder] AI OCR Engine (Tesseract.js) initialized and ready in browser');
          return worker;
        } catch (err) {
          console.warn('[FontFinder] Tesseract worker init error:', err);
          tesseractWorkerPromise = null;
          return null;
        }
      })();

      return tesseractWorkerPromise;
    }

    // Warm up AI OCR engine in background immediately
    getTesseractWorker();

    function otsuThresh(histogram, total) {
      let sumAll = 0;
      for (let i = 0; i < 256; i++) sumAll += i * histogram[i];
      let aSum = 0, iSum = 0, maxVar = -1, thresh = 0;
      for (let i = 0; i < 256; i++) {
        aSum += histogram[i];
        if (aSum === 0) continue;
        let cSum = total - aSum;
        if (cSum === 0) break;
        iSum += i * histogram[i];
        let lMean = iSum / aSum, uMean = (sumAll - iSum) / cSum;
        let varBetween = aSum * cSum * (lMean - uMean) ** 2;
        if (varBetween > maxVar) { maxVar = varBetween; thresh = i; }
      }
      return thresh;
    }

    function binarizeColorDist(rgbaData, width, height) {
      const total = width * height;
      const rArr = new Uint8Array(total), gArr = new Uint8Array(total), bArr = new Uint8Array(total);
      for (let i = 0; i < total; i++) {
        const idx = i * 4, a = rgbaData[idx + 3] / 255;
        rArr[i] = Math.round(rgbaData[idx] * a + 255 * (1 - a));
        gArr[i] = Math.round(rgbaData[idx + 1] * a + 255 * (1 - a));
        bArr[i] = Math.round(rgbaData[idx + 2] * a + 255 * (1 - a));
      }
      const colorHist = new Uint32Array(4096);
      for (let i = 0; i < total; i++) {
        colorHist[(rArr[i] >> 4) << 8 | (gArr[i] >> 4) << 4 | (bArr[i] >> 4)]++;
      }
      let maxBin = 0;
      for (let i = 1; i < colorHist.length; i++) {
        if (colorHist[i] > colorHist[maxBin]) maxBin = i;
      }
      const bgR = ((maxBin >> 8) & 15) * 17;
      const bgG = ((maxBin >> 4) & 15) * 17;
      const bgB = (maxBin & 15) * 17;
      const bgLum = 0.299 * bgR + 0.587 * bgG + 0.114 * bgB;
      const isLightOnDark = bgLum < 128;

      const dists = new Float64Array(total);
      let maxDist = 0;
      for (let i = 0; i < total; i++) {
        const d = Math.hypot(rArr[i] - bgR, gArr[i] - bgG, bArr[i] - bgB);
        dists[i] = d;
        if (d > maxDist) maxDist = d;
      }
      if (maxDist === 0) return { bits: new Uint8Array(total), width, height, isLightOnDark, bgLum };

      const distBytes = new Uint8Array(total);
      const hist = new Uint32Array(256);
      for (let i = 0; i < total; i++) {
        const v = Math.round((dists[i] * 255) / maxDist);
        distBytes[i] = v;
        hist[v]++;
      }
      const thresh = otsuThresh(hist, total);
      const bits = new Uint8Array(total);
      for (let i = 0; i < total; i++) {
        bits[i] = distBytes[i] > thresh ? 1 : 0;
      }
      return { bits, width, height, isLightOnDark, bgLum };
    }

    function compute16x16Sig(maskOrBits, arg2, arg3) {
      let bits, imgWidth, box;
      if (arg3 !== undefined) {
        bits = maskOrBits;
        imgWidth = arg2;
        box = arg3;
      } else {
        bits = maskOrBits.bits;
        imgWidth = maskOrBits.width;
        box = arg2;
      }
      const n = 16;
      const sig = new Uint8Array((n * n) / 8); // 32 bytes
      for (let row = 0; row < n; row++) {
        const y0 = box.y + Math.floor((row * box.h) / n);
        const y1 = box.y + Math.max(Math.floor(((row + 1) * box.h) / n), Math.floor((row * box.h) / n) + 1);
        for (let col = 0; col < n; col++) {
          const x0 = box.x + Math.floor((col * box.w) / n);
          const x1 = box.x + Math.max(Math.floor(((col + 1) * box.w) / n), Math.floor((col * box.w) / n) + 1);
          let total = 0, ink = 0;
          for (let y = y0; y < y1; y++) {
            const rOff = y * imgWidth;
            for (let x = x0; x < x1; x++) {
              total++;
              if (bits[rOff + x]) ink++;
            }
          }
          if (total > 0 && (ink / total) >= 0.5) {
            const pixelIdx = row * n + col;
            sig[pixelIdx >> 3] |= 1 << (7 - (pixelIdx & 7));
          }
        }
      }
      return sig;
    }

    function tightenBox(maskOrBits, arg2, arg3) {
      let bits, imgWidth, box;
      if (arg3 !== undefined) {
        bits = maskOrBits;
        imgWidth = arg2;
        box = arg3;
      } else {
        bits = maskOrBits.bits;
        imgWidth = maskOrBits.width;
        box = arg2;
      }
      let minX = box.x + box.w, maxX = box.x - 1;
      let minY = box.y + box.h, maxY = box.y - 1;
      for (let y = box.y; y < box.y + box.h; y++) {
        const rOff = y * imgWidth;
        for (let x = box.x; x < box.x + box.w; x++) {
          if (bits[rOff + x]) {
            if (x < minX) minX = x;
            if (x > maxX) maxX = x;
            if (y < minY) minY = y;
            if (y > maxY) maxY = y;
          }
        }
      }
      if (maxX < minX || maxY < minY) return null;
      return { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1 };
    }

    function erodeMask(mask) {
      const { bits, width, height } = mask;
      const eroded = new Uint8Array(bits.length);
      for (let y = 1; y < height - 1; y++) {
        const row = y * width;
        for (let x = 1; x < width - 1; x++) {
          const idx = row + x;
          if (!bits[idx]) continue;
          let allNeighbors = 1;
          for (let dy = -1; dy <= 1 && allNeighbors; dy++) {
            const nRow = (y + dy) * width;
            for (let dx = -1; dx <= 1; dx++) {
              if (!bits[nRow + x + dx]) { allNeighbors = 0; break; }
            }
          }
          eroded[idx] = allNeighbors;
        }
      }
      return { bits: eroded, width, height };
    }

    function computeErosionSignatures(mask, boxes, maxPasses = 5) {
      const passes = [boxes.map(b => compute16x16Sig(mask, b))];
      let curMask = mask;
      for (let p = 1; p <= maxPasses; p++) {
        curMask = erodeMask(curMask);
        const tightBoxes = boxes.map(b => tightenBox(curMask, b));
        if (tightBoxes.some(b => b === null)) break;
        passes.push(tightBoxes.map(b => compute16x16Sig(curMask, b)));
      }
      return passes;
    }

    function hammingDist(sigA, sigB, offsetB) {
      let diffBits = 0;
      for (let i = 0; i < sigA.length; i++) {
        let xor = sigA[i] ^ sigB[offsetB + i];
        while (xor) { xor &= xor - 1; diffBits++; }
      }
      return diffBits;
    }

    function isBlankSig(buf, offset, bytesPerGlyph) {
      for (let i = 0; i < bytesPerGlyph; i++) {
        if (buf[offset + i] !== 0) return false;
      }
      return true;
    }

    function scoreCut(manifest, charMap, queryGlyphs) {
      const { bytesPerGlyph, fonts } = manifest;
      const numFonts = fonts.length;
      const dists = new Float64Array(numFonts);
      const counts = new Uint16Array(numFonts);

      for (const g of queryGlyphs) {
        const slice = charMap.get(g.char);
        if (!slice) continue;
        for (let f = 0; f < numFonts; f++) {
          const offset = f * bytesPerGlyph;
          if (isBlankSig(slice, offset, bytesPerGlyph)) continue;
          const diff = hammingDist(g.signature, slice, offset);
          dists[f] += diff / 256;
          counts[f]++;
        }
      }

      const candidates = [];
      for (let f = 0; f < numFonts; f++) {
        if (counts[f] === 0) continue;
        candidates.push({
          fontIndex: f,
          slug: fonts[f],
          family: manifest.families[f] || fonts[f],
          category: manifest.categories[f] || 'sans-serif',
          score: 1 - dists[f] / counts[f],
          lettersUsed: counts[f]
        });
      }
      return candidates.sort((a, b) => b.score - a.score);
    }

    function scoreAllCuts(manifest, cuts, queryGlyphs) {
      const bestPerFont = new Map();
      for (const cut of cuts) {
        const scored = scoreCut(manifest, cut.data, queryGlyphs);
        for (const item of scored) {
          const existing = bestPerFont.get(item.slug);
          if (!existing || item.score > existing.score) {
            bestPerFont.set(item.slug, { ...item, weight: cut.name });
          }
        }
      }
      return [...bestPerFont.values()].sort((a, b) => b.score - a.score);
    }

    async function preloadGoogleFontsSubset(candidatesOrFamilies, text) {
      if (typeof document === 'undefined' || !candidatesOrFamilies || candidatesOrFamilies.length === 0) return;
      const rawFamilies = candidatesOrFamilies.map(f => (typeof f === 'string' ? f : (f?.family || ''))).filter(Boolean);
      const uniqueFamilies = [...new Set(rawFamilies)].slice(0, 30);
      if (uniqueFamilies.length === 0) return;

      const cleanText = text && text.trim().length > 0 ? text.trim() : 'Handgloves';
      const uniqueText = encodeURIComponent([...new Set(Array.from(cleanText))].join(''));
      const linkId = 'gfonts-stage-b-subset';
      let existingLink = document.getElementById(linkId);
      if (existingLink) existingLink.remove();

      const link = document.createElement('link');
      link.id = linkId;
      link.rel = 'stylesheet';
      link.dataset.rerank = 'true';
      link.href = 'https://fonts.googleapis.com/css2?' +
        uniqueFamilies.map(f => `family=${encodeURIComponent(f).replace(/%20/g, '+')}`).join('&') +
        `&text=${uniqueText}&display=block`;

      const stylesheetLoaded = new Promise((resolve) => {
        link.onload = () => resolve(true);
        link.onerror = () => resolve(false);
        setTimeout(() => resolve(false), 2500);
      });

      document.head.appendChild(link);
      await stylesheetLoaded;

      // Ensure browser registers and loads fonts in memory
      if (document.fonts && document.fonts.load) {
        await Promise.race([
          Promise.all(uniqueFamilies.map(f => document.fonts.load(`140px "${f}"`, cleanText).catch(() => []))),
          new Promise(resolve => setTimeout(resolve, 1500))
        ]);
      }
    }

    function normalizeGrayscaleSilhouette(gray, width, height, targetH = 64) {
      let minX = width, maxX = -1, minY = height, maxY = -1;
      for (let y = 0; y < height; y++) {
        for (let x = 0; x < width; x++) {
          if (gray[y * width + x] < 128) {
            if (x < minX) minX = x;
            if (x > maxX) maxX = x;
            if (y < minY) minY = y;
            if (y > maxY) maxY = y;
          }
        }
      }
      if (maxX < 0) return null;
      const inkW = maxX - minX + 1;
      const inkH = maxY - minY + 1;
      let normW = Math.max(1, Math.round((inkW * targetH) / inkH));
      if (normW > 900) normW = 900;

      const normGray = new Uint8Array(57600).fill(255); // 64 * 900
      for (let ny = 0; ny < targetH; ny++) {
        const y0 = minY + Math.floor((ny * inkH) / targetH);
        const y1 = Math.max(minY + Math.floor(((ny + 1) * inkH) / targetH), y0 + 1);
        for (let nx = 0; nx < normW; nx++) {
          const x0 = minX + Math.floor((nx * inkW) / normW);
          const x1 = Math.max(minX + Math.floor(((nx + 1) * inkW) / normW), x0 + 1);
          let sum = 0, count = 0;
          for (let y = y0; y < y1; y++) {
            for (let x = x0; x < x1; x++) {
              sum += gray[y * width + x];
              count++;
            }
          }
          normGray[ny * 900 + nx] = count ? Math.round(sum / count) : 255;
        }
      }
      return { gray: normGray, inkWidth: normW };
    }

    function extractWordSilhouetteGrayscale(sourceCanvas, targetH = 64) {
      if (!sourceCanvas) return null;
      const ctx = sourceCanvas.getContext('2d');
      if (!ctx) return null;
      const imgData = ctx.getImageData(0, 0, sourceCanvas.width, sourceCanvas.height);
      const data = imgData.data;
      const w = sourceCanvas.width, h = sourceCanvas.height;
      const gray = new Uint8Array(w * h);
      for (let i = 0; i < gray.length; i++) {
        const idx = i * 4;
        const a = data[idx + 3] / 255;
        const lum = 0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2];
        gray[i] = Math.round(lum * a + 255 * (1 - a));
      }
      return normalizeGrayscaleSilhouette(gray, w, h, targetH);
    }

    function renderCandidateWordSilhouette(family, text, weight = 400) {
      // Gatekeeper: ensure font is actually ready in document.fonts before rendering to canvas
      if (typeof document !== 'undefined' && document.fonts && document.fonts.check) {
        const isReady = document.fonts.check(`${weight} 140px "${family}"`, text) ||
                        document.fonts.check(`140px "${family}"`, text);
        if (!isReady) {
          // Do NOT render fallback monospace! Return null so Stage A score is preserved cleanly.
          return null;
        }
      }

      const canvas = document.createElement('canvas');
      canvas.width = Math.max(600, 140 * text.length);
      canvas.height = 280;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return null;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#000000';
      ctx.textBaseline = 'alphabetic';
      ctx.font = `${weight} 140px "${family}", sans-serif`;
      ctx.fillText(text, 20, 182);

      const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imgData.data;
      const gray = new Uint8Array(canvas.width * canvas.height);
      for (let i = 0; i < gray.length; i++) {
        const idx = i * 4;
        const a = data[idx + 3] / 255;
        const lum = 0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2];
        gray[i] = Math.round(lum * a + 255 * (1 - a));
      }
      return normalizeGrayscaleSilhouette(gray, canvas.width, canvas.height, 64);
    }

    function compareWordSilhouettes(userSil, candSil) {
      if (!userSil || !candSil) return 0.5;
      let diff = 0;
      const len = userSil.gray.length;
      for (let i = 0; i < len; i++) {
        diff += Math.abs(userSil.gray[i] - candSil.gray[i]);
      }
      return Math.max(0, Math.min(1, 1 - diff / (len * 255)));
    }

    const uploadStage = document.getElementById('upload-stage');
    const organizeStage = document.getElementById('organize-stage');
    const manualCropPanel = document.getElementById('manual-crop-panel');
