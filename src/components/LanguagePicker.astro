---
import { LANGUAGES, LOCALES, type SupportedLocale } from '../i18n/languages';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  currentLang?: string;
  class?: string;
}

const { currentLang = (Astro.currentLocale as string) || 'en', class: className = '' } = Astro.props;
const pathname = Astro.url.pathname;
const activeLangInfo = LANGUAGES[(currentLang as SupportedLocale)] || LANGUAGES.en;
---

<div class={`relative inline-block text-left language-picker-container ${className}`}>
  <!-- Dropdown Trigger Button -->
  <button
    type="button"
    class="language-picker-btn h-8 px-2.5 sm:px-3 rounded-[6px] border border-[#e2e4e8] dark:border-[#383b44] bg-white dark:bg-[#161718] flex items-center gap-1.5 text-[12px] font-mono text-[#475569] dark:text-[#8a8f98] hover:text-[#08090a] dark:hover:text-[#ffffff] hover:border-[#cbd5e1] dark:hover:border-[#64748b] transition-colors cursor-pointer shadow-sm dark:shadow-[0_1px_3px_rgba(0,0,0,0.5),inset_0_1px_0_rgba(255,255,255,0.08)]"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={`Select Language (Current: ${activeLangInfo.nativeName})`}
    title="Select Language / Cambiar Idioma / 言語を変更"
  >
    <!-- Globe Icon -->
    <svg class="w-3.5 h-3.5 shrink-0 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
      <circle cx="12" cy="12" r="9"></circle>
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a15.3 15.3 0 014 9 15.3 15.3 0 01-4 9 15.3 15.3 0 01-4-9 15.3 15.3 0 014-9z"></path>
    </svg>
    <span class="font-medium tracking-tight uppercase">{activeLangInfo.code}</span>
    <!-- Chevron Down Icon -->
    <svg class="w-3 h-3 transition-transform duration-200 chevron-icon opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    class="language-picker-menu hidden absolute right-0 mt-1.5 w-44 rounded-[8px] bg-white dark:bg-[#121316] border border-[#e2e4e8] dark:border-[#2a2d34] shadow-lg dark:shadow-[0_12px_28px_rgba(0,0,0,0.6)] py-1 z-50 backdrop-blur-md transition-all"
    role="menu"
    aria-orientation="vertical"
  >
    <div class="px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider text-[#94a3b8] dark:text-[#64748b] border-b border-[#f1f3f6] dark:border-[#1e2025] mb-1">
      Languages
    </div>
    {LOCALES.map((locale) => {
      const info = LANGUAGES[locale];
      const targetUrl = getLocalizedPath(pathname, locale);
      const isActive = locale === activeLangInfo.code;
      return (
        <a
          href={targetUrl}
          role="menuitem"
          class={`flex items-center justify-between px-3 py-1.5 text-[12px] transition-colors rounded-[4px] mx-1 ${
            isActive
              ? 'text-[#08090a] dark:text-[#ffffff] font-medium bg-black/[0.05] dark:bg-white/[0.08]'
              : 'text-[#475569] dark:text-[#c0c5cf] hover:text-[#08090a] dark:hover:text-[#ffffff] hover:bg-black/[0.03] dark:hover:bg-white/[0.04]'
          }`}
          data-lang={locale}
        >
          <span class="flex items-center gap-2">
            <span class="font-mono text-[10px] uppercase opacity-70 w-5">{info.code}</span>
            <span>{info.nativeName}</span>
          </span>
          {isActive && (
            <span class="w-1.5 h-1.5 rounded-full bg-[#ff4d00] dark:bg-[#e4f222]"></span>
          )}
        </a>
      );
    })}
  </div>
</div>

<script>
  (function initLanguagePickers() {
    function setup() {
      const containers = document.querySelectorAll('.language-picker-container');
      containers.forEach((container) => {
        const btn = container.querySelector('.language-picker-btn') as HTMLButtonElement | null;
        const menu = container.querySelector('.language-picker-menu') as HTMLElement | null;
        const chevron = container.querySelector('.chevron-icon') as HTMLElement | null;
        if (!btn || !menu) return;

        function toggle(open?: boolean) {
          const isOpen = open !== undefined ? open : menu.classList.contains('hidden');
          if (isOpen) {
            menu.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
          } else {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
          }
        }

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggle();
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
          if (!container.contains(e.target as Node)) {
            toggle(false);
          }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            toggle(false);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
