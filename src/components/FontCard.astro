---
import type { FontFamily } from '../types/font';

interface Props {
  font: FontFamily;
}

const { font } = Astro.props;
const encodedFamily = encodeURIComponent(font.family).replace(/%20/g, '+');
---

<div class="group rounded-xl border border-border bg-card p-5 transition-all hover:border-foreground/30 hover:shadow-card flex flex-col justify-between">
  <div>
    <!-- Header -->
    <div class="flex items-start justify-between gap-2 mb-3">
      <div>
        <h3 class="font-bold text-lg text-foreground tracking-tight group-hover:text-primary transition-colors">
          <a href={`/fonts/${font.id}`}>{font.family}</a>
        </h3>
        <p class="text-xs text-muted-foreground">
          {font.designer} &bull; <span class="capitalize">{font.category}</span>
        </p>
      </div>
      <span class="inline-flex items-center gap-1 text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shrink-0">
        Verified
      </span>
    </div>

    <!-- Live Specimen -->
    <div class="my-4 p-3 rounded-lg bg-muted/40 overflow-hidden">
      <!-- Preload the font dynamically for the specimen -->
      <link
        rel="stylesheet"
        href={`https://fonts.googleapis.com/css2?family=${encodedFamily}:wght@400;700&display=swap`}
      />
      <p
        class="text-xl text-foreground truncate select-all"
        style={`font-family: '${font.family}', ${font.category};`}
      >
        Almost before we knew it, we had left the ground.
      </p>
    </div>

    <p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">
      {font.description}
    </p>
  </div>

  <!-- Footer Info & Actions -->
  <div class="mt-5 pt-4 border-t border-border flex items-center justify-between text-xs">
    <span class="text-muted-foreground font-mono">
      {font.variants.length} styles {font.variable ? '• Variable' : ''}
    </span>
    <a
      href={`/fonts/${font.id}`}
      class="font-medium text-foreground hover:underline inline-flex items-center gap-1"
    >
      Inspect Specimen &rarr;
    </a>
  </div>
</div>
