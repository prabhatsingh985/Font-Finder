---
import type { FontFamily } from '../types/font';

interface Props {
  font: FontFamily;
}

const { font } = Astro.props;
const encodedFamily = encodeURIComponent(font.family).replace(/%20/g, '+');
---

<div class="group rounded-[12px] border border-[#23252a] bg-[#0f1011] p-5 transition-all hover:bg-[#161718] hover:border-[#383b3f] shadow-sm flex flex-col justify-between">
  <div>
    <!-- Header -->
    <div class="flex items-start justify-between gap-2 mb-3">
      <div>
        <h3 class="font-[510] text-[15px] sm:text-[16px] text-[#ffffff] tracking-[-0.012em] group-hover:text-[#ffffff] transition-colors">
          <a href={`/fonts/${font.id}`}>{font.family}</a>
        </h3>
        <p class="text-[12px] text-[#8a8f98] mt-0.5 font-normal">
          {font.designer} &bull; <span class="capitalize">{font.category}</span>
        </p>
      </div>
      <span class="inline-flex items-center gap-1.5 text-[11px] font-mono px-2 py-0.5 rounded-[4px] bg-white/[0.04] text-[#8a8f98] border border-[#23252a] shrink-0">
        <span class="w-1.5 h-1.5 rounded-full bg-[#27a644]"></span>
        <span>Verified</span>
      </span>
    </div>

    <!-- Live Specimen -->
    <div class="my-3.5 p-3.5 rounded-[6px] bg-[#161718] border border-[#23252a] overflow-hidden">
      <link
        rel="stylesheet"
        href={`https://fonts.googleapis.com/css2?family=${encodedFamily}:wght@400;700&display=swap`}
      />
      <p
        class="text-[18px] text-[#ffffff] truncate select-all"
        style={`font-family: '${font.family}', ${font.category};`}
      >
        Almost before we knew it, we had left the ground.
      </p>
    </div>

    <p class="text-[13px] text-[#8a8f98] line-clamp-2 leading-relaxed">
      {font.description}
    </p>
  </div>

  <!-- Footer Info & Actions -->
  <div class="mt-4 pt-3.5 border-t border-[#23252a] flex items-center justify-between font-mono text-[12px]">
    <span class="text-[#62666d] text-[11px]">
      {font.variants.length} styles {font.variable ? '• Variable' : ''}
    </span>
    <a
      href={`/fonts/${font.id}`}
      class="font-normal text-[12px] text-[#d0d6e0] hover:text-[#ffffff] transition-colors inline-flex items-center gap-1"
    >
      Inspect &rarr;
    </a>
  </div>
</div>
