---
import type { FontFamily } from '../types/font';

interface Props {
  font: FontFamily;
}

const { font } = Astro.props;
const encodedFamily = encodeURIComponent(font.family).replace(/%20/g, '+');
---

<div class="group rounded-2xl border border-[#e5e7eb] bg-[#f9f9f9] p-6 transition-all hover:bg-[#ffffff] hover:border-[#ff4d00]/30 hover:shadow-[0_0_0_6px_rgb(249,249,249)] flex flex-col justify-between">
  <div>
    <!-- Header -->
    <div class="flex items-start justify-between gap-2 mb-3">
      <div>
        <h3 class="font-medium text-base text-[#262626] tracking-tight group-hover:text-[#ff4d00] transition-colors">
          <a href={`/fonts/${font.id}`}>{font.family}</a>
        </h3>
        <p class="text-xs text-[#727272] mt-0.5">
          {font.designer} &bull; <span class="capitalize">{font.category}</span>
        </p>
      </div>
      <span class="inline-flex items-center gap-1.5 text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-white text-[#262626] border border-[#e5e7eb] shrink-0">
        <span class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></span>
        <span>Verified</span>
      </span>
    </div>

    <!-- Live Specimen on White 8px container -->
    <div class="my-4 p-3.5 rounded-lg bg-white border border-[#e5e7eb] overflow-hidden">
      <link
        rel="stylesheet"
        href={`https://fonts.googleapis.com/css2?family=${encodedFamily}:wght@400;700&display=swap`}
      />
      <p
        class="text-xl text-[#262626] truncate select-all"
        style={`font-family: '${font.family}', ${font.category};`}
      >
        Almost before we knew it, we had left the ground.
      </p>
    </div>

    <p class="text-xs text-[#727272] line-clamp-2 leading-relaxed">
      {font.description}
    </p>
  </div>

  <!-- Footer Info & Actions -->
  <div class="mt-5 pt-4 border-t border-[#e5e7eb] flex items-center justify-between font-mono text-xs">
    <span class="text-[#727272]">
      {font.variants.length} styles {font.variable ? '• Variable' : ''}
    </span>
    <a
      href={`/fonts/${font.id}`}
      class="font-medium text-[#262626] group-hover:text-[#ff4d00] transition-colors inline-flex items-center gap-1"
    >
      Inspect &rarr;
    </a>
  </div>
</div>
