---
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/languages';

interface Props {
  lang?: string;
}

const { lang = (Astro.currentLocale as string) || 'en' } = Astro.props;
const currentLocale = lang as SupportedLocale;
const t = useTranslations(lang);
const fT = t.common.footer;
const year = new Date().getFullYear();

const p = (path: string) => getLocalizedPath(path, currentLocale);
---

<footer class="border-t border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#08090a] transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10 mb-12">
      <!-- Col 1: Brand & Core Mission -->
      <div class="sm:col-span-2 lg:col-span-2 space-y-4">
        <a href={p('/')} class="inline-flex items-center gap-2 font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] text-sm sm:text-base">
          <div class="w-6 h-6 rounded-[6px] bg-[#f1f3f6] dark:bg-[#161718] border border-[#e2e4e8] dark:border-[#23252a] flex items-center justify-center text-[#08090a] dark:text-[#ffffff]">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span>{t.common.brandName}</span>
        </a>
        <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] max-w-sm leading-relaxed">
          {fT.mission}
        </p>
        <div class="pt-1">
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-[#334155] dark:text-[#d0d6e0] bg-[#f8f9fa] dark:bg-[#0f1011] px-2.5 py-1 rounded-full border border-[#e2e4e8] dark:border-[#23252a]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a] dark:bg-[#27a644]"></span>
            <span>{fT.zeroStorageBadge}</span>
          </span>
        </div>
      </div>

      <!-- Col 2: Products (Tools) -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-[510] text-[#64748b] dark:text-[#8a8f98] uppercase tracking-wider">{fT.productsTitle}</h4>
        <ul class="space-y-2 text-[13px] text-[#475569] dark:text-[#8a8f98]">
          <li><a href={p('/')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.tools.imageFontFinder}</a></li>
          <li><a href={p('/tools/url-font-finder')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.tools.urlFontFinder}</a></li>
          <li><a href={p('/tools/logo-font-finder')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.tools.logoFontFinder}</a></li>
          <li><a href={p('/tools/screenshot-font-finder')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.tools.screenshotFontFinder}</a></li>
          <li><a href={p('/tools/font-pairing')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.tools.fontPairing}</a></li>
          <li><a href={p('/tools/handwriting-font-finder')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.tools.handwritingMatcher}</a></li>
          <li><a href={p('/tools/commercial-alternative')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.tools.commercialAlternatives}</a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Resources -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-[510] text-[#64748b] dark:text-[#8a8f98] uppercase tracking-wider">{fT.companyTitle}</h4>
        <ul class="space-y-2 text-[13px] text-[#475569] dark:text-[#8a8f98]">
          <li><a href={p('/about')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.aboutUs}</a></li>
          <li><a href={p('/how-it-works')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.howItWorks}</a></li>
          <li><a href={p('/tools')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.allFontTools}</a></li>
          <li><a href={p('/contact')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.contactSupport}</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Legal -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-[510] text-[#64748b] dark:text-[#8a8f98] uppercase tracking-wider">{fT.trustLegalTitle}</h4>
        <ul class="space-y-2 text-[13px] text-[#475569] dark:text-[#8a8f98]">
          <li><a href={p('/privacy')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.privacyPolicy}</a></li>
          <li><a href={p('/terms')} class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">{fT.termsOfService}</a></li>
          <li><a href="https://fonts.google.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors inline-flex items-center gap-1">{fT.googleFonts} <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a></li>
          <li><a href="https://scripts.sil.org/OFL" target="_blank" rel="noopener noreferrer" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors inline-flex items-center gap-1">{fT.silLicense} <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#e2e4e8] dark:border-[#23252a] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-[#64748b] dark:text-[#62666d]">
      <p>&copy; {year} {fT.copyright}</p>
      <div class="flex items-center gap-3">
        <span>{fT.noCookies}</span>
        <span>&bull;</span>
        <span>{fT.noAccount}</span>
        <span>&bull;</span>
        <span>{fT.freeCommercial}</span>
      </div>
    </div>
  </div>
</footer>
