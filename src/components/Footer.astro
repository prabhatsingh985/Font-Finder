---
const year = new Date().getFullYear();
---

<footer class="border-t border-[#e5e7eb] bg-[#f9f9f9] transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2 font-semibold text-[#262626] tracking-tight text-base">
          <div class="w-6 h-6 rounded-full bg-[#ff4d00]/10 flex items-center justify-center text-[#ff4d00]">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2c-.8 2.2-2.8 4.2-4.5 6-2 2.2-3.5 4.8-3.5 7.8 0 4.4 3.6 8.2 8 8.2s8-3.8 8-8.2c0-2.5-1-4.8-2.6-6.7-1.5-1.8-3.4-3.5-4.4-5.3-.3-.6-.7-1.3-1-1.8zM12 20c-2.8 0-5-2.2-5-5 0-1.8 1-3.3 2.1-4.7 1.1-1.3 2.2-2.7 2.9-4.3.7 1.5 1.8 2.9 2.9 4.3 1.1 1.4 2.1 2.9 2.1 4.7 0 2.8-2.2 5-5 5z"/>
            </svg>
          </div>
          <span>Font Finder</span>
        </div>
        <p class="text-xs text-[#727272] max-w-sm leading-relaxed">
          The developer-first image font identifier. Inspect letterform geometry, verify authentic open-source Google Fonts, and copy production-ready CSS blueprints.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-[#262626] bg-white px-3 py-1 rounded-full border border-[#e5e7eb]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ff4d00]"></span>
            <span>Zero Image Storage &bull; 100% In-Memory</span>
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold text-[#262626] uppercase tracking-wider">Product</h4>
        <ul class="space-y-2 text-xs text-[#727272]">
          <li><a href="/" class="hover:text-[#ff4d00] transition-colors">Font Finder</a></li>
          <li><a href="/fonts" class="hover:text-[#ff4d00] transition-colors">Verified Font Catalog</a></li>
          <li><a href="/how-it-works" class="hover:text-[#ff4d00] transition-colors">Optical Anatomy & Guide</a></li>
          <li><a href="/about" class="hover:text-[#ff4d00] transition-colors">About</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Trust -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold text-[#262626] uppercase tracking-wider">Trust & Open Source</h4>
        <ul class="space-y-2 text-xs text-[#727272]">
          <li><a href="/privacy" class="hover:text-[#ff4d00] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-[#ff4d00] transition-colors">Terms of Service</a></li>
          <li><a href="https://fonts.google.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#ff4d00] transition-colors inline-flex items-center gap-1">Google Fonts <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a></li>
          <li><a href="https://scripts.sil.org/OFL" target="_blank" rel="noopener noreferrer" class="hover:text-[#ff4d00] transition-colors">SIL Open Font License</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#e5e7eb] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-[#727272]">
      <p>&copy; {year} Font Finder. Built on the Firecrawl technical blueprint.</p>
      <div class="flex items-center gap-3">
        <span>No cookies</span>
        <span>&bull;</span>
        <span>No account required</span>
        <span>&bull;</span>
        <span>Free for commercial use</span>
      </div>
    </div>
  </div>
</footer>
