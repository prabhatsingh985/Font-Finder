---
const year = new Date().getFullYear();
---

<footer class="border-t border-[#e2e4e8] dark:border-[#23252a] bg-white dark:bg-[#08090a] transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10 mb-12">
      <!-- Col 1: Brand & Core Mission -->
      <div class="sm:col-span-2 lg:col-span-2 space-y-4">
        <a href="/" class="inline-flex items-center gap-2 font-[510] text-[#08090a] dark:text-[#ffffff] tracking-[-0.015em] text-sm sm:text-base">
          <div class="w-6 h-6 rounded-[6px] bg-[#f1f3f6] dark:bg-[#161718] border border-[#e2e4e8] dark:border-[#23252a] flex items-center justify-center text-[#08090a] dark:text-[#ffffff]">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span>Pro Font Finder</span>
        </a>
        <p class="text-[13px] text-[#475569] dark:text-[#8a8f98] max-w-sm leading-relaxed">
          The developer-first image font identifier. Inspect letterform geometry, verify authentic open-source Google Fonts, and copy production-ready CSS blueprints.
        </p>
        <div class="pt-1">
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-[#334155] dark:text-[#d0d6e0] bg-[#f8f9fa] dark:bg-[#0f1011] px-2.5 py-1 rounded-full border border-[#e2e4e8] dark:border-[#23252a]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a] dark:bg-[#27a644]"></span>
            <span>Zero Image Storage &bull; 100% Client-Side In-Memory</span>
          </span>
        </div>
      </div>

      <!-- Col 2: Products (Tools) -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-[510] text-[#64748b] dark:text-[#8a8f98] uppercase tracking-wider">Products</h4>
        <ul class="space-y-2 text-[13px] text-[#475569] dark:text-[#8a8f98]">
          <li><a href="/" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Image Font Finder</a></li>
          <li><a href="/tools/url-font-finder" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">URL Font Finder</a></li>
          <li><a href="/tools/logo-font-finder" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Logo Font Finder</a></li>
          <li><a href="/tools/screenshot-font-finder" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Screenshot Font Finder</a></li>
          <li><a href="/tools/font-pairing" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Font Pairing Tool</a></li>
          <li><a href="/tools/handwriting-font-finder" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Handwriting Matcher</a></li>
          <li><a href="/tools/commercial-alternative" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Commercial Alternatives</a></li>
          <li><a href="/fonts" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Verified Font Catalog</a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Resources -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-[510] text-[#64748b] dark:text-[#8a8f98] uppercase tracking-wider">Company</h4>
        <ul class="space-y-2 text-[13px] text-[#475569] dark:text-[#8a8f98]">
          <li><a href="/about" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">About Us</a></li>
          <li><a href="/how-it-works" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">How It Works</a></li>
          <li><a href="/tools" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">All Font Tools</a></li>
          <li><a href="/contact" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Contact Support</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Legal -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-[510] text-[#64748b] dark:text-[#8a8f98] uppercase tracking-wider">Trust & Legal</h4>
        <ul class="space-y-2 text-[13px] text-[#475569] dark:text-[#8a8f98]">
          <li><a href="/privacy" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors">Terms of Service</a></li>
          <li><a href="https://fonts.google.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors inline-flex items-center gap-1">Google Fonts <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a></li>
          <li><a href="https://scripts.sil.org/OFL" target="_blank" rel="noopener noreferrer" class="hover:text-[#08090a] dark:hover:text-[#ffffff] transition-colors inline-flex items-center gap-1">SIL Open Font License <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#e2e4e8] dark:border-[#23252a] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-[#64748b] dark:text-[#62666d]">
      <p>&copy; {year} Pro Font Finder. Precision typography inspection for developers &amp; designers.</p>
      <div class="flex items-center gap-3">
        <span>No cookies</span>
        <span>&bull;</span>
        <span>No account required</span>
        <span>&bull;</span>
        <span>Free for commercial use</span>
      </div>
    </div>
  </div>
</footer>
