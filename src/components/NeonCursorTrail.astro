---
// NeonCursorTrail.astro - Neon cursor lighting and trail strictly scoped to grid background sections
---

<canvas id="neon-cursor-canvas" class="pointer-events-none fixed inset-0 z-[99999]" aria-hidden="true"></canvas>

<script>
  (function initNeonCursor() {
    // Respect reduced motion preference and coarse pointers (touch devices)
    if (typeof window === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const canvas = document.getElementById('neon-cursor-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      if (!canvas || !ctx) return;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    interface TrailPoint {
      x: number;
      y: number;
      time: number;
    }

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      color: string;
      glowColor: string;
      life: number;
      maxLife: number;
    }

    interface Ripple {
      x: number;
      y: number;
      radius: number;
      maxRadius: number;
      life: number;
      maxLife: number;
    }

    const trail: TrailPoint[] = [];
    const particles: Particle[] = [];
    const ripples: Ripple[] = [];

    const TRAIL_LIFETIME = 280; // ms
    let animId: number | null = null;
    
    // Cursor position and smooth interpolation
    let targetX = -200;
    let targetY = -200;
    let currentX = -200;
    let currentY = -200;
    let lastX = -200;
    let lastY = -200;
    
    let targetAlpha = 0;
    let currentAlpha = 0;
    let isInGrid = false;
    let lastMoveTime = 0;
    let lastFrameTime = performance.now();

    function isDarkMode(): boolean {
      return document.documentElement.classList.contains('dark') || !document.documentElement.classList.contains('light');
    }

    // Theme palettes: Electric Acid Lime in Dark Mode, Warm Orange in Light Mode
    const DARK_PALETTE = {
      neonCore: 'rgba(255, 255, 255, 0.95)',
      neonInner: 'rgba(228, 242, 34, 0.85)',
      neonMid: 'rgba(228, 242, 34, 0.28)',
      neonOuter: 'rgba(228, 242, 34, 0.08)',
      neonEdge: 'rgba(228, 242, 34, 0)',
      ringColor: 'rgba(228, 242, 34, 0.35)',
      trailBloom: 'rgba(228, 242, 34, 0.35)',
      trailBody: 'rgba(228, 242, 34, 0.8)',
      trailCore: 'rgba(255, 255, 255, 0.9)',
      shadowColor: '#e4f222',
      particles: [
        { fill: '#e4f222', glow: 'rgba(228, 242, 34, 0.9)' },
        { fill: '#f5ff60', glow: 'rgba(245, 255, 96, 0.9)' },
        { fill: '#ffffff', glow: 'rgba(255, 255, 255, 0.9)' },
        { fill: '#b8e617', glow: 'rgba(184, 230, 23, 0.8)' },
      ],
      composite: 'lighter' as GlobalCompositeOperation
    };

    const LIGHT_PALETTE = {
      neonCore: 'rgba(255, 255, 255, 0.95)',
      neonInner: 'rgba(255, 77, 0, 0.70)',
      neonMid: 'rgba(255, 110, 20, 0.22)',
      neonOuter: 'rgba(255, 77, 0, 0.06)',
      neonEdge: 'rgba(255, 77, 0, 0)',
      ringColor: 'rgba(255, 77, 0, 0.35)',
      trailBloom: 'rgba(255, 77, 0, 0.35)',
      trailBody: 'rgba(255, 100, 20, 0.8)',
      trailCore: 'rgba(255, 255, 255, 0.9)',
      shadowColor: '#ff4d00',
      particles: [
        { fill: '#ff4d00', glow: 'rgba(255, 77, 0, 0.9)' },
        { fill: '#ff7b00', glow: 'rgba(255, 123, 0, 0.9)' },
        { fill: '#ffa600', glow: 'rgba(255, 166, 0, 0.9)' },
        { fill: '#ffffff', glow: 'rgba(255, 255, 255, 0.9)' },
      ],
      composite: 'source-over' as GlobalCompositeOperation
    };

    /**
     * Check whether coordinates (x, y) are inside any element with the grid background pattern
     */
    function isPointInGrid(x: number, y: number): boolean {
      const gridElements = document.querySelectorAll('.bg-grid-pattern, .bg-grid-pattern-subtle');
      for (let i = 0; i < gridElements.length; i++) {
        const rect = gridElements[i].getBoundingClientRect();
        if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
          return true;
        }
      }
      return false;
    }

    /**
     * Check whether coordinates (x, y) or an event target is inside the drop image section
     */
    function isPointInDropSection(x: number, y: number, target?: EventTarget | null): boolean {
      if (target instanceof Element && target.closest('#dropzone, [data-drop-zone="true"]')) {
        return true;
      }
      const dropEl = document.getElementById('dropzone') || document.querySelector('[data-drop-zone="true"]');
      if (dropEl) {
        const rect = dropEl.getBoundingClientRect();
        if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
          return true;
        }
      }
      return false;
    }

    /**
     * Get all visible grid background bounding boxes to clip the canvas rendering
     */
    function getVisibleGridRects(): DOMRect[] {
      const rects: DOMRect[] = [];
      const gridElements = document.querySelectorAll('.bg-grid-pattern, .bg-grid-pattern-subtle');
      for (let i = 0; i < gridElements.length; i++) {
        const rect = gridElements[i].getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < height && rect.right > 0 && rect.left < width) {
          rects.push(rect);
        }
      }
      return rects;
    }


    function startLoop() {
      if (!animId) {
        lastFrameTime = performance.now();
        animId = requestAnimationFrame(render);
      }
    }

    function updateGridStatus(x: number, y: number, target?: EventTarget | null) {
      if (isPointInDropSection(x, y, target)) {
        isInGrid = false;
        targetAlpha = 0;
        currentAlpha = 0;
        trail.length = 0;
        return;
      }

      const inGrid = isPointInGrid(x, y);
      if (inGrid) {
        isInGrid = true;
        targetAlpha = 1;
        startLoop();
      } else {
        isInGrid = false;
        targetAlpha = 0;
      }
    }

    function onPointerMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;

      if (currentX < 0) {
        currentX = targetX;
        currentY = targetY;
        lastX = targetX;
        lastY = targetY;
      }

      updateGridStatus(targetX, targetY, e.target);

      if (!isInGrid || isPointInDropSection(targetX, targetY, e.target)) {
        currentAlpha = 0;
        return;
      }

      const now = performance.now();
      trail.push({ x: targetX, y: targetY, time: now });

      const dx = targetX - lastX;
      const dy = targetY - lastY;
      const dist = Math.hypot(dx, dy);

      // Micro-sparks on active movement inside grid
      if (dist > 5 && now - lastMoveTime > 30) {
        const dark = isDarkMode();
        const palette = dark ? DARK_PALETTE : LIGHT_PALETTE;
        const colorObj = palette.particles[Math.floor(Math.random() * palette.particles.length)];
        const angle = Math.random() * Math.PI * 2;
        const speed = 0.3 + Math.random() * 1.2;
        particles.push({
          x: targetX + (Math.random() - 0.5) * 4,
          y: targetY + (Math.random() - 0.5) * 4,
          vx: Math.cos(angle) * speed + (dx * 0.03),
          vy: Math.sin(angle) * speed + (dy * 0.03) - 0.15,
          size: 1.0 + Math.random() * 1.6,
          color: colorObj.fill,
          glowColor: colorObj.glow,
          life: 0,
          maxLife: 240 + Math.random() * 200,
        });
        lastMoveTime = now;
      }

      lastX = targetX;
      lastY = targetY;
      startLoop();
    }

    function onPointerDown(e: MouseEvent) {
      const x = e.clientX;
      const y = e.clientY;

      if (!isPointInGrid(x, y) || isPointInDropSection(x, y, e.target)) return;

      const dark = isDarkMode();
      const palette = dark ? DARK_PALETTE : LIGHT_PALETTE;

      // Subtle neon ripple (compact shockwave)
      ripples.push({
        x,
        y,
        radius: 3,
        maxRadius: 36,
        life: 0,
        maxLife: 320,
      });

      // Subtle burst of themed sparks
      for (let i = 0; i < 8; i++) {
        const colorObj = palette.particles[Math.floor(Math.random() * palette.particles.length)];
        const angle = (i / 8) * Math.PI * 2 + (Math.random() * 0.4 - 0.2);
        const speed = 1.0 + Math.random() * 2.2;
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          size: 1.2 + Math.random() * 1.8,
          color: colorObj.fill,
          glowColor: colorObj.glow,
          life: 0,
          maxLife: 320 + Math.random() * 200,
        });
      }

      startLoop();
    }

    function onMouseLeave() {
      isInGrid = false;
      targetAlpha = 0;
    }

    function onScroll() {
      if (targetX >= 0 && targetY >= 0) {
        updateGridStatus(targetX, targetY);
      }
    }

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    window.addEventListener('pointerdown', onPointerDown, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });

    function render(now: number) {
      if (!ctx || !canvas) return;


      const dt = Math.min(now - lastFrameTime, 100);
      lastFrameTime = now;

      // Smooth tracking of cursor coordinates
      currentX += (targetX - currentX) * 0.45;
      currentY += (targetY - currentY) * 0.45;

      // Alpha transition: strictly 0 inside drop section or outside grid
      if (isInGrid && !isPointInDropSection(targetX, targetY) && !isPointInDropSection(currentX, currentY)) {
        currentAlpha += (targetAlpha - currentAlpha) * 0.25;
      } else {
        currentAlpha = 0;
      }
      if (currentAlpha < 0.002) currentAlpha = 0;

      ctx.clearRect(0, 0, width, height);

      // Clean up old trail points
      while (trail.length > 0 && now - trail[0].time > TRAIL_LIFETIME) {
        trail.shift();
      }

      const gridRects = getVisibleGridRects();
      if (gridRects.length === 0) {
        if (currentAlpha > 0 || particles.length > 0 || ripples.length > 0) {
          animId = requestAnimationFrame(render);
        } else {
          animId = null;
        }
        return;
      }

      const dark = isDarkMode();
      const palette = dark ? DARK_PALETTE : LIGHT_PALETTE;

      // Clip canvas strictly to visible grid sections, carving out drop zone
      const dropEl = document.getElementById('dropzone') || document.querySelector('[data-drop-zone="true"]');
      ctx.save();
      ctx.beginPath();
      for (let i = 0; i < gridRects.length; i++) {
        const r = gridRects[i];
        ctx.rect(r.left, r.top, r.width, r.height);
      }
      if (dropEl) {
        const dr = dropEl.getBoundingClientRect();
        if (dr.bottom > 0 && dr.top < height && dr.right > 0 && dr.left < width) {
          ctx.rect(dr.left, dr.top, dr.width, dr.height);
        }
      }
      ctx.clip('evenodd');

      ctx.globalCompositeOperation = palette.composite;

      // 1. Continuous Neon Cursor Lighting (Follows cursor all the time in grid area)
      if (currentAlpha > 0.01 && currentX >= 0 && currentY >= 0) {
        ctx.save();
        ctx.globalAlpha = currentAlpha;

        // Subtle electric breathing effect (tight radius: 68px to 76px)
        const pulse = Math.sin(now * 0.0035) * 4;
        const outerRadius = 72 + pulse; // Compact radius as requested
        const innerRadius = 24;

        // Radial multi-stop neon aura
        const grad = ctx.createRadialGradient(currentX, currentY, 0, currentX, currentY, outerRadius);
        grad.addColorStop(0, palette.neonCore);
        grad.addColorStop(0.15, palette.neonInner);
        grad.addColorStop(0.45, palette.neonMid);
        grad.addColorStop(0.80, palette.neonOuter);
        grad.addColorStop(1.0, palette.neonEdge);

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(currentX, currentY, outerRadius, 0, Math.PI * 2);
        ctx.fill();

        // Delicate precision concentric neon ring (Linear engineering aesthetic)
        ctx.beginPath();
        ctx.arc(currentX, currentY, innerRadius, 0, Math.PI * 2);
        ctx.strokeStyle = palette.ringColor;
        ctx.lineWidth = 0.75;
        ctx.shadowColor = palette.shadowColor;
        ctx.shadowBlur = 8;
        ctx.stroke();

        // Hot center pinpoint
        ctx.beginPath();
        ctx.arc(currentX, currentY, 2, 0, Math.PI * 2);
        ctx.fillStyle = palette.neonCore;
        ctx.shadowColor = palette.shadowColor;
        ctx.shadowBlur = 6;
        ctx.fill();

        ctx.restore();
      }

      // 2. Neon Ribbon Trail (Smooth motion ribbon behind cursor)
      if (trail.length > 1) {
        ctx.save();
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        for (let i = 0; i < trail.length - 1; i++) {
          const p1 = trail[i];
          const p2 = trail[i + 1];
          const age = now - p2.time;
          const progress = 1 - Math.min(age / TRAIL_LIFETIME, 1);
          if (progress <= 0) continue;

          const ratio = (i + 1) / trail.length;
          const alpha = progress * ratio * currentAlpha;
          if (alpha <= 0.01) continue;

          const lineWidth = Math.max(0.8, ratio * 4.5);

          // Pass 1: Neon glow bloom
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.strokeStyle = palette.trailBloom;
          ctx.shadowColor = palette.shadowColor;
          ctx.shadowBlur = 12;
          ctx.lineWidth = lineWidth * 2;
          ctx.stroke();

          // Pass 2: Hot filament core
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.strokeStyle = palette.trailCore;
          ctx.shadowColor = '#ffffff';
          ctx.shadowBlur = 3;
          ctx.lineWidth = Math.max(0.6, lineWidth * 0.4);
          ctx.stroke();
        }
        ctx.restore();
      }

      // 3. Neon Shockwave Ripples (Click effect)
      for (let i = ripples.length - 1; i >= 0; i--) {
        const r = ripples[i];
        r.life += dt;
        const progress = r.life / r.maxLife;

        if (progress >= 1) {
          ripples.splice(i, 1);
          continue;
        }

        const currentRadius = r.radius + (r.maxRadius - r.radius) * Math.sin(progress * Math.PI * 0.5);
        const alpha = (1 - progress);

        ctx.save();
        ctx.beginPath();
        ctx.arc(r.x, r.y, currentRadius, 0, Math.PI * 2);
        ctx.strokeStyle = palette.ringColor;
        ctx.shadowColor = palette.shadowColor;
        ctx.shadowBlur = 10;
        ctx.lineWidth = 1.2 * (1 - progress * 0.5);
        ctx.globalAlpha = Math.max(0, alpha);
        ctx.stroke();
        ctx.restore();
      }

      // 4. Neon Micro-Sparks
      ctx.save();
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life += dt;

        if (p.life >= p.maxLife) {
          particles.splice(i, 1);
          continue;
        }

        const progress = p.life / p.maxLife;
        const alpha = Math.sin((1 - progress) * Math.PI * 0.5);

        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.95;
        p.vy *= 0.95;
        p.vy += 0.015;

        const currentSize = p.size * (1 - progress * 0.5);

        ctx.beginPath();
        ctx.arc(p.x, p.y, Math.max(0.5, currentSize), 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.glowColor;
        ctx.shadowBlur = 8;
        ctx.globalAlpha = Math.max(0, alpha);
        ctx.fill();
      }
      ctx.restore();

      // End grid clipping
      ctx.restore();

      // Keep loop running if in grid or if there are active elements or fading out
      const hasActiveContent = isInGrid || currentAlpha > 0.005 || trail.length > 0 || particles.length > 0 || ripples.length > 0;
      if (hasActiveContent) {
        animId = requestAnimationFrame(render);
      } else {
        ctx.clearRect(0, 0, width, height);
        animId = null;
      }
    }
  })();
</script>
