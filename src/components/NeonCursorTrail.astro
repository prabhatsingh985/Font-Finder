---
// NeonCursorTrail.astro - Neon cursor after-effect strictly scoped to the grid background sections
---

<canvas id="neon-cursor-canvas" class="pointer-events-none fixed inset-0 z-[99999]" aria-hidden="true"></canvas>

<script>
  (function initNeonCursor() {
    // Respect reduced motion preference and coarse pointers (touch devices)
    if (typeof window === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const canvas = document.getElementById('neon-cursor-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      if (!canvas) return;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx?.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    interface TrailPoint {
      x: number;
      y: number;
      time: number;
    }

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      color: string;
      glowColor: string;
      life: number;
      maxLife: number;
    }

    interface Ripple {
      x: number;
      y: number;
      radius: number;
      maxRadius: number;
      life: number;
      maxLife: number;
    }

    const trail: TrailPoint[] = [];
    const particles: Particle[] = [];
    const ripples: Ripple[] = [];

    const TRAIL_LIFETIME = 380; // milliseconds
    let animId: number | null = null;
    let lastX = -100;
    let lastY = -100;
    let lastMoveTime = 0;
    let wasInGrid = false;

    // Palette of vibrant neon embers & hot orange tones
    const NEON_COLORS = [
      { fill: '#ff4d00', glow: 'rgba(255, 77, 0, 0.9)' },
      { fill: '#ff7b00', glow: 'rgba(255, 123, 0, 0.9)' },
      { fill: '#ffa600', glow: 'rgba(255, 166, 0, 0.9)' },
      { fill: '#ff3366', glow: 'rgba(255, 51, 102, 0.85)' },
      { fill: '#ffffff', glow: 'rgba(255, 200, 150, 0.9)' },
    ];

    /**
     * Check whether coordinates (x, y) are inside any element with the grid background pattern
     */
    function isPointInGrid(x: number, y: number): boolean {
      const gridElements = document.querySelectorAll('.bg-grid-pattern, .bg-grid-pattern-subtle');
      for (let i = 0; i < gridElements.length; i++) {
        const rect = gridElements[i].getBoundingClientRect();
        if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
          return true;
        }
      }
      return false;
    }

    /**
     * Get all visible grid background bounding boxes to clip the canvas rendering
     */
    function getVisibleGridRects(): DOMRect[] {
      const rects: DOMRect[] = [];
      const gridElements = document.querySelectorAll('.bg-grid-pattern, .bg-grid-pattern-subtle');
      for (let i = 0; i < gridElements.length; i++) {
        const rect = gridElements[i].getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < height && rect.right > 0 && rect.left < width) {
          rects.push(rect);
        }
      }
      return rects;
    }

    function startLoop() {
      if (!animId) {
        lastFrameTime = performance.now();
        animId = requestAnimationFrame(render);
      }
    }

    let lastFrameTime = performance.now();

    function onPointerMove(e: MouseEvent) {
      const x = e.clientX;
      const y = e.clientY;

      const inGrid = isPointInGrid(x, y);

      // If cursor is outside the grid background part, stop adding to the trail
      if (!inGrid) {
        wasInGrid = false;
        return;
      }

      // If re-entering the grid from outside, reset trail so no jump lines connect across other sections
      if (!wasInGrid) {
        trail.length = 0;
        lastX = x;
        lastY = y;
        wasInGrid = true;
      }

      const now = performance.now();
      trail.push({ x, y, time: now });

      const dx = x - lastX;
      const dy = y - lastY;
      const dist = Math.hypot(dx, dy);

      // Spawn glowing neon micro-sparks on movement over the grid
      if (dist > 3 && now - lastMoveTime > 16) {
        const count = Math.min(Math.floor(dist / 8) + 1, 3);
        for (let i = 0; i < count; i++) {
          const colorObj = NEON_COLORS[Math.floor(Math.random() * NEON_COLORS.length)];
          const angle = Math.random() * Math.PI * 2;
          const speed = 0.4 + Math.random() * 1.8;
          particles.push({
            x: x + (Math.random() - 0.5) * 6,
            y: y + (Math.random() - 0.5) * 6,
            vx: Math.cos(angle) * speed + (dx * 0.05),
            vy: Math.sin(angle) * speed + (dy * 0.05) - 0.3,
            size: 1.2 + Math.random() * 2.2,
            color: colorObj.fill,
            glowColor: colorObj.glow,
            life: 0,
            maxLife: 320 + Math.random() * 280,
          });
        }
        lastMoveTime = now;
      }

      lastX = x;
      lastY = y;
      startLoop();
    }

    function onPointerDown(e: MouseEvent) {
      const x = e.clientX;
      const y = e.clientY;

      // Only produce click ripples and spark bursts if clicking inside the grid background part
      if (!isPointInGrid(x, y)) return;

      // Create expanding neon shockwave ripple
      ripples.push({
        x,
        y,
        radius: 4,
        maxRadius: 42,
        life: 0,
        maxLife: 380,
      });

      // Burst of neon ember sparks
      for (let i = 0; i < 12; i++) {
        const colorObj = NEON_COLORS[Math.floor(Math.random() * NEON_COLORS.length)];
        const angle = (i / 12) * Math.PI * 2 + (Math.random() * 0.4 - 0.2);
        const speed = 1.5 + Math.random() * 3.2;
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          size: 1.6 + Math.random() * 2.4,
          color: colorObj.fill,
          glowColor: colorObj.glow,
          life: 0,
          maxLife: 420 + Math.random() * 300,
        });
      }

      startLoop();
    }

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    window.addEventListener('pointerdown', onPointerDown, { passive: true });

    function render(now: number) {
      if (!ctx || !canvas) return;

      const dt = Math.min(now - lastFrameTime, 100);
      lastFrameTime = now;

      ctx.clearRect(0, 0, width, height);

      // Clean up old points in trail
      while (trail.length > 0 && now - trail[0].time > TRAIL_LIFETIME) {
        trail.shift();
      }

      const gridRects = getVisibleGridRects();
      // If no grid sections are currently visible on screen, skip rendering
      if (gridRects.length === 0) {
        if (trail.length > 0 || particles.length > 0 || ripples.length > 0) {
          animId = requestAnimationFrame(render);
        } else {
          animId = null;
        }
        return;
      }

      // Strictly clip rendering to the visible grid background parts
      ctx.save();
      ctx.beginPath();
      for (let i = 0; i < gridRects.length; i++) {
        const r = gridRects[i];
        ctx.rect(r.left, r.top, r.width, r.height);
      }
      ctx.clip();

      // 1. Draw smooth Neon Ribbon Trail
      if (trail.length > 1) {
        ctx.save();
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        for (let i = 0; i < trail.length - 1; i++) {
          const p1 = trail[i];
          const p2 = trail[i + 1];
          const age = now - p2.time;
          const progress = 1 - Math.min(age / TRAIL_LIFETIME, 1);
          if (progress <= 0) continue;

          const ratio = (i + 1) / trail.length;
          const alpha = progress * ratio;
          const lineWidth = Math.max(1, ratio * 7);

          // Pass 1: Wide neon bloom
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.strokeStyle = `rgba(255, 77, 0, ${alpha * 0.45})`;
          ctx.shadowColor = '#ff4d00';
          ctx.shadowBlur = 18;
          ctx.lineWidth = lineWidth * 2.4;
          ctx.stroke();

          // Pass 2: Intense neon body
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.strokeStyle = `rgba(255, 120, 20, ${alpha * 0.85})`;
          ctx.shadowColor = '#ff7b00';
          ctx.shadowBlur = 10;
          ctx.lineWidth = lineWidth * 1.2;
          ctx.stroke();

          // Pass 3: Ultra-hot white/orange core
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.strokeStyle = `rgba(255, 245, 230, ${alpha * 0.95})`;
          ctx.shadowColor = '#ffffff';
          ctx.shadowBlur = 4;
          ctx.lineWidth = Math.max(1, lineWidth * 0.45);
          ctx.stroke();
        }
        ctx.restore();
      }

      // 2. Draw Neon Ripples (Click Shockwaves)
      for (let i = ripples.length - 1; i >= 0; i--) {
        const r = ripples[i];
        r.life += dt;
        const progress = r.life / r.maxLife;

        if (progress >= 1) {
          ripples.splice(i, 1);
          continue;
        }

        const currentRadius = r.radius + (r.maxRadius - r.radius) * Math.sin(progress * Math.PI * 0.5);
        const alpha = (1 - progress);

        ctx.save();
        ctx.beginPath();
        ctx.arc(r.x, r.y, currentRadius, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(255, 77, 0, ${alpha * 0.7})`;
        ctx.shadowColor = '#ff4d00';
        ctx.shadowBlur = 14;
        ctx.lineWidth = 2 * (1 - progress * 0.5);
        ctx.stroke();
        ctx.restore();
      }

      // 3. Update and Draw Neon Sparks / Micro-particles
      ctx.save();
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life += dt;

        if (p.life >= p.maxLife) {
          particles.splice(i, 1);
          continue;
        }

        const progress = p.life / p.maxLife;
        const alpha = Math.sin((1 - progress) * Math.PI * 0.5);

        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.96;
        p.vy *= 0.96;
        p.vy += 0.02; // tiny gravity drift

        const currentSize = p.size * (1 - progress * 0.6);

        ctx.beginPath();
        ctx.arc(p.x, p.y, Math.max(0.6, currentSize), 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.glowColor;
        ctx.shadowBlur = 10;
        ctx.globalAlpha = Math.max(0, alpha);
        ctx.fill();
      }
      ctx.restore();

      // End clipping
      ctx.restore();

      // Loop condition: only keep running if there's active visual content
      const hasActiveContent = trail.length > 0 || particles.length > 0 || ripples.length > 0;
      if (hasActiveContent) {
        animId = requestAnimationFrame(render);
      } else {
        ctx.clearRect(0, 0, width, height);
        animId = null;
      }
    }
  })();
</script>
